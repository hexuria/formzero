 the COR says" label="{profileCorAddressLabel}" on-input="profile_cor_address_input"/><checkbox height="44" checked="{profileCorAddressAccepted}" text="Use this value" on-toggle="profile_cor_toggle_address"/></column><column gap="6"><text wrap="true" foreground="text_muted">{profileCorZipLabel}</text><input height="44" text="{profileCorZipValue}" placeholder="What the COR says" label="{profileCorZipLabel}" on-input="profile_cor_zip_input"/><checkbox height="44" checked="{profileCorZipAccepted}" text="Use this value" on-toggle="profile_cor_toggle_zip"/></column><checkbox height="44" checked="{profileCorApplyFormsSelected}" text="{profileCorApplyFormsLabel}" on-toggle="profile_cor_toggle_apply_forms"/></column></else><row gap="8"><button height="44" variant="outline" on-press="profile_cor_cancel_review">Cancel</button><button height="44" variant="primary" disabled="{profileCorApplyDisabled}" on-press="profile_cor_apply">{profileCorApplyLabel}</button></row></column></card></template><template name="bc"><column min-width="0"><row min-width="0" padding="20" gap="12" cross="center"><column grow="1" min-width="0" gap="4"><text><span weight="bold" scale="1.2">{profileDirtyNavigationTitle}</span></text></column><button width="36" height="36" size="icon" variant="ghost" icon="x" label="Keep editing" on-press="profile_keep_editing"></button></row><separator/><column grow="1" min-width="0" padding="20" gap="16"><text wrap="true" foreground="text_muted">{profileDirtyNavigationBody}</text><if test="{profileSessionDraftActionVisible}"><text size="sm" wrap="true" foreground="text_muted">{profileSessionDraftMessage}</text></if><if test="{profileSessionDraftBlockedVisible}"><text size="sm" wrap="true" foreground="warning">A session draft is already available. Resume or discard it before saving another draft.</text></if></column><separator/><if test="{constrainedLayout}"><column min-width="0" padding="20" gap="8"><if test="{profileSessionDraftActionVisible}"><button size="sm" variant="primary" on-press="profile_save_session_draft_navigation">Save draft and continue</button></if><button size="sm" variant="destructive" on-press="profile_discard_navigation">{profileDiscardNavigationLabel}</button></column></if><else><row min-width="0" padding="20" gap="8" main="end" cross="center"><if test="{profileSessionDraftActionVisible}"><button size="sm" variant="primary" on-press="profile_save_session_draft_navigation">Save draft and continue</button></if><button size="sm" variant="destructive" on-press="profile_discard_navigation">{profileDiscardNavigationLabel}</button></row></else></column></template><template name="bd"><column gap="24"><if test="{profileInlineBackVisible}"><row gap="10" cross="start"><button width="44" height="44" size="icon" variant="ghost" radius="xl" icon="chevron-left" label="{profileBackLabel}" disabled="{profileInlineBackDisabled}" on-press="go_back"></button><column grow="1" gap="6"><text size="heading">{profileEditorTitle}</text><text wrap="true" foreground="text_muted">{profileVersioningHelp}</text></column></row></if><tabs label="Profile setup sections"><button height="44" selected="{profileTaxActive}" on-press="show_profile_tax">{profileTaxTabLabel}</button><button height="44" selected="{profileRegistrationFilingActive}" on-press="show_profile_reg_filing">{profileRegistrationTabLabel}</button><button height="44" selected="{profileTaxFormsActive}" on-press="show_profile_tax_forms">{profileTaxFormsTabLabel}</button><button height="44" selected="{profileEmailActive}" on-press="show_profile_email">{profileEmailTabLabel}</button></tabs><if test="{profileCompletionVisible}"><card padding="0"><row padding="12" gap="10" cross="center"><badge variant="outline">Profile data required</badge><text wrap="true" foreground="text_muted">{profileCompletionMessage}</text></row></card></if><if test="{profileTaxActive}"><if test="{profileSessionDraftVisible}"><card padding="0"><column padding="14" gap="10"><column gap="4"><row gap="8" cross="center"><text><span weight="bold">Session draft available</span></text><badge variant="secondary">Session only</badge></row><text wrap="true" foreground="text_muted">{profileSessionDraftMessage}</text></column><if test="{constrainedLayout}"><column gap="8"><button size="sm" variant="primary" on-press="resume_profile_session_draft">Resume draft</button><button size="sm" variant="ghost" icon="x" on-press="discard_profile_session_draft">Discard session draft</button></column></if><else><row gap="8" main="end"><button size="sm" variant="ghost" icon="x" label="Discard session draft" on-press="discard_profile_session_draft"></button><button size="sm" variant="primary" on-press="resume_profile_session_draft">Resume draft</button></row></else></column></card></if><if test="{profileLegacyIdentityReadOnly}"><alert text="Legacy Taxpayer Profile is read-only"><column gap="10"><text wrap="true">{profileLegacyIdentityReadOnlyHelp}</text><row><button height="44" variant="primary" on-press="show_profile_reg_filing">Open Registration & Filing</button></row></column></alert></if><else><column gap="24"><if test="{profileTaxViewing}"><column gap="20"><if test="{constrainedLayout}"><column gap="10"><column gap="4"><text><span weight="bold">Saved Taxpayer Profile</span></text><text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text></column><button height="44" variant="primary" on-press="edit_tax_profile">Edit Taxpayer Profile</button></column></if><else><row gap="12" cross="center"><column grow="1" gap="4"><text><span weight="bold">Saved Taxpayer Profile</span></text><text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text></column><button height="44" variant="primary" on-press="edit_tax_profile">Edit Taxpayer Profile</button></row></else><if test="{profileFactsSummaryVisible}"><card padding="0"><column padding="14" gap="6"><text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text></column></card></if><card padding="0"><column padding="18" gap="16"><column gap="4"><text><span weight="bold">Identity and contact</span></text><text wrap="true" foreground="text_muted">Base facts shared by the taxpayer's forms.</text></column><grid columns="{profileReadColumns}" gap="16"><use template="as" label="Taxpayer Identification Number (TIN)" value="{profileTinDisplayValue}"/><use template="as" label="Revenue District Office (RDO) code" value="{profileRdoDisplayValue}"/><use template="as" label="Taxpayer Type" value="{profileSubjectKindLabel}"/><if test="{profileNaturalPersonClassificationVisible}"><use template="as" label="Tax Classification" value="{profileNaturalPersonClassificationLabel}"/></if><use template="as" label="Taxpayer or registered name" value="{profileNameDisplayValue}"/><if test="{profileTradeNameVisible}"><use template="as" label="Trade name" value="{profileTradeNameDisplayValue}"/></if><use template="as" label="Registered address" value="{profileAddressDisplayValue}"/><use template="as" label="ZIP code" value="{profileZipDisplayValue}"/><use template="as" label="Contact number" value="{profilePhoneDisplayValue}"/><use template="as" label="Registered email address" value="{profileEmailDisplayValue}"/></grid></column></card><card padding="0"><column padding="18" gap="16"><column gap="4"><text><span weight="bold">Accounting period</span></text><text wrap="true" foreground="text_muted">The accounting basis used to derive filing periods.</text></column><grid columns="{profileReadColumns}" gap="16"><use template="as" label="Accounting basis" value="{profileAccountingPeriodBasisLabel}"/><if test="{profileFiscalYearEndMonthVisible}"><use template="as" label="Fiscal year-end month" value="{profileFiscalYearEndMonthValue}"/></if></grid></column></card><if test="{profileBusinessFieldsVisible}"><card padding="0"><column padding="18" gap="16"><column gap="4"><text><span weight="bold">Business details</span></text><text wrap="true" foreground="text_muted">Reusable business facts shared by forms that request them.</text></column><grid columns="{profileReadColumns}" gap="16"><use template="as" label="EOPT Tier" value="{profileEoptTierLabel}"/><use template="as" label="Primary Line of Business" value="{profilePrimaryLineOfBusinessDisplayValue}"/></grid></column></card></if><if test="{profilePersonalFieldsVisible}"><card padding="0"><column padding="18" gap="16"><text><span weight="bold">Individual details</span></text><grid columns="{profileReadColumns}" gap="16"><use template="as" label="Birth date" value="{profileBirthDateDisplayValue}"/><use template="as" label="Citizenship" value="{profileCitizenshipDisplayValue}"/><use template="as" label="Foreign tax number" value="{profileForeignTaxNumberDisplayValue}"/></grid></column></card></if><card padding="0"><column padding="18" gap="8"><text><span weight="bold">Effective date</span></text><use template="as" label="Details effective from" value="{profileEffectiveFromDisplayValue}"/></column></card></column></if><else><if test="{profileBranchMode}"><card padding="0"><column padding="14" gap="6"><text><span weight="bold">{profileBranchBannerTitle}</span></text><text wrap="true" foreground="text_muted">{profileBranchBannerBody}</text><text wrap="true" foreground="text_muted">{profileBranchCopyNote}</text></column></card></if><if test="{profileFactsSummaryVisible}"><card padding="0"><column padding="14" gap="6"><text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text><if test="{profileFactsMissingVisible}"><text wrap="true" foreground="text_muted">{profileFactsMissingHelpText}</text></if></column></card></if><column gap="16"><column gap="4"><text><span weight="bold">Identity and contact</span></text><text wrap="true" foreground="text_muted">{profileIdentityHelp}</text></column><grid columns="{profileReadColumns}" gap="12"><use template="ar" label="Taxpayer Identification Number (TIN)"><use template="av"/></use><use template="ar" label="Revenue District Office (RDO)"><use template="aw"/></use></grid><if test="{profileTinInvalidVisible}"><text wrap="true" foreground="destructive">{profileTinValidationMessage}</text></if><column gap="8"><text>Taxpayer Type</text><stack><combobox height="44" text="{profileSubjectQueryValue}" placeholder="Search taxpayer type" label="Taxpayer Type" selected="{profileSubjectCommittedSelection}" expanded="{profileSubjectPickerOpen}" disabled="{profileBranchMode}" on-input="profile_subject_query_input" on-focus="toggle_profile_subject_picker" on-press="toggle_profile_subject_picker" on-blur="profile_subject_blurred"/><if test="{profileSubjectPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="close_profile_subject_picker"><column padding="4" gap="2"><for each="profileSubjectKindOptionRows" key="id" as="option"><menu-item height="44" selected="{option.selected}" on-press="profile_subject_select:{option.id}">{option.label}</menu-item></for></column></dropdown-menu></if></stack><if test="{profileSubjectErrorVisible}"><text wrap="true" foreground="destructive">{profileSubjectValidationMessage}</text></if></column><if test="{profileNaturalPersonClassificationVisible}"><column gap="8"><text>Tax Classification</text><text wrap="true" foreground="text_muted">{profileClassificationHelp}</text><stack><combobox height="44" text="{profileClassificationQueryValue}" placeholder="Search tax classification" label="Tax Classification" selected="{profileClassificationCommittedSelection}" expanded="{profileClassificationPickerOpen}" on-input="profile_classification_query_input" on-focus="toggle_profile_classification_picker" on-press="toggle_profile_classification_picker" on-blur="profile_classification_blurred"/><if test="{profileClassificationPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="close_profile_classification_picker"><column padding="4" gap="2"><for each="profileClassificationOptionRows" key="id" as="option"><menu-item height="44" selected="{option.selected}" on-press="profile_classification_select:{option.id}">{option.label}</menu-item></for><else><menu-item height="44" disabled="true">No matching classifications</menu-item></else></column></dropdown-menu></if></stack><if test="{profileClassificationErrorVisible}"><text wrap="true" foreground="destructive">{profileClassificationValidationMessage}</text></if></column></if><use template="ar" label="Taxpayer or registered name"><column gap="6"><input height="44" text="{profileNameValue}" placeholder="Registered taxpayer name" label="Taxpayer or registered name" autofocus="{profileNameAutofocus}" on-input="profile_name_input" on-blur="profile_name_blurred"/><if test="{profileNameErrorVisible}"><text wrap="true" foreground="destructive">{profileNameValidationMessage}</text></if></column></use><if test="{profileTradeNameVisible}"><use template="ar" label="Trade name"><input height="44" text="{profileTradeNameValue}" placeholder="Optional DTI or registered trade name" label="Trade name" on-input="profile_trade_name_input"/></use></if><use template="ar" label="Registered address"><column gap="6"><input height="44" text="{profileAddressValue}" placeholder="Registered address" label="Registered address" autofocus="{profileAddressAutofocus}" on-input="profile_address_input" on-blur="profile_address_blurred"/><if test="{profileAddressErrorVisible}"><text wrap="true" foreground="destructive">{profileAddressValidationMessage}</text></if></column></use><grid columns="{profileReadColumns}" gap="12"><use template="ar" label="ZIP code"><column gap="6"><stack><combobox height="44" text="{profileZipQueryValue}" placeholder="Search ZIP code or location" label="ZIP code" selected="{profileZipCommittedSelection}" expanded="{profileZipPickerOpen}" autofocus="{profileZipAutofocus}" on-input="profile_zip_query_input" on-focus="profile_zip_toggle_picker" on-press="profile_zip_toggle_picker" on-blur="profile_zip_blurred"/><if test="{profileZipPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_zip_close_picker"><column padding="4" gap="2"><if test="{profileZipCommittedSelection}"><menu-item height="44" on-press="profile_zip_clear">Clear ZIP code</menu-item></if><for each="profileZipOptionRows" key="id" as="option"><menu-item height="44" selected="{option.selected}" on-press="profile_zip_select:{option.id}">{option.rowLabel}</menu-item></for><else><menu-item height="44" disabled="true">No matching ZIP codes or locations</menu-item></else></column></dropdown-menu></if></stack><text size="sm" wrap="true" foreground="text_muted">Postal-code suggestions © GeoNames, CC BY 4.0. You may still enter any valid four-digit Philippine ZIP code.</text><if test="{profileZipErrorVisible}"><text wrap="true" foreground="destructive">{profileZipValidationMessage}</text></if></column></use><use template="ar" label="Contact number"><column gap="6"><input height="44" text="{profilePhoneValue}" placeholder="+63 917 123 4567" label="Contact number" autofocus="{profilePhoneAutofocus}" on-input="profile_phone_input" on-blur="profile_phone_blurred"/><if test="{profilePhoneErrorVisible}"><text wrap="true" foreground="destructive">{profilePhoneValidationMessage}</text></if></column></use></grid><use template="ar" label="Registered email address"><column gap="6"><input height="44" text="{profileEmailValue}" placeholder="name@example.ph" label="Registered email address" autofocus="{profileEmailAutofocus}" on-input="profile_email_input" on-blur="profile_email_blurred"/><if test="{profileEmailErrorVisible}"><text wrap="true" foreground="destructive">{profileEmailValidationMessage}</text></if></column></use></column><column gap="16"><column gap="4"><text><span weight="bold">Accounting period</span></text><text wrap="true" foreground="text_muted">Choose the basis used to derive this taxpayer's filing periods.</text></column><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" selected="{profileAccountingPeriodCalendarSelected}" on-press="profile_accounting_period_calendar">Calendar</button><button height="44" variant="outline" selected="{profileAccountingPeriodFiscalSelected}" on-press="profile_accounting_period_fiscal">Fiscal</button></grid><if test="{profileAccountingPeriodBasisErrorVisible}"><text wrap="true" foreground="destructive">{profileAccountingPeriodBasisValidationMessage}</text></if><if test="{profileFiscalYearEndMonthVisible}"><use template="ar" label="Fiscal year-end month"><column gap="6"><input height="44" text="{profileFiscalYearEndMonthValue}" placeholder="1 to 12" label="Fiscal year-end month" on-input="profile_fiscal_year_end_month_input" on-blur="profile_fiscal_year_end_month_blurred"/><if test="{profileFiscalYearEndMonthErrorVisible}"><text wrap="true" foreground="destructive">{profileFiscalYearEndMonthValidationMessage}</text></if></column></use></if></column><if test="{profileBusinessFieldsVisible}"><column gap="16"><column gap="4"><text><span weight="bold">Business details</span></text><text wrap="true" foreground="text_muted">These reusable fields are saved in this Taxpayer Profile revision.</text></column><column gap="8"><text>EOPT Tier</text><stack><select height="44" label="EOPT Tier" on-press="toggle_profile_eopt_picker">{profileEoptTierLabel}</select><if test="{profileEoptPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="close_profile_eopt_picker"><menu-item height="44" selected="{profileEoptMicroSelected}" on-press="profile_eopt_micro">Micro</menu-item><menu-item height="44" selected="{profileEoptSmallSelected}" on-press="profile_eopt_small">Small</menu-item><menu-item height="44" selected="{profileEoptMediumSelected}" on-press="profile_eopt_medium">Medium</menu-item><menu-item height="44" selected="{profileEoptLargeSelected}" on-press="profile_eopt_large">Large</menu-item></dropdown-menu></if></stack></column><use template="ar" label="Primary Line of Business"><input height="44" text="{profilePrimaryLineOfBusinessValue}" placeholder="Primary line of business" label="Primary Line of Business" on-input="profile_primary_line_of_business_input"/></use></column></if><if test="{profilePersonalFieldsVisible}"><column gap="16"><column gap="4"><text><span weight="bold">Individual details</span></text><text wrap="true" foreground="text_muted">Birth date and citizenship are required for an individual taxpayer. A foreign tax number remains optional.</text></column><grid columns="{profileReadColumns}" gap="12"><use template="ar" label="Birth date"><column gap="6"><input height="44" text="{profileBirthDateValue}" placeholder="81788, 08/17/1988, or 1988-08-17" label="Birth date" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileBirthDateAutofocus}" on-input="profile_birth_date_input" on-focus="profile_birth_date_focused" on-blur="profile_birth_date_blurred"/><if test="{profileBirthDateErrorVisible}"><text wrap="true" foreground="destructive">{profileBirthDateValidationMessage}</text></if></column></use><use template="ar" label="Citizenship"><column gap="6"><stack><combobox height="44" text="{profileCitizenshipQueryValue}" placeholder="Search citizenship" label="Citizenship" selected="{profileCitizenshipCommittedSelection}" expanded="{profileCitizenshipPickerOpen}" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileCitizenshipAutofocus}" on-input="profile_citizenship_input" on-focus="profile_citizenship_toggle_picker" on-press="profile_citizenship_toggle_picker" on-blur="profile_citizenship_blurred"/><if test="{profileCitizenshipPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_citizenship_close_picker"><column padding="4" gap="2"><for each="profileCitizenshipOptionRows" key="id" as="option"><menu-item height="44" selected="{option.selected}" on-press="profile_citizenship_select:{option.id}">{option.label}</menu-item></for></column></dropdown-menu></if></stack><if test="{profileCitizenshipErrorVisible}"><text wrap="true" foreground="destructive">{profileCitizenshipValidationMessage}</text></if></column></use></grid><use template="ar" label="Foreign tax number"><input height="44" text="{profileForeignTaxNumberValue}" placeholder="Optional foreign tax identifier" label="Foreign tax number" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileForeignTaxNumberAutofocus}" on-input="profile_foreign_tax_number_input"/></use></column></if><column gap="16"><column gap="4"><text><span weight="bold">When this applies</span></text><text wrap="true" foreground="text_muted">{profileEffectiveDateHelp}</text></column><if test="{profileChangeControlsVisible}"><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" selected="{profileRecordChangeSelected}" on-press="profile_record_change">Record a change</button><button height="44" variant="outline" selected="{profileFixMistakeSelected}" on-press="profile_fix_mistake">Fix a mistake</button></grid></if><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" selected="{profileAnnualEffectiveYears}" on-press="profile_use_annual_effective_years">Year selection</button><button height="44" variant="outline" selected="{profileExactEffectiveDates}" on-press="profile_use_exact_effective_dates">Use exact dates</button></grid><if test="{profileAnnualEffectiveYears}"><text wrap="true" foreground="text_muted">A start year maps to January 1. An optional end year maps to December 31; leaving it blank keeps this profile available in later years.</text><grid columns="{profileReadColumns}" gap="12"><use template="ar" label="When did this take effect?"><column gap="6"><stack><combobox height="44" text="{profileEffectiveStartYearValue}" placeholder="YYYY" label="When did this take effect?" selected="{profileEffectiveStartYearSelected}" expanded="{profileEffectiveStartYearPickerOpen}" on-input="profile_effective_start_year_input" on-focus="profile_effective_start_year_toggle_picker" on-press="profile_effective_start_year_toggle_picker" on-blur="profile_effective_start_year_blurred"/><if test="{profileEffectiveStartYearPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_effective_start_year_close_picker"><column padding="4" gap="2"><for each="profileEffectiveStartYearOptionRows" key="value" as="option"><menu-item height="44" selected="{option.selected}" on-press="profile_effective_start_year_select:{option.value}">{option.value}</menu-item></for></column></dropdown-menu></if></stack><if test="{profileEffectiveStartErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveStartValidationMessage}</text></if></column></use><use template="ar" label="Applies until"><column gap="6"><stack><combobox height="44" text="{profileEffectiveEndYearValue}" placeholder="Optional YYYY" label="Applies until" selected="{profileEffectiveEndYearSelected}" expanded="{profileEffectiveEndYearPickerOpen}" on-input="profile_effective_end_year_input" on-focus="profile_effective_end_year_toggle_picker" on-press="profile_effective_end_year_toggle_picker" on-blur="profile_effective_end_year_blurred"/><if test="{profileEffectiveEndYearPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_effective_end_year_close_picker"><column padding="4" gap="2"><menu-item height="44" selected="{profileEffectiveEndYearClearSelected}" on-press="profile_effective_end_year_clear">No end year</menu-item><for each="profileEffectiveEndYearOptionRows" key="value" as="option"><menu-item height="44" selected="{option.selected}" on-press="profile_effective_end_year_select:{option.value}">{option.value}</menu-item></for></column></dropdown-menu></if></stack><if test="{profileEffectiveEndErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveEndValidationMessage}</text></if></column></use></grid></if><else><text wrap="true" foreground="warning">This revision uses custom dates. Keep them exact so historic filings continue to select the right profile facts.</text><use template="ar" label="{profileEffectiveDateLabel}"><column gap="6"><input height="44" text="{profileEffectiveFromValue}" placeholder="YYYY-MM-DD" label="{profileEffectiveDateLabel}" on-input="profile_effective_from_input" on-blur="profile_effective_start_blurred"/><if test="{profileEffectiveStartErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveStartValidationMessage}</text></if></column></use><use template="ar" label="Applies until"><column gap="6"><input height="44" text="{profileEffectiveUntilValue}" placeholder="YYYY-MM-DD or empty" label="Applies until" on-input="profile_effective_until_input" on-blur="profile_effective_end_blurred"/><if test="{profileEffectiveEndErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveEndValidationMessage}</text></if></column></use></else><text wrap="true" foreground="text_muted">{profileIdentityLockNote}</text></column></else></column></else></if><if test="{profileRegistrationFilingActive}"><column gap="20"><column gap="4"><text size="heading"><span weight="bold">Registration & Filing</span></text><text wrap="true" foreground="text_muted">{regCanonicalHelp}</text></column><alert text="{regCanonicalMutationGateTitle}"><text wrap="true">{regCanonicalMutationGateHelp}</text></alert><if test="{regGlobalActionVisible}"><alert text="{regActionHeading}"><text wrap="true">{regActionLabel}</text></alert></if><if test="{regCanonicalEmpty}"><if test="{regCanonicalMutationsEnabled}"><card padding="0"><column padding="20" gap="10"><text><span weight="bold">Create the first Taxpayer</span></text><row><badge variant="outline">{regWorkspaceStatusLabel}</badge></row><text wrap="true" foreground="text_muted">{regCreateHelp}</text><use template="au" action="Create Taxpayer"/></column></card></if><else><card padding="0"><column padding="20" gap="8"><text><span weight="bold">No canonical registration records</span></text><row><badge variant="outline">Read-only</badge></row><text wrap="true" foreground="text_muted">No Taxpayer or Registration Unit records exist in this data store. Creation controls are hidden because this is not an explicitly owned fixture workspace.</text></column></card></else></if><else><column gap="16"><column gap="10"><grid columns="{profileReadColumns}" gap="8"><text grow="1"><span weight="bold">Taxpayers</span></text><row gap="6" cross="center"><badge variant="outline">{regWorkspaceStatusLabel}</badge><if test="{regCanonicalMutationsDisabled}"><badge variant="outline">Read-only</badge></if><if test="{regWorkspaceReviewRequired}"><badge variant="destructive">Review Required</badge></if></row></grid><column gap="6"><for each="regTaxpayerRows" key="stableKey" as="taxpayer"><list-item height="64" padding="10" selected="{taxpayer.selected}" label="{taxpayer.accessibleLabel}" on-press="reg_select_taxpayer:{taxpayer.id}"><column grow="1" gap="3"><text><span weight="bold">{taxpayer.visibleLabel}</span></text><text size="sm" foreground="text_muted">{taxpayer.statusLabel}</text></column></list-item></for></column><if test="{regCanonicalMutationsEnabled}"><separator/><use template="au" action="Add Taxpayer"/></if></column><separator/><grid columns="{profileReadColumns}" gap="16"><column gap="10"><column gap="3"><text><span weight="bold">Registration Units</span></text><text wrap="true" foreground="text_muted">{regUnitListStatusLabel}</text></column><if test="{regUnitRowsEmpty}"><text wrap="true" foreground="warning">Review Required — no effective Registration Unit is available.</text></if><else><column gap="6"><for each="regUnitRows" key="stableKey" as="unit"><list-item height="84" padding="10" selected="{unit.selected}" label="{unit.accessibleLabel}" on-press="reg_select_registration_unit:{unit.id}"><column grow="1" gap="3"><text><span weight="bold">{unit.kindLabel}</span>· {unit.codeLabel}</text><text size="sm" wrap="true" foreground="text_muted">{unit.statusLabel} · RDO {unit.rdoLabel}</text><row><badge variant="{unit.vatRegistrationTone}">{unit.vatRegistrationLabel}</badge></row></column></list-item></for></column></else></column><column gap="10"><use template="as" label="Taxpayer TIN root" value="{regSelectedTaxpayerMaskedTin}"/><use template="as" label="Workspace focus" value="{regSelectedRegistrationUnitLabel}"/><use template="as" label="Workspace-focus RDO" value="{regSelectedRegistrationUnitRdoLabel}"/><text wrap="true" foreground="text_muted">This Registration Unit selection is for workspace review only; it is neither Source Attribution nor the resolved Filing Unit.</text></column></grid><separator/><column gap="10"><if test="{phoneLayout}"><column gap="6"><text><span weight="bold">Source records for this Registration Unit</span></text><text wrap="true" foreground="text_muted">{regSourceWorkspaceSummary}</text><row><if test="{regSourceWorkspaceReviewRequired}"><badge variant="destructive">Review Required</badge></if><else><badge variant="outline">Read-only filter</badge></else></row></column></if><else><row gap="8" cross="center"><column grow="1" gap="3"><text><span weight="bold">Source records for this Registration Unit</span></text><text wrap="true" foreground="text_muted">{regSourceWorkspaceSummary}</text></column><if test="{regSourceWorkspaceReviewRequired}"><badge variant="destructive">Review Required</badge></if><else><badge variant="outline">Read-only filter</badge></else></row></else><text wrap="true" foreground="text_muted">Only records with Source Attribution entered or derived before this selection can appear. Changing this workspace filter never assigns a Source Unit, changes Return Coverage, or chooses the Filing Unit.</text><if test="{regSourceRowsEmpty}"><text wrap="true" foreground="text_muted">No explicitly attributed records match this taxpayer, Registration Unit, and quarter.</text></if><else><column gap="4"><for each="regSourceRecordRows" key="stableKey" as="record"><list-item label="{record.accessibleLabel}"><row padding="10" gap="12" cross="center"><column grow="1" gap="3"><text><span weight="bold">{record.visibleLabel}</span>· {record.occurredOnLabel}</text><text size="sm" wrap="true" foreground="text_muted">{record.attributionLabel}</text></column><badge variant="outline">Attributed</badge></row></list-item></for></column></else><if test="{regSourceWorkspaceReviewRequired}"><alert text="Unresolved Source Attribution excluded"><text wrap="true">{regSourceWorkspaceReviewLabel}</text></alert></if><text size="sm" wrap="true" foreground="text_muted">{regSourcePreviewHelp}</text></column><if test="{regCanonicalMutationsEnabled}"><separator/><column gap="12"><column gap="4"><text><span weight="bold">Add a branch candidate</span></text><text foreground="warning"><span weight="bold">{regSuggestedBranchLabel}</span></text><text wrap="true" foreground="text_muted">{regBranchHelp}</text></column><grid columns="{profileReadColumns}" gap="12"><use template="ar" label="Candidate Branch Code"><input height="44" text="{regBranchCodeInputValue}" placeholder="e.g. 00001" label="Candidate Branch Code" on-input="reg_branch_code_input"/></use><use template="ar" label="Branch candidate effective from"><input height="44" text="{regBranchEffectiveInputValue}" placeholder="YYYY-MM-DD" label="Branch candidate effective from" on-input="reg_branch_effective_input"/></use></grid><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" disabled="{regBranchSuggestionUnavailable}" on-press="reg_use_branch_suggestion">Use suggestion</button><button height="44" variant="primary" disabled="{regCreateBranchDisabled}" on-press="reg_create_branch">Create pending branch</button></grid><use template="at" visible="{regBranchActionVisible}"/></column><separator/></if><if test="{regRegistrationEvidenceAuthoringVisible}"><column gap="14"><column gap="4"><grid columns="{profileReadColumns}" gap="8"><text><span weight="bold">{regRegistrationUnitReviewTitle}</span></text><row><badge variant="outline">{regRegistrationUnitReviewBadge}</badge></row></grid><text wrap="true" foreground="text_muted">{regEvidenceHelp}</text></column><use template="ar" label="Taxpayer TIN shown on reviewed evidence"><input height="44" text="{regConfirmTinInputValue}" placeholder="9 digits" label="Taxpayer TIN shown on reviewed evidence" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_tin_input"/></use><if test="{regSelectedRegistrationUnitReviewable}"><grid columns="{profileReadColumns}" gap="12"><use template="ar" label="Exact BIR Branch Code"><input height="44" text="{regConfirmCodeInputValue}" placeholder="e.g. 00000" label="Exact BIR Branch Code" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_code_input"/></use><use template="ar" label="RDO code (optional)"><input height="44" text="{regConfirmRdoInputValue}" label="RDO code (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_rdo_input"/></use><use template="ar" label="Registered address (required)"><input height="44" text="{regAddressValue}" placeholder="Address shown on reviewed evidence" label="Registered address (required)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_address_input"/></use><use template="ar" label="ZIP code (optional)"><input height="44" text="{regZipValue}" placeholder="4 digits" label="ZIP code (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_zip_input"/></use><use template="ar" label="Phone / contact number (optional)"><input height="44" text="{regContactValue}" placeholder="+63 900 000 0000" label="Phone / contact number (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_contact_input"/></use><use template="ar" label="Email address (optional)"><input height="44" text="{regEmailValue}" placeholder="name@example.com" label="Email address (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_email_input"/></use></grid></if><grid columns="{profileReadColumns}" gap="12"><use template="ar" label="Reviewed evidence effective from"><input height="44" text="{regConfirmEffectiveInputValue}" placeholder="YYYY-MM-DD" label="Reviewed evidence effective from" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_effective_input"/></use><use template="ar" label="Evidence capture date (required)"><input height="44" text="{regEvidenceCapturedInputValue}" placeholder="YYYY-MM-DD" label="Evidence capture date (required)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_evidence_captured_input"/></use></grid><if test="{regVatRegistrationChoiceVisible}"><toggle checked="{regVatRegistrationConfirmed}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_toggle_vat_registration">Reviewed evidence confirms active VAT registration</toggle></if><column gap="6"><text>Evidence source</text><text wrap="true" size="sm" foreground="text_muted">Choose the single reviewed BIR source used for this confirmation.</text><toggle-group gap="2" label="Evidence source choices"><toggle-button height="44" variant="outline" label="Certificate of Registration (COR)" selected="{regEvidenceSourceCorSelected}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_evidence_source_cor">COR</toggle-button><toggle-button height="44" variant="outline" label="Electronic Certificate of Registration (eCOR)" selected="{regEvidenceSourceEcorSelected}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_evidence_source_ecor">eCOR</toggle-button><toggle-button height="44" variant="outline" label="Other BIR registration record" selected="{regEvidenceSourceBirRecordSelected}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_evidence_source_bir_record">Other BIR record</toggle-button></toggle-group></column><column gap="6"><text>Reviewed evidence file</text><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" label="Choose reviewed registration evidence file" disabled="{regCanonicalMutationsDisabled}" on-press="reg_choose_evidence_file">Choose evidence file</button><text wrap="true">{regEvidenceFileLabel}</text></grid><if test="{regEvidenceFileProblemVisible}"><text wrap="true" foreground="warning">{regEvidenceFileHelp}</text></if><else><text wrap="true" foreground="text_muted">{regEvidenceFileHelp}</text></else></column><text wrap="true" foreground="text_muted">{regDateHelp}</text><if test="{regEvidenceFormProblemVisible}"><alert text="Check reviewed evidence details"><text wrap="true">{regEvidenceFormHelp}</text></alert></if><row><button height="44" variant="primary" label="{regConfirmActionLabel}" disabled="{regConfirmDisabled or regCanonicalMutationsDisabled}" on-press="reg_confirm_selected_unit">{regConfirmActionLabel}</button></row></column><separator/></if><use template="at" visible="{regConfirmationActionVisible}"/><column gap="12"><grid columns="{profileReadColumns}" gap="8"><column grow="1" gap="3"><text><span weight="bold">2550Q filing-scope check</span></text><text wrap="true" foreground="text_muted">{regPlanningPeriodLabel}</text></column><if test="{regPolicyCatalogMissing}"><row><badge variant="destructive">Policy Review Required</badge></row></if><else><row><badge variant="outline">Reviewed fixture policy</badge></row></else></grid><text wrap="true">{regPlanningStatusLabel}</text><grid columns="{profileReadColumns}" gap="12"><use template="as" label="Workspace focus (view only)" value="{regSelectedRegistrationUnitLabel}"/><use template="as" label="Resolved Filing Unit branch code" value="{regResolvedFilingCodeLabel}"/><use template="as" label="Resolved Filing Unit RDO" value="{regResolvedFilingRdoLabel}"/><use template="as" label="Projected filer identity" value="{regProjectedFilerTinLabel}"/><use template="as" label="Resolved form revision" value="{regResolvedFormRevisionLabel}"/><use template="as" label="Policy revision" value="{regPolicyCatalogLabel}"/></grid><column gap="4"><text size="sm" foreground="text_muted">Return Coverage</text><if test="{regCoverageVisible}"><for each="regCoverageRows" key="id" as="coverage"><text wrap="true">{coverage.accessibleLabel}</text></for></if><else><text>Not resolved</text></else></column><column gap="4"><text size="sm" foreground="text_muted">Policy evidence</text><if test="{regPolicyEvidenceVisible}"><for each="regPolicyEvidenceRows" key="id" as="evidence"><column gap="3"><text><span weight="bold">{evidence.displayName}</span></text><text wrap="true">{evidence.reviewBasis}</text><text size="sm" wrap="true" foreground="text_muted">Evidence ID: {evidence.evidenceId}</text></column></for></if><else><text wrap="true">{regPolicyEvidenceLabel}</text></else></column><use template="as" label="Preview scope validation" value="{regProvenanceLabel}"/><use template="as" label="Editor and filing capability" value="{regFileabilityLabel}"/><if test="{regRepairActionsVisible}"><column gap="6"><text><span weight="bold">Why review is required</span></text><for each="regReviewReasonRows" key="id" as="reason"><text wrap="true" foreground="warning">• {reason.label}</text></for><text wrap="true" foreground="text_muted">{regRepairHelp}</text></column></if><text wrap="true" foreground="text_muted">{regReadinessHelp}</text><row><button height="44" variant="primary" global-key="{registrationPreviewOpenerIdentity}" autofocus="{regResolved2550QPreviewOpenerAutofocus}" disabled="{regResolved2550QPreviewDisabled}" on-press="reg_open_resolved_2550q_preview">Open resolved 2550Q preview</button></row></column></column></else><if test="{regLegacyReviewVisible}"><card padding="0"><column padding="16" gap="8"><grid columns="{profileReadColumns}" gap="8"><row><badge variant="outline">Legacy Taxpayer Profile context · separate</badge></row><row><badge variant="destructive">Review Required</badge></row></grid><text><span weight="bold">{profileRegistrationLegacyWorkspaceLabel}</span></text><text label="{profileRegistrationMaskedTinRootLabel}"><span mono="true">{profileRegistrationMaskedTinRoot}</span></text><text wrap="true" foreground="text_