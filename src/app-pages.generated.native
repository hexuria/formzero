</span></text><text wrap="true" foreground="text_muted">{profileFormsConflictHelp}</text><row gap="8"><button height="44" variant="primary" on-press="profile_setup_conflict_review">{profileSetupConflictReviewLabel}</button><button height="44" variant="outline" on-press="profile_setup_conflict_discard">Discard my draft</button></row></column></card></if><if test="{profileSetupDraftBannerVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">{profileSetupDraftTitle}</span></text><if test="{profileSetupDraftChoiceVisible}"><column gap="8"><text wrap="true" foreground="text_muted">{profileFormsDraftHelp}</text><if test="{profileFormsHeaderStacked}"><column gap="8"><button height="44" variant="outline" on-press="profile_setup_draft_empty">Start empty</button><if test="{profileSetupSeedAvailable}"><button height="44" variant="primary" on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button></if></column></if><else><row gap="8"><button height="44" variant="outline" on-press="profile_setup_draft_empty">Start empty</button><if test="{profileSetupSeedAvailable}"><button height="44" variant="primary" on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button></if></row></else></column></if><if test="{profileSetupSeededVisible}"><column gap="8"><text><span weight="bold">{profileSetupSourceLabel}</span></text><text wrap="true" foreground="text_muted">{profileSetupSourceSummary}</text><use template="az"/></column></if><text wrap="true" foreground="text_muted">{profileSetupInheritanceNote}</text><text wrap="true" foreground="text_muted">{profileFormsInheritanceHelp}</text></column></card></if><if test="{profileSetupBrowseVisible}"><column gap="16"><row main="end"><button height="44" variant="outline" icon="settings" on-press="profile_forms_manage">Manage Forms</button></row><use template="aq"/></column></if><if test="{profileSetupManagerVisible}"><if test="{profileSetupScopeVisible}"><column gap="10"><text><span weight="bold">When does this apply?</span></text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button><button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button></column></if><else><row gap="8"><button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button><button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button></row></else><if test="{profileSetupScopeDateVisible}"><use template="ar" label="Change takes effect"><input height="44" text="{profileSetupChangeDateValue}" placeholder="YYYY-MM-DD" label="Change takes effect" on-input="profile_setup_change_date_input"/></use><text wrap="true" foreground="text_muted">{profileFormsChangeHelp}</text></if></column></if><if test="{profileSetupZeroFormsHelperVisible}"><text wrap="true" foreground="text_muted">{profileSetupZeroFormsHelperText}</text></if><if test="{profileSetupDeactivationWarningVisible}"><card padding="0"><column padding="12" gap="6"><text><span weight="bold">Confirm deactivation on Save</span></text><text wrap="true" foreground="text_muted">{profileSetupDeactivationWarningText}</text></column></card></if><if test="{profileFormsHeaderStacked}"><column gap="10"><button height="44" variant="primary" icon="save" disabled="{profileSetupPrimaryDisabled}" on-press="profile_setup_save">{profileSetupPrimaryLabel}</button><button height="44" variant="outline" disabled="{profileFormsCancelDisabled}" on-press="profile_forms_cancel">Cancel</button></column></if><else><row main="end" gap="12"><button height="44" variant="outline" disabled="{profileFormsCancelDisabled}" on-press="profile_forms_cancel">Cancel</button><button height="44" variant="primary" icon="save" disabled="{profileSetupPrimaryDisabled}" on-press="profile_setup_save">{profileSetupPrimaryLabel}</button></row></else><if test="{profileSetupChangesVisible}"><column gap="8"><row><button height="44" variant="ghost" icon="chevron-right" on-press="profile_setup_toggle_changes_disclosure">{profileSetupChangesDisclosureLabel}</button></row><if test="{profileSetupChangesExpandedVisible}"><column gap="8"><for each="profileSetupChangeRows" key="id" as="change"><card padding="0"><row padding="12" gap="12" cross="center"><column grow="1" gap="2"><text><span weight="bold">{change.rangeLabel}</span></text><text foreground="text_muted">{change.formsLabel}</text></column><if test="{change.todayBadgeVisible}"><badge variant="secondary">Covers today</badge></if></row></card></for><text wrap="true" foreground="text_muted">{profileFormsReferenceHelp}</text></column></if></column></if><use template="aq"/></if><if test="{profileSetupYearsDisclosureVisible}"><column gap="8"><row><button height="44" variant="ghost" icon="chevron-right" on-press="profile_setup_toggle_years_disclosure">{profileSetupYearsDisclosureLabel}</button></row><if test="{profileSetupYearsExpandedVisible}"><column gap="8"><for each="profileFormSetRows" key="id" as="set"><card padding="0"><row padding="12" gap="12" cross="center"><text width="60" text-alignment="center"><span weight="bold">{set.yearLabel}</span></text><column width="1" height="36" background="border"></column><column grow="1" gap="2"><text foreground="text_muted">{set.formsLabel}</text></column><badge variant="secondary">{set.stateLabel}</badge><button height="44" variant="outline" on-press="profile_setup_select_year:{set.tax_year}">Open</button></row></card></for></column></if></column></if></else></column></if><if test="{profileEmailActive}"><column gap="12"><text><span weight="bold">Email monitoring credentials</span></text><text wrap="true" foreground="text_muted">{profileEmailSecretHelp}</text><button height="44" variant="outline" icon="send" disabled="true">Configure secure mailbox connection</button></column></if><if test="{profileEditorActionsVisible}"><grid columns="{profileReadColumns}" gap="10"><button height="44" variant="outline" disabled="{profileCancelDisabled}" on-press="cancel_profile_edit">Cancel</button><button height="44" variant="primary" icon="save" disabled="{profileSaveDisabled}" on-press="save_profile">{profileSaveLabel}</button></grid></if></column></template><template name="be"><scroll grow="1" global-key="page-profile-setup" label="Taxpayer profile setup content" value="{profileSetupScrollOffset}" on-scroll="profile_setup_scrolled"><if test="{phoneLayout}"><column padding="16"><use template="bd"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="bd"/></column></if><else><column padding="32"><use template="bd"/></column></else></else></scroll></template><template name="bf" args="label value"><column gap="4"><text size="sm" foreground="text_muted">{label}</text><text wrap="true">{value}</text></column></template><template name="bg"><column><if test="{constrainedLayout}"><column gap="10"><if test="{taxFormProfileEditTaxProfileVisible}"><button height="44" variant="outline" on-press="tax_form_profile_edit_tax_profile">Edit Tax Profile</button></if><if test="{taxFormProfileEditing}"><column gap="10"><button height="44" variant="outline" disabled="{taxFormProfileCancelDisabled}" on-press="cancel_tax_form_profile">Cancel</button><button height="44" variant="primary" disabled="{taxFormProfileSaveDisabled}" on-press="save_tax_form_profile">Save Tax Form Profile</button></column></if><else><if test="{taxFormProfileEditVisible}"><button height="44" variant="primary" on-press="edit_tax_form_profile">Edit Tax Form Profile</button></if></else></column></if><else><row gap="10" main="end"><if test="{taxFormProfileEditTaxProfileVisible}"><button height="44" variant="outline" on-press="tax_form_profile_edit_tax_profile">Edit Tax Profile</button></if><if test="{taxFormProfileEditing}"><row gap="10"><button height="44" variant="outline" disabled="{taxFormProfileCancelDisabled}" on-press="cancel_tax_form_profile">Cancel</button><button height="44" variant="primary" disabled="{taxFormProfileSaveDisabled}" on-press="save_tax_form_profile">Save Tax Form Profile</button></row></if><else><if test="{taxFormProfileEditVisible}"><button height="44" variant="primary" on-press="edit_tax_form_profile">Edit Tax Form Profile</button></if></else></row></else></column></template><template name="bh"><column><if test="{constrainedLayout}"><column gap="10"><if test="{taxpayerYearEditing}"><column gap="10"><button height="44" variant="outline" disabled="{taxpayerYearCancelDisabled}" on-press="taxpayer_year_cancel">Cancel</button><button height="44" variant="primary" disabled="{taxpayerYearSaveDisabled}" on-press="taxpayer_year_save">Save Yearly Settings</button></column></if><else><if test="{taxpayerYearEditVisible}"><button height="44" variant="primary" on-press="taxpayer_year_edit">Edit Yearly Settings</button></if></else></column></if><else><row gap="10" main="end"><if test="{taxpayerYearEditing}"><row gap="10"><button height="44" variant="outline" disabled="{taxpayerYearCancelDisabled}" on-press="taxpayer_year_cancel">Cancel</button><button height="44" variant="primary" disabled="{taxpayerYearSaveDisabled}" on-press="taxpayer_year_save">Save Yearly Settings</button></row></if><else><if test="{taxpayerYearEditVisible}"><button height="44" variant="primary" on-press="taxpayer_year_edit">Edit Yearly Settings</button></if></else></row></else></column></template><template name="bi"><column padding="20" gap="14"><text><span weight="bold" scale="1.25">Discard unsaved changes?</span></text><text wrap="true" foreground="text_muted">Leaving restores the last saved Tax Form Profile and yearly settings.</text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" on-press="tax_form_profile_keep_editing">Keep editing</button><button height="44" variant="destructive" on-press="tax_form_profile_discard_navigation">Discard</button></column></if><else><row gap="8" main="end"><button height="44" variant="outline" on-press="tax_form_profile_keep_editing">Keep editing</button><button height="44" variant="destructive" on-press="tax_form_profile_discard_navigation">Discard</button></row></else></column></template><template name="bj"><stack grow="1"><scroll grow="1" label="Tax Form Profile"><column padding="24" gap="16"><row gap="12" cross="start"><button width="44" height="44" size="icon" variant="ghost" icon="chevron-left" label="{taxFormProfileBackLabel}" on-press="close_tax_form_profile"></button><column grow="1" gap="5"><row gap="8" cross="center"><badge variant="secondary">{taxFormProfileCode}</badge><badge variant="{taxFormProfileStatusTone}">{taxFormProfileStatusLabel}</badge></row><text><span weight="bold" scale="1.5">{taxFormProfileCode} Tax Form Profile — {taxFormProfileYear}</span></text><text wrap="true">{taxFormProfileTitle}</text><text foreground="text_muted">Form revision {taxFormProfileRevision}</text><text wrap="true" foreground="text_muted">{taxFormProfileActivationLabel}</text></column></row><if test="{taxFormProfileHistoryTabVisible}"><tabs gap="4" label="Tax Form Profile sections"><button height="44" variant="ghost" selected="{taxFormProfileDetailsSelected}" on-press="tax_form_profile_show_details">Details</button><button height="44" variant="ghost" selected="{taxFormProfileHistorySelected}" on-press="tax_form_profile_show_history">History</button></tabs></if><if test="{taxFormProfileDetailsSelected}"><if test="{taxFormProfileMissingInheritedVisible}"><card padding="0" background="surface_subtle"><column padding="14" gap="10"><text><span weight="bold">{taxFormProfileMissingInheritedTitle}</span></text><text wrap="true" foreground="text_muted">{taxFormProfileMissingInheritedSummary}</text><for each="taxFormProfileMissingInheritedRows" key="id" as="fact"><row gap="8" cross="center"><text grow="1" wrap="true">{fact.label}</text><badge variant="destructive">Required</badge></row></for><button height="44" variant="outline" on-press="tax_form_profile_edit_tax_profile">Edit Tax Profile</button></column></card></if><if test="{taxFormProfileSegmentNavigationVisible}"><row gap="8"><button grow="1" height="44" variant="outline" disabled="{taxFormProfilePreviousSegmentDisabled}" on-press="tax_form_profile_previous_segment">Previous interval</button><button grow="1" height="44" variant="outline" disabled="{taxFormProfileNextSegmentDisabled}" on-press="tax_form_profile_next_segment">Next interval</button></row></if><if test="{taxFormProfileFilingContextVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">Filing context</span></text><grid columns="{profileReadColumns}" gap="12"><use template="bf" label="Quarter" value="{taxFormProfileQuarterLabel}"/><use template="bf" label="Taxable period" value="{taxFormProfileTaxablePeriodLabel}"/></grid></column></card></if><card padding="0"><column padding="16" gap="12"><column gap="4"><text><span weight="bold">Inherited Tax Profile details</span></text></column><grid columns="{profileReadColumns}" gap="12"><for each="taxFormProfileInheritedRows" key="id" as="fact"><use template="bf" label="{fact.label}" value="{fact.value}"/></for></grid></column></card><if test="{taxFormProfileConflictVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">A newer revision was saved</span></text><text wrap="true" foreground="text_muted">Your draft is preserved. Review the latest stream sequence, or reload this interval and discard the draft.</text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="primary" disabled="{taxFormProfileConflictKeepDraftDisabled}" on-press="tax_form_profile_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxFormProfileConflictReloadDisabled}" on-press="tax_form_profile_reload_after_conflict">Reload this interval</button></column></if><else><row gap="8"><button height="44" variant="primary" disabled="{taxFormProfileConflictKeepDraftDisabled}" on-press="tax_form_profile_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxFormProfileConflictReloadDisabled}" on-press="tax_form_profile_reload_after_conflict">Reload this interval</button></row></else></column></card></if><if test="{taxpayerYearSettingsVisible}"><card padding="0"><column padding="16" gap="12"><column gap="4"><row gap="8" cross="center"><text grow="1"><span weight="bold">Yearly income-tax settings</span></text><badge variant="{taxpayerYearStatusTone}">{taxpayerYearStatus}</badge></row><text wrap="true" foreground="text_muted">These settings apply to 1701Q and 1701 for this tax year. They are not copied into a Tax Form Profile.</text></column><if test="{taxpayerYearConflictVisible}"><card padding="0"><column padding="12" gap="10"><text><span weight="bold">A newer yearly revision was saved</span></text><text wrap="true" foreground="text_muted">Your draft is preserved. Keep it against the latest sequence, or reload the saved yearly settings.</text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="primary" disabled="{taxpayerYearConflictKeepDraftDisabled}" on-press="taxpayer_year_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxpayerYearConflictReloadDisabled}" on-press="taxpayer_year_reload_after_conflict">Reload yearly settings</button></column></if><else><row gap="8"><button height="44" variant="primary" disabled="{taxpayerYearConflictKeepDraftDisabled}" on-press="taxpayer_year_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxpayerYearConflictReloadDisabled}" on-press="taxpayer_year_reload_after_conflict">Reload yearly settings</button></row></else></column></card></if><if test="{taxpayerYearEditing}"><column gap="10"><column gap="6"><text><span weight="bold">Income-tax rate</span></text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" selected="{taxpayerYearGraduatedSelected}" on-press="taxpayer_year_rate_graduated">Graduated income-tax rates</button><button height="44" variant="outline" selected="{taxpayerYearEightPercentSelected}" on-press="taxpayer_year_rate_eight_percent">8% income-tax rate</button></column></if><else><row gap="8"><button grow="1" height="44" variant="outline" selected="{taxpayerYearGraduatedSelected}" on-press="taxpayer_year_rate_graduated">Graduated income-tax rates</button><button grow="1" height="44" variant="outline" selected="{taxpayerYearEightPercentSelected}" on-press="taxpayer_year_rate_eight_percent">8% income-tax rate</button></row></else></column><if test="{taxpayerYearDeductionVisible}"><column gap="6"><text><span weight="bold">Deduction method</span></text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" selected="{taxpayerYearItemizedSelected}" on-press="taxpayer_year_deduction_itemized">Itemized deduction</button><button height="44" variant="outline" selected="{taxpayerYearOsdSelected}" on-press="taxpayer_year_deduction_osd">Optional standard deduction</button></column></if><else><row gap="8"><button grow="1" height="44" variant="outline" selected="{taxpayerYearItemizedSelected}" on-press="taxpayer_year_deduction_itemized">Itemized deduction</button><button grow="1" height="44" variant="outline" selected="{taxpayerYearOsdSelected}" on-press="taxpayer_year_deduction_osd">Optional standard deduction</button></row></else></column></if></column></if><else><grid columns="{profileReadColumns}" gap="12"><use template="bf" label="Income-tax rate" value="{taxpayerYearRateLabel}"/><if test="{taxpayerYearDeductionVisible}"><use template="bf" label="Deduction method" value="{taxpayerYearDeductionLabel}"/></if></grid></else><if test="{taxpayerYearReviewVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="12" gap="10"><text wrap="true">Copied or unconfirmed yearly settings must be reviewed before Save.</text><button height="44" variant="outline" on-press="taxpayer_year_acknowledge_review">Mark reviewed</button></column></if><else><row padding="12" gap="10" cross="center"><text grow="1" wrap="true">Copied or unconfirmed yearly settings must be reviewed before Save.</text><button height="44" variant="outline" on-press="taxpayer_year_acknowledge_review">Mark reviewed</button></row></else></card></if><if test="{taxpayerYearCopyPriorYearVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="12" gap="10"><text wrap="true" foreground="text_muted">Reuse is never automatic. The prior-year settings open as an unsaved draft and must be reviewed before Save.</text><button height="44" variant="outline" on-press="taxpayer_year_copy_prior_year">{taxpayerYearCopyPriorYearLabel}</button></column></if><else><row padding="12" gap="10" cross="center"><text grow="1" wrap="true" foreground="text_muted">Reuse is never automatic. The prior-year settings open as an unsaved draft and must be reviewed before Save.</text><button height="44" variant="outline" on-press="taxpayer_year_copy_prior_year">{taxpayerYearCopyPriorYearLabel}</button></row></else></card></if><use template="bh"/></column></card></if><if test="{taxFormProfileInheritedOnlyVisible}"><card padding="0"><column padding="16" gap="4"><text><span weight="bold">No additional yearly details required</span></text><text wrap="true" foreground="text_muted">This form uses the inherited Tax Profile details shown above.</text></column></card></if><if test="{taxFormProfileSetupVisible}"><column gap="10"><text><span weight="bold">Form-specific details</span></text><for each="taxFormProfileFieldRows" key="id" as="field"><card padding="0"><column padding="14" gap="8"><row gap="8" cross="center"><text grow="1"><span weight="bold">{field.label}</span></text><badge variant="secondary">{field.requiredLabel}</badge></row><text wrap="true">{field.value}</text><text wrap="true" foreground="text_muted">{field.helper}</text><if test="{field.editable}"><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" on-press="tax_form_profile_toggle_picker:{field.id}">{field.pickerLabel}</button><if test="{field.hasValue}"><button height="44" variant="ghost" on-press="tax_form_profile_clear_value:{field.id}">Clear</button></if></column></if><else><row gap="8"><button grow="1" height="44" variant="outline" on-press="tax_form_profile_toggle_picker:{field.id}">{field.pickerLabel}</button><if test="{field.hasValue}"><button height="44" variant="ghost" on-press="tax_form_profile_clear_value:{field.id}">Clear</button></if></row></else><if test="{field.pickerOpen}"><card padding="0"><column padding="8" gap="4"><if test="{taxFormProfileChoicesEmpty}"><text wrap="true" foreground="text_muted">No choices are available.</text></if><else><for each="taxFormProfileChoiceRows" key="id" as="choice"><button height="44" variant="ghost" selected="{choice.selected}" on-press="tax_form_profile_select_choice:{choice.id}">{choice.label}</button></for></else></column></card></if></if></column></card></for></column></if><if test="{taxFormProfileReviewVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="14" gap="10"><text wrap="true">{taxFormProfileReviewText}</text><button height="44" variant="outline" on-press="tax_form_profile_acknowledge_review">Mark reviewed</button></column></if><else><row padding="14" gap="10" cross="center"><text grow="1" wrap="true">{taxFormProfileReviewText}</text><button height="44" variant="outline" on-press="tax_form_profile_acknowledge_review">Mark reviewed</button></row></else></card></if><if test="{taxFormProfileCopyPriorYearVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="14" gap="10"><text wrap="true" foreground="text_muted">Reuse is never automatic. The prior setup opens as an unsaved draft and must be reviewed before Save.</text><button height="44" variant="outline" on-press="tax_form_profile_copy_prior_year">{taxFormProfileCopyPriorYearLabel}</button></column></if><else><row padding="14" gap="10" cross="center"><text grow="1" wrap="true" foreground="text_muted">Reuse is never automatic. The prior setup opens as an unsaved draft and must be reviewed before Save.</text><button height="44" variant="outline" on-press="tax_form_profile_copy_prior_year">{taxFormProfileCopyPriorYearLabel}</button></row></else></card></if><if test="{taxFormProfileReactivationReuseVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="14" gap="10"><text wrap="true" foreground="text_muted">Another active interval has compatible setup. Review it before saving it for this interval.</text><button height="44" variant="outline" on-press="tax_form_profile_reuse_after_reactivation">{taxFormProfileReactivationReuseLabel}</button></column></if><else><row padding="14" gap="10" cross="center"><text grow="1" wrap="true" foreground="text_muted">Another active interval has compatible setup. Review it before saving it for this interval.</text><button height="44" variant="outline" on-press="tax_form_profile_reuse_after_reactivation">{taxFormProfileReactivationReuseLabel}</button></row></else></card></if><use template="bg"/></if><if test="{taxFormProfileHistorySelected}"><card padding="0"><column padding="16" gap="10"><column gap="4"><text><span weight="bold">Tax Form Profile history</span></text><text wrap="true" foreground="text_muted">Saved annual revisions remain visible after deactivation and are never overwritten.</text></column><for each="taxFormProfileHistoryRows" key="id" as="revision"><card padding="0"><column padding="12" gap="4"><row gap="8" cross="center"><text grow="1"><span weight="bold">Revision {revision.sequence}</span></text><if test="{revision.currentVisible}"><badge variant="secondary">Current view</badge></if></row><text foreground="text_muted">{revision.effectiveLabel}</text><text wrap="true" foreground="text_muted">{revision.sourceLabel}</text></column></card></for><if test="{taxFormProfileHistoryTruncatedVisible}"><text wrap="true" foreground="text_muted">Showing the 24 most recent revisions.</text></if></column></card></if></column></scroll><if test="{taxFormProfileDiscardPromptOpen}"><column grow="1" padding="16" main="center" cross="center"><if test="{phoneLayout}"><dialog width="288" on-dismiss="tax_form_profile_keep_editing"><use template="bi"/></dialog></if><else><if test="{constrainedLayout}"><dialog width="400" on-dismiss="tax_form_profile_keep_editing"><use template="bi"/></dialog></if><else><dialog width="480" on-dismiss="tax_form_profile_keep_editing"><use template="bi"/></dialog></else></else></column></if></stack></template><template name="bk"><stack width="44" height="44"><button width="44" height="44" size="icon" variant="ghost" radius="xl" icon="git-branch" label="Add new branch" on-press="add_branch_profile"></button><tooltip anchor="below">Add new branch</tooltip></stack></template><template name="bl"><scroll grow="1" global-key="page-taxpayer-dashboard" label="Taxpayer dashboard content"><column padding="{taxpayerDashboardPagePadding}" gap="24"><row gap="12" cross="center"><avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar><column grow="1" gap="5"><if test="{constrainedLayout}"><text size="heading" wrap="true">{selectedTaxpayerName}</text><text wrap="true" foreground="text_muted">TIN: {selectedTaxpayerTin}</text><text wrap="true" foreground="text_muted">Type: {selectedTaxpayerKind} - Tax Year {currentCalendarYear} - {selectedTaxpayerTaxType}</text></if><else><text size="heading">{selectedTaxpayerName}</text><text wrap="true" foreground="text_muted">{selectedTaxpayerSummary}</text></else></column><if test="{profileCanAddBranch}"><use template="bk"/></if></row><tabs gap="4" label="Dashboard view"><button height="44" variant="ghost" icon="app:calendar" selected="{dashboardCalendarActive}" on-press="show_dashboard_calendar">Calendar</button><button height="44" variant="ghost" icon="folder-open" selected="{dashboardFormsActive}" on-press="show_dashboard_forms">{dashboardFormsTabLabel}</button><button height="44" variant="ghost" icon="settings" selected="{dashboardProfileSettingsActive}" on-press="show_dashboard_profile_settings">{dashboardProfileTabLabel}</button></tabs><if test="{dashboardCalendarActive}"><use template="al"/></if><if test="{dashboardFormsActive}"><use template="aq"/></if><if test="{dashboardProfileSettingsActive}"><use template="bd"/></if></column></scroll></template><template name="bm"><column gap="24"><column gap="6"><text size="heading">Import Data</text><text wrap="true" foreground="text_muted">Import a profile or database backup from a .zip file.</text></column><card><column padding="24" gap="20"><if test="{constrainedLayout}"><column gap="14"><row gap="14" cross="center"><icon name="download" foreground="accent" width="36" height="36"/><column grow="1" gap="5"><text><span weight="bold">Smart Import</span></text><text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text></column></row><row cross="center"><badge variant="secondary">Recommended</badge></row></column></if><else><row gap="16" cross="center"><icon name="download" foreground="accent" width="36" height="36"/><column grow="1" gap="5"><text><span weight="bold">Smart Import</span></text><text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text></column><badge variant="secondary">Recommended</badge></row></else><separator/><text wrap="true">Smart Import inspects the selected .zip file and determines whether it contains a taxpayer profile or a complete database backup.</text><card><column padding="24" gap="14" cross="center"><icon name="archive" foreground="text_muted" width="42" height="42"/><text text-alignment="center"><span weight="bold">Choose an eBIRForms archive</span></text><text foreground="text_muted">Supported file type: .zip</text><button variant="primary" icon="folder-open" disabled="true">Smart Import</button></column></card><row gap="12" cross="start"><icon name="info" foreground="info" width="20" height="20"/><column grow="1" gap="5"><text><span weight="bold">Before importing</span></text><text wrap="true" foreground="text_muted">Keep a current backup of your existing profiles. Imported data should come from a trusted eBIRForms export.</text></column></row></column></card><card><column padding="20" gap="12"><text><span weight="bold">What Smart Import can recognize</span></text><row gap="12" cross="start"><icon name="check-circle" foreground="success" width="18" height="18"/><text wrap="true" grow="1">Single taxpayer profile exports</text></row><row gap="12" cross="start"><icon name="check-circle" foreground="success" width="18" height="18"/><text wrap="true" grow="1">Full database backup archives</text></row><row gap="12" cross="start"><icon name="check-circle" foreground="success" width="18" height="18"/><text wrap="true" grow="1">Compatible static form and calendar data</text></row></column></card></column></template><template name="bn"><scroll grow="1" global-key="page-import-data" label="Import data content"><if test="{phoneLayout}"><column padding="16"><use template="bm"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="bm"/></column></if><else><column padding="32"><use template="bm"/></column></else></else></scroll></template><template name="bo" args="title description source cadence next_run"><card><column padding="20" gap="14"><if test="{constrainedLayout}"><column gap="12"><row gap="12" cross="start"><icon name="clock" foreground="warning" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{description}</text></column></row><row cross="center"><badge variant="secondary">Queued</badge></row></column></if><else><row gap="12" cross="center"><icon name="clock" foreground="warning" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{description}</text></column><badge variant="secondary">Queued</badge></row></else><separator/><if test="{constrainedLayout}"><column gap="14"><column gap="5"><text foreground="text_muted">Source</text><text>{source}</text></column><column gap="5"><text foreground="text_muted">Schedule</text><text>{cadence}</text></column><column gap="5"><text foreground="text_muted">Next run</text><text>{next_run}</text></column></column></if><else><row gap="24" cross="start"><column grow="1" gap="5"><text foreground="text_muted">Source</text><text>{source}</text></column><column grow="1" gap="5"><text foreground="text_muted">Schedule</text><text>{cadence}</text></column><column grow="1" gap="5"><text foreground="text_muted">Next run</text><text>{next_run}</text></column></row></else><text wrap="true" foreground="text_muted">Status: Queued - Retries: 0</text><if test="{constrainedLayout}"><column gap="8"><button size="sm" variant="ghost" icon="eye" on-press="show_aux_background_task_debug_log">View Job</button><button size="sm" variant="outline" icon="play" disabled="true">Run Now</button><button size="sm" variant="outline" icon="archive" disabled="true">Archive</button><button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button></column></if><else><row main="end" gap="8"><button size="sm" variant="ghost" icon="eye" on-press="show_aux_background_task_debug_log">View Job</button><button size="sm" variant="outline" icon="play" disabled="true">Run Now</button><button size="sm" variant="outline" icon="archive" disabled="true">Archive</button><button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button></row></else></column></card></template><template name="bp"><column gap="24"><card><column padding="16" gap="12"><if test="{constrainedLayout}"><column gap="10"><select text="Queued" label="Job status"/><search-field placeholder="Search jobs" label="Search background jobs"/><select text="Archive Days: 30" label="Archive retention"/><button variant="outline" icon="archive" disabled="true">Purge Archives</button></column></if><else><row gap="12" cross="center"><select text="Queued" label="Job status"/><search-field grow="1" placeholder="Search jobs" label="Search background jobs"/><select text="Archive Days: 30" label="Archive retention"/><button variant="outline" icon="archive" disabled="true">Purge Archives</button></row></else><row gap="8" cross="center"><badge variant="secondary">1 queued</badge><text wrap="true" foreground="text_muted">Last checked moments ago</text></row></column></card><use template="bo" title="Waiting for 2551Q confirmation email" description="Checks demo@example.com for the filing confirmation message." source="System" cadence="Every minute" next_run="Past due"/></column></template><template name="bq"><card><column padding="20" gap="14"><row gap="10" cross="center"><icon name="terminal" foreground="accent" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">Recent task logs</span></text><text wrap="true" foreground="text_muted">Static diagnostic entries from the desktop application.</text></column></row><separator/><button variant="ghost" icon="eye" on-press="show_aux_background_task_debug_log">Open Poll eFPS Email Confirmations Log</button><text wrap="true" foreground="text_muted">No other task logs are available in this static build.</text></column></card></template><template name="br"><column gap="24"><column gap="6"><text size="heading">Background Tasks</text><text wrap="true" foreground="text_muted">Monitor scheduled jobs, email checks, and maintenance activity.</text></column><if test="{constrainedLayout}"><column gap="4" label="Background task sections"><button variant="ghost" selected="{backgroundJobsActive}" on-press="show_background_jobs">Jobs</button><button variant="ghost" selected="{backgroundLogsActive}" on-press="show_background_logs">Logs</button></column></if><else><tabs gap="4" label="Background task sections"><button variant="ghost" selected="{backgroundJobsActive}" on-press="show_background_jobs">Jobs</button><button variant="ghost" selected="{backgroundLogsActive}" on-press="show_background_logs">Logs</button></tabs></else><if test="{backgroundJobsActive}"><use template="bp"/></if><if test="{backgroundLogsActive}"><use template="bq"/></if><card><column padding="18" gap="10"><row gap="10" cross="center"><icon name="info" foreground="info" width="20" height="20"/><text><span weight="bold">Prototype task monitor</span></text></row><text wrap="true" foreground="text_muted">Job controls are presented to match the desktop application. This static milestone does not execute or modify background work.</text></column></card></column></template><template name="bs"><scroll grow="1" global-key="page-background-tasks" label="Background tasks content"><if test="{phoneLayout}"><column padding="16"><use template="br"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="br"/></column></if><else><column padding="32"><use template="br"/></column></else></else></scroll></template><template name="bt"><column gap="12"><column gap="4"><text><span weight="bold">Compiled Calendar Rules</span></text><text wrap="true" foreground="text_muted">Shared form-deadline rules derived from the reference eBIRForms subsystem and checked against current BIR guidance. Event-based forms stay separate from dated deadlines.</text></column><for each="calendarRules" key="id" as="rule"><card><column padding="20" gap="10"><row gap="8" cross="center"><badge variant="secondary">{rule.frequency}</badge><text><span weight="bold">{rule.form_name}</span></text></row><text wrap="true" foreground="text_muted">Forms: {rule.form_codes}</text><text wrap="true">{rule.description}</text></column></card></for><card><column padding="20" gap="8"><text><span weight="bold">Source boundary</span></text><text wrap="true" foreground="text_muted">This view is a calendar-year / non-eFPS baseline and includes mutually exclusive or conditional form alternatives. Current BIR issuances, the taxpayer's registered Forms Set, eFPS filer group, fiscal-year facts, and official holiday proclamations remain authoritative.</text></column></card></column></template><template name="bu"><card><column padding="20" gap="14"><text><span weight="bold">{overrideEditorTitle}</span></text><text wrap="true" foreground="text_muted">Source and at least one recognized canonical form are required. Separate multiple values with commas.</text><input text="{overrideTitleValue}" placeholder="Extension title" label="Override title" on-input="calendar_override_title_input"/><input text="{overrideFormsValue}" placeholder="1701Q, 1702Q" label="Affected form codes" on-input="calendar_override_forms_input"/><if test="{constrainedLayout}"><column gap="10"><input text="{overrideOriginalValue}" placeholder="YYYY-MM-DD" label="Original or operative deadline" on-input="calendar_override_original_input"/><input text="{overrideAdjustedValue}" placeholder="YYYY-MM-DD" label="Adjusted deadline" on-input="calendar_override_adjusted_input"/></column></if><else><row gap="10"><input grow="1" text="{overrideOriginalValue}" placeholder="YYYY-MM-DD" label="Original or operative deadline" on-input="calendar_override_original_input"/><input grow="1" text="{overrideAdjustedValue}" placeholder="YYYY-MM-DD" label="Adjusted deadline" on-input="calendar_override_adjusted_input"/></row></else><input text="{overrideSourceValue}" placeholder="RMC / RR / advisory reference" label="Official source reference" on-input="calendar_override_source_input"/><if test="{constrainedLayout}"><column gap="10"><input text="{overrideRegionsValue}" placeholder="Optional RDO codes, e.g. 040; 041" label="Affected RDO codes" on-input="calendar_override_regions_input"/><input text="{overrideTaxpayerTypesValue}" placeholder="Optional, e.g. individual" label="Taxpayer types" on-input="calendar_override_taxpayer_types_input"/></column></if><else><row gap="10"><input grow="1" text="{overrideRegionsValue}" placeholder="Optional RDO codes, e.g. 040; 041" label="Affected RDO codes" on-input="calendar_override_regions_input"/><input grow="1" text="{overrideTaxpayerTypesValue}" placeholder="Optional, e.g. individual" label="Taxpayer types" on-input="calendar_override_taxpayer_types_input"/></row></else><if test="{constrainedLayout}"><column gap="10"><input text="{overrideEffectiveFromValue}" placeholder="Optional YYYY-MM-DD" label="Effective from" on-input="calendar_override_effective_from_input"/><input text="{overrideEffectiveUntilValue}" placeholder="Optional YYYY-MM-DD" label="Effective until" on-input="calendar_override_effective_until_input"/><input text="{overrideExpiresAtValue}" placeholder="Optional YYYY-MM-DD" label="Expires at" on-input="calendar_override_expires_at_input"/></column></if><else><row gap="10"><input grow="1" text="{overrideEffectiveFromValue}" placeholder="Optional YYYY-MM-DD" label="Effective from" on-input="calendar_override_effective_from_input"/><input grow="1" text="{overrideEffectiveUntilValue}" placeholder="Optional YYYY-MM-DD" label="Effective until" on-input="calendar_override_effective_until_input"/><input grow="1" text="{overrideExpiresAtValue}" placeholder="Optional YYYY-MM-DD" label="Expires at" on-input="calendar_override_expires_at_input"/></row></else><row gap="10"><button variant="primary" icon="check" on-press="calendar_save_override">{overrideSaveLabel}</button><button variant="outline" on-press="calendar_cancel_override">Clear</button></row></column></card></template><template name="bv"><card><column padding="20" gap="14"><text><span weight="bold">{nonWorkingDayEditorTitle}</span></text><text wrap="true" foreground="text_muted">Kind must be regular, local, special, or closure. Entries without an RDO scope adjust the global explorer; scoped entries apply only to matching tax-profile dashboards and calendar handoffs.</text><if test="{constrainedLayout}"><column gap="10"><input text="{nonWorkingDateValue}" placeholder="YYYY-MM-DD" label="Date" on-input="calendar_non_working_date_input"/><input text="{nonWorkingKindValue}" placeholder="regular" label="Kind" on-input="calendar_non_working_kind_input"/></column></if><else><row gap="10"><input grow="1" text="{nonWorkingDateValue}" placeholder="YYYY-MM-DD" label="Date" on-input="calendar_non_working_date_input"/><input grow="1" text="{nonWorkingKindValue}" placeholder="regular" label="Kind" on-input="calendar_non_working_kind_input"/></row></else><input text="{nonWorkingNameValue}" placeholder="Official holiday or closure name" label="Name" on-input="calendar_non_working_name_input"/><input text="{nonWorkingSourceValue}" placeholder="Official Gazette / proclamation reference" label="Official source" on-input="calendar_non_working_source_input"/><input text="{nonWorkingRegionsValue}" placeholder="Optional RDO codes, e.g. 040; 041" label="Affected RDO codes" on-input="calendar_non_working_regions_input"/><row gap="10"><button variant="primary" icon="check" on-press="calendar_save_non_working_day">{nonWorkingDaySaveLabel}</button><button variant="outline" on-press="calendar_cancel_non_working_day">Clear</button></row></column></card></template><template name="bw"><column gap="20"><if test="{calendarNoticeVisible}"><row cross="center"><badge variant="{calendarNoticeTone}">{calendarNotice}</badge></row></if><column gap="10"><text><span weight="bold">Deadline Overrides</span></text><text wrap="true" foreground="text_muted">Matching follows the reference resolver: form code plus original or already business-day-adjusted deadline; later matching overrides win. RDO- or taxpayer-scoped overrides apply only to matching tax profiles. Effective-range and expiry metadata are preserved separately in SQLite; like the reference resolver, they do not limit global matching yet.</text></column><if test="{calendarOverridesEmpty}"><card><column padding="20" gap="8" cross="center"><icon name="clock" foreground="text_muted" width="30" height="30"/><text><span weight="bold">No deadline overrides</span></text><text wrap="true" text-alignment="center" foreground="text_muted">Add only sourced BIR extensions or corrections. No sample or fictitious holiday override is seeded.</text></column></card></if><for each="calendarOverrides" key="id" as="override"><card><column padding="18" gap="8"><row gap="10" cross="center"><column grow="1" gap="4"><text><span weight="bold">{override.titleLabel}</span></text><text wrap="true" foreground="text_muted">Forms: {override.formsLabel}</text></column><badge variant="primary">{override.datesLabel}</badge></row><text wrap="true" foreground="text_muted">{override.scopeLabel}</text><text wrap="true" foreground="text_muted">{override.effectiveLabel}</text><row gap="8" cross="center"><if test="{override.syncedFromFeed}"><badge variant="secondary">{override.originLabel}</badge></if><text grow="1" wrap="true">Source: {override.sourceLabel}</text></row><if test="{override.syncedFromFeed}"><text wrap="true" foreground="text_muted">This override arrived with the BIR feed and cannot be edited here. Dismissing it stops future syncs from re-adding it; record a different rule as a separate manual override.</text></if><row gap="8"><button size="sm" variant="outline" disabled="{override.editDisabled}" on-press="calendar_edit_override:{override.id}">Edit</button><button size="sm" variant="ghost" on-press="calendar_delete_override:{override.id}">{override.removeActionLabel}</button></row></column></card></for><use template="bu"/><separator/><column gap="10"><text><span weight="bold">Non-working Days</span></text><text wrap="true" foreground="text_muted">Weekends are built in. Official holidays and closures are explicit, source-cited SQLite records; none are guessed or auto-seeded.</text></column><if test="{calendarNonWorkingDaysEmpty}"><card><column padding="18" gap="6" cross="center"><text><span weight="bold">No configured non-working days</span></text><text wrap="true" text-alignment="center" foreground="text_muted">Until an official day is entered, only Saturday and Sunday business-day adjustment is active.</text></column></card></if><for each="calendarNonWorkingDays" key="id" as="day"><card><column padding="18" gap="8"><row gap="10" cross="center"><badge variant="secondary">{day.dateLabel}</badge><column grow="1" gap="3"><text><span weight="bold">{day.nameLabel}</span></text><text wrap="true" foreground="text_muted">{day.kindLabel} · {day.regionsLabel}</text></column></row><text wrap="true">Source: {day.sourceLabel}</text><row gap="8"><button size="sm" variant="outline" on-press="calendar_edit_non_working_day:{day.id}">Edit</button><button size="sm" variant="ghost" on-press="calendar_delete_non_working_day:{day.id}">Delete</button></row></column></card></for><use template="bv"/></column></template><template name="bx" args="padding"><column padding="{padding}" gap="{dashboardContentGap}"><if test="{constrainedLayout}"><row gap="8" cross="center"><spacer grow="1"/><button width="44" height="44" size="icon" variant="outline" icon="refresh-cw" label="Refresh calendar from SQLite" on-press="calendar_refresh"/></row></if><else><row gap="16" cross="center"><column grow="1" gap="6"><text size="heading">Tax Calendar Explorer</text><text foreground="text_muted">Review calendar-year rules, source-cited changes, and SQLite overrides.</text></column><button variant="outline" icon="refresh-cw" on-press="calendar_refresh">Refresh</button></row></else><tabs gap="4" label="Tax calendar sections"><button variant="ghost" selected="{calendarRulesActive}" on-press="show_calendar_rules">Rules</button><button variant="ghost" selected="{calendarOverridesActive}" on-press="show_calendar_overrides">Overrides</button></tabs><if test="{calendarRulesActive}"><use template="bt"/></if><if test="{calendarOverridesActive}"><use template="bw"/></if></column></template><template name="by"><scroll grow="1" global-key="page-tax-calendar" label="Tax calendar explorer content"><if test="{phoneLayout}"><use template="bx" padding="16"/></if><else><if test="{desktopLayout}"><use template="bx" padding="32"/></if><else><use template="bx" padding="24"/></else></else></scroll></template><template name="bz" args="icon title body action"><column><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column></row><button variant="outline" disabled="true">{action}</button></column></if><else><row gap="14" cross="center"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column><button variant="outline" disabled="true">{action}</button></row></else></column></template><template name="ca" args="icon title body enabled=false"><column><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column></row><switch checked="{enabled}" disabled="true" label="{title}"></switch></column></if><else><row gap="14" cross="center"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column><switch checked="{enabled}" disabled="true" label="{title}"></switch></row></else></column></template><template name="cb" args="icon title body action"><column><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="{icon}" foreground="destructive" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column></row><button variant="destructive" disabled="true">{action}</button></column></if><else><row gap="14" cross="center"><icon name="{icon}" foreground="destructive" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column><button variant="destructive" disabled="true">{action}</button></row></else></column></template><template name="cc"><column gap="24"><column gap="6"><text size="heading">Settings</text><text wrap="true" foreground="text_muted">Configure security, privacy, and global application preferences.</text></column><card><if test="{constrainedLayout}"><column padding="22" gap="16"><row gap="14" cross="start"><icon name="sun" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Appearance</span></text><text wrap="true" foreground="text_muted">Follow the system appearance or keep Buwiz App in a specific theme.</text></column></row><toggle-group gap="2" label="Application appearance"><toggle-button size="sm" selected="{themePreference == 'system'}" on-toggle="set_theme_system">System</toggle-button><toggle-button size="sm" selected="{themePreference == 'light'}" on-toggle="set_theme_light">Light</toggle-button><toggle-button size="sm" selected="{themePreference == 'dark'}" on-toggle="set_theme_dark">Dark</toggle-button></toggle-group></column></if><else><row padding="22" gap="18" cross="center"><icon name="sun" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Appearance</span></text><text wrap="true" foreground="text_muted">Follow the system appearance or keep Buwiz App in a specific theme.</text></column><toggle-group gap="2" label="Application appearance"><toggle-button size="sm" selected="{themePreference == 'system'}" on-toggle="set_theme_system">System</toggle-button><toggle-button size="sm" selected="{themePreference == 'light'}" on-toggle="set_theme_light">Light</toggle-button><toggle-button size="sm" selected="{themePreference == 'dark'}" on-toggle="set_theme_dark">Dark</toggle-button></toggle-group></row></else></card><card><column padding="22" gap="10"><text><span weight="bold">Data attribution</span></text><text wrap="true" foreground="text_muted">Philippine postal-code suggestions use GeoNames data under the Creative Commons Attribution 4.0 License. © GeoNames — www.geonames.org.</text></column></card><card><column padding="22" gap="18"><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="file-text" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Calendar Integration</span></text><text wrap="true" foreground="text_muted">Default calendar handoff is ready</text></column></row><row cross="center"><badge variant="primary">Ready</badge></row></column></if><else><row gap="14" cross="center"><icon name="file-text" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Calendar Integration</span></text><text foreground="text_muted">Default calendar handoff is ready</text></column><badge variant="primary">Ready</badge></row></else><text wrap="true" foreground="text_muted">Add the resolved schedule to Apple Calendar, Outlook, Google Calendar, or another registered calendar app using an ICS handoff. Choose an iCloud, Google, or Outlook calendar during import to propagate it to mobile. Direct managed Google OAuth sync is optional and not connected.</text><if test="{constrainedLayout}"><column gap="10"><button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button><button variant="outline" disabled="true">Connect Google Directly</button></column></if><else><row gap="10"><button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button><button variant="outline" disabled="true">Connect Google Directly</button></row></else></column></card><card><column padding="22" gap="18"><column gap="4"><text><span weight="bold">Security</span></text><text wrap="true" foreground="text_muted">Protect application access and individual taxpayer profiles.</text></column><separator/><use template="bz" icon="settings" title="Master PIN" body="Require a master PIN when opening protected areas." action="Configure"/><separator/><use template="bz" icon="circle-dot" title="Master Authenticator App" body="Use a one-time code from an authenticator application." action="Set Up"/><separator/><use template="ca" icon="check-circle" title="Enable Profile PINs" body="Allow separate access PINs for taxpayer profiles."/></column></card><card><column padding="22" gap="18"><column gap="4"><text><span weight="bold">Privacy and Display</span></text><text wrap="true" foreground="text_muted">Choose how taxpayer profiles appear in the application shell.</text></column><separator/><use template="ca" icon="eye" title="Hide Tax Profiles from Sidebar" body="Keep profile names and TINs hidden until the list is opened."/><separator/><use template="bz" icon="terminal" title="Global Toggle Hotkey" body="Configure a keyboard shortcut for hiding and showing profiles." action="Set Shortcut"/></column></card><card><column padding="22" gap="18"><column gap="4"><text><span weight="bold">Data</span></text><text wrap="true" foreground="text_muted">Create a portable archive of application data.</text></column><separator/><row gap="14" cross="start"><icon name="alert" foreground="warning" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">Storage status</span></text><text wrap="true" foreground="warning">{artifactStorageClassification}</text></column></row><separator/><use template="bz" icon="download" title="Export Data" body="Export taxpayer profiles and application records to a backup archive." action="Export"/></column></card><card><column padding="22" gap="18"><column gap="4"><text foreground="destructive"><span weight="bold">Danger Zone</span></text><text wrap="true" foreground="text_muted">Destructive options are displayed for layout parity only.</text></column><separator/><use template="cb" icon="alert" title="Factory Reset" body="Restore global preferences to their defaults." action="Factory Reset"/><separator/><use template="cb" icon="trash" title="Zero Out Everything" body="Remove all local taxpayer and application data." action="Zero Out Everything"/></column></card></column></template><template name="cd"><scroll grow="1" global-key="page-settings" label="Settings content"><if test="{phoneLayout}"><column padding="16"><use template="cc"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="cc"/></column></if><else><column padding="32"><use template="cc"/></column></else></else></scroll></template><template name="ce" args="grid_columns"><grid columns="{grid_columns}" gap="12"><button variant="secondary" on-press="show_taxpayer_dashboard">Taxpayer Dashboard</button><button variant="secondary" on-press="show_global_dashboard">Global Dashboard</button><button variant="secondary" on-press="show_profile_setup">Taxpayer Profile Setup</button><button variant="secondary" on-press="show_background_tasks">Background Tasks</button><button variant="secondary" on-press="show_import_data">Import Data</button><button variant="secondary" on-press="show_tax_calendar">Tax Calendar Explorer</button><button variant="secondary" on-press="show_settings">Settings</button></grid></template><template name="cf" args="grid_columns"><grid columns="{grid_columns}" gap="12"><button variant="secondary" on-press="show_form_0605">0605 - Payment Form</button><button variant="secondary" on-press="show_form_0619_e">0619-E - Creditable Income Taxes Withheld</button><button variant="secondary" on-press="show_form_0619_f">0619-F - Final Income Taxes Withheld</button><button variant="secondary" on-press="show_form_1601_c">1601C - Compensation Withholding</button><button variant="secondary" on-press="show_form_1701">1701 - Annual Individual ITR</button><button variant="secondary" on-press="show_form_1701q">1701Q - Quarterly Individual ITR</button><button variant="secondary" on-press="show_form_1702_rt">1702-RT - Regular-Rate Corporation ITR</button><button variant="secondary" on-press="show_form_1702_mx">1702-MX - Mixed-Income Corporation ITR</button><button variant="secondary" on-press="show_form_2550q">2550Q - Quarterly VAT Return</button><button variant="secondary" on-press="show_form_2551q">2551Q - Quarterly Percentage Tax</button></grid></template><template name="cg" args="grid_columns"><grid columns="{grid_columns}" gap="12"><button variant="secondary" on-press="show_aux_admin_auth_overlay">Admin Authentication Overlay</button><button variant="secondary" on-press="show_aux_background_task_debug_log">Background Task Debug Log</button><button variant="secondary" on-press="show_aux_command_palette">Command Palette</button><button variant="secondary" on-press="show_aux_email_confirmation">Email Confirmation</button><button variant="secondary" on-press="show_aux_html_print_preview">HTML Print Preview</button><button variant="secondary" on-press="show_aux_lock_screen">Lock Screen</button><button variant="secondary" on-press="show_aux_profile_auth_overlay">Profile Authentication Overlay</button></grid></template><template name="ch"><column gap="24"><if test="{constrainedLayout}"><column gap="8"><row cross="center"><badge variant="outline">Developer Tools</badge></row><column gap="4"><text size="heading">Screen Gallery</text><text wrap="true" foreground="text_muted">Reviewer-only index for every reconstructed Buwiz App surface. This page is not part of the taxpayer workflow.</text></column></column></if><else><row gap="14" cross="start"><column grow="1" gap="4"><text size="heading">Screen Gallery</text><text wrap="true" foreground="text_muted">Reviewer-only index for every reconstructed Buwiz App surface. This page is not part of the taxpayer workflow.</text></column><badge variant="outline">Developer Tools</badge></row></else><card><column padding="20" gap="12"><column gap="4"><text><span weight="bold">Main Screens</span></text><text wrap="true" foreground="text_muted">Primary application pages and taxpayer workflows.</text></column><column><if test="{phoneLayout}"><use template="ce" grid_columns="1"/></if><if test="{constrainedLayout and phoneLayout == false}"><use template="ce" grid_columns="1"/></if><if test="{tabletLayout}"><use template="ce" grid_columns="2"/></if><if test="{desktopLayout}"><use template="ce" grid_columns="3"/></if></column></column></card><card><column padding="20" gap="12"><column gap="4"><text><span weight="bold">BIR Form Editors</span></text><text wrap="true" foreground="text_muted">Static form-editor replicas with audited filing sections and status pipelines.</text></column><column><if test="{phoneLayout}"><use template="cf" grid_columns="1"/></if><if test="{constrainedLayout and phoneLayout == false}"><use template="cf" grid_columns="1"/></if><if test="{tabletLayout}"><use template="cf" grid_columns="2"/></if><if test="{desktopLayout}"><use template="cf" grid_columns="3"/></if></column></column></card><card><column padding="20" gap="12"><column gap="4"><text><span weight="bold">Auxiliary Surfaces</span></text><text wrap="true" foreground="text_muted">Overlays, confirmation windows, previews, and supporting diagnostic views.</text></column><column><if test="{phoneLayout}"><use template="cg" grid_columns="1"/></if><if test="{constrainedLayout and phoneLayout == false}"><use template="cg" grid_columns="1"/></if><if test="{tabletLayout}"><use template="cg" grid_columns="2"/></if><if test="{desktopLayout}"><use template="cg" grid_columns="3"/></if></column></column></card></column></template><template name="ci"><scroll grow="1" global-key="page-screen-gallery" label="Developer screen gallery"><if test="{phoneLayout}"><column padding="16"><use template="ch"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="ch"/></column></if><else><column padding="32"><use template="ch"/></column></else></else></scroll></template>
