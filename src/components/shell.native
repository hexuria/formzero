<template name="form-field" args="label ph disabled=false">
  <column gap="4">
    <text foreground="text_muted">{label}</text>
    <input placeholder="{ph}" label="{label}" disabled="{disabled}" />
  </column>
</template>

<template name="profile-filing-readiness-toast">
  <alert
    width="360"
    global-key="profile-filing-readiness-toast"
    label="Filing setup required">
    <column gap="10">
      <row gap="12" cross="start">
        <icon name="alert" foreground="warning" width="20" height="20"/>
        <text grow="1" wrap="true">{profileFilingReadinessNotice}</text>
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="x"
          label="Dismiss filing setup notice"
          on-press="dismiss_profile_filing_readiness_notice">
        </button>
      </row>
      <button
        variant="primary"
        on-press="open_profile_filing_readiness_remediation">
        {profileFilingReadinessActionLabel}
      </button>
    </column>
  </alert>
</template>

<template name="form-field-bound" args="label v ph">
  <column gap="4">
    <text foreground="text_muted">{label}</text>
    <input text="{v}" placeholder="{ph}" label="{label}" disabled="true" />
  </column>
</template>

<template name="sidebar-profile" args="name tin profile branch active=false">
  <list-item
    width="255"
    height="72"
    padding="8"
    radius="md"
    selected="{active}"
    label="{name}"
    on-press="select_taxpayer:{profile}">
    <column grow="1" gap="2">
      <text><span weight="bold">{name}</span></text>
      <text foreground="text_muted">{tin}</text>
      <text foreground="text_muted">{branch}</text>
    </column>
  </list-item>
</template>

<template name="sidebar-dock-full">
  <column width="232" gap="8">
    <row width="232" height="48" cross="center">
      <if test="{darkThemeActive}">
        <list-item
          key="{sidebarActionEpoch}"
          width="232"
          height="44"
          padding="12"
          radius="md"
          icon="sun"
          selected="false"
          label="Switch to light mode"
          on-press="toggle_theme">
          Light Mode
        </list-item>
      </if>
      <if test="{lightThemeActive}">
        <list-item
          key="{sidebarActionEpoch}"
          width="232"
          height="44"
          padding="12"
          radius="md"
          icon="moon"
          selected="false"
          label="Switch to dark mode"
          on-press="toggle_theme">
          Dark Mode
        </list-item>
      </if>
    </row>

    <row width="232" height="48" cross="center">
      <list-item
        key="{sidebarActionEpoch}"
        width="232"
        height="44"
        padding="12"
        radius="md"
        icon="file-text"
        selected="false"
        on-press="show_tax_calendar">
        Tax Calendars
      </list-item>
    </row>

    <row width="232" height="48" cross="center">
      <list-item
        key="{sidebarActionEpoch}"
        width="232"
        height="44"
        padding="12"
        radius="md"
        icon="settings"
        selected="false"
        on-press="show_settings">
        Settings
      </list-item>
    </row>
  </column>
</template>

<template name="sidebar-dock-rail">
  <column width="48" gap="8" cross="center">
    <if test="{darkThemeActive}">
      <button
        width="48"
        height="48"
        size="icon"
        variant="ghost"
        radius="xl"
        icon="sun"
        label="Switch to light mode"
        on-press="toggle_theme">
      </button>
    </if>
    <if test="{lightThemeActive}">
      <button
        width="48"
        height="48"
        size="icon"
        variant="ghost"
        radius="xl"
        icon="moon"
        label="Switch to dark mode"
        on-press="toggle_theme">
      </button>
    </if>

    <button
      width="48"
      height="48"
      size="icon"
      variant="ghost"
      radius="xl"
      icon="file-text"
      label="Tax Calendars"
      on-press="show_tax_calendar">
    </button>

    <button
      width="48"
      height="48"
      size="icon"
      variant="ghost"
      radius="xl"
      icon="settings"
      label="Settings"
      on-press="show_settings">
    </button>
  </column>
</template>

<template name="app-sidebar-full" args="app_icon overlay=false">
  <stack width="280">
    <status-bar background="surface" border-color="surface"></status-bar>
    <row width="280">
      <column width="279" grow="1" cross="center">
      <spacer height="12"/>

      <row width="255" height="44" main="end" cross="center">
        <if test="{overlay}">
          <list-item
            width="44"
            height="44"
            padding="0"
            main="center"
            cross="center"
            radius="xl"
            selected="false"
            label="Close navigation"
            on-press="close_sidebar_overlay">
            <icon name="x" width="24" height="24"/>
          </list-item>
        </if>
        <else>
          <list-item
            width="44"
            height="44"
            padding="0"
            main="center"
            cross="center"
            radius="xl"
            selected="false"
            label="Use compact sidebar"
            on-press="collapse_sidebar">
            <icon name="chevron-left" width="28" height="28"/>
          </list-item>
        </else>
      </row>

      <row
        width="255"
        height="88"
        padding="8"
        gap="10"
        main="center"
        cross="center"
        role="button"
        label="Open Global Dashboard"
        on-press="show_global_dashboard">
        <image image="{app_icon}" width="52" height="52" label="{appDisplayName}"/>
        <column grow="1" gap="2">
          <text><span weight="bold">Buwiz App</span></text>
          <if test="{branchBuild}">
            <text wrap="true" size="sm" foreground="text_muted">Branch: {appBuildSlug}</text>
          </if>
        </column>
      </row>

      <row width="232" height="56" cross="center" gap="8">
        <text grow="1" foreground="text_muted">
          <span weight="bold">TAXPAYER PROFILES</span>
        </text>
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="plus"
          label="{profileNewTaxpayerActionLabel}"
          on-press="new_taxpayer_profile">
        </button>
      </row>

      <search-field
        width="232"
        text="{sidebarProfileSearchValue}"
        placeholder="Search profiles"
        label="Search taxpayer profiles"
        autofocus="{overlay}"
        on-input="sidebar_profile_search_changed"/>
      <if test="{profileListTruncatedVisible}">
        <text width="232" wrap="true" foreground="text_muted">{profileListTruncatedLabel}</text>
      </if>

      <spacer height="16"/>
      <separator/>

      <scroll grow="1" width="255" overscroll="none" label="Sidebar navigation">
        <column width="255" grow="1" cross="center" gap="8">
          <spacer height="4"/>
          <if test="{visibleProfileRowsEmpty}">
            <column width="232" padding="12" gap="6" cross="center">
              <text><span weight="bold">{profileRowsEmptyTitle}</span></text>
              <text wrap="true" text-alignment="center" foreground="text_muted">
                {profileRowsEmptyMessage}
              </text>
            </column>
          </if>
          <for each="visibleProfileRows" key="idLabel" as="profile">
            <use
              template="sidebar-profile"
              name="{profile.nameLabel}"
              tin="{profile.tinLabel}"
              branch="{profile.branchLabel}"
              profile="{profile.slot}"
              active="{profile.active and taxpayerNavigationSelectionVisible}"/>
          </for>

          <spacer grow="1"/>
          <separator/>
          <spacer height="8"/>
          <use template="sidebar-dock-full"/>
          <spacer height="12"/>
        </column>
      </scroll>
      </column>
      <separator/>
    </row>
  </stack>
</template>

<template name="sidebar-avatar" args="initials name profile active=false">
  <row width="48" height="64" main="center" cross="center">
    <if test="{active}">
      <button
        width="48"
        height="48"
        size="icon"
        variant="primary"
        radius="xl"
        selected="true"
        label="{name}"
        on-press="select_taxpayer:{profile}">
        {initials}
      </button>
    </if>
    <else>
      <button
        width="48"
        height="48"
        size="icon"
        variant="ghost"
        radius="xl"
        selected="false"
        label="{name}"
        on-press="select_taxpayer:{profile}">
        {initials}
      </button>
    </else>
  </row>
</template>

<template name="app-sidebar-rail" args="app_icon">
  <row width="72" background="background">
    <column width="71" grow="1" cross="center">
      <spacer height="12"/>

      <row width="48" height="44" main="center" cross="center">
        <list-item
          width="44"
          height="44"
          padding="0"
          main="center"
          cross="center"
          radius="xl"
          selected="false"
          label="Expand sidebar"
          on-press="expand_sidebar">
          <icon name="chevron-right" width="28" height="28"/>
        </list-item>
      </row>

      <row
        width="48"
        height="64"
        main="center"
        cross="center"
        role="button"
        label="Open Global Dashboard"
        on-press="show_global_dashboard">
        <image image="{app_icon}" width="48" height="48" label="{appDisplayName}"/>
      </row>

      <row width="48" height="56" main="center" cross="center">
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="plus"
          selected="{page == 'profile_setup'}"
          label="{profileNewTaxpayerActionLabel}"
          on-press="new_taxpayer_profile">
        </button>
      </row>

      <row width="48" height="64" main="center" cross="center">
        <button
          width="48"
          height="48"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="search"
          label="Search taxpayer profiles"
          on-press="open_sidebar_overlay">
        </button>
      </row>

      <spacer height="16"/>
      <separator/>

      <scroll
        grow="1"
        width="70"
        overscroll="none"
        label="Compact sidebar navigation">
        <column width="70" grow="1" cross="center" gap="8">
          <spacer height="4"/>
          <for each="profileRows" key="idLabel" as="profile">
            <use
              template="sidebar-avatar"
              initials="{profile.initialsLabel}"
              name="{profile.nameLabel}"
              profile="{profile.slot}"
              active="{profile.active and taxpayerNavigationSelectionVisible}"/>
          </for>

          <spacer grow="1"/>
          <separator/>
          <spacer height="8"/>
          <use template="sidebar-dock-rail"/>
          <spacer height="12"/>
        </column>
      </scroll>
    </column>
    <separator/>
  </row>
</template>

<template name="app-mobile-header">
  <column>
    <row height="56" padding="8" gap="10" cross="center" background="background">
      <if test="{page == 'profile_setup'}">
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="chevron-left"
          label="{profileBackLabel}"
          on-press="cancel_profile_edit">
        </button>
      </if>
      <else>
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="menu"
          label="Open navigation"
          on-press="toggle_navigation">
        </button>
      </else>
      <text grow="1"><span weight="bold">{currentPageTitle}</span></text>
    </row>
    <separator/>
  </column>
</template>

<template name="app-footer" args="bagong_logo bir_logo goldcoders_logo">
  <column>
    <if test="{regularFooter}">
      <column>
        <separator/>
        <row height="71" padding="12" cross="center" gap="12" background="background">
          <image image="{bagong_logo}" width="48" height="48" label="Bagong Pilipinas"/>
          <image image="{bir_logo}" width="48" height="48" label="Bureau of Internal Revenue"/>
          <spacer grow="1"/>
          <if test="{footerCopyrightVisible}">
            <text foreground="text_muted">© 2026 Goldcoders Corp. · goldcoders.dev</text>
          </if>
          <image image="{goldcoders_logo}" width="44" height="44" label="Goldcoders"/>
        </row>
      </column>
    </if>

    <if test="{compactFooter}">
      <column>
        <separator/>
        <row height="57" padding="8" cross="center" gap="8" background="background">
          <image image="{bagong_logo}" width="38" height="38" label="Bagong Pilipinas"/>
          <image image="{bir_logo}" width="38" height="38" label="Bureau of Internal Revenue"/>
          <spacer grow="1"/>
          <text foreground="text_muted">© 2026</text>
          <image image="{goldcoders_logo}" width="36" height="36" label="Goldcoders"/>
        </row>
      </column>
    </if>
  </column>
</template>

<template name="tax-profile-form-context">
  <card>
    <column padding="16" gap="12">
      <column gap="2">
        <text><span weight="bold">{formProfileContextTitle}</span></text>
        <text wrap="true" foreground="text_muted">{formProfileStatus}</text>
        <text wrap="true" foreground="text_muted">Filing period: {formFilingPeriodLabel}</text>
      </column>

      <if test="{formProfileNotice}">
        <if test="{phoneLayout}">
          <column
            padding="10"
            gap="8"
            background="surface_subtle"
            radius="md">
            <icon name="info" width="18" height="18" foreground="info"/>
            <text wrap="true">{formProfileNotice}</text>
          </column>
        </if>
        <else>
          <row
            padding="10"
            gap="8"
            cross="start"
            background="surface_subtle"
            radius="md">
            <icon name="info" width="18" height="18" foreground="info"/>
            <text grow="1" wrap="true">{formProfileNotice}</text>
          </row>
        </else>
      </if>

      <separator/>
      <column gap="2">
        <text><span weight="bold">Reusable form details</span></text>
        <text wrap="true" foreground="text_muted">
          Form-specific yearly values and spouse profiles are managed in the Tax Form Profile for this tax year.
        </text>
      </column>
    </column>
  </card>
</template>

<template name="profile-notice-toast">
  <alert
    width="320"
    global-key="profile-notice-toast"
    label="Tax profile notification">
    <row gap="12" cross="start">
      <if test="{profileNoticeFailure}">
        <icon name="alert" foreground="destructive" width="20" height="20"/>
      </if>
      <else>
        <if test="{profileNoticeSuccess}">
          <icon name="check-circle" foreground="success" width="20" height="20"/>
        </if>
        <else>
          <icon name="info" foreground="info" width="20" height="20"/>
        </else>
      </else>
      <text grow="1" wrap="true">{profileNotice}</text>
      <button
        width="44"
        height="44"
        size="icon"
        variant="ghost"
        radius="xl"
        icon="x"
        label="Dismiss tax profile notification"
        on-press="dismiss_profile_notice">
      </button>
    </row>
  </alert>
</template>

<template name="profile-calendar-export-toast">
  <alert
    width="320"
    global-key="profile-calendar-export-toast"
    label="Calendar export notification">
    <row gap="12" cross="start">
      <if test="{profileCalendarExportNoticeFailure}">
        <icon name="alert" foreground="destructive" width="20" height="20"/>
      </if>
      <else>
        <if test="{profileCalendarExportNoticeSuccess}">
          <icon name="check-circle" foreground="success" width="20" height="20"/>
        </if>
        <else>
          <icon name="info" foreground="info" width="20" height="20"/>
        </else>
      </else>
      <text grow="1" wrap="true">{profileCalendarExportNotice}</text>
      <if test="{profileCalendarExportNoticeDismissible}">
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="x"
          label="Dismiss calendar export notification"
          on-press="dismiss_profile_calendar_export_notice">
        </button>
      </if>
    </row>
  </alert>
</template>

<template name="app-shell" args="app_icon bagong_logo bir_logo goldcoders_logo">
  <stack grow="1">
    <status-bar background="background" border-color="background"></status-bar>

    <column grow="1">
      <row grow="1">
        <if test="{sidebarExpandedVisible}">
          <use template="app-sidebar-full" app_icon="{app_icon}"/>
        </if>
        <if test="{sidebarRailVisible}">
          <use template="app-sidebar-rail" app_icon="{app_icon}"/>
        </if>

        <column grow="1" min-width="0">
          <column grow="1" min-width="0">
            <if test="{sidebarLauncherVisible}">
              <use template="app-mobile-header"/>
            </if>
            <slot/>
          </column>

          <use
            template="app-footer"
            bagong_logo="{bagong_logo}"
            bir_logo="{bir_logo}"
            goldcoders_logo="{goldcoders_logo}"/>
        </column>
      </row>

    </column>

    <if test="{sidebarOverlayVisible}">
      <column grow="1">
        <row grow="1">
          <use
            template="app-sidebar-full"
            app_icon="{app_icon}"
            overlay="true"/>
          <status-bar
            grow="1"
            background="shadow"
            border-color="shadow"
            on-press="close_sidebar_overlay"
            label="Close navigation">
          </status-bar>
        </row>
      </column>
    </if>

    <if test="{profileToastRegionVisible}">
      <column grow="1" padding="16" cross="end" gap="8">
        <if test="{sidebarLauncherVisible}">
          <spacer height="56"/>
        </if>
        <if test="{profileNoticeVisible}">
          <use template="profile-notice-toast"/>
        </if>
        <if test="{profileCalendarExportNoticeVisible}">
          <use template="profile-calendar-export-toast"/>
        </if>
        <if test="{profileFilingReadinessNoticeVisible}">
          <use template="profile-filing-readiness-toast"/>
        </if>
      </column>
    </if>
  </stack>
</template>
