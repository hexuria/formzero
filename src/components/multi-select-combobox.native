<!--
  Reusable view contract for the app's bounded multi-select state.

  The host supplies derived option rows and summary flags. The fixed
  multi_select_* messages form the adapter seam to the host model:
    - multi_select_open / multi_select_close
    - multi_select_query_changed
    - multi_select_toggle_option:{option.id}
    - multi_select_select_all_filtered / multi_select_clear_all
-->
<template
  name="multi-select-combobox"
  args="placeholder label">
  <stack width="{globalCalendarFormPickerWidth}">
    <!-- The summary trigger and search editor are deliberately separate.
         Mounting a menu around the same editor that initiated the click
         creates a focus/dismiss race on AppKit. -->
    <select
      size="sm"
      height="{globalCalendarFormRowHeight}"
      placeholder="Select options..."
      label="{label}"
      disabled="{globalCalendarFormPickerDisabled}"
      on-press="multi_select_open">{globalCalendarFormSelectionText}</select>

    <if test="{globalCalendarFormPickerOpen}">
      <dropdown-menu
        anchor="below"
        anchor-alignment="stretch"
        anchor-offset="4"
        height="{globalCalendarFormMenuHeight}"
        on-dismiss="multi_select_close">
        <!-- Search and bulk actions remain pinned; only the supplied option
             rows participate in the bounded scrolling region below. -->
        <search-field
          size="sm"
          height="{globalCalendarFormRowHeight}"
          text="{globalCalendarFormQuery}"
          placeholder="{placeholder}"
          autofocus="true"
          on-input="multi_select_query_changed"/>

        <separator/>

        <row height="{globalCalendarFormRowHeight}" gap="4" cross="center">
          <if test="{globalCalendarAllFilteredSelected}">
            <button
              height="{globalCalendarFormRowHeight}"
              size="sm"
              variant="ghost"
              icon="x"
              on-press="multi_select_clear_all">Deselect All</button>
          </if>
          <else>
            <button
              height="{globalCalendarFormRowHeight}"
              size="sm"
              variant="ghost"
              icon="check"
              on-press="multi_select_select_all_filtered">Select All</button>
            <if test="{globalCalendarAnyFormsSelected}">
              <button
                height="{globalCalendarFormRowHeight}"
                size="sm"
                variant="ghost"
                icon="x-circle"
                on-press="multi_select_clear_all">Clear All</button>
            </if>
          </else>
        </row>

        <separator/>

        <scroll
          height="{globalCalendarFormOptionsHeight}"
          overscroll="none"
          label="{label}">
          <column>
            <for each="visibleGlobalCalendarFormOptions" key="id" as="option">
              <if test="{option.selected}">
                <menu-item
                  height="{globalCalendarFormRowHeight}"
                  icon="check"
                  selected="true"
                  on-press="multi_select_toggle_option:{option.id}">{option.label}</menu-item>
              </if>
              <else>
                <menu-item
                  height="{globalCalendarFormRowHeight}"
                  selected="false"
                  on-press="multi_select_toggle_option:{option.id}">{option.label}</menu-item>
              </else>
            </for>
            <else>
              <menu-item height="{globalCalendarFormRowHeight}" disabled="true">No matching options</menu-item>
            </else>
          </column>
        </scroll>
      </dropdown-menu>
    </if>
  </stack>
</template>
