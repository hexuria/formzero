    <column width="300" gap="8">
      <button width="300" variant="outline" disabled="true">Admin Override</button>
      <button width="300" variant="ghost" on-press="go_back">Cancel</button>
    </column>
  </column>
</template>

<template name="profile-auth-overlay">
  <column grow="1" padding="16" main="center" cross="center" background="background">
    <if test="{phoneLayout}">
      <column gap="24" cross="center">
        <use template="profile-auth-content"/>
      </column>
    </if>
    <else>
      <column width="440" gap="24" cross="center">
        <use template="profile-auth-content"/>
      </column>
    </else>
  </column>
</template>

<template name="admin-auth-content">
  <column gap="24" cross="center">
    <column gap="4" cross="center">
      <badge variant="outline">BIR</badge>
      <text size="display">e-BIRForms</text>
    </column>

    <column gap="6" cross="center">
      <text wrap="true" text-alignment="center" size="heading">Admin Access Required</text>
      <text wrap="true" text-alignment="center" foreground="text_muted">Enter App Lock PIN to access Background Tasks</text>
    </column>

    <input
      width="300"
      size="lg"
      placeholder="Enter 4-digit PIN"
      label="Administrator PIN"
    />

    <column width="300" gap="8">
      <button width="300" variant="outline" disabled="true">OS Auth Override</button>
      <button width="300" variant="ghost" on-press="go_back">Cancel</button>
    </column>
  </column>
</template>

<template name="admin-auth-overlay">
  <column grow="1" padding="16" main="center" cross="center" background="background">
    <if test="{phoneLayout}">
      <column gap="24" cross="center">
        <use template="admin-auth-content"/>
      </column>
    </if>
    <else>
      <column width="460" gap="24" cross="center">
        <use template="admin-auth-content"/>
      </column>
    </else>
  </column>
</template>

<template name="command-palette-card">
  <card radius="lg" background="background">
    <column>
      <row padding="16" gap="12" cross="center">
        <icon name="search" width="20" height="20" foreground="text_muted"/>
        <input
          grow="1"
          size="lg"
          placeholder="Search profiles..."
          label="Search tax profiles"
        />
        <button
          size="icon"
          variant="ghost"
          icon="x"
          label="Close command palette"
          on-press="go_back"
        />
      </row>

      <separator/>

      <scroll height="350" overscroll="none">
        <column padding="8" gap="4">
          <text size="sm" foreground="text_muted">ACTIVE PROFILES</text>
          <list-item
            selected="true"
            label="Juan Dela Cruz, TIN 123-456-789-000"
          >
            <row padding="12" gap="16" cross="center">
              <avatar label="Juan Dela Cruz">JD</avatar>
              <column grow="1" gap="2">
                <text wrap="true" size="heading">Juan Dela Cruz</text>
                <text wrap="true" foreground="text_muted">TIN: 123-456-789-000</text>
              </column>
            </row>
          </list-item>
          <list-item label="Maria Santos, TIN 987-654-321-000">
            <row padding="12" gap="16" cross="center">
              <avatar label="Maria Santos">MS</avatar>
              <column grow="1" gap="2">
                <text wrap="true" size="heading">Maria Santos</text>
                <text wrap="true" foreground="text_muted">TIN: 987-654-321-000</text>
              </column>
            </row>
          </list-item>

          <separator/>

          <text size="sm" foreground="text_muted">ARCHIVED PROFILES</text>
          <list-item label="Archived profile, TIN 555-555-555-000">
            <row padding="12" gap="16" cross="center">
              <avatar label="Archived profile">AP</avatar>
              <column grow="1" gap="2">
                <text wrap="true" foreground="text_muted">Archived Profile</text>
                <text wrap="true" foreground="text_muted">TIN: 555-555-555-000</text>
              </column>
            </row>
          </list-item>
        </column>
      </scroll>
    </column>
  </card>
</template>

<template name="command-palette-overlay">
  <column grow="1" padding="16" background="shadow">
    <if test="{constrainedLayout}">
      <spacer height="16"/>
    </if>
    <else>
      <spacer height="72"/>
    </else>

    <if test="{constrainedLayout}">
      <use template="command-palette-card"/>
