<column gap="4">
<text foreground="text_muted">Tax on Compensation Income</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Tax on Business / Profession Income</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Total Income Tax Due</text>
<input placeholder="Enter amount" />
</column>
</grid>
</template>
<template name="form-1701-grid-8" args="columns">
<grid columns="{columns}" gap="12">
<column gap="4">
<text foreground="text_muted">Quarterly Income Tax Payments</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Creditable Tax Withheld (BIR Form 2307)</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Tax Withheld on Compensation</text>
<input placeholder="Enter amount" />
</column>
</grid>
</template>
<template name="form-1701-grid-9" args="columns">
<grid columns="{columns}" gap="12">
<column gap="4">
<text foreground="text_muted">Other Tax Credit Description</text>
<input placeholder="Specify credit" />
</column>
<column gap="4">
<text foreground="text_muted">Other Tax Credit Amount</text>
<input placeholder="Enter amount" />
</column>
</grid>
</template>
<template name="form-1701-grid-10" args="columns">
<grid columns="{columns}" gap="12">
<column gap="4">
<text foreground="text_muted">Tax Relief / Special Rate</text>
<input placeholder="Relief code or basis" />
</column>
<column gap="4">
<text foreground="text_muted">Tax Relief Amount</text>
<input placeholder="Enter amount" />
</column>
</grid>
</template>
<template name="form-1701-grid-11" args="columns">
<grid columns="{columns}" gap="12">
<column gap="4">
<text foreground="text_muted">Net Income per Books</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Add: Non-Deductible Expenses</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Less: Non-Taxable Income</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Taxable Net Income</text>
<input placeholder="Enter amount" />
</column>
</grid>
</template>
<template name="form-1701-grid-12" args="columns">
<grid columns="{columns}" gap="12">
<column gap="4">
<text foreground="text_muted">Tax Due</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Less: Total Tax Credits / Payments</text>
<input placeholder="Enter amount" />
</column>
<column gap="4">
<text foreground="text_muted">Penalties</text>
<input placeholder="Enter amount" />
</column>
</grid>
</template>
<template name="form-1701-grid-13" args="columns">
<grid columns="{columns}" gap="12">
<column gap="4">
<text foreground="text_muted">32 Overpayment Disposition</text>
<input placeholder="Refund / Tax Credit / Carry Over" />
</column>
<column gap="4">
<text foreground="text_muted">33 Required Attachments</text>
<input placeholder="Attachment summary" />
</column>
</grid>
</template>
