="{profileFormsPreviousDisabled}" on-press="profile_forms_show_previous"></button><text width="150" text-alignment="center" foreground="text_muted">{profileFormsPageLabel}</text><button width="44" height="44" size="icon" variant="outline" icon="chevron-right" label="Next forms" disabled="{profileFormsNextDisabled}" on-press="profile_forms_show_more"></button></row></if></else></column></template><template name="ap" args="label grow=0"><column grow="{grow}" gap="6"><text>{label}</text><slot/></column></template><template name="aq" args="label value"><column gap="4"><text size="sm" foreground="text_muted">{label}</text><text wrap="true">{value}</text></column></template><template name="ar"><row gap="6" cross="center"><input grow="1" height="44" text="{profileTinSegmentOneValue}" placeholder="3 digits" label="TIN first three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentOneAutofocus}" on-input="profile_tin_segment_one_input"/><text foreground="text_muted">-</text><input grow="1" height="44" text="{profileTinSegmentTwoValue}" placeholder="3 digits" label="TIN second three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentTwoAutofocus}" on-input="profile_tin_segment_two_input"/><text foreground="text_muted">-</text><input grow="1" height="44" text="{profileTinSegmentThreeValue}" placeholder="3 digits" label="TIN third three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentThreeAutofocus}" on-input="profile_tin_segment_three_input"/><text foreground="text_muted">-</text><input grow="1" height="44" text="{profileTinSegmentBranchValue}" placeholder="5 digits" label="TIN five digit branch code" autofocus="{profileTinSegmentBranchAutofocus}" on-input="profile_tin_segment_branch_input"/></row></template><template name="as"><column gap="4"><stack><combobox height="44" text="{profileRdoQueryValue}" placeholder="Search code or city" label="Revenue District Office (RDO)" autofocus="{profileRdoAutofocus}" on-input="profile_rdo_query_input" on-press="profile_rdo_toggle_picker"/><if test="{profileRdoPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_rdo_close_picker"><column padding="4" gap="2"><for each="profileRdoOptionRows" key="id" as="option"><menu-item height="44" selected="{option.selected}" on-press="profile_rdo_select:{option.id}">{option.rowLabel}</menu-item></for></column></dropdown-menu></if></stack><if test="{profileRdoSelectionMissing}"><text wrap="true" foreground="warning">Choose an RDO from the filtered results.</text></if></column></template><template name="at"><column><select height="44" label="Tax year for forms setup" on-press="profile_setup_toggle_year_picker">{profileSetupYearLabel}</select><if test="{profileSetupYearPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="end" anchor-offset="4" width="300" height="300" on-dismiss="profile_setup_close_year_picker"><column padding="8" gap="8"><input height="40" text="{profileSetupYearQueryValue}" placeholder="Type a year" label="Filter tax years" on-input="profile_setup_year_query"/><if test="{profileSetupYearHelperVisible}"><text wrap="true" foreground="text_muted">{profileSetupYearHelperText}</text></if><scroll height="200" label="Tax years"><column gap="4"><for each="profileSetupYearOptions" key="id" as="option"><menu-item height="44" selected="{option.selected}" label="{option.accessibleLabel}" on-press="profile_setup_select_year:{option.year}">{option.rowLabel}</menu-item></for></column></scroll></column></dropdown-menu></if></column></template><template name="au"><column><if test="{profileFormsHeaderStacked}"><stack><use template="at"/></stack></if><else><stack width="176"><use template="at"/></stack></else></column></template><template name="av"><stack width="220"><select height="44" label="Change the year this setup copies from" on-press="profile_setup_toggle_source_picker">Change source</select><if test="{profileSetupSourcePickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" anchor-offset="4" height="240" on-dismiss="profile_setup_close_source_picker"><scroll height="220" label="Years you can copy from"><column padding="8" gap="4"><for each="profileSetupSourceOptions" key="id" as="source"><menu-item height="44" selected="{source.selected}" label="{source.accessibleLabel}" on-press="profile_setup_draft_seed:{source.year}">{source.rowLabel}</menu-item></for></column></scroll></dropdown-menu></if></stack></template><template name="aw"><card padding="0"><row padding="14" gap="12" cross="center"><icon name="file-text" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">Certificate of Registration</span></text><text wrap="true" foreground="text_muted">{profileCorStatusLabel}</text></column><if test="{profileCorReviewAvailable}"><button height="44" variant="outline" on-press="profile_cor_begin_review">Review against COR</button></if><button height="44" variant="outline" icon="folder-open" disabled="{profileCorUploadDisabled}" on-press="profile_cor_upload">{profileCorActionLabel}</button></row></card></template><template name="ax"><card padding="0"><column padding="16" gap="12"><column gap="4"><text><span weight="bold">Review against the COR</span></text><text wrap="true" foreground="text_muted">Type what the document says. Only the rows you accept are applied.</text></column><use template="ap" label="TIN shown on the COR"><input height="44" text="{profileCorReviewTinValue}" placeholder="000-000-000-000" label="TIN shown on the COR" on-input="profile_cor_tin_input"/></use><if test="{profileCorMismatchVisible}"><card padding="0"><column padding="12" gap="6"><text><span weight="bold">{profileCorMismatchLabel}</span></text><text wrap="true" foreground="text_muted">Nothing here can be applied to this taxpayer.</text></column></card></if><else><column gap="10"><column gap="6"><text wrap="true" foreground="text_muted">{profileCorRdoLabel}</text><input height="44" text="{profileCorRdoValue}" placeholder="What the COR says" label="{profileCorRdoLabel}" on-input="profile_cor_rdo_input"/><checkbox height="44" checked="{profileCorRdoAccepted}" text="Use this value" on-toggle="profile_cor_toggle_rdo"/></column><column gap="6"><text wrap="true" foreground="text_muted">{profileCorNameLabel}</text><input height="44" text="{profileCorNameValue}" placeholder="What the COR says" label="{profileCorNameLabel}" on-input="profile_cor_name_input"/><checkbox height="44" checked="{profileCorNameAccepted}" text="Use this value" on-toggle="profile_cor_toggle_name"/></column><column gap="6"><text wrap="true" foreground="text_muted">{profileCorAddressLabel}</text><input height="44" text="{profileCorAddressValue}" placeholder="What the COR says" label="{profileCorAddressLabel}" on-input="profile_cor_address_input"/><checkbox height="44" checked="{profileCorAddressAccepted}" text="Use this value" on-toggle="profile_cor_toggle_address"/></column><column gap="6"><text wrap="true" foreground="text_muted">{profileCorZipLabel}</text><input height="44" text="{profileCorZipValue}" placeholder="What the COR says" label="{profileCorZipLabel}" on-input="profile_cor_zip_input"/><checkbox height="44" checked="{profileCorZipAccepted}" text="Use this value" on-toggle="profile_cor_toggle_zip"/></column><column gap="6"><text wrap="true" foreground="text_muted">{profileCorTaxTypeLabel}</text><input height="44" text="{profileCorTaxTypeValue}" placeholder="What the COR says" label="{profileCorTaxTypeLabel}" on-input="profile_cor_tax_type_input"/><checkbox height="44" checked="{profileCorTaxTypeAccepted}" text="Use this value" on-toggle="profile_cor_toggle_tax_type"/></column><checkbox height="44" checked="{profileCorApplyFormsSelected}" text="{profileCorApplyFormsLabel}" on-toggle="profile_cor_toggle_apply_forms"/></column></else><row gap="8"><button height="44" variant="outline" on-press="profile_cor_cancel_review">Cancel</button><button height="44" variant="primary" disabled="{profileCorApplyDisabled}" on-press="profile_cor_apply">{profileCorApplyLabel}</button></row></column></card></template><template name="ay"><column gap="24"><if test="{profileInlineBackVisible}"><row gap="10" cross="start"><button width="44" height="44" size="icon" variant="ghost" radius="xl" icon="chevron-left" label="{profileBackLabel}" disabled="{profileInlineBackDisabled}" on-press="go_back"></button><column grow="1" gap="6"><text size="heading">{profileEditorTitle}</text><text wrap="true" foreground="text_muted">Reusable tax facts are versioned once and projected into each qualified form. Existing filing snapshots never change when a profile is revised.</text></column></row></if><tabs label="Profile setup sections"><button height="44" selected="{profileTaxActive}" on-press="show_profile_tax">Tax Profile</button><button height="44" selected="{profileTaxFormsActive}" on-press="show_profile_tax_forms">Registration & Forms</button><button height="44" selected="{profileEmailActive}" on-press="show_profile_email">Email Settings</button></tabs><if test="{profileDirtyNavigationVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">{profileDirtyNavigationTitle}</span></text><text wrap="true" foreground="text_muted">{profileDirtyNavigationBody}</text><row gap="8"><button height="44" variant="primary" autofocus="true" on-press="profile_keep_editing">Stay and keep editing</button><button height="44" variant="outline" on-press="profile_discard_navigation">Discard and continue</button></row></column></card></if><if test="{profileCompletionVisible}"><card padding="0"><row padding="12" gap="10" cross="center"><badge variant="outline">Profile data required</badge><text wrap="true" foreground="text_muted">{profileCompletionMessage}</text></row></card></if><if test="{profileTaxActive}"><column gap="24"><if test="{profileTaxViewing}"><column gap="20"><if test="{constrainedLayout}"><column gap="10"><column gap="4"><text><span weight="bold">Saved tax profile</span></text><text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text></column><button height="44" variant="primary" on-press="edit_tax_profile">Edit Tax Profile</button></column></if><else><row gap="12" cross="center"><column grow="1" gap="4"><text><span weight="bold">Saved tax profile</span></text><text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text></column><button height="44" variant="primary" on-press="edit_tax_profile">Edit Tax Profile</button></row></else><if test="{profileFactsSummaryVisible}"><card padding="0"><column padding="14" gap="6"><text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text></column></card></if><card padding="0"><column padding="18" gap="16"><column gap="4"><text><span weight="bold">Identity and contact</span></text><text wrap="true" foreground="text_muted">Base facts shared by the taxpayer's forms.</text></column><grid columns="{profileReadColumns}" gap="16"><use template="aq" label="Taxpayer Identification Number (TIN)" value="{profileTinDisplayValue}"/><use template="aq" label="Revenue District Office (RDO) code" value="{profileRdoDisplayValue}"/><use template="aq" label="Taxpayer Type" value="{profileSubjectKindLabel}"/><if test="{profileNaturalPersonClassificationVisible}"><use template="aq" label="Tax Classification" value="{profileNaturalPersonClassificationLabel}"/></if><use template="aq" label="Taxpayer or registered name" value="{profileNameDisplayValue}"/><if test="{profileTradeNameVisible}"><use template="aq" label="Trade name" value="{profileTradeNameDisplayValue}"/></if><use template="aq" label="Registered address" value="{profileAddressDisplayValue}"/><use template="aq" label="ZIP code" value="{profileZipDisplayValue}"/><use template="aq" label="Contact number" value="{profilePhoneDisplayValue}"/><use template="aq" label="Registered email address" value="{profileEmailDisplayValue}"/></grid></column></card><if test="{profileBusinessFieldsVisible}"><card padding="0"><column padding="18" gap="16"><column gap="4"><text><span weight="bold">Business registration</span></text><text wrap="true" foreground="text_muted">Registration-owned details used by forms that apply to this taxpayer.</text></column><grid columns="{profileReadColumns}" gap="16"><use template="aq" label="EOPT Tier" value="{profileEoptTierLabel}"/><use template="aq" label="Primary Line of Business" value="{profilePrimaryLineOfBusinessDisplayValue}"/></grid></column></card></if><if test="{profilePersonalFieldsVisible}"><card padding="0"><column padding="18" gap="16"><text><span weight="bold">Individual details</span></text><grid columns="{profileReadColumns}" gap="16"><use template="aq" label="Birth date" value="{profileBirthDateDisplayValue}"/><use template="aq" label="Citizenship" value="{profileCitizenshipDisplayValue}"/><use template="aq" label="Foreign tax number" value="{profileForeignTaxNumberDisplayValue}"/></grid></column></card></if><card padding="0"><column padding="18" gap="8"><text><span weight="bold">Effective date</span></text><use template="aq" label="Details effective from" value="{profileEffectiveFromDisplayValue}"/></column></card></column></if><else><if test="{profileBranchMode}"><card padding="0"><column padding="14" gap="6"><text><span weight="bold">{profileBranchBannerTitle}</span></text><text wrap="true" foreground="text_muted">{profileBranchBannerBody}</text><text wrap="true" foreground="text_muted">{profileBranchCopyNote}</text></column></card></if><if test="{profileFactsSummaryVisible}"><card padding="0"><column padding="14" gap="6"><text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text><if test="{profileFactsMissingVisible}"><text wrap="true" foreground="text_muted">{profileFactsMissingHelpText}</text></if></column></card></if><column gap="16"><column gap="4"><text><span weight="bold">Identity and registration</span></text><text wrap="true" foreground="text_muted">TIN, RDO, registered name, and Taxpayer Type identify this immutable profile revision.</text></column><grid columns="{profileReadColumns}" gap="12"><use template="ap" label="Taxpayer Identification Number (TIN)"><use template="ar"/></use><use template="ap" label="Revenue District Office (RDO)"><use template="as"/></use></grid><column gap="8"><text>Taxpayer Type</text><stack><select height="44" label="Taxpayer Type" disabled="{profileBranchMode}" on-press="toggle_profile_subject_picker">{profileSubjectKindLabel}</select><if test="{profileSubjectPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="close_profile_subject_picker"><menu-item height="44" disabled="{profileBranchMode}" selected="{profileIndividualSelected}" on-press="profile_subject_individual">Individual</menu-item><menu-item height="44" disabled="{profileBranchMode}" selected="{profileCorporationSelected}" on-press="profile_subject_corporation">Corporation</menu-item><menu-item height="44" disabled="{profileBranchMode}" selected="{profilePartnershipSelected}" on-press="profile_subject_partnership">Partnership</menu-item><menu-item height="44" disabled="{profileBranchMode}" selected="{profileCooperativeSelected}" on-press="profile_subject_cooperative">Cooperative</menu-item><menu-item height="44" disabled="{profileBranchMode}" selected="{profileEstateSelected}" on-press="profile_subject_estate">Estate</menu-item><menu-item height="44" disabled="{profileBranchMode}" selected="{profileTrustSelected}" on-press="profile_subject_trust">Trust</menu-item><menu-item height="44" disabled="{profileBranchMode}" selected="{profileOtherLegalSelected}" on-press="profile_subject_other_legal">Other Legal Entity</menu-item></dropdown-menu></if></stack></column><if test="{profileNaturalPersonClassificationVisible}"><column gap="8"><text>Tax Classification</text><text wrap="true" foreground="text_muted">Individual is the Taxpayer Type. Classification records whether this person earns compensation, business/professional income, or both.</text><if test="{profileClassificationUnknownSelected}"><text wrap="true" foreground="warning">Choose a Tax Classification before saving this profile.</text></if><stack><select height="44" label="Tax Classification" on-press="toggle_profile_classification_picker">{profileNaturalPersonClassificationLabel}</select><if test="{profileClassificationPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="close_profile_classification_picker"><menu-item height="44" selected="{profilePureCompensationSelected}" on-press="profile_classification_pure_compensation">Purely Compensation</menu-item><menu-item height="44" selected="{profileSelfEmployedSelected}" on-press="profile_classification_self_employed">Self-Employed / Professional</menu-item><menu-item height="44" selected="{profileMixedIncomeSelected}" on-press="profile_classification_mixed_income">Mixed Income</menu-item></dropdown-menu></if></stack></column></if><use template="ap" label="Taxpayer or registered name"><input height="44" text="{profileNameValue}" placeholder="Registered taxpayer name" label="Taxpayer or registered name" autofocus="{profileNameAutofocus}" on-input="profile_name_input"/></use><if test="{profileTradeNameVisible}"><use template="ap" label="Trade name"><input height="44" text="{profileTradeNameValue}" placeholder="Optional DTI or registered trade name" label="Trade name" on-input="profile_trade_name_input"/></use></if><use template="ap" label="Registered address"><input height="44" text="{profileAddressValue}" placeholder="Registered address" label="Registered address" autofocus="{profileAddressAutofocus}" on-input="profile_address_input"/></use><grid columns="{profileReadColumns}" gap="12"><use template="ap" label="ZIP code"><input height="44" text="{profileZipValue}" placeholder="ZIP code" label="ZIP code" autofocus="{profileZipAutofocus}" on-input="profile_zip_input"/></use><use template="ap" label="Contact number"><input height="44" text="{profilePhoneValue}" placeholder="+63 900 000 0000" label="Contact number" autofocus="{profilePhoneAutofocus}" on-input="profile_phone_input"/></use></grid><use template="ap" label="Registered email address"><input height="44" text="{profileEmailValue}" placeholder="name@example.com" label="Registered email address" autofocus="{profileEmailAutofocus}" on-input="profile_email_input"/></use></column><if test="{profileBusinessFieldsVisible}"><column gap="16"><column gap="4"><text><span weight="bold">Business registration</span></text><text wrap="true" foreground="text_muted">The primary activity and EOPT Tier belong to Registration and are saved together with this Tax Profile.</text></column><if test="{profileRegistrationLoadFailureVisible}"><text wrap="true" foreground="destructive">Registration details could not be loaded. Retry before saving this Tax Profile.</text></if><else><column gap="8"><text>EOPT Tier</text><if test="{profileEoptTierMissing}"><text wrap="true" foreground="warning">Choose the taxpayer's EOPT Tier before saving.</text></if><stack><select height="44" label="EOPT Tier" on-press="toggle_profile_eopt_picker">{profileEoptTierLabel}</select><if test="{profileEoptPickerOpen}"><dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="close_profile_eopt_picker"><menu-item height="44" selected="{profileEoptMicroSelected}" on-press="profile_eopt_micro">Micro</menu-item><menu-item height="44" selected="{profileEoptSmallSelected}" on-press="profile_eopt_small">Small</menu-item><menu-item height="44" selected="{profileEoptMediumSelected}" on-press="profile_eopt_medium">Medium</menu-item><menu-item height="44" selected="{profileEoptLargeSelected}" on-press="profile_eopt_large">Large</menu-item></dropdown-menu></if></stack></column><use template="ap" label="Primary Line of Business"><input height="44" text="{profilePrimaryLineOfBusinessValue}" placeholder="Primary registered business activity" label="Primary Line of Business" on-input="profile_primary_line_of_business_input"/></use><if test="{profilePrimaryLineOfBusinessMissing}"><text wrap="true" foreground="warning">Enter the primary Line of Business before saving.</text></if><text wrap="true" foreground="text_muted">Manage additional business activities under Registration & Forms.</text></else></column></if><if test="{profilePersonalFieldsVisible}"><column gap="16"><column gap="4"><text><span weight="bold">Individual capabilities</span></text><text wrap="true" foreground="text_muted">Leave fields empty when they do not truthfully apply. Forms requiring a missing capability will reject this profile.</text></column><grid columns="{profileReadColumns}" gap="12"><use template="ap" label="Birth date"><input height="44" text="{profileBirthDateValue}" placeholder="YYYY-MM-DD" label="Birth date" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileBirthDateAutofocus}" on-input="profile_birth_date_input"/></use><use template="ap" label="Citizenship"><input height="44" text="{profileCitizenshipValue}" placeholder="Citizenship" label="Citizenship" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileCitizenshipAutofocus}" on-input="profile_citizenship_input"/></use></grid><use template="ap" label="Foreign tax number"><input height="44" text="{profileForeignTaxNumberValue}" placeholder="Optional foreign tax identifier" label="Foreign tax number" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileForeignTaxNumberAutofocus}" on-input="profile_foreign_tax_number_input"/></use></column></if><column gap="16"><column gap="4"><text><span weight="bold">When this applies</span></text><text wrap="true" foreground="text_muted">{profileEffectiveDateHelp}</text></column><if test="{profileChangeControlsVisible}"><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" selected="{profileRecordChangeSelected}" on-press="profile_record_change">Record a change</button><button height="44" variant="outline" selected="{profileFixMistakeSelected}" on-press="profile_fix_mistake">Fix a mistake</button></grid></if><use template="ap" label="{profileEffectiveDateLabel}"><input height="44" text="{profileEffectiveFromValue}" placeholder="YYYY-MM-DD" label="{profileEffectiveDateLabel}" on-input="profile_effective_from_input"/></use><text wrap="true" foreground="text_muted">{profileIdentityLockNote}</text><use template="ap" label="Applies until"><input height="44" text="{profileEffectiveUntilValue}" placeholder="YYYY-MM-DD or empty" label="Applies until" on-input="profile_effective_until_input"/></use></column></else></column></if><if test="{profileTaxFormsActive}"><column gap="16"><if test="{profileFormsHeaderStacked}"><column gap="10"><column gap="4"><text><span weight="bold">Registration & Forms</span></text><text wrap="true" foreground="text_muted">Choose which BIR forms apply to this taxpayer in each tax year.</text></column><use template="au"/></column></if><else><row gap="12" cross="center"><column grow="1" gap="4"><text><span weight="bold">Registration & Forms</span></text><text wrap="true" foreground="text_muted">Choose which BIR forms apply to this taxpayer in each tax year.</text></column><use template="au"/></row></else><if test="{editingNewProfile}"><card padding="0"><column padding="20" gap="6"><text><span weight="bold">Save this taxpayer first</span></text><text wrap="true" foreground="text_muted">Yearly forms belong to a saved taxpayer. Save this taxpayer, then return here to choose its forms.</text></column></card></if><else><if test="{regLoadFail}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">Registration unavailable</span></text><button height="44" variant="outline" on-press="reg_retry">Try again</button></column></card></if><if test="{regContent}"><card padding="0"><column padding="16" gap="14"><column gap="4"><text><span weight="bold">Registration</span></text><text wrap="true" foreground="text_muted">Reusable, effective-dated activities and tax obligations.</text></column><if test="{regEditing}"><column gap="8"><button height="44" variant="primary" disabled="{regSaveDisabled}" on-press="reg_save">Save Registration</button><button height="44" variant="outline" disabled="{regCancelDisabled}" on-press="reg_cancel">Cancel</button></column></if><else><if test="{regEditVisible}"><button height="44" variant="outline" on-press="reg_edit">Edit Registration</button></if></else><if test="{regErrVisible}"><text wrap="true" foreground="destructive">{regErrText}</text></if><if test="{regConflict}"><card padding="0"><column padding="12" gap="8"><text><span weight="bold">Newer revision saved</span></text><button height="44" variant="outline" on-press="reg_conflict_accept">Keep my draft</button><button height="44" variant="outline" on-press="reg_conflict_reload">Reload saved</button></column></card></if><if test="{regActVisible}"><column gap="8"><row gap="8" cross="center"><text grow="1"><span weight="bold">Activities</span></text><if test="{regEditing}"><button height="44" variant="outline" disabled="{regAddActDisabled}" on-press="reg_add_act">Add activity</button></if></row><if test="{regActEmpty}"><text foreground="text_muted">No activity recorded.</text></if><for each="regActRows" key="id" as="activity"><card padding="0"><column padding="12" gap="6"><text><span weight="bold">{activity.lineOfBusiness}</span></text><text foreground="text_muted">ATC: {activity.atcLabel} - {activity.effectiveLabel}</text><if test="{regEditing}"><row gap="8"><button height="44" variant="outline" on-press="reg_edit_act:{activity.id}">Edit</button><button height="44" variant="ghost" on-press="reg_remove_act:{activity.id}">Remove</button></row></if></column></card></for></column></if><if test="{regObVisible}"><column gap="8"><row gap="8" cross="center"><text grow="1"><span weight="bold">Tax obligations</span></text><if test="{regEditing}"><button height="44" variant="outline" disabled="{regAddObDisabled}" on-press="reg_add_ob">Add obligation</button></if></row><if test="{regObEmpty}"><text foreground="text_muted">None recorded.</text></if><for each="regObRows" key="id" as="obligation"><card padding="0"><column padding="12" gap="6"><text><span weight="bold">{obligation.kindLabel}</span></text><text foreground="text_muted">{obligation.effectiveLabel}</text><if test="{regEditing}"><row gap="8"><button height="44" variant="outline" on-press="reg_edit_ob:{obligation.id}">Edit</button><button height="44" variant="ghost" on-press="reg_remove_ob:{obligation.id}">Remove</button></row></if></column></card></for></column></if><if test="{regFactsVisible}"><column gap="8"><text><span weight="bold">Other confirmed registration facts</span></text><grid columns="{profileReadColumns}" gap="8"><for each="regFactRows" key="id" as="fact"><use template="aq" label="{fact.label}" value="{fact.value}"/></for></grid></column></if><if test="{regReview}"><text wrap="true" foreground="warning">{regReviewLabel}</text></if><if test="{regDialog}"><card padding="0"><column padding="14" gap="10"><text><span weight="bold">{regDialogTitle}</span></text><if test="{regActivityDialog}"><input height="44" text="{regLine}" placeholder="Line of business" label="Line of business" on-input="reg_line_input"/><input height="44" text="{regAtcValue}" placeholder="Optional ATC, for example PT010" label="Alphanumeric Tax Code" on-input="reg_atc_input"/></if><else><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" selected="{regIncome}" on-press="reg_kind_income_tax">Income tax</button><button height="44" variant="outline" selected="{regVat}" on-press="reg_kind_vat">VAT</button><button height="44" variant="outline" selected="{regPct}" on-press="reg_kind_percentage_tax">Percentage tax</button><button height="44" variant="outline" selected="{regWhComp}" on-press="reg_kind_wh_comp">Withholding - compensation</button><button height="44" variant="outline" selected="{regWhExpanded}" on-press="reg_kind_wh_expanded">Withholding - expanded</button><button height="44" variant="outline" selected="{regWhFinal}" on-press="reg_kind_wh_final">Withholding - final</button><button height="44" variant="outline" selected="{regWhOther}" on-press="reg_kind_wh_other">Other withholding</button></grid><if test="{regOtherVisible}"><input height="44" text="{regOtherValue}" placeholder="Registered withholding type" label="Other withholding type" on-input="reg_other_input"/></if></else><input height="44" text="{regFrom}" placeholder="YYYY-MM-DD" label="Effective from" on-input="reg_from_input"/><input height="44" text="{regUntil}" placeholder="Optional YYYY-MM-DD" label="Effective until" on-input="reg_until_input"/><row gap="8"><button height="44" variant="outline" on-press="reg_dialog_cancel">Cancel</button><button height="44" variant="primary" on-press="reg_dialog_save">Apply</button></row></column></card></if></column></card></if><use template="aw"/><if test="{profileCorReviewOpen}"><use template="ax"/></if><if test="{profileSetupPendingSwitchVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">{profileSetupPendingSwitchTitle}</span></text><text wrap="true" foreground="text_muted">{profileSetupPendingSwitchBody}</text><row gap="8"><button height="44" variant="primary" autofocus="true" on-press="profile_setup_cancel_year_switch">Keep editing</button><button height="44" variant="outline" on-press="profile_setup_confirm_year_switch">Discard changes</button></row></column></card></if><if test="{profileSetupOpenFailedVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">{profileSetupStatusLabel}</span></text><row><button height="44" variant="outline" on-press="profile_setup_retry_year">Try again</button></row></column></card></if><else><text wrap="true" foreground="text_muted">{profileSetupStatusLabel}</text></else><if test="{profileSetupConflictVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">{profileSetupConflictTitle}</span></text><text wrap="true" foreground="text_muted">Your choices are still here. Review the saved setup, then keep or change it.</text><row gap="8"><button height="44" variant="primary" on-press="profile_setup_conflict_review">{profileSetupConflictReviewLabel}</button><button height="44" variant="outline" on-press="profile_setup_conflict_discard">Discard my draft</button></row></column></card></if><if test="{profileSetupDraftBannerVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">{profileSetupDraftTitle}</span></text><if test="{profileSetupDraftChoiceVisible}"><column gap="8"><text wrap="true" foreground="text_muted">Start from scratch, or copy the forms you already set up for another year.</text><if test="{profileFormsHeaderStacked}"><column gap="8"><button height="44" variant="outline" on-press="profile_setup_draft_empty">Start empty</button><if test="{profileSetupSeedAvailable}"><button height="44" variant="primary" on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button></if></column></if><else><row gap="8"><button height="44" variant="outline" on-press="profile_setup_draft_empty">Start empty</button><if test="{profileSetupSeedAvailable}"><button height="44" variant="primary" on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button></if></row></else></column></if><if test="{profileSetupSeededVisible}"><column gap="8"><text><span weight="bold">{profileSetupSourceLabel}</span></text><text wrap="true" foreground="text_muted">{profileSetupSourceSummary}</text><use template="av"/></column></if><text wrap="true" foreground="text_muted">{profileSetupInheritanceNote}</text><text wrap="true" foreground="text_muted">Filings, drafts, payments, deadlines, COR files, and email settings never copy between years.</text></column></card></if><if test="{profileSetupBrowseVisible}"><column gap="16"><row main="end"><button height="44" variant="outline" icon="settings" on-press="profile_forms_manage">Manage Forms</button></row><use template="ao"/></column></if><if test="{profileSetupManagerVisible}"><if test="{profileSetupScopeVisible}"><column gap="10"><text><span weight="bold">When does this apply?</span></text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button><button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button></column></if><else><row gap="8"><button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button><button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button></row></else><if test="{profileSetupScopeDateVisible}"><use template="ap" label="Change takes effect"><input height="44" text="{profileSetupChangeDateValue}" placeholder="YYYY-MM-DD" label="Change takes effect" on-input="profile_setup_change_date_input"/></use><text wrap="true" foreground="text_muted">Records that this year's forms changed on that date. Deadlines and the tax calendar still follow the year's saved setup.</text></if></column></if><if test="{profileSetupZeroFormsHelperVisible}"><text wrap="true" foreground="text_muted">{profileSetupZeroFormsHelperText}</text></if><if test="{profileSetupDeactivationWarningVisible}"><card padding="0"><column padding="12" gap="6"><text><span weight="bold">Confirm deactivation on Save</span></text><text wrap="true" foreground="text_muted">{profileSetupDeactivationWarningText}</text></column></card></if><if test="{profileFormsHeaderStacked}"><column gap="10"><button height="44" variant="primary" icon="save" disabled="{profileSetupPrimaryDisabled}" on-press="profile_setup_save">{profileSetupPrimaryLabel}</button><button height="44" variant="outline" disabled="{profileFormsCancelDisabled}" on-press="profile_forms_cancel">Cancel</button></column></if><else><row main="end" gap="12"><button height="44" variant="outline" disabled="{profileFormsCancelDisabled}" on-press="profile_forms_cancel">Cancel</button><button height="44" variant="primary" icon="save" disabled="{profileSetupPrimaryDisabled}" on-press="profile_setup_save">{profileSetupPrimaryLabel}</button></row></else><if test="{profileSetupChangesVisible}"><column gap="8"><row><button height="44" variant="ghost" icon="chevron-right" on-press="profile_setup_toggle_changes_disclosure">{profileSetupChangesDisclosureLabel}</button></row><if test="{profileSetupChangesExpandedVisible}"><column gap="8"><for each="profileSetupChangeRows" key="id" as="change"><card padding="0"><row padding="12" gap="12" cross="center"><column grow="1" gap="2"><text><span weight="bold">{change.rangeLabel}</span></text><text foreground="text_muted">{change.formsLabel}</text></column><if test="{change.todayBadgeVisible}"><badge variant="secondary">Covers today</badge></if></row></card></for><text wrap="true" foreground="text_muted">Recorded for reference. Deadlines and the calendar keep following the year's saved setup.</text></column></if></column></if><use template="ao"/></if><if test="{profileSetupYearsDisclosureVisible}"><column gap="8"><row><button height="44" variant="ghost" icon="chevron-right" on-press="profile_setup_toggle_years_disclosure">{profileSetupYearsDisclosureLabel}</button></row><if test="{profileSetupYearsExpandedVisible}"><column gap="8"><for each="profileFormSetRows" key="id" as="set"><card padding="0"><row padding="12" gap="12" cross="center"><text width="60" text-alignment="center"><span weight="bold">{set.yearLabel}</span></text><column width="1" height="36" background="border"></column><column grow="1" gap="2"><text foreground="text_muted">{set.formsLabel}</text></column><badge variant="secondary">{set.stateLabel}</badge><button height="44" variant="outline" on-press="profile_setup_select_year:{set.tax_year}">Open</button></row></card></for></column></if></column></if></else></column></if><if test="{profileEmailActive}"><column gap="12"><text><span weight="bold">Email monitoring credentials</span></text><text wrap="true" foreground="text_muted">Mailbox credentials are operational secrets, not reusable tax facts. They are not stored in the tax-profile revision tables.</text><button height="44" variant="outline" icon="send" disabled="true">Configure secure mailbox connection</button></column></if><if test="{profileEditorActionsVisible}"><grid columns="{profileReadColumns}" gap="10"><button height="44" variant="outline" disabled="{profileCancelDisabled}" on-press="cancel_profile_edit">Cancel changes</button><button height="44" variant="primary" icon="save" disabled="{profileSaveDisabled}" on-press="save_profile">{profileSaveLabel}</button></grid></if></column></template><template name="az"><scroll grow="1" global-key="page-profile-setup" label="Taxpayer profile setup content"><if test="{phoneLayout}"><column padding="16"><use template="ay"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="ay"/></column></if><else><column padding="32"><use template="ay"/></column></else></else></scroll></template><template name="ba" args="label value"><column gap="4"><text size="sm" foreground="text_muted">{label}</text><text wrap="true">{value}</text></column></template><template name="bb"><column><if test="{constrainedLayout}"><column gap="8"><radio height="44" checked="{taxpayerYearGraduatedSelected}" text="Graduated income tax rates" on-toggle="taxpayer_year_rate_graduated"/><radio height="44" checked="{taxpayerYearEightPercentSelected}" text="8% income tax rate" on-toggle="taxpayer_year_rate_eight_percent"/></column></if><else><row gap="16"><radio height="44" checked="{taxpayerYearGraduatedSelected}" text="Graduated income tax rates" on-toggle="taxpayer_year_rate_graduated"/><radio height="44" checked="{taxpayerYearEightPercentSelected}" text="8% income tax rate" on-toggle="taxpayer_year_rate_eight_percent"/></row></else></column></template><template name="bc"><column><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" selected="{taxpayerYearItemizedSelected}" on-press="taxpayer_year_deduction_itemized">Itemized</button><button height="44" variant="outline" selected="{taxpayerYearOsdSelected}" on-press="taxpayer_year_deduction_osd">OSD</button></column></if><else><row gap="8"><button height="44" variant="outline" selected="{taxpayerYearItemizedSelected}" on-press="taxpayer_year_deduction_itemized">Itemized</button><button height="44" variant="outline" selected="{taxpayerYearOsdSelected}" on-press="taxpayer_year_deduction_osd">OSD</button></row></else></column></template><template name="bd"><column><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" disabled="{taxpayerYearCancelDisabled}" on-press="taxpayer_year_cancel">Cancel</button><button height="44" variant="primary" disabled="{taxpayerYearSaveDisabled}" on-press="taxpayer_year_save">Save income tax rate</button></column></if><else><row gap="8" main="end"><button height="44" variant="outline" disabled="{taxpayerYearCancelDisabled}" on-press="taxpayer_year_cancel">Cancel</button><button height="44" variant="primary" disabled="{taxpayerYearSaveDisabled}" on-press="taxpayer_year_save">Save income tax rate</button></row></else></column></template><template name="be"><column><if test="{constrainedLayout}"><column gap="10"><if test="{taxFormProfileEditTaxProfileVisible}"><button height="44" variant="outline" on-press="tax_form_profile_edit_tax_profile">Edit Tax Profile</button></if><if test="{taxFormProfileEditing}"><column gap="10"><button height="44" variant="outline" disabled="{taxFormProfileCancelDisabled}" on-press="cancel_tax_form_profile">Cancel</button><button height="44" variant="primary" disabled="{taxFormProfileSaveDisabled}" on-press="save_tax_form_profile">Save Tax Form Profile</button></column></if><else><if test="{taxFormProfileEditVisible}"><button height="44" variant="primary" on-press="edit_tax_form_profile">Edit Tax Form Profile</button></if></else></column></if><else><row gap="10" main="end"><if test="{taxFormProfileEditTaxProfileVisible}"><button height="44" variant="outline" on-press="tax_form_profile_edit_tax_profile">Edit Tax Profile</button></if><if test="{taxFormProfileEditing}"><row gap="10"><button height="44" variant="outline" disabled="{taxFormProfileCancelDisabled}" on-press="cancel_tax_form_profile">Cancel</button><button height="44" variant="primary" disabled="{taxFormProfileSaveDisabled}" on-press="save_tax_form_profile">Save Tax Form Profile</button></row></if><else><if test="{taxFormProfileEditVisible}"><button height="44" variant="primary" on-press="edit_tax_form_profile">Edit Tax Form Profile</button></if></else></row></else></column></template><template name="bf"><column padding="20" gap="14"><text><span weight="bold" scale="1.25">Discard unsaved changes?</span></text><text wrap="true" foreground="text_muted">Leaving restores the saved Tax Form Profile.</text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" on-press="tax_form_profile_keep_editing">Keep editing</button><button height="44" variant="destructive" on-press="tax_form_profile_discard_navigation">Discard</button></column></if><else><row gap="8" main="end"><button height="44" variant="outline" on-press="tax_form_profile_keep_editing">Keep editing</button><button height="44" variant="destructive" on-press="tax_form_profile_discard_navigation">Discard</button></row></else></column></template><template name="bg"><stack grow="1"><scroll grow="1" label="Tax Form Profile"><column padding="24" gap="16"><row gap="12" cross="start"><button width="44" height="44" size="icon" variant="ghost" icon="chevron-left" label="{taxFormProfileBackLabel}" on-press="close_tax_form_profile"></button><column grow="1" gap="5"><row gap="8" cross="center"><badge variant="secondary">{taxFormProfileCode}</badge><badge variant="{taxFormProfileStatusTone}">{taxFormProfileStatusLabel}</badge></row><text><span weight="bold" scale="1.5">{taxFormProfileCode} Tax Form Profile — {taxFormProfileYear}</span></text><text wrap="true">{taxFormProfileTitle}</text><text foreground="text_muted">Form revision {taxFormProfileRevision}</text><text wrap="true" foreground="text_muted">{taxFormProfileActivationLabel}</text></column></row><if test="{taxFormProfileMissingInheritedVisible}"><card padding="0" background="surface_subtle"><column padding="14" gap="10"><text><span weight="bold">{taxFormProfileMissingInheritedTitle}</span></text><text wrap="true" foreground="text_muted">{taxFormProfileMissingInheritedSummary}</text><for each="taxFormProfileMissingInheritedRows" key="id" as="fact"><row gap="8" cross="center"><text grow="1" wrap="true">{fact.label}</text><badge variant="destructive">Required</badge></row></for><button height="44" variant="outline" on-press="tax_form_profile_edit_tax_profile">Edit Tax Profile</button></column></card></if><if test="{taxFormProfileRegistrationRepairVisible}"><card padding="0" background="surface_subtle"><row padding="14" gap="10" cross="center"><text grow="1"><span weight="bold">{taxFormProfileRegistrationRepairTitle}</span></text><button height="44" variant="outline" on-press="tax_form_profile_edit_registration">{taxFormProfileRegistrationRepairAction}</button></row></card></if><if test="{taxFormProfileSegmentNavigationVisible}"><row gap="8"><button grow="1" height="44" variant="outline" disabled="{taxFormProfilePreviousSegmentDisabled}" on-press="tax_form_profile_previous_segment">Previous interval</button><button grow="1" height="44" variant="outline" disabled="{taxFormProfileNextSegmentDisabled}" on-press="tax_form_profile_next_segment">Next interval</button></row></if><if test="{taxFormProfileFilingContextVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">Filing context</span></text><grid columns="{profileReadColumns}" gap="12"><use template="ba" label="Quarter" value="{taxFormProfileQuarterLabel}"/><use template="ba" label="Taxable period" value="{taxFormProfileTaxablePeriodLabel}"/></grid></column></card></if><card padding="0"><column padding="16" gap="12"><column gap="4"><text><span weight="bold">Inherited Tax Profile details</span></text></column><grid columns="{profileReadColumns}" gap="12"><for each="taxFormProfileInheritedRows" key="id" as="fact"><use template="ba" label="{fact.label}" value="{fact.value}"/></for></grid></column></card><if test="{taxFormProfileConflictVisible}"><card padding="0"><column padding="16" gap="10"><text><span weight="bold">A newer revision was saved</span></text><text wrap="true" foreground="text_muted">Your draft is preserved. Review the latest stream sequence, or reload this interval and discard the draft.</text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="primary" disabled="{taxFormProfileConflictKeepDraftDisabled}" on-press="tax_form_profile_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxFormProfileConflictReloadDisabled}" on-press="tax_form_profile_reload_after_conflict">Reload this interval</button></column></if><else><row gap="8"><button height="44" variant="primary" disabled="{taxFormProfileConflictKeepDraftDisabled}" on-press="tax_form_profile_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxFormProfileConflictReloadDisabled}" on-press="tax_form_profile_reload_after_conflict">Reload this interval</button></row></else></column></card></if><if test="{taxpayerYearSettingsVisible}"><card padding="0"><column padding="16" gap="10"><row gap="8" cross="center"><text grow="1"><span weight="bold">Income tax rate for {taxFormProfileYear}</span></text><badge variant="{taxpayerYearStatusTone}">{taxpayerYearStatus}</badge></row><grid columns="{profileReadColumns}" gap="12"><use template="ba" label="Eligibility" value="{taxpayerYearEligibilityLabel}"/><use template="ba" label="Initial applicable quarter" value="{taxpayerYearInitialQuarterLabel}"/><use template="ba" label="Source" value="{taxpayerYearSourceLabel}"/><use template="ba" label="Lock state" value="{taxpayerYearLockStateLabel}"/></grid><if test="{taxpayerYearBlockNoticeVisible}"><card padding="0" background="surface_subtle"><column padding="12"><text wrap="true" foreground="destructive">{taxpayerYearBlockNotice}</text></column></card></if><if test="{taxpayerYearConflictVisible}"><card padding="0"><column padding="12" gap="8"><text><span weight="bold">A newer annual tax choice was saved</span></text><text wrap="true" foreground="text_muted">Your draft is preserved. Keep it after reviewing the latest saved choice, or reload the saved choice and discard this draft.</text><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="primary" disabled="{taxpayerYearConflictKeepDraftDisabled}" on-press="taxpayer_year_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxpayerYearConflictReloadDisabled}" on-press="taxpayer_year_reload_after_conflict">Reload saved choice</button></column></if><else><row gap="8"><button height="44" variant="primary" disabled="{taxpayerYearConflictKeepDraftDisabled}" on-press="taxpayer_year_keep_draft_after_conflict">Keep my draft</button><button height="44" variant="outline" disabled="{taxpayerYearConflictReloadDisabled}" on-press="taxpayer_year_reload_after_conflict">Reload saved choice</button></row></else></column></card></if><if test="{taxpayerYearEditing}"><column gap="8"><text wrap="true">What income tax rates are you availing?</text><use template="bb"/></column><if test="{taxpayerYearDeductionVisible}"><column gap="8"><text>Deduction method</text><use template="bc"/></column></if><if test="{taxpayerYearReviewVisible}"><button height="44" variant="outline" on-press="taxpayer_year_acknowledge_review">Mark reviewed</button></if><use template="bd"/></if><else><if test="{constrainedLayout}"><column gap="8"><text wrap="true">{taxpayerYearRateLabel}</text><if test="{taxpayerYearCopyPriorYearVisible}"><button height="44" variant="outline" on-press="taxpayer_year_copy_prior_year">{taxpayerYearCopyPriorYearLabel}</button></if><if test="{taxpayerYearEditVisible}"><button height="44" variant="outline" on-press="taxpayer_year_edit">Edit income tax rate</button></if></column></if><else><row gap="8" cross="center"><text grow="1" wrap="true">{taxpayerYearRateLabel}</text><if test="{taxpayerYearCopyPriorYearVisible}"><button height="44" variant="outline" on-press="taxpayer_year_copy_prior_year">{taxpayerYearCopyPriorYearLabel}</button></if><if test="{taxpayerYearEditVisible}"><button height="44" variant="outline" on-press="taxpayer_year_edit">Edit income tax rate</button></if></row></else></else></column></card></if><if test="{taxFormProfileSetupVisible}"><column gap="10"><text><span weight="bold">Form-specific details</span></text><for each="taxFormProfileFieldRows" key="id" as="field"><card padding="0"><column padding="14" gap="8"><row gap="8" cross="center"><text grow="1"><span weight="bold">{field.label}</span></text><badge variant="secondary">{field.requiredLabel}</badge></row><text wrap="true">{field.value}</text><text wrap="true" foreground="text_muted">{field.helper}</text><if test="{field.editable}"><if test="{constrainedLayout}"><column gap="8"><button height="44" variant="outline" on-press="tax_form_profile_toggle_picker:{field.id}">{field.pickerLabel}</button><if test="{field.hasValue}"><button height="44" variant="ghost" on-press="tax_form_profile_clear_value:{field.id}">Clear</button></if></column></if><else><row gap="8"><button grow="1" height="44" variant="outline" on-press="tax_form_profile_toggle_picker:{field.id}">{field.pickerLabel}</button><if test="{field.hasValue}"><button height="44" variant="ghost" on-press="tax_form_profile_clear_value:{field.id}">Clear</button></if></row></else><if test="{field.pickerOpen}"><card padding="0"><column padding="8" gap="4"><if test="{taxFormProfileChoicesEmpty}"><column gap="8"><text wrap="true" foreground="text_muted">No eligible saved values.</text><if test="{taxFormProfileChoicesRegistrationRepairVisible}"><button height="44" variant="outline" on-press="tax_form_profile_edit_registration">Add or edit Registration</button></if></column></if><else><for each="taxFormProfileChoiceRows" key="id" as="choice"><button height="44" variant="ghost" selected="{choice.selected}" on-press="tax_form_profile_select_choice:{choice.id}">{choice.label}</button></for></else></column></card></if></if></column></card></for></column></if><if test="{taxFormProfileReviewVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="14" gap="10"><text wrap="true">{taxFormProfileReviewText}</text><button height="44" variant="outline" on-press="tax_form_profile_acknowledge_review">Mark reviewed</button></column></if><else><row padding="14" gap="10" cross="center"><text grow="1" wrap="true">{taxFormProfileReviewText}</text><button height="44" variant="outline" on-press="tax_form_profile_acknowledge_review">Mark reviewed</button></row></else></card></if><if test="{taxFormProfileCopyPriorYearVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="14" gap="10"><text wrap="true" foreground="text_muted">Reuse is never automatic. The prior setup opens as an unsaved draft and must be reviewed before Save.</text><button height="44" variant="outline" on-press="tax_form_profile_copy_prior_year">{taxFormProfileCopyPriorYearLabel}</button></column></if><else><row padding="14" gap="10" cross="center"><text grow="1" wrap="true" foreground="text_muted">Reuse is never automatic. The prior setup opens as an unsaved draft and must be reviewed before Save.</text><button height="44" variant="outline" on-press="tax_form_profile_copy_prior_year">{taxFormProfileCopyPriorYearLabel}</button></row></else></card></if><if test="{taxFormProfileReactivationReuseVisible}"><card padding="0"><if test="{constrainedLayout}"><column padding="14" gap="10"><text wrap="true" foreground="text_muted">Another active interval has compatible setup. Review it before saving it for this interval.</text><button height="44" variant="outline" on-press="tax_form_profile_reuse_after_reactivation">{taxFormProfileReactivationReuseLabel}</button></column></if><else><row padding="14" gap="10" cross="center"><text grow="1" wrap="true" foreground="text_muted">Another active interval has compatible setup. Review it before saving it for this interval.</text><button height="44" variant="outline" on-press="tax_form_profile_reuse_after_reactivation">{taxFormProfileReactivationReuseLabel}</button></row></else></card></if><if test="{taxFormProfileHistoryVisible}"><card padding="0"><column padding="16" gap="10"><column gap="4"><text><span weight="bold">Tax Form Profile history</span></text><text wrap="true" foreground="text_muted">Saved annual revisions remain visible after deactivation and are never overwritten.</text></column><for each="taxFormProfileHistoryRows" key="id" as="revision"><card padding="0"><column padding="12" gap="4"><row gap="8" cross="center"><text grow="1"><span weight="bold">Revision {revision.sequence}</span></text><if test="{revision.currentVisible}"><badge variant="secondary">Current view</badge></if></row><text foreground="text_muted">{revision.effectiveLabel}</text><text wrap="true" foreground="text_muted">{revision.sourceLabel}</text></column></card></for><if test="{taxFormProfileHistoryTruncatedVisible}"><text wrap="true" foreground="text_muted">Showing the 24 most recent revisions.</text></if></column></card></if><use template="be"/></column></scroll><if test="{taxFormProfileDiscardPromptOpen}"><column grow="1" padding="16" main="center" cross="center"><if test="{phoneLayout}"><dialog width="288" on-dismiss="tax_form_profile_keep_editing"><use template="bf"/></dialog></if><else><if test="{constrainedLayout}"><dialog width="400" on-dismiss="tax_form_profile_keep_editing"><use template="bf"/></dialog></if><else><dialog width="480" on-dismiss="tax_form_profile_keep_editing"><use template="bf"/></dialog></else></else></column></if></stack></template><template name="bh"><scroll grow="1" global-key="page-taxpayer-dashboard" label="Taxpayer dashboard content"><column padding="{taxpayerDashboardPagePadding}" gap="24"><if test="{constrainedLayout}"><row gap="12" cross="center"><avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar><column grow="1" gap="5"><text size="heading" wrap="true">{selectedTaxpayerName}</text><text wrap="true" foreground="text_muted">TIN: {selectedTaxpayerTin}</text><text wrap="true" foreground="text_muted">Type: {selectedTaxpayerKind} - Tax Year {currentCalendarYear} - {selectedTaxpayerTaxType}</text></column></row></if><else><row gap="16" cross="center"><avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar><column grow="1" gap="6"><text size="heading">{selectedTaxpayerName}</text><text wrap="true" foreground="text_muted">{selectedTaxpayerSummary}</text></column></row></else><if test="{constrainedLayout}"><tabs gap="4" label="Dashboard view"><button height="44" variant="ghost" selected="{dashboardCalendarActive}" on-press="show_dashboard_calendar">Calendar</button><button height="44" variant="ghost" selected="{dashboardFormsActive}" on-press="show_dashboard_forms">Forms</button><button height="44" variant="ghost" selected="{dashboardProfileSettingsActive}" on-press="show_dashboard_profile_settings">Profile</button></tabs></if><else><tabs gap="4" label="Dashboard view"><button variant="ghost" icon="app:calendar" selected="{dashboardCalendarActive}" on-press="show_dashboard_calendar">Calendar</button><button variant="ghost" icon="folder-open" selected="{dashboardFormsActive}" on-press="show_dashboard_forms">Tax Form Library</button><button variant="ghost" icon="settings" selected="{dashboardProfileSettingsActive}" on-press="show_dashboard_profile_settings">Profile Settings</button></tabs></else><if test="{dashboardCalendarActive}"><use template="aj"/></if><if test="{dashboardFormsActive}"><use template="ao"/></if><if test="{dashboardProfileSettingsActive}"><use template="ay"/></if></column></scroll></template><template name="bi"><column gap="24"><column gap="6"><text size="heading">Import Data</text><text wrap="true" foreground="text_muted">Import a profile or database backup from a .zip file.</text></column><card><column padding="24" gap="20"><if test="{constrainedLayout}"><column gap="14"><row gap="14" cross="center"><icon name="download" foreground="accent" width="36" height="36"/><column grow="1" gap="5"><text><span weight="bold">Smart Import</span></text><text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text></column></row><row cross="center"><badge variant="secondary">Recommended</badge></row></column></if><else><row gap="16" cross="center"><icon name="download" foreground="accent" width="36" height="36"/><column grow="1" gap="5"><text><span weight="bold">Smart Import</span></text><text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text></column><badge variant="secondary">Recommended</badge></row></else><separator/><text wrap="true">Smart Import inspects the selected .zip file and determines whether it contains a taxpayer profile or a complete database backup.</text><card><column padding="24" gap="14" cross="center"><icon name="archive" foreground="text_muted" width="42" height="42"/><text text-alignment="center"><span weight="bold">Choose an eBIRForms archive</span></text><text foreground="text_muted">Supported file type: .zip</text><button variant="primary" icon="folder-open" disabled="true">Smart Import</button></column></card><row gap="12" cross="start"><icon name="info" foreground="info" width="20" height="20"/><column grow="1" gap="5"><text><span weight="bold">Before importing</span></text><text wrap="true" foreground="text_muted">Keep a current backup of your existing profiles. Imported data should come from a trusted eBIRForms export.</text></column></row></column></card><card><column padding="20" gap="12"><text><span weight="bold">What Smart Import can recognize</span></text><row gap="12" cross="start"><icon name="check-circle" foreground="success" width="18" height="18"/><text wrap="true" grow="1">Single taxpayer profile exports</text></row><row gap="12" cross="start"><icon name="check-circle" foreground="success" width="18" height="18"/><text wrap="true" grow="1">Full database backup archives</text></row><row gap="12" cross="start"><icon name="check-circle" foreground="success" width="18" height="18"/><text wrap="true" grow="1">Compatible static form and calendar data</text></row></column></card></column></template><template name="bj"><scroll grow="1" global-key="page-import-data" label="Import data content"><if test="{phoneLayout}"><column padding="16"><use template="bi"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="bi"/></column></if><else><column padding="32"><use template="bi"/></column></else></else></scroll></template><template name="bk" args="title description source cadence next_run"><card><column padding="20" gap="14"><if test="{constrainedLayout}"><column gap="12"><row gap="12" cross="start"><icon name="clock" foreground="warning" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{description}</text></column></row><row cross="center"><badge variant="secondary">Queued</badge></row></column></if><else><row gap="12" cross="center"><icon name="clock" foreground="warning" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{description}</text></column><badge variant="secondary">Queued</badge></row></else><separator/><if test="{constrainedLayout}"><column gap="14"><column gap="5"><text foreground="text_muted">Source</text><text>{source}</text></column><column gap="5"><text foreground="text_muted">Schedule</text><text>{cadence}</text></column><column gap="5"><text foreground="text_muted">Next run</text><text>{next_run}</text></column></column></if><else><row gap="24" cross="start"><column grow="1" gap="5"><text foreground="text_muted">Source</text><text>{source}</text></column><column grow="1" gap="5"><text foreground="text_muted">Schedule</text><text>{cadence}</text></column><column grow="1" gap="5"><text foreground="text_muted">Next run</text><text>{next_run}</text></column></row></else><text wrap="true" foreground="text_muted">Status: Queued - Retries: 0</text><if test="{constrainedLayout}"><column gap="8"><button size="sm" variant="ghost" icon="eye" on-press="show_aux_background_task_debug_log">View Job</button><button size="sm" variant="outline" icon="play" disabled="true">Run Now</button><button size="sm" variant="outline" icon="archive" disabled="true">Archive</button><button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button></column></if><else><row main="end" gap="8"><button size="sm" variant="ghost" icon="eye" on-press="show_aux_background_task_debug_log">View Job</button><button size="sm" variant="outline" icon="play" disabled="true">Run Now</button><button size="sm" variant="outline" icon="archive" disabled="true">Archive</button><button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button></row></else></column></card></template><template name="bl"><column gap="24"><card><column padding="16" gap="12"><if test="{constrainedLayout}"><column gap="10"><select text="Queued" label="Job status"/><search-field placeholder="Search jobs" label="Search background jobs"/><select text="Archive Days: 30" label="Archive retention"/><button variant="outline" icon="archive" disabled="true">Purge Archives</button></column></if><else><row gap="12" cross="center"><select text="Queued" label="Job status"/><search-field grow="1" placeholder="Search jobs" label="Search background jobs"/><select text="Archive Days: 30" label="Archive retention"/><button variant="outline" icon="archive" disabled="true">Purge Archives</button></row></else><row gap="8" cross="center"><badge variant="secondary">1 queued</badge><text wrap="true" foreground="text_muted">Last checked moments ago</text></row></column></card><use template="bk" title="Waiting for 2551Q confirmation email" description="Checks demo@example.com for the filing confirmation message." source="System" cadence="Every minute" next_run="Past due"/></column></template><template name="bm"><card><column padding="20" gap="14"><row gap="10" cross="center"><icon name="terminal" foreground="accent" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">Recent task logs</span></text><text wrap="true" foreground="text_muted">Static diagnostic entries from the desktop application.</text></column></row><separator/><button variant="ghost" icon="eye" on-press="show_aux_background_task_debug_log">Open Poll eFPS Email Confirmations Log</button><text wrap="true" foreground="text_muted">No other task logs are available in this static build.</text></column></card></template><template name="bn"><column gap="24"><column gap="6"><text size="heading">Background Tasks</text><text wrap="true" foreground="text_muted">Monitor scheduled jobs, email checks, and maintenance activity.</text></column><if test="{constrainedLayout}"><column gap="4" label="Background task sections"><button variant="ghost" selected="{backgroundJobsActive}" on-press="show_background_jobs">Jobs</button><button variant="ghost" selected="{backgroundLogsActive}" on-press="show_background_logs">Logs</button></column></if><else><tabs gap="4" label="Background task sections"><button variant="ghost" selected="{backgroundJobsActive}" on-press="show_background_jobs">Jobs</button><button variant="ghost" selected="{backgroundLogsActive}" on-press="show_background_logs">Logs</button></tabs></else><if test="{backgroundJobsActive}"><use template="bl"/></if><if test="{backgroundLogsActive}"><use template="bm"/></if><card><column padding="18" gap="10"><row gap="10" cross="center"><icon name="info" foreground="info" width="20" height="20"/><text><span weight="bold">Prototype task monitor</span></text></row><text wrap="true" foreground="text_muted">Job controls are presented to match the desktop application. This static milestone does not execute or modify background work.</text></column></card></column></template><template name="bo"><scroll grow="1" global-key="page-background-tasks" label="Background tasks content"><if test="{phoneLayout}"><column padding="16"><use template="bn"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="bn"/></column></if><else><column padding="32"><use template="bn"/></column></else></else></scroll></template><template name="bp"><column gap="12"><column gap="4"><text><span weight="bold">Compiled Calendar Rules</span></text><text wrap="true" foreground="text_muted">Shared form-deadline rules derived from the reference eBIRForms subsystem and checked against current BIR guidance. Event-based forms stay separate from dated deadlines.</text></column><for each="calendarRules" key="id" as="rule"><card><column padding="20" gap="10"><row gap="8" cross="center"><badge variant="secondary">{rule.frequency}</badge><text><span weight="bold">{rule.form_name}</span></text></row><text wrap="true" foreground="text_muted">Forms: {rule.form_codes}</text><text wrap="true">{rule.description}</text></column></card></for><card><column padding="20" gap="8"><text><span weight="bold">Source boundary</span></text><text wrap="true" foreground="text_muted">This view is a calendar-year / non-eFPS baseline and includes mutually exclusive or conditional form alternatives. Current BIR issuances, the taxpayer's registered Forms Set, eFPS filer group, fiscal-year facts, and official holiday proclamations remain authoritative.</text></column></card></column></template><template name="bq"><card><column padding="20" gap="14"><text><span weight="bold">{overrideEditorTitle}</span></text><text wrap="true" foreground="text_muted">Source and at least one recognized canonical form are required. Separate multiple values with commas.</text><input text="{overrideTitleValue}" placeholder="Extension title" label="Override title" on-input="calendar_override_title_input"/><input text="{overrideFormsValue}" placeholder="1701Q, 1702Q" label="Affected form codes" on-input="calendar_override_forms_input"/><if test="{constrainedLayout}"><column gap="10"><input text="{overrideOriginalValue}" placeholder="YYYY-MM-DD" label="Original or operative deadline" on-input="calendar_override_original_input"/><input text="{overrideAdjustedValue}" placeholder="YYYY-MM-DD" label="Adjusted deadline" on-input="calendar_override_adjusted_input"/></column></if><else><row gap="10"><input grow="1" text="{overrideOriginalValue}" placeholder="YYYY-MM-DD" label="Original or operative deadline" on-input="calendar_override_original_input"/><input grow="1" text="{overrideAdjustedValue}" placeholder="YYYY-MM-DD" label="Adjusted deadline" on-input="calendar_override_adjusted_input"/></row></else><input text="{overrideSourceValue}" placeholder="RMC / RR / advisory reference" label="Official source reference" on-input="calendar_override_source_input"/><if test="{constrainedLayout}"><column gap="10"><input text="{overrideRegionsValue}" placeholder="Optional RDO codes, e.g. 040; 041" label="Affected RDO codes" on-input="calendar_override_regions_input"/><input text="{overrideTaxpayerTypesValue}" placeholder="Optional, e.g. individual" label="Taxpayer types" on-input="calendar_override_taxpayer_types_input"/></column></if><else><row gap="10"><input grow="1" text="{overrideRegionsValue}" placeholder="Optional RDO codes, e.g. 040; 041" label="Affected RDO codes" on-input="calendar_override_regions_input"/><input grow="1" text="{overrideTaxpayerTypesValue}" placeholder="Optional, e.g. individual" label="Taxpayer types" on-input="calendar_override_taxpayer_types_input"/></row></else><if test="{constrainedLayout}"><column gap="10"><input text="{overrideEffectiveFromValue}" placeholder="Optional YYYY-MM-DD" label="Effective from" on-input="calendar_override_effective_from_input"/><input text="{overrideEffectiveUntilValue}" placeholder="Optional YYYY-MM-DD" label="Effective until" on-input="calendar_override_effective_until_input"/><input text="{overrideExpiresAtValue}" placeholder="Optional YYYY-MM-DD" label="Expires at" on-input="calendar_override_expires_at_input"/></column></if><else><row gap="10"><input grow="1" text="{overrideEffectiveFromValue}" placeholder="Optional YYYY-MM-DD" label="Effective from" on-input="calendar_override_effective_from_input"/><input grow="1" text="{overrideEffectiveUntilValue}" placeholder="Optional YYYY-MM-DD" label="Effective until" on-input="calendar_override_effective_until_input"/><input grow="1" text="{overrideExpiresAtValue}" placeholder="Optional YYYY-MM-DD" label="Expires at" on-input="calendar_override_expires_at_input"/></row></else><row gap="10"><button variant="primary" icon="check" on-press="calendar_save_override">{overrideSaveLabel}</button><button variant="outline" on-press="calendar_cancel_override">Clear</button></row></column></card></template><template name="br"><card><column padding="20" gap="14"><text><span weight="bold">{nonWorkingDayEditorTitle}</span></text><text wrap="true" foreground="text_muted">Kind must be regular, local, special, or closure. Entries without an RDO scope adjust the global explorer; scoped entries apply only to matching tax-profile dashboards and calendar handoffs.</text><if test="{constrainedLayout}"><column gap="10"><input text="{nonWorkingDateValue}" placeholder="YYYY-MM-DD" label="Date" on-input="calendar_non_working_date_input"/><input text="{nonWorkingKindValue}" placeholder="regular" label="Kind" on-input="calendar_non_working_kind_input"/></column></if><else><row gap="10"><input grow="1" text="{nonWorkingDateValue}" placeholder="YYYY-MM-DD" label="Date" on-input="calendar_non_working_date_input"/><input grow="1" text="{nonWorkingKindValue}" placeholder="regular" label="Kind" on-input="calendar_non_working_kind_input"/></row></else><input text="{nonWorkingNameValue}" placeholder="Official holiday or closure name" label="Name" on-input="calendar_non_working_name_input"/><input text="{nonWorkingSourceValue}" placeholder="Official Gazette / proclamation reference" label="Official source" on-input="calendar_non_working_source_input"/><input text="{nonWorkingRegionsValue}" placeholder="Optional RDO codes, e.g. 040; 041" label="Affected RDO codes" on-input="calendar_non_working_regions_input"/><row gap="10"><button variant="primary" icon="check" on-press="calendar_save_non_working_day">{nonWorkingDaySaveLabel}</button><button variant="outline" on-press="calendar_cancel_non_working_day">Clear</button></row></column></card></template><template name="bs"><column gap="20"><if test="{calendarNoticeVisible}"><row cross="center"><badge variant="{calendarNoticeTone}">{calendarNotice}</badge></row></if><column gap="10"><text><span weight="bold">Deadline Overrides</span></text><text wrap="true" foreground="text_muted">Matching follows the reference resolver: form code plus original or already business-day-adjusted deadline; later matching overrides win. RDO- or taxpayer-scoped overrides apply only to matching tax profiles. Effective-range and expiry metadata are preserved separately in SQLite; like the reference resolver, they do not limit global matching yet.</text></column><if test="{calendarOverridesEmpty}"><card><column padding="20" gap="8" cross="center"><icon name="clock" foreground="text_muted" width="30" height="30"/><text><span weight="bold">No deadline overrides</span></text><text wrap="true" text-alignment="center" foreground="text_muted">Add only sourced BIR extensions or corrections. No sample or fictitious holiday override is seeded.</text></column></card></if><for each="calendarOverrides" key="id" as="override"><card><column padding="18" gap="8"><row gap="10" cross="center"><column grow="1" gap="4"><text><span weight="bold">{override.titleLabel}</span></text><text wrap="true" foreground="text_muted">Forms: {override.formsLabel}</text></column><badge variant="primary">{override.datesLabel}</badge></row><text wrap="true" foreground="text_muted">{override.scopeLabel}</text><text wrap="true" foreground="text_muted">{override.effectiveLabel}</text><text wrap="true">Source: {override.sourceLabel}</text><row gap="8"><button size="sm" variant="outline" on-press="calendar_edit_override:{override.id}">Edit</button><button size="sm" variant="ghost" on-press="calendar_delete_override:{override.id}">Delete</button></row></column></card></for><use template="bq"/><separator/><column gap="10"><text><span weight="bold">Non-working Days</span></text><text wrap="true" foreground="text_muted">Weekends are built in. Official holidays and closures are explicit, source-cited SQLite records; none are guessed or auto-seeded.</text></column><if test="{calendarNonWorkingDaysEmpty}"><card><column padding="18" gap="6" cross="center"><text><span weight="bold">No configured non-working days</span></text><text wrap="true" text-alignment="center" foreground="text_muted">Until an official day is entered, only Saturday and Sunday business-day adjustment is active.</text></column></card></if><for each="calendarNonWorkingDays" key="id" as="day"><card><column padding="18" gap="8"><row gap="10" cross="center"><badge variant="secondary">{day.dateLabel}</badge><column grow="1" gap="3"><text><span weight="bold">{day.nameLabel}</span></text><text wrap="true" foreground="text_muted">{day.kindLabel} · {day.regionsLabel}</text></column></row><text wrap="true">Source: {day.sourceLabel}</text><row gap="8"><button size="sm" variant="outline" on-press="calendar_edit_non_working_day:{day.id}">Edit</button><button size="sm" variant="ghost" on-press="calendar_delete_non_working_day:{day.id}">Delete</button></row></column></card></for><use template="br"/></column></template><template name="bt" args="padding"><column padding="{padding}" gap="{dashboardContentGap}"><if test="{constrainedLayout}"><row gap="8" cross="center"><spacer grow="1"/><button width="44" height="44" size="icon" variant="outline" icon="refresh-cw" label="Refresh calendar from SQLite" on-press="calendar_refresh"/></row></if><else><row gap="16" cross="center"><column grow="1" gap="6"><text size="heading">Tax Calendar Explorer</text><text foreground="text_muted">Review calendar-year rules, source-cited changes, and SQLite overrides.</text></column><button variant="outline" icon="refresh-cw" on-press="calendar_refresh">Refresh</button></row></else><tabs gap="4" label="Tax calendar sections"><button variant="ghost" selected="{calendarRulesActive}" on-press="show_calendar_rules">Rules</button><button variant="ghost" selected="{calendarOverridesActive}" on-press="show_calendar_overrides">Overrides</button></tabs><if test="{calendarRulesActive}"><use template="bp"/></if><if test="{calendarOverridesActive}"><use template="bs"/></if></column></template><template name="bu"><scroll grow="1" global-key="page-tax-calendar" label="Tax calendar explorer content"><if test="{phoneLayout}"><use template="bt" padding="16"/></if><else><if test="{desktopLayout}"><use template="bt" padding="32"/></if><else><use template="bt" padding="24"/></else></else></scroll></template><template name="bv" args="icon title body action"><column><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column></row><button variant="outline" disabled="true">{action}</button></column></if><else><row gap="14" cross="center"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column><button variant="outline" disabled="true">{action}</button></row></else></column></template><template name="bw" args="icon title body enabled=false"><column><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column></row><switch checked="{enabled}" disabled="true" label="{title}"></switch></column></if><else><row gap="14" cross="center"><icon name="{icon}" foreground="text_muted" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column><switch checked="{enabled}" disabled="true" label="{title}"></switch></row></else></column></template><template name="bx" args="icon title body action"><column><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="{icon}" foreground="destructive" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column></row><button variant="destructive" disabled="true">{action}</button></column></if><else><row gap="14" cross="center"><icon name="{icon}" foreground="destructive" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">{title}</span></text><text wrap="true" foreground="text_muted">{body}</text></column><button variant="destructive" disabled="true">{action}</button></row></else></column></template><template name="by"><column gap="24"><column gap="6"><text size="heading">Settings</text><text wrap="true" foreground="text_muted">Configure security, privacy, and global application preferences.</text></column><card><if test="{constrainedLayout}"><column padding="22" gap="16"><row gap="14" cross="start"><icon name="sun" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Appearance</span></text><text wrap="true" foreground="text_muted">Follow the system appearance or keep eBIRForms in a specific theme.</text></column></row><toggle-group gap="2" label="Application appearance"><toggle-button size="sm" selected="{themePreference == 'system'}" on-toggle="set_theme_system">System</toggle-button><toggle-button size="sm" selected="{themePreference == 'light'}" on-toggle="set_theme_light">Light</toggle-button><toggle-button size="sm" selected="{themePreference == 'dark'}" on-toggle="set_theme_dark">Dark</toggle-button></toggle-group></column></if><else><row padding="22" gap="18" cross="center"><icon name="sun" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Appearance</span></text><text wrap="true" foreground="text_muted">Follow the system appearance or keep eBIRForms in a specific theme.</text></column><toggle-group gap="2" label="Application appearance"><toggle-button size="sm" selected="{themePreference == 'system'}" on-toggle="set_theme_system">System</toggle-button><toggle-button size="sm" selected="{themePreference == 'light'}" on-toggle="set_theme_light">Light</toggle-button><toggle-button size="sm" selected="{themePreference == 'dark'}" on-toggle="set_theme_dark">Dark</toggle-button></toggle-group></row></else></card><card><column padding="22" gap="18"><if test="{constrainedLayout}"><column gap="12"><row gap="14" cross="start"><icon name="file-text" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Calendar Integration</span></text><text wrap="true" foreground="text_muted">Default calendar handoff is ready</text></column></row><row cross="center"><badge variant="primary">Ready</badge></row></column></if><else><row gap="14" cross="center"><icon name="file-text" foreground="accent" width="30" height="30"/><column grow="1" gap="4"><text><span weight="bold">Calendar Integration</span></text><text foreground="text_muted">Default calendar handoff is ready</text></column><badge variant="primary">Ready</badge></row></else><text wrap="true" foreground="text_muted">Add the resolved schedule to Apple Calendar, Outlook, Google Calendar, or another registered calendar app using an ICS handoff. Choose an iCloud, Google, or Outlook calendar during import to propagate it to mobile. Direct managed Google OAuth sync is optional and not connected.</text><if test="{constrainedLayout}"><column gap="10"><button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button><button variant="outline" disabled="true">Connect Google Directly</button></column></if><else><row gap="10"><button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button><button variant="outline" disabled="true">Connect Google Directly</button></row></else></column></card><card><column padding="22" gap="18"><column gap="4"><text><span weight="bold">Security</span></text><text wrap="true" foreground="text_muted">Protect application access and individual taxpayer profiles.</text></column><separator/><use template="bv" icon="settings" title="Master PIN" body="Require a master PIN when opening protected areas." action="Configure"/><separator/><use template="bv" icon="circle-dot" title="Master Authenticator App" body="Use a one-time code from an authenticator application." action="Set Up"/><separator/><use template="bw" icon="check-circle" title="Enable Profile PINs" body="Allow separate access PINs for taxpayer profiles."/></column></card><card><column padding="22" gap="18"><column gap="4"><text><span weight="bold">Privacy and Display</span></text><text wrap="true" foreground="text_muted">Choose how taxpayer profiles appear in the application shell.</text></column><separator/><use template="bw" icon="eye" title="Hide Tax Profiles from Sidebar" body="Keep profile names and TINs hidden until the list is opened."/><separator/><use template="bv" icon="terminal" title="Global Toggle Hotkey" body="Configure a keyboard shortcut for hiding and showing profiles." action="Set Shortcut"/></column></card><card><column padding="22" gap="18"><column gap="4"><text><span weight="bold">Data</span></text><text wrap="true" foreground="text_muted">Create a portable archive of application data.</text></column><separator/><row gap="14" cross="start"><icon name="alert" foreground="warning" width="22" height="22"/><column grow="1" gap="4"><text><span weight="bold">Storage status</span></text><text wrap="true" foreground="warning">{artifactStorageClassification}</text></column></row><separator/><use template="bv" icon="download" title="Export Data" body="Export taxpayer profiles and application records to a backup archive." action="Export"/></column></card><card><column padding="22" gap="18"><column gap="4"><text foreground="destructive"><span weight="bold">Danger Zone</span></text><text wrap="true" foreground="text_muted">Destructive options are displayed for layout parity only.</text></column><separator/><use template="bx" icon="alert" title="Factory Reset" body="Restore global preferences to their defaults." action="Factory Reset"/><separator/><use template="bx" icon="trash" title="Zero Out Everything" body="Remove all local taxpayer and application data." action="Zero Out Everything"/></column></card></column></template><template name="bz"><scroll grow="1" global-key="page-settings" label="Settings content"><if test="{phoneLayout}"><column padding="16"><use template="by"/></column></if><else><if test="{constrainedLayout}"><column padding="20"><use template="by"/></column></if><else><column padding="32"><use template="by"/></column></else></else></scroll></template><template name="ca" args="grid_columns"><grid columns="{grid_columns}" gap="12"><button variant="secondary" on-press="show_taxpayer_dashboard">Taxpayer Dashboard</button><button variant="secondary" on-press="show_global_dashboard">Global Dashboard</button><button variant="secondary" on-press="show_profile_setup">Taxpayer Profile Setup</button><button variant="secondary" on-press="show_background_tasks">Background Tasks</button><button variant="secondary" on-press="show_import_data">Import Data</button><button variant="secondary" on-press="show_tax_calendar">Tax Calendar Explorer</button><button variant="secondary" on-press="show_settings">Settings</button></grid></template><template name="cb" args="grid_columns"><grid columns="{grid_columns}" gap="12"><button variant="secondary" on-press="show_form_0605">0605 - Payment Form</button><button variant="secondary" on-press="show_form_0619_e">0619-E - Creditable Income Taxes Withheld</button><button variant="secondary" on-press="show_form_0619_f">0619-F - Final Income Taxes Withheld</button><button variant="secondary" on-press="show_form_1601_c">1601C - Compensation Withholding</button><button variant="secondary" on-press="show_form_1701">1701 - Annual Individual ITR</button><button variant="secondary" on-press="show_form_1701q">1701Q - Quarterly Individual ITR</button><button variant="secondary" on-press="show_form_1702_rt">1702-RT - Regular-Rate Corporation ITR</button><button variant="secondary" on-press="show_form_1702_mx">1702-MX - Mixed-Income Corporation ITR</button><button variant="secondary" on-press="show_form_2550q">2550Q - Quarterly VAT Return</button><button variant="secondary" on-press="show_form_2551q">2551Q - Quarterly Percentage Tax</button></grid></template><template name="cc" args="grid_columns"><grid columns="{grid_columns}" gap="12"><button variant="secondary" on-press="show_aux_admin_auth_overlay">Admin Authentication Overlay</button><button variant="secondary" on-press="show_aux_background_task_debug_log">Background Task Debug Log</button><button variant="secondary" on-press="show_aux_command_palette">Command Palette</button><button variant="secondary" on-press="show_aux_email_confirmation">Email Confirmation</button><button variant="secondary" on-press="show_aux_html_print_preview">HTML Print Preview</button><button variant="secondary" on-press="show_aux_lock_screen">Lock Screen</button><button variant="secondary" on-press="show_aux_profile_auth_overlay">Profile Authentication Overlay</button></grid></template><template name="cd"><column gap="24"><if test="{constrainedLayout}"><column gap="8"><row cross="center"><badge variant="outline">Developer Tools</badge></row><column gap="4"><text size="heading">Screen Gallery</text><text wrap="true" foreground="text_muted">Reviewer-only index for every reconstructed eBIRForms surface. This page is not part of the taxpayer workflow.</text></column></column></if><else><row gap="14" cross="start"><column grow="1" gap="4"><text size="heading">Screen Gallery</text><text wrap="true" foreground="text_muted">Reviewer-only index for every reconstructed eBIRForms surface. This page is not part of the taxpayer workflow.</text></column><badge variant="outline">Developer Tools</badge></row></else><card><column padding="20" gap="12"><column gap="4"><text><span weight="bold">Main Screens</span></text><text wrap="true" foreground="text_muted">Primary application pages and taxpayer workflows.</text></column><column><if test="{phoneLayout}"><use template="ca" grid_columns="1"/></if><if test="{constrainedLayout and phoneLayout == false}"><use template="ca" grid_columns="1"/></if><if test="{tabletLayout}"><use template="ca" grid_columns="2"/></if><if test="{desktopLayout}"><use template="ca" grid_columns="3"/></if></column></column></card><card><column padding="20" gap="12"><colu