20" gap="12"><text size="heading">FILING PERIOD AND BACKGROUND INFORMATION</text><if test="{constrainedLayout}"><use template="fe" columns="1"/></if><if test="{tabletLayout}"><use template="fe" columns="2"/></if><if test="{desktopLayout}"><use template="fe" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">PART IV — SALES AND OUTPUT TAX</text><if test="{constrainedLayout}"><use template="ff" columns="1"/></if><if test="{tabletLayout}"><use template="ff" columns="2"/></if><if test="{desktopLayout}"><use template="ff" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">PART IV — CURRENT PURCHASES AND ADJUSTMENTS</text><if test="{constrainedLayout}"><use template="fg" columns="1"/></if><if test="{tabletLayout}"><use template="fg" columns="2"/></if><if test="{desktopLayout}"><use template="fg" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 1 — CAPITAL GOODS (2 reviewed rows)</text><use template="fk"/></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 2 — INPUT TAX ATTRIBUTABLE TO EXEMPT SALES</text><if test="{constrainedLayout}"><use template="fh" columns="1"/></if><if test="{tabletLayout}"><use template="fh" columns="2"/></if><if test="{desktopLayout}"><use template="fh" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 3 — CREDITABLE VAT WITHHELD (2 reviewed rows)</text><use template="fl"/></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 4 — ADVANCE VAT PAYMENTS (2 reviewed rows)</text><use template="fm"/></column></card><card><column padding="20" gap="12"><text size="heading">PART II — TOTAL TAX PAYABLE</text><if test="{constrainedLayout}"><use template="fi" columns="1"/></if><if test="{tabletLayout}"><use template="fi" columns="2"/></if><if test="{desktopLayout}"><use template="fi" columns="3"/></if><separator/><if test="{c