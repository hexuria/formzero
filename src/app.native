<template name="form-2551q-table-1">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">ATC</text>
          <text>ATC line 1</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Tax Base / Taxable Amount</text>
          <text>0.00</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Tax Rate</text>
          <text>0.00%</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Percentage Tax Due</text>
          <text>0.00</text>
        </column>
      </column>
      <separator/>
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">ATC</text>
          <text>ATC line 2</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Tax Base / Taxable Amount</text>
          <text>0.00</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Tax Rate</text>
          <text>0.00%</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Percentage Tax Due</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                  <table-row gap="8">
                    <table-cell>ATC</table-cell>
                    <table-cell>Tax Base / Taxable Amount</table-cell>
                    <table-cell>Tax Rate</table-cell>
                    <table-cell>Percentage Tax Due</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>ATC line 1</table-cell>
                    <table-cell>0.00</table-cell>
                    <table-cell>0.00%</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>ATC line 2</table-cell>
                    <table-cell>0.00</table-cell>
                    <table-cell>0.00%</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                </table>
    </else>
  </column>
</template>

<template name="form-2551q-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
      <column gap="6">
        <text size="heading">BIR Form No. 2551Q</text>
        <text>Quarterly Percentage Tax Return</text>
        <row gap="8" cross="center">
          <text foreground="text_muted" grow="1">January 2018 (ENCS)</text>
          <badge>Draft</badge>
        </row>
      </column>
        <column gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <separator/>
        <button variant="secondary" disabled="true">Save</button>
        <button variant="primary" disabled="true">Submit</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 2551Q</text>
            <text>Quarterly Percentage Tax Return</text>
            <text foreground="text_muted">January 2018 (ENCS)</text>
          </column>
          <badge>Draft</badge>
        </row>
        <row gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <spacer/>
        <button variant="secondary" disabled="true">Save</button>
        <button variant="primary" disabled="true">Submit</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-2551q-filing-status">
  <card>
    <column padding="20" gap="12">
      <text size="heading">Filing status</text>
      <if test="{constrainedLayout}">
        <if test="{phoneLayout}">
          <column gap="8">
            <row cross="center">
              <badge>Draft</badge>
            </row>
            <text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <badge>Draft</badge>
            <text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
          </row>
        </else>
      </if>
      <else>
        <stepper active="0">
          <step>Draft</step>
          <step>Queued</step>
          <step>Submitted</step>
          <step>Confirmed</step>
          <step>Paid</step>
        </stepper>
      </else>
    </column>
  </card>
</template>

<template name="form-2551q">
  <scroll grow="1" global-key="page-form-2551q">
    <column padding="32" gap="24">
      <use template="form-2551q-masthead"/>

      <use template="form-2551q-filing-status"/>

      <card>
        <column padding="20" gap="12">
          <text size="heading">FILING PERIOD</text>
          <if test="{constrainedLayout}">
            <use template="form-2551q-grid-1" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2551q-grid-1" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2551q-grid-1" columns="4"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART I — BACKGROUND INFORMATION (pre-filled from profile)</text>
          <if test="{constrainedLayout}">
            <use template="form-2551q-grid-2" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2551q-grid-2" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2551q-grid-2" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 1 — COMPUTATION OF TAX</text>
          <use template="form-2551q-table-1"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II — COMPUTATION OF TAX</text>
          <if test="{constrainedLayout}">
            <use template="form-2551q-grid-3" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2551q-grid-3" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2551q-grid-3" columns="3"/>
          </if>
          <separator />
          <if test="{constrainedLayout}">
            <column gap="8">
              <text>Total Amount Payable</text>
              <row cross="center">
                <badge>PHP 0.00</badge>
              </row>
            </column>
          </if>
          <else>
            <row gap="8">
              <text grow="1">Total Amount Payable</text>
              <badge>PHP 0.00</badge>
            </row>
          </else>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">Submission controls by status</text>
          <text foreground="text_muted">Draft: Save and Submit. Queued: Cancel Submission Queue. Submitted: Revert Draft and Check Confirmation or Mark as Confirmed Manually. Confirmed: Revert Draft and Mark as Paid. A receipt action appears when available.</text>
        </column>
      </card>
    </column>
  </scroll>
</template>

<template name="lock-screen-content">
  <column gap="24" cross="center">
    <column gap="4" cross="center">
      <badge variant="outline">BIR</badge>
      <text size="display">e-BIRForms</text>
    </column>

    <column gap="8" cross="center">
      <text wrap="true" text-alignment="center" size="heading">Enter PIN to unlock e-BIRForms</text>
      <text wrap="true" text-alignment="center" foreground="text_muted">
        Your tax records remain protected while this session is locked.
      </text>
    </column>

    <input
      width="300"
      size="lg"
      placeholder="Enter 4-digit PIN"
      label="App lock PIN"
    />

    <column width="300" gap="8">
      <button width="300" size="lg" variant="primary" disabled="true">Unlock</button>
      <button width="300" variant="ghost" disabled="true">Use Biometric or Password Instead</button>
      <button width="300" variant="outline" icon="chevron-left" on-press="go_back">Back to Screen Gallery</button>
    </column>
  </column>
</template>

<template name="lock-screen-page">
  <column grow="1" padding="16" main="center" cross="center" background="background">
    <if test="{phoneLayout}">
      <column gap="24" cross="center">
        <use template="lock-screen-content"/>
      </column>
    </if>
    <else>
      <column width="420" gap="24" cross="center">
        <use template="lock-screen-content"/>
      </column>
    </else>
  </column>
</template>

<template name="profile-auth-content">
  <column gap="24" cross="center">
    <column gap="4" cross="center">
      <badge variant="outline">BIR</badge>
      <text size="display">e-BIRForms</text>
    </column>

    <column gap="6" cross="center">
      <text wrap="true" text-alignment="center" size="heading">Enter PIN to unlock Tax Profile</text>
      <text wrap="true" text-alignment="center" foreground="text_muted">Profile: 123-456-789-000</text>
    </column>

    <input
      width="300"
      size="lg"
      placeholder="Enter 4-digit PIN"
      label="Tax profile PIN"
