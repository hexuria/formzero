lumn gap="4"><text foreground="text_muted">Tax Relief?</text><input text="{percentageTaxRelief}" placeholder="No / Specify" disabled="true"/><row gap="8"><button variant="outline" selected="{percentageTaxReliefNoneSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_relief_none">No</button><button variant="outline" selected="{percentageTaxReliefSpecifiedSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_relief_specified">Specify</button></row></column><column gap="4"><text foreground="text_muted">12A Tax Relief Specification</text><input text="{percentageTaxReliefReference}" placeholder="Relief code or basis" disabled="{not percentageTaxEditable}" on-input="percentage_tax_relief_reference_input"/></column><column gap="4"><text foreground="text_muted">13 What income tax rates are you availing?</text><input height="44" text="{percentageTaxElection}" placeholder="Set in the annual Income tax rate profile" disabled="true"/><text wrap="true" foreground="text_muted">The eligible initial quarter sets this choice for the taxable year. Later quarters inherit the saved annual rate.</text></column></grid></template><template name="fr" args="columns"><grid columns="{columns}" gap="12"><use template="b" label="TIN" v="{formFilerTin}" ph="000-000-000-000"/><use template="b" label="RDO Code" v="{formFilerRdo}" ph="RDO"/><use template="b" label="Taxpayer's Name" v="{formFilerTaxpayerName}" ph="Registered taxpayer name"/><column gap="4"><text foreground="text_muted">Registered Address</text><input text="{formFilerRegisteredAddress}" placeholder="Registered address" disabled="{not formFilingContactEditable}" on-input="form_filing_address_input"/></column><column gap="4"><text foreground="text_muted">ZIP Code</text><input text="{formFilerZipCode}" placeholder="ZIP code" disabled="{not formFilingContactEditable}" on-input="form_filing_zip_input"/></column><column gap="4"><text foreground="text_muted">Contact Number</text><input text="{formFilerContactNumber}" placeholder="Contact number" disabled="{not formFilingContactEditable}" on-input="form_filing_contact_input"/></column><column gap="4"><text foreground="text_muted">Email Address</text><input text="{formFilerEmailAddress}" placeholder="name@example.com" disabled="{not formFilingContactEditable}" on-input="form_filing_email_input"/></column></grid></template><template name="fs"><row gap="8" cross="center"><badge variant="outline">{formFilingContactProvenance}</badge><text grow="1" wrap="true" foreground="text_muted">Changes here apply to this filing only.</text><button height="44" variant="outline" disabled="{formFilingContactResetDisabled}" on-press="form_filing_use_profile_contacts">Use profile values</button></row></template><template name="ft" args="columns"><column gap="16"><text foreground="text_muted">Enter the externally supplied rate for each active row. No tax rate is assumed by the application.</text><grid columns="{columns}" gap="12"><column gap="4"><text foreground="text_muted">Schedule 1 Line 1 Percentage-tax Code</text><input text="{percentageTaxLine1Atc}" placeholder="ATC code" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_1_atc_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 1 Tax Base / Taxable Amount</text><input text="{percentageTaxLine1Base}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_1_base_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 1 Policy-supplied Tax Rate</text><input text="{percentageTaxLine1Rate}" placeholder="Rate" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_1_rate_input"/></column><use template="b" label="Schedule 1 Line 1 Percentage Tax Due" v="{percentageTaxLine1Due}" ph="Enter amount"/><column gap="4"><text foreground="text_muted">Schedule 1 Line 2 Percentage-tax Code</text><input text="{percentageTaxLine2Atc}" placeholder="ATC code" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_2_atc_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 2 Tax Base / Taxable Amount</text><input text="{percentageTaxLine2Base}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_2_base_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 2 Policy-supplied Tax Rate</text><input text="{percentageTaxLine2Rate}" placeholder="Rate" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_2_rate_input"/></column><use template="b" label="Schedule 1 Line 2 Percentage Tax Due" v="{percentageTaxLine2Due}" ph="Enter amount"/></grid></column></template><template name="fu" args="columns"><grid columns="{columns}" gap="12"><use template="b" label="14 Total Percentage Tax Due" v="{percentageTaxTotalDue}" ph="Enter amount"/><column gap="4"><text foreground="text_muted">15 Creditable Percentage Tax Withheld</text><input text="{percentageTaxCreditableWithheld}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_creditable_withheld_input"/></column><column gap="4"><text foreground="text_muted">16 Tax Paid in Previous Return</text><input text="{percentageTaxPaidPrevious}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_paid_previous_input"/></column><column gap="4"><text foreground="text_muted">17 Other Tax Credit / Payment</text><input text="{percentageTaxOtherCredit}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_other_credit_input"/></column><use template="b" label="18 Total Tax Credits / Payments" v="{percentageTaxTotalCredits}" ph="Enter amount"/><use template="b" label="19 Tax Payable / (Overpayment)" v="{percentageTaxNetTax}" ph="Enter amount"/><column gap="4"><text foreground="text_muted">20 Surcharge (manual)</text><input text="{percentageTaxSurcharge}" placeholder="Enter amount" disable