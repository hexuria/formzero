ofile_calendar_export"></button></row></else></column></else></column></template><template name="ad"><row height="40" padding="10" gap="8" cross="center" background="surface_subtle"><text size="sm" grow="1" foreground="text_muted"><span weight="bold">Form</span></text><text size="sm" width="108" foreground="text_muted"><span weight="bold">Status</span></text><text size="sm" width="{profileDeadlineActionColumnWidth}" text-alignment="center" foreground="text_muted"><span weight="bold">Action</span></text></row></template><template name="ae" args="pi pl pd mk mo oi ol od"><stack width="{profileDeadlineActionColumnWidth}"><row gap="2" main="end" cross="center"><button width="{profileDeadlineActionButtonSize}" height="{profileDeadlineActionButtonSize}" size="icon" variant="secondary" icon="{pi}" label="{pl}" on-press="profile_deadline_run_action:{pd}"></button><if test="{ol != ''}"><button width="{profileDeadlineActionButtonSize}" height="{profileDeadlineActionButtonSize}" size="icon" variant="ghost" icon="chevron-down" label="More filing actions" on-press="profile_deadline_toggle_actions:{mk}"></button></if></row><if test="{mo}"><dropdown-menu width="220" anchor="below" anchor-alignment="end" anchor-offset="4" on-dismiss="profile_deadline_close_actions"><column padding="4" gap="2"><menu-item height="44" icon="{oi}" on-press="profile_deadline_run_action:{od}">{ol}</menu-item></column></dropdown-menu></if></stack></template><template name="af" args="r h"><column><if test="{h}"><column><if test="{profileDeadlineTableLayout}"><card padding="0"><column gap="0"><use template="ad"/><separator/><for each="r" key="id" as="deadline"><column gap="0"><row padding="10" gap="8" cross="center"><column grow="1" gap="4"><row gap="6" cross="center"><badge variant="secondary">{deadline.compactLabel}</badge><if test="{deadline.timingVisible}"><row gap="4" cross="center"><icon name="{deadline.timingIcon}" width="16" height="16"/><badge variant="{deadline.timingTone}">{deadline.timingLabel}<