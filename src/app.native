w="1" wrap="true" foreground="text_muted">Nothing is saved until you choose Save.</text></row></else></if><if test="{profileFormRowsEmpty}"><if test="{browsingProfileForms}"><if test="{profileBrowseActiveEmpty}"><card padding="0"><column height="180" padding="24" gap="12" main="center" cross="center"><icon name="search" foreground="text_muted" width="28" height="28"/><text text-alignment="center"><span weight="bold">No active forms</span></text><text wrap="true" text-alignment="center" foreground="text_muted">Activate forms for this profile and tax year to add them to the library.</text><text wrap="true" text-alignment="center" foreground="text_muted">Open Profile Settings → Registration & Forms to activate a yearly form set.</text></column></card></if><else><card padding="0"><column height="180" padding="24" gap="12" main="center" cross="center"><icon name="search" foreground="text_muted" width="28" height="28"/><text text-alignment="center"><span weight="bold">No forms match these filters</span></text><text wrap="true" text-alignment="center" foreground="text_muted">Try another search, month, quarter, or filing type.</text><button height="44" variant="outline" on-press="profile_forms_reset_filters">Reset filters</button></column></card></else></if><else><use template="z" i="search" t="No matching catalog forms" b="Change the search, selection, capability, cadence, or tax-category filters."/></else></if><else><if test="{managingProfileForms}"><grid columns="{profileFormCardColumns}" gap="12"><for each="profileFormRows" key="id" as="form"><card padding="0" selected="{form.selected}"><row padding="14" gap="12" cross="start"><checkbox checked="{form.selected}" label="{form.selectionLabel}" on-toggle="toggle_profile_form:{form.id}"/><column grow="1" gap="8"><row gap="8" cross="center"><badge variant="secondary">{form.code}</badge><badge variant="{form.manageStatusTone}">{form.manageStatusLabel}</badge></row><text wrap="true">{form.title}</text><text wrap="true" foreground="text_muted">{form.categoryLabel} - {form.cadenceLabel}</text><badge variant="outline">{form.capability}</badge><text wrap="true" size="sm" foreground="text_muted">Fileability: {form.fileability}</text><if test="{form.taxFormProfileActionVisible}"><column gap="6"><text wrap="true" size="sm" foreground="text_muted">{form.taxFormProfileStatus}</text><button height="36" variant="outline" disabled="{form.taxFormProfileActionDisabled}" on-press="open_tax_form_profile:{form.id}">{form.taxFormProfileAction}</button></column></if></column></row></card></for></grid></if><else><grid columns="{profileFormCardColumns}" gap="12"><for each="profileFormRows" key="id" as="form"><card padding="0"><column padding="12" gap="10" cross="stretch"><row gap="8" cross="center"><text grow="1"><span weight="bold" scale="1.25">{form.code}</span></text><text size="sm" foreground="text_muted">{form.filingProgress}</text><button width="32" height="32" size="icon" variant="ghost" icon="info" label="{form.infoLabel}" on-press="profile_forms_show_info:{form.id}"></button></row><text wrap="true">{form.title}</text><row gap="6" cross="center"><badge variant="secondary">{form.activeLabel}</badge><badge variant="outline">{form.cadenceLabel}</badge><badge variant="outline">{form.capability}</badge></row><text wrap="true" size="sm" foreground="text_muted">Fileability: {form.fileability}</text><text wrap="true" size="sm" foreground="text_muted">{form.activationLabel}</text><column gap="8" cross="stretch"><text wrap="true" size="sm" foreground="text_muted">{form.taxFormProfileStatus}</text><if test="{form.taxFormProfileActionVisible}"><button height="36" variant="outline" disabled="{form.taxFormProfileActionDisabled}" on-press="open_tax_form_profile:{form.id}">{form.taxFormProfileAction}</button></if></column><if test="{form.hasPeriodCells}"><grid columns="{form.periodGridColumns}" gap="6"><if test="{form.period1.available}"><use template="an" a="{form.period1.actionLabel}" i="{form.period1.actionId}" x