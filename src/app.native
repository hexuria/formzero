<!--
The two tax-catalog-source templates are never mounted. Their deliberate
spacing preserves the existing coarse catalog's stable source-line facts
while the visible page is replaced by the exact 173-control inventory.
Only form-1701q-selected-editor-input is mounted, as the bounded editor.
-->
<template name="form-1701q-boundaries">
<card>
<column padding="16" gap="8">
<text><span weight="bold">Fail-closed research boundaries</span></text>
<text wrap="true">Network transport: disabled</text>
<text wrap="true">Outbound encryption: unavailable - 0/67 private Windows vectors</text>
<text wrap="true">Local database: plaintext / synthetic-test-only until key custody</text>
<text wrap="true">Submission/queue: disabled</text>
</column>
</card>
</template>
<template name="form-1701q-actions">
<card>
<column padding="20" gap="12">
<row gap="12" cross="center">
<column grow="1" gap="2">
<text size="heading">Exact ordered workflow</text>
<text wrap="true" foreground="text_muted">
Calculate, run the four-rule Save gate, inspect an Editable candidate, then run full source-ordered validation before creating a Final Copy candidate.
</text>
</column>
<badge>{exact1701QPhase}</badge>
</row>
<text foreground="text_muted">{exact1701QHistory}</text>
<if test="{constrainedLayout}">
<column gap="8">
<button
variant="secondary"
disabled="{not exact1701QCanCalculate}"
on-press="exact_1701q_calculate">
1. Calculate
</button>
<button
variant="secondary"
disabled="{not exact1701QCanValidateSave}"
on-press="exact_1701q_validate_save">
2. Save validation
</button>
<button
variant="secondary"
disabled="{not exact1701QCanGenerateEditableCandidate}"
on-press="exact_1701q_generate_editable_candidate">
3. Build Editable candidate
</button>
<button
variant="secondary"
disabled="{not exact1701QCanValidateFull}"
on-press="exact_1701q_validate_full">
4. Full validation
</button>
<button
variant="secondary"
disabled="{not exact1701QCanGenerateFinalCandidate}"
on-press="exact_1701q_generate_final_candidate">
5. Build Final Copy candidate
</button>
</column>
</if>
<else>
<row gap="8">
<button
variant="secondary"
disabled="{not exact1701QCanCalculate}"
on-press="exact_1701q_calculate">
1. Calculate
</button>
<button
variant="secondary"
disabled="{not exact1701QCanValidateSave}"
on-press="exact_1701q_validate_save">
2. Save validation
</button>
<button
variant="secondary"
disabled="{not exact1701QCanGenerateEditableCandidate}"
on-press="exact_1701q_generate_editable_candidate">
3. Editable candidate
</button>
<button
variant="secondary"
disabled="{not exact1701QCanValidateFull}"
on-press="exact_1701q_validate_full">
4. Full validation
</button>
<button
variant="secondary"
disabled="{not exact1701QCanGenerateFinalCandidate}"
on-press="exact_1701q_generate_final_candidate">
5. Final Copy candidate
</button>
</row>
</else>
</column>
</card>
</template>
<template name="form-1701q-artifact-lab">
<column>
<if test="{exact1701QCandidateVisible}">
<card>
<column padding="20" gap="12">
<row gap="12" cross="center">
<column grow="1" gap="2">
<text size="heading">Artifact Lab - generated plaintext</text>
<text wrap="true">{exact1701QCandidateLabel}</text>
</column>
<badge>{exact1701QCandidateQualification}</badge>
</row>
<text>{exact1701QCandidateShape}</text>
<text foreground="text_muted" wrap="true">{exact1701QCandidateMasked}</text>
<button
variant="outline"
on-press="exact_1701q_toggle_generated_reveal">
{exact1701QGeneratedRevealLabel}
</button>
<if test="{exact1701QGeneratedRevealed}">
<column
padding="12"
gap="4"
background="surface_subtle"
radius="md">
<text wrap="true">{exact1701QGeneratedText}</text>
</column>
</if>
<separator/>
<text wrap="true" foreground="text_muted">
Imported ciphertext: unavailable until bounded import and a secure SecretProvider are connected.
</text>
<text wrap="true" foreground="text_muted">
Decrypted plaintext: unavailable. No protocol-secret text input is exposed.
</text>
</column>
</card>
</if>
</column>
</template>
<template name="form-1701q-selected-control">
<column>
<if test="{exact1701QSelectedVisible}">
<card>
<column padding="20" gap="12">
<row gap="12" cross="center">
<column grow="1" gap="2">
<text size="heading">Selected exact control</text>
<text wrap="true">{exact1701QSelectedId}</text>
<text wrap="true" foreground="text_muted">{exact1701QSelectedMeta}</text>
</column>
<badge>{exact1701QSelectedValueLabel}</badge>
</row>
<if test="{exact1701QSelectedIsRadio}">
<row gap="8" cross="center">
<text grow="1">{exact1701QSelectedRadioLabel}</text>
<button
variant="outline"
disabled="{not exact1701QSelectedCanToggleRadio}"
on-press="exact_1701q_toggle_selected_radio">
Toggle exact radio
</button>
</row>
</if>
<else>
<button
variant="outline"
disabled="{not exact1701QSelectedCanReveal}"
on-press="exact_1701q_toggle_selected_reveal">
{exact1701QSelectedRevealLabel}
</button>
<if test="{exact1701QSelectedCanReveal}">
<use template="form-1701q-selected-editor-input"/>
<button
variant="secondary"
disabled="{not exact1701QSelectedCanEdit}"
on-press="exact_1701q_commit_selected">
Commit reviewed value
</button>
</if>
</else>
</column>
</card>
</if>
</column>
</template>
<template name="form-1701q-control-list">
<card>
<column padding="20" gap="12">
<column gap="2">
<text size="heading">Exact live control inventory - 173 controls</text>
<text wrap="true" foreground="text_muted">
Values stay masked in this list. Selecting a control never reveals it. The ordered row inventory is a view only and is never serialized.
</text>
</column>
<for each="exact1701QRows" key="idLabel" as="control">
<button
variant="outline"
selected="{control.selected}"
on-press="exact_1701q_select_control:{control.slot}">
{control.metaLabel} - {control.idLabel} - {control.accessLabel} - {control.valueLabel}
</button>
</for>
<else>
<text foreground="text_muted">
No exact controls are available because the workspace is blocked or not attached.
</text>
</else>
</column>
</card>
</template>
<template name="form-1701q">
<scroll grow="1" global-key="page-form-1701q">
<column padding="32" gap="24">
<if test="{constrainedLayout}">
<column gap="12">
<column gap="4">
<text size="heading">BIR Form No. 1701Q</text>
<text wrap="true">Exact January 2018 (ENCS) core-logic research editor</text>
<text foreground="text_muted">{exact1701QFilingContext}</text>
</column>
<button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
</column>
</if>
<else>
<row gap="16" cross="center">
<column grow="1" gap="4">
<text size="heading">BIR Form No. 1701Q</text>
<text>Exact January 2018 (ENCS) core-logic research editor</text>
<text foreground="text_muted">{exact1701QFilingContext}</text>
</column>
<badge>Research / candidate</badge>
<button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
</row>
</else>
<use template="form-1701q-boundaries"/>
<use template="tax-profile-form-context"/>
<if test="{exact1701QNoticeVisible}">
<row gap="8" cross="center">
<badge variant="{exact1701QNoticeTone}">{exact1701QNotice}</badge>
</row>
</if>
<card>
<column padding="20" gap="12">
<text size="heading">Open filing workspace</text>
<text wrap="true" foreground="text_muted">
Original and Amended are separate exact workspaces. Opening either action creates a new workspace identity; existing material work must be explicitly discarded first.
</text>
<row gap="12">
<button
variant="outline"
on-press="exact_1701q_open_original">
Open Original workspace
</button>
<button
variant="outline"
on-press="exact_1701q_open_amended">
Open Amended workspace
</button>
</row>
</column>
</card>
<if test="{exact1701QReady}">
<button
variant="outline"
on-press="exact_1701q_discard_workspace">
Discard and close exact workspace
</button>
<use template="form-1701q-actions"/>
<use template="form-1701q-artifact-lab"/>
<use template="form-1701q-selected-control"/>
<use template="form-1701q-control-list"/>
</if>
<else>
<card>
<column padding="20" gap="8">
<text size="heading">Exact workspace unavailable</text>
<text wrap="true" foreground="text_muted">
Resolve the tax-profile projection or Windows runtime failure shown above. No fallback serializer or legacy draft editor is used by this page.
</text>
</column>
</card>
</else>
</column>
</scroll>
</template>
