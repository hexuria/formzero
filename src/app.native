<template name="command-palette-overlay">
<column grow="1" padding="16" background="shadow">
<if test="{constrainedLayout}">
<spacer height="16"/>
</if>
<else>
<spacer height="72"/>
</else>
<if test="{constrainedLayout}">
<use template="command-palette-card"/>
