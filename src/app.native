<template name="sidebar-profile" args="name tin profile active=false">
  <list-item
    width="255"
    height="64"
    padding="8"
    radius="md"
    selected="{active}"
    label="{name}"
    on-press="select_taxpayer:{profile}">
    <column grow="1" gap="2">
      <text><span weight="bold">{name}</span></text>
      <text foreground="text_muted">{tin}</text>
    </column>
  </list-item>
</template>

<template name="sidebar-dock-full">
  <column width="232" gap="8">
    <row width="232" height="48" cross="center">
      <list-item
        key="{sidebarActionEpoch}"
        width="232"
        height="40"
        padding="12"
        radius="md"
        icon="download"
        selected="false"
        on-press="show_import_data">
        Import Data
      </list-item>
    </row>

    <row width="232" height="48" cross="center">
      <if test="{darkThemeActive}">
        <list-item
          key="{sidebarActionEpoch}"
          width="232"
          height="40"
          padding="12"
          radius="md"
          icon="sun"
          selected="false"
          label="Switch to light mode"
          on-press="toggle_theme">
          Light Mode
        </list-item>
      </if>
      <if test="{lightThemeActive}">
        <list-item
          key="{sidebarActionEpoch}"
          width="232"
          height="40"
          padding="12"
          radius="md"
          icon="moon"
          selected="false"
          label="Switch to dark mode"
          on-press="toggle_theme">
          Dark Mode
        </list-item>
      </if>
    </row>

    <row width="232" height="48" cross="center">
      <list-item
        key="{sidebarActionEpoch}"
        width="232"
        height="40"
        padding="12"
        radius="md"
        icon="clock"
        selected="false"
        on-press="show_background_tasks">
        Background Tasks
      </list-item>
    </row>

    <row width="232" height="48" cross="center">
      <list-item
        key="{sidebarActionEpoch}"
        width="232"
        height="40"
        padding="12"
        radius="md"
        icon="file-text"
        selected="false"
        on-press="show_tax_calendar">
        Tax Calendars
      </list-item>
    </row>

    <row width="232" height="48" cross="center">
      <list-item
        key="{sidebarActionEpoch}"
        width="232"
        height="40"
        padding="12"
        radius="md"
        icon="settings"
        selected="false"
        on-press="show_settings">
        Settings
      </list-item>
    </row>
  </column>
</template>

<template name="sidebar-dock-rail">
  <column width="48" gap="8" cross="center">
    <button
      width="48"
      height="48"
      size="icon"
      variant="ghost"
      radius="xl"
      icon="download"
      label="Import Data"
      on-press="show_import_data">
    </button>

    <if test="{darkThemeActive}">
      <button
        width="48"
        height="48"
        size="icon"
        variant="ghost"
        radius="xl"
        icon="sun"
        label="Switch to light mode"
        on-press="toggle_theme">
      </button>
    </if>
    <if test="{lightThemeActive}">
      <button
        width="48"
        height="48"
        size="icon"
        variant="ghost"
        radius="xl"
        icon="moon"
        label="Switch to dark mode"
        on-press="toggle_theme">
      </button>
    </if>

    <button
      width="48"
      height="48"
      size="icon"
      variant="ghost"
      radius="xl"
      icon="clock"
      label="Background Tasks"
      on-press="show_background_tasks">
    </button>

    <button
      width="48"
      height="48"
      size="icon"
      variant="ghost"
      radius="xl"
      icon="file-text"
      label="Tax Calendars"
      on-press="show_tax_calendar">
    </button>

    <button
      width="48"
      height="48"
      size="icon"
      variant="ghost"
      radius="xl"
      icon="settings"
      label="Settings"
      on-press="show_settings">
    </button>
  </column>
</template>

<!--
  Expanded and compact sidebars intentionally use the same vertical slot
  matrix. Switching modes swaps only the content inside each slot, so the
  chevron, brand, profile controls, profile rows, and dock never jump.
-->
<template name="app-sidebar-full" args="brand_logo overlay=false">
  <!--
    Native 0.6.1 does not paint backgrounds on layout-only rows. The empty
    status bar is a square, full-frame paint leaf beneath the unchanged
    sidebar flow, keeping the phone drawer opaque without adding chrome.
  -->
  <stack width="280">
    <status-bar background="surface" border-color="surface"></status-bar>
    <row width="280">
      <column width="279" grow="1" cross="center">
      <spacer height="12"/>

      <row width="255" height="40" main="end" cross="center">
        <if test="{overlay}">
          <list-item
            width="40"
            height="40"
            padding="0"
            main="center"
            cross="center"
            radius="xl"
            selected="false"
            label="Close navigation"
            on-press="close_sidebar_overlay">
            <icon name="x" width="24" height="24"/>
          </list-item>
        </if>
        <else>
          <list-item
            width="40"
            height="40"
            padding="0"
            main="center"
            cross="center"
            radius="xl"
            selected="false"
            label="Use compact sidebar"
            on-press="collapse_sidebar">
            <icon name="chevron-left" width="28" height="28"/>
          </list-item>
        </else>
      </row>

      <row
        width="255"
        height="64"
        main="center"
        cross="center"
        role="button"
        label="Open Global Dashboard"
        on-press="show_global_dashboard">
        <image image="{brand_logo}" width="216" height="54" label="eBIRForms"/>
      </row>

      <row width="232" height="56" cross="center" gap="8">
        <text grow="1" foreground="text_muted">
          <span weight="bold">TAXPAYER PROFILES</span>
        </text>
        <button
          width="40"
          height="40"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="plus"
          label="Add taxpayer profile"
          on-press="show_profile_setup">
        </button>
      </row>

      <row width="232" height="64" main="center" cross="center">
        <search-field
          width="232"
          placeholder="Search profiles"
          label="Search taxpayer profiles"
          autofocus="{overlay}"/>
      </row>

      <spacer height="16"/>
      <separator/>

      <scroll grow="1" width="255" overscroll="none" label="Sidebar navigation">
        <column width="255" cross="center" gap="8">
          <!-- Keep all three profile slots visible at the 768 px reference height. -->
          <spacer height="4"/>
          <use
            template="sidebar-profile"
            name="Juan Dela Cruz"
            tin="TIN: 000-000-000-00000"
            profile="juan_dela_cruz"
            active="{juanProfileActive}"/>
          <use
            template="sidebar-profile"
            name="Demo Corporation"
            tin="TIN: 111-111-111-00000"
            profile="demo_corporation"
            active="{demoProfileActive}"/>
          <use
            template="sidebar-profile"
            name="Sample Partnership"
            tin="TIN: 222-222-222-00000"
            profile="sample_partnership"
            active="{partnershipProfileActive}"/>

          <row width="232" height="48" cross="center">
            <list-item
              key="{sidebarActionEpoch}"
              width="232"
              height="40"
              padding="12"
              radius="md"
              icon="folder-open"
              selected="false"
              on-press="show_screen_gallery">
              Screen Gallery
            </list-item>
          </row>
        </column>
      </scroll>

      <separator/>
      <spacer height="8"/>
      <use template="sidebar-dock-full"/>
      <spacer height="12"/>
      </column>
      <separator/>
    </row>
  </stack>
</template>

<template name="sidebar-avatar" args="initials name profile active=false">
  <row width="48" height="64" main="center" cross="center">
    <if test="{active}">
      <button
        width="48"
        height="48"
        size="icon"
        variant="primary"
        radius="xl"
        selected="true"
        label="{name}"
        on-press="select_taxpayer:{profile}">
        {initials}
      </button>
    </if>
    <else>
      <button
        width="48"
        height="48"
        size="icon"
        variant="ghost"
        radius="xl"
        selected="false"
        label="{name}"
        on-press="select_taxpayer:{profile}">
        {initials}
      </button>
    </else>
  </row>
</template>

<template name="app-sidebar-rail" args="app_icon">
  <row width="72" background="background">
    <column width="71" grow="1" cross="center">
      <spacer height="12"/>

      <row width="48" height="40" main="center" cross="center">
        <list-item
          width="40"
          height="40"
          padding="0"
          main="center"
          cross="center"
          radius="xl"
          selected="false"
          label="Expand sidebar"
          on-press="expand_sidebar">
          <icon name="chevron-right" width="28" height="28"/>
        </list-item>
      </row>

      <row
        width="48"
        height="64"
        main="center"
        cross="center"
        role="button"
        label="Open Global Dashboard"
        on-press="show_global_dashboard">
        <image image="{app_icon}" width="48" height="48" label="eBIRForms"/>
      </row>

      <row width="48" height="56" main="center" cross="center">
        <button
          width="40"
          height="40"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="plus"
          selected="{page == 'profile_setup'}"
          label="Add taxpayer profile"
          on-press="show_profile_setup">
        </button>
      </row>

      <row width="48" height="64" main="center" cross="center">
        <button
          width="48"
          height="48"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="search"
          label="Search taxpayer profiles"
          on-press="open_sidebar_overlay">
        </button>
      </row>

      <spacer height="16"/>
      <separator/>

      <scroll
        grow="1"
        width="70"
        overscroll="none"
        label="Compact sidebar navigation">
        <column width="70" cross="center" gap="8">
          <!-- Mirrors the expanded profile matrix exactly, with no mode jump. -->
          <spacer height="4"/>
          <use
            template="sidebar-avatar"
            initials="JD"
            name="Juan Dela Cruz"
            profile="juan_dela_cruz"
            active="{juanProfileActive}"/>
          <use
            template="sidebar-avatar"
            initials="DC"
            name="Demo Corporation"
            profile="demo_corporation"
            active="{demoProfileActive}"/>
          <use
            template="sidebar-avatar"
            initials="SP"
            name="Sample Partnership"
            profile="sample_partnership"
            active="{partnershipProfileActive}"/>

          <row width="48" height="64" main="center" cross="center">
            <button
              width="48"
              height="48"
              size="icon"
              variant="ghost"
              radius="xl"
              icon="folder-open"
              label="Screen Gallery"
              on-press="show_screen_gallery">
            </button>
          </row>
        </column>
      </scroll>

      <separator/>
      <spacer height="8"/>
      <use template="sidebar-dock-rail"/>
      <spacer height="12"/>
    </column>
    <separator/>
  </row>
</template>

<template name="app-mobile-header" args="app_icon">
  <column>
    <row height="56" padding="8" gap="10" cross="center" background="background">
      <button
        width="40"
        height="40"
        size="icon"
        variant="ghost"
        radius="xl"
        icon="menu"
        label="Open navigation"
        on-press="toggle_navigation">
      </button>
      <image image="{app_icon}" width="38" height="38" label="eBIRForms"/>
      <text grow="1"><span weight="bold">{currentPageTitle}</span></text>
    </row>
    <separator/>
  </column>
</template>

<template name="app-footer" args="bagong_logo bir_logo goldcoders_logo">
  <column>
    <if test="{regularFooter}">
      <column>
        <separator/>
        <row height="71" padding="12" cross="center" gap="12" background="background">
          <image image="{bagong_logo}" width="48" height="48" label="Bagong Pilipinas"/>
          <image image="{bir_logo}" width="48" height="48" label="Bureau of Internal Revenue"/>
          <spacer grow="1"/>
          <if test="{footerCopyrightVisible}">
            <text foreground="text_muted">© 2026 Goldcoders Corp. · goldcoders.dev</text>
          </if>
          <image image="{goldcoders_logo}" width="44" height="44" label="Goldcoders"/>
        </row>
      </column>
    </if>

    <if test="{compactFooter}">
      <column>
        <separator/>
        <row height="57" padding="8" cross="center" gap="8" background="background">
          <image image="{bagong_logo}" width="38" height="38" label="Bagong Pilipinas"/>
          <image image="{bir_logo}" width="38" height="38" label="Bureau of Internal Revenue"/>
          <spacer grow="1"/>
          <text foreground="text_muted">© 2026</text>
          <image image="{goldcoders_logo}" width="36" height="36" label="Goldcoders"/>
        </row>
      </column>
    </if>
  </column>
</template>

<template name="app-shell" args="brand_logo app_icon bagong_logo bir_logo goldcoders_logo">
  <stack grow="1">
    <!--
      Theme changes alter the canvas clear color. Native 0.6.1 otherwise
      invalidates only the bounds of commands whose colors changed, leaving
      untouched regions on the previous theme until macOS exposes the
      window. This full-frame paint leaf changes with the background token,
      so every theme switch damages the entire surface immediately.
    -->
    <status-bar background="background" border-color="background"></status-bar>

    <column grow="1">
      <row grow="1">
        <if test="{sidebarExpandedVisible}">
          <use template="app-sidebar-full" brand_logo="{brand_logo}"/>
        </if>
        <if test="{sidebarRailVisible}">
          <use template="app-sidebar-rail" app_icon="{app_icon}"/>
        </if>

        <column grow="1" min-width="0">
          <column grow="1" min-width="0">
            <if test="{sidebarLauncherVisible}">
              <use template="app-mobile-header" app_icon="{app_icon}"/>
            </if>
            <slot/>
          </column>

          <use
            template="app-footer"
            bagong_logo="{bagong_logo}"
            bir_logo="{bir_logo}"
            goldcoders_logo="{goldcoders_logo}"/>
        </column>
      </row>
    </column>

    <!--
      Native has a bottom drawer and a right sheet, but no left sheet. A root
      stack gives this full-height sidebar the correct left edge and a real
      click-away scrim without changing the page's flow geometry.
    -->
    <if test="{sidebarOverlayVisible}">
      <column grow="1">
        <row grow="1">
          <use
            template="app-sidebar-full"
            brand_logo="{brand_logo}"
            overlay="true"/>
          <status-bar
            grow="1"
            background="shadow"
            border-color="shadow"
            on-press="close_sidebar_overlay"
            label="Close navigation">
          </status-bar>
        </row>
      </column>
    </if>
  </stack>
</template>

<!--
  Reusable view contract for the app's bounded multi-select state.

  The host supplies derived option rows and summary flags. The fixed
  multi_select_* messages form the adapter seam to the host model:
    - multi_select_open / multi_select_close
    - multi_select_query_changed
    - multi_select_toggle_option:{option.id}
    - multi_select_select_all_filtered / multi_select_clear_all
-->
<template
  name="multi-select-combobox"
  args="value query open options allselected hiddencount width menuheight placeholder label">
  <stack width="{width}">
    <!-- The summary trigger and search editor are deliberately separate.
         Mounting a menu around the same editor that initiated the click
         creates a focus/dismiss race on AppKit. -->
    <select
      size="sm"
      placeholder="Select options..."
      label="{label}"
      on-press="multi_select_open">{value}</select>

    <if test="{open}">
      <dropdown-menu
        anchor="below"
        anchor-alignment="stretch"
        anchor-offset="4"
        height="{menuheight}"
        on-dismiss="multi_select_close">
        <input
          size="sm"
          text="{query}"
          placeholder="{placeholder}"
          autofocus="true"
          on-input="multi_select_query_changed"/>

        <separator/>

        <if test="{allselected}">
          <menu-item icon="x" on-press="multi_select_clear_all">Deselect All</menu-item>
        </if>
        <else>
          <menu-item icon="check" on-press="multi_select_select_all_filtered">Select All</menu-item>
        </else>

        <menu-item icon="x-circle" on-press="multi_select_clear_all">Clear All</menu-item>

        <separator/>

        <for each="options" key="id" as="option">
          <if test="{option.selected}">
            <menu-item
              selected="true"
              on-press="multi_select_toggle_option:{option.id}">{option.label}</menu-item>
          </if>
          <else>
            <menu-item
              selected="false"
              on-press="multi_select_toggle_option:{option.id}">{option.label}</menu-item>
          </else>
        </for>
        <else>
          <menu-item disabled="true">No matching options</menu-item>
        </else>

        <if test="{hiddencount > 0}">
          <separator/>
          <menu-item disabled="true">{hiddencount} more matches - keep typing</menu-item>
        </if>
      </dropdown-menu>
    </if>
  </stack>
</template>

<template name="global-deadline-row" args="date form title detail">
  <card padding="0">
    <row padding="12" gap="14" cross="center">
      <card padding="0" background="surface_subtle">
        <column width="54" height="54" main="center" cross="center" gap="1">
          <text foreground="text_muted"><span weight="bold">JUL</span></text>
          <text size="heading"><span weight="bold">{date}</span></text>
        </column>
      </card>
      <column grow="1" gap="4">
        <text><span weight="bold">{form}</span></text>
        <text wrap="true" foreground="text_muted">{title}</text>
        <if test="{detail}">
          <text wrap="true" foreground="text_muted">{detail}</text>
        </if>
      </column>
    </row>
  </card>
</template>

<template name="global-news-item" args="title body meta">
  <card padding="0">
    <column padding="16" gap="8">
      <row cross="center" gap="8">
        <badge variant="secondary">RSS Feed</badge>
        <text grow="1" text-alignment="end" foreground="text_muted">{meta}</text>
      </row>
      <text><span weight="bold">{title}</span></text>
      <text wrap="true" foreground="text_muted">{body}</text>
    </column>
  </card>
</template>

<template name="global-calendar-weekday" args="label">
  <column height="34" padding="6" main="center" cross="center" background="surface_subtle">
    <text text-alignment="center" foreground="text_muted">
      <span weight="bold">{label}</span>
    </text>
  </column>
</template>

<template name="global-calendar-day" args="day marker=">
  <column height="58" padding="7" main="space_between" cross="stretch" background="surface">
    <text text-alignment="end">{day}</text>
    <if test="{marker}">
      <text text-alignment="center" foreground="destructive">{marker}</text>
    </if>
  </column>
</template>

<template name="global-calendar-warning-day" args="day marker=">
  <column height="58" padding="7" main="space_between" cross="stretch" background="surface">
    <text text-alignment="end">{day}</text>
    <if test="{marker}">
      <text text-alignment="center" foreground="warning">{marker}</text>
    </if>
  </column>
</template>

<template name="global-calendar-empty">
  <column height="58" background="surface_subtle"></column>
</template>

<template name="global-calendar-today">
  <column height="58" padding="7" main="space_between" cross="stretch" background="surface">
    <row main="end">
      <badge variant="outline">29</badge>
    </row>
    <spacer/>
  </column>
</template>

<template name="global-calendar-column">
  <column grow="1" gap="12">
    <if test="{constrainedLayout}">
      <column gap="10">
        <text><span weight="bold">Compliance Calendar</span></text>
        <use
          template="multi-select-combobox"
          value="{formFilterText}"
          query="{formFilterQuery}"
          open="{formFilterOpen}"
          options="{visibleFormOptions}"
          allselected="{formFilterAllFilteredSelected}"
          hiddencount="{formFilterHiddenCount}"
          width="240"
          menuheight="420"
          placeholder="Search form codes..."
          label="Filter compliance calendar forms"/>
      </column>
    </if>
    <else>
      <row cross="center" gap="12">
        <text grow="1"><span weight="bold">Compliance Calendar</span></text>
        <use
          template="multi-select-combobox"
          value="{formFilterText}"
          query="{formFilterQuery}"
          open="{formFilterOpen}"
          options="{visibleFormOptions}"
          allselected="{formFilterAllFilteredSelected}"
          hiddencount="{formFilterHiddenCount}"
          width="240"
          menuheight="420"
          placeholder="Search form codes..."
          label="Filter compliance calendar forms"/>
      </row>
    </else>

    <card padding="0">
      <column gap="0">
        <row padding="12" cross="center" gap="8">
          <text grow="1"><span weight="bold">July 2026</span></text>
          <row padding="4" cross="center" gap="2" background="surface_subtle" radius="md">
            <button
              size="sm"
              variant="ghost"
              icon="chevron-left"
              label="Previous month"></button>
            <button
              size="sm"
              variant="ghost"
              icon="chevron-right"
              label="Next month"></button>
          </row>
        </row>
        <separator/>
        <grid columns="7" gap="1" background="border">
          <use template="global-calendar-weekday" label="Sun"/>
          <use template="global-calendar-weekday" label="Mon"/>
          <use template="global-calendar-weekday" label="Tue"/>
          <use template="global-calendar-weekday" label="Wed"/>
          <use template="global-calendar-weekday" label="Thu"/>
          <use template="global-calendar-weekday" label="Fri"/>
          <use template="global-calendar-weekday" label="Sat"/>

          <use template="global-calendar-empty"/>
          <use template="global-calendar-empty"/>
          <use template="global-calendar-empty"/>
          <use template="global-calendar-day" day="1"/>
          <use template="global-calendar-day" day="2"/>
          <use template="global-calendar-day" day="3"/>
          <use template="global-calendar-day" day="4"/>

          <use template="global-calendar-day" day="5"/>
          <use template="global-calendar-day" day="6"/>
          <use template="global-calendar-day" day="7"/>
          <use template="global-calendar-day" day="8"/>
          <use template="global-calendar-day" day="9"/>
          <use template="global-calendar-day" day="10" marker="{calendarDay10Marker}"/>
          <use template="global-calendar-day" day="11"/>

          <use template="global-calendar-day" day="12"/>
          <use template="global-calendar-day" day="13"/>
          <use template="global-calendar-day" day="14"/>
          <use template="global-calendar-day" day="15" marker="{calendarDay15Marker}"/>
          <use template="global-calendar-day" day="16"/>
          <use template="global-calendar-day" day="17"/>
          <use template="global-calendar-day" day="18"/>

          <use template="global-calendar-day" day="19"/>
          <use template="global-calendar-day" day="20"/>
          <use template="global-calendar-day" day="21"/>
          <use template="global-calendar-day" day="22"/>
          <use template="global-calendar-day" day="23"/>
          <use template="global-calendar-day" day="24"/>
          <use template="global-calendar-day" day="25"/>

          <use template="global-calendar-day" day="26"/>
          <use template="global-calendar-day" day="27" marker="{calendarDay27Marker}"/>
          <use template="global-calendar-day" day="28"/>
          <use template="global-calendar-today"/>
          <use template="global-calendar-day" day="30"/>
          <use
            template="global-calendar-warning-day"
            day="31"
            marker="{calendarDay31Marker}"/>
          <use template="global-calendar-empty"/>
        </grid>
      </column>
    </card>

    <text><span weight="bold">Deadlines for July 2026</span></text>
    <if test="{hasVisibleGlobalDeadlines}">
      <for each="visibleGlobalDeadlines" key="id" as="deadline">
        <use
          template="global-deadline-row"
          date="{deadline.day}"
          form="{deadline.form}"
          title="{deadline.title}"
          detail="{deadline.detail}"/>
      </for>
    </if>
    <else>
      <card padding="0">
        <column padding="24" gap="8" cross="center">
          <icon name="file-text" foreground="text_muted" width="22" height="22"/>
          <text><span weight="bold">No upcoming deadlines</span></text>
          <text wrap="true" text-alignment="center" foreground="text_muted">
            Select one or more forms to show their July filing deadlines.
          </text>
        </column>
      </card>
    </else>
  </column>
</template>

<template name="global-news-column">
  <column grow="1" gap="12">
    <row cross="center" gap="12">
      <text grow="1"><span weight="bold">Important News</span></text>
      <button size="sm" variant="secondary">Refresh</button>
    </row>

    <use
      template="global-news-item"
      title="Executive Order No. 115, s. 2026"
      body="STRENGTHENING THE TECHNICAL COOPERATION COUNCIL OF THE PHILIPPINES"
      meta="Wed, 29 Apr 2026 02:00:36 +0000"/>
    <use
      template="global-news-item"
      title="Republic Act No. 12321"
      body="AN ACT INSTITUTIONALIZING SUPPORT FOR PUBLIC BASIC EDUCATION SCHOOLS IN GEOGRAPHICALLY ISOLATED AND DISADVANTAGED AREAS (GIDA) AND UNDERSERVED COMMUNITIES, AND APPROPRIATING FUNDS THEREFOR"
      meta="Wed, 22 Jul 2026 03:04:07 +0000"/>
    <use
      template="global-news-item"
      title="DMW-Advisory No. 44, s. 2026"
      body="OWWA E-CARD AS AN OFW'S PRIMARY IDENTIFICATION CARD AND VALID GOVERNMENT-ISSUED ID"
      meta="Wed, 15 Jul 2026 02:00:38 +0000"/>
    <use
      template="global-news-item"
      title="Executive Order No. 118, s. 2026"
      body="MALACAÑAN PALACE MANILA BY THE PRESIDENT OF THE PHILIPPINES EXECUTIVE ORDER NO. 118 IMPOSITION OF A MANDATED PRICE CEILING ON IMPORTED RICE"
      meta="Wed, 13 May 2026 08:00:36 +0000"/>
    <use
      template="global-news-item"
      title="Proclamation No. 1317 s. 2026"
      body="DECLARING WEDNESDAY, 01 JULY 2026 AS A SPECIAL (NON-WORKING) DAY IN THE CITY OF DIPOLOG, PROVINCE OF ZAMBOANGA DEL NORTE"
      meta="Wed, 10 Jun 2026 04:05:31 +0000"/>
    <use
      template="global-news-item"
      title="Proclamation No. 1316 s. 2026"
      body="DECLARING WEDNESDAY, 01 JULY 2026, A SPECIAL (NON-WORKING) DAY IN THE MUNICIPALITY OF KIBAWE"
      meta="Wed, 10 Jun 2026 04:00:31 +0000"/>
  </column>
</template>

<template name="global-dashboard-content" args="padding">
  <column padding="{padding}" gap="32">
    <column gap="6">
      <text size="heading">Global Dashboard</text>
      <text wrap="true" foreground="text_muted">
        Overview of all taxpayer profiles for 2026
      </text>
    </column>

    <if test="{constrainedLayout}">
      <column gap="24">
        <use template="global-calendar-column"/>
        <use template="global-news-column"/>
      </column>
    </if>
    <else>
      <row gap="20" cross="start">
        <use template="global-calendar-column"/>
        <use template="global-news-column"/>
      </row>
    </else>
  </column>
</template>

<template name="global-dashboard-page">
  <scroll grow="1" global-key="page-global-dashboard" label="Global dashboard content">
    <if test="{phoneLayout}">
      <use template="global-dashboard-content" padding="16"/>
    </if>
    <else>
      <if test="{desktopLayout}">
        <use template="global-dashboard-content" padding="32"/>
      </if>
      <else>
        <use template="global-dashboard-content" padding="24"/>
      </else>
    </else>
  </scroll>
</template>

<template name="taxpayer-empty-card" args="title icon body">
  <card>
    <column padding="20" gap="16">
      <row gap="10" cross="center">
        <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
        <text><span weight="bold">{title}</span></text>
      </row>
      <column height="154" main="center" cross="center" gap="10">
        <icon name="check-circle" foreground="success" width="34" height="34"/>
        <text><span weight="bold">Nothing here</span></text>
        <text wrap="true" text-alignment="center" foreground="text_muted">{body}</text>
      </column>
    </column>
  </card>
</template>

<template name="taxpayer-form-launcher" args="code title body">
  <card>
    <column padding="16" gap="10">
      <row cross="center">
        <badge variant="secondary">{code}</badge>
      </row>
      <text><span weight="bold">{title}</span></text>
      <text wrap="true" foreground="text_muted">{body}</text>
      <slot/>
    </column>
  </card>
</template>

<template name="taxpayer-form-library-column-a">
  <column grow="1" gap="12">
    <use
      template="taxpayer-form-launcher"
      code="0605"
      title="Payment Form"
      body="Prepare a payment reference for taxes and fees without a dedicated return.">
      <button variant="secondary" icon="file-text" on-press="show_form_0605">Open Form 0605</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="0619-E"
      title="Creditable Income Taxes Withheld"
      body="Monthly remittance form for expanded withholding tax.">
      <button variant="secondary" icon="file-text" on-press="show_form_0619_e">Open Form 0619-E</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="0619-F"
      title="Final Income Taxes Withheld"
      body="Monthly remittance form for final withholding tax.">
      <button variant="secondary" icon="file-text" on-press="show_form_0619_f">Open Form 0619-F</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1601-C"
      title="Compensation Withholding"
      body="Monthly remittance return for taxes withheld on compensation.">
      <button variant="secondary" icon="file-text" on-press="show_form_1601_c">Open Form 1601-C</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1701"
      title="Annual Individual Income Tax Return"
      body="Annual return for individuals, estates, and trusts.">
      <button variant="secondary" icon="file-text" on-press="show_form_1701">Open Form 1701</button>
    </use>
  </column>
</template>

<template name="taxpayer-form-library-column-b">
  <column grow="1" gap="12">
    <use
      template="taxpayer-form-launcher"
      code="1701Q"
      title="Quarterly Individual Income Tax Return"
      body="Quarterly return for self-employed individuals and professionals.">
      <button variant="secondary" icon="file-text" on-press="show_form_1701q">Open Form 1701Q</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1702-RT"
      title="Regular-Rate Corporation Income Tax Return"
      body="Annual corporate return for taxpayers subject only to the regular rate.">
      <button variant="secondary" icon="file-text" on-press="show_form_1702_rt">Open Form 1702-RT</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1702-MX"
      title="Mixed-Income Corporation Income Tax Return"
      body="Annual corporate return for mixed or special tax regimes.">
      <button variant="secondary" icon="file-text" on-press="show_form_1702_mx">Open Form 1702-MX</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="2550Q"
      title="Quarterly VAT Return"
      body="Quarterly value-added tax return for VAT-registered taxpayers.">
      <button variant="secondary" icon="file-text" on-press="show_form_2550q">Open Form 2550Q</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="2551Q"
      title="Quarterly Percentage Tax Return"
      body="Quarterly return for taxpayers subject to percentage tax.">
      <button variant="secondary" icon="file-text" on-press="show_form_2551q">Open Form 2551Q</button>
    </use>
  </column>
</template>

<template name="taxpayer-calendar-section">
  <column gap="24">
    <row cross="center" gap="12">
      <column grow="1" gap="4">
        <text><span weight="bold">Taxpayer Calendar</span></text>
        <text wrap="true" foreground="text_muted">
          For now, Add to Calendar includes every supported form. Once this
          profile has a registered Forms Set, only its forms will be included.
        </text>
      </column>
      <badge variant="secondary">{currentCalendarYear}</badge>
    </row>

    <if test="{profileCalendarExportNoticeVisible}">
      <badge variant="{profileCalendarExportNoticeTone}">{profileCalendarExportNotice}</badge>
    </if>

    <if test="{constrainedLayout}">
      <column gap="20">
        <use
          template="taxpayer-empty-card"
          title="Upcoming Deadlines"
          icon="clock"
          body="Profile-specific deadlines will appear when its registered Forms Set is available."/>
        <use
          template="taxpayer-empty-card"
          title="Action Required"
          icon="alert"
          body="No forms currently require your attention."/>
      </column>
    </if>
    <else>
      <row gap="20" cross="start">
        <column grow="1">
          <use
            template="taxpayer-empty-card"
            title="Upcoming Deadlines"
            icon="clock"
            body="Profile-specific deadlines will appear when its registered Forms Set is available."/>
        </column>
        <column grow="1">
          <use
            template="taxpayer-empty-card"
            title="Action Required"
            icon="alert"
            body="No forms currently require your attention."/>
        </column>
      </row>
    </else>

  </column>
</template>

<template name="taxpayer-form-library-section">
  <column gap="16">
    <column gap="4">
      <text><span weight="bold">Tax Form Library</span></text>
      <text wrap="true" foreground="text_muted">
        Choose a reconstructed return to review its static Native layout.
      </text>
    </column>
    <if test="{constrainedLayout}">
      <column gap="12">
        <use template="taxpayer-form-library-column-a"/>
        <use template="taxpayer-form-library-column-b"/>
      </column>
    </if>
    <else>
      <row gap="20" cross="start">
        <use template="taxpayer-form-library-column-a"/>
        <use template="taxpayer-form-library-column-b"/>
      </row>
    </else>
  </column>
</template>

<template name="taxpayer-dashboard-content" args="padding">
  <column padding="{padding}" gap="24">
    <if test="{phoneLayout}">
      <row gap="12" cross="center">
        <avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
        <column grow="1" gap="5">
          <text size="heading" wrap="true">{selectedTaxpayerName}</text>
          <text wrap="true" foreground="text_muted">TIN: {selectedTaxpayerTin}</text>
          <text wrap="true" foreground="text_muted">Type: {selectedTaxpayerKind} - Tax Year 2026 - Non-VAT</text>
        </column>
        <stack>
          <button
            size="sm"
            variant="outline"
            icon="wrench"
            on-press="toggle_profile_actions">Actions</button>
          <if test="{profileActionsOpen}">
            <dropdown-menu
              anchor="below"
              anchor-alignment="end"
              on-dismiss="close_profile_actions">
              <menu-item
                icon="clock"
                disabled="{profileCalendarExportBusy}"
                on-press="profile_calendar_export">Add to Calendar</menu-item>
              <menu-item icon="settings" on-press="show_profile_setup">Profile Settings</menu-item>
            </dropdown-menu>
          </if>
        </stack>
      </row>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column gap="14">
          <row gap="12" cross="center">
            <avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
            <column grow="1" gap="5">
              <text size="heading" wrap="true">{selectedTaxpayerName}</text>
              <text wrap="true" foreground="text_muted">TIN: {selectedTaxpayerTin}</text>
              <text wrap="true" foreground="text_muted">Type: {selectedTaxpayerKind} - Tax Year 2026 - Non-VAT</text>
            </column>
          </row>
          <row gap="10">
            <button variant="primary" icon="clock" disabled="{profileCalendarExportBusy}" on-press="profile_calendar_export">Add to Calendar</button>
            <button variant="outline" icon="settings" on-press="show_profile_setup">Profile Settings</button>
          </row>
        </column>
      </if>
      <else>
        <row gap="16" cross="center">
          <avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
          <column grow="1" gap="6">
            <text size="heading">{selectedTaxpayerName}</text>
            <text wrap="true" foreground="text_muted">
              TIN: {selectedTaxpayerTin} - Type: {selectedTaxpayerKind} - Tax Year 2026 - Non-VAT
            </text>
          </column>
          <button variant="primary" icon="clock" disabled="{profileCalendarExportBusy}" on-press="profile_calendar_export">Add to Calendar</button>
          <button variant="outline" icon="settings" on-press="show_profile_setup">Profile Settings</button>
        </row>
      </else>
    </else>

    <card>
      <column padding="16" gap="12">
        <if test="{constrainedLayout}">
          <column gap="12">
            <search-field disabled="true" placeholder="Search tax forms" label="Search tax forms"/>
            <select disabled="true" text="Tax Year 2026" label="Tax year"/>
            <button variant="outline" icon="refresh-cw" disabled="true">Refresh</button>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <search-field grow="1" disabled="true" placeholder="Search tax forms" label="Search tax forms"/>
            <select disabled="true" text="Tax Year 2026" label="Tax year"/>
            <button variant="outline" icon="refresh-cw" disabled="true">Refresh</button>
          </row>
        </else>
        <tabs gap="4" label="Dashboard view">
          <button
            variant="ghost"
            icon="file-text"
            selected="{dashboardCalendarActive}"
            on-press="show_dashboard_calendar">Calendar</button>
          <button
            variant="ghost"
            icon="folder-open"
            selected="{dashboardFormsActive}"
            on-press="show_dashboard_forms">Tax Form Library</button>
        </tabs>
      </column>
    </card>

    <if test="{dashboardCalendarActive}">
      <use template="taxpayer-calendar-section"/>
    </if>
    <if test="{dashboardFormsActive}">
      <use template="taxpayer-form-library-section"/>
    </if>
  </column>
</template>

<template name="taxpayer-dashboard-page">
  <scroll grow="1" global-key="page-taxpayer-dashboard" label="Taxpayer dashboard content">
    <if test="{phoneLayout}">
      <use template="taxpayer-dashboard-content" padding="16"/>
    </if>
    <else>
      <if test="{desktopLayout}">
        <use template="taxpayer-dashboard-content" padding="32"/>
      </if>
      <else>
        <use template="taxpayer-dashboard-content" padding="24"/>
      </else>
    </else>
  </scroll>
</template>

<template name="profile-text-field" args="field_label value">
  <column grow="1" gap="6">
    <text foreground="text_muted">{field_label}</text>
    <card>
      <row padding="11" cross="center">
        <text grow="1">{value}</text>
      </row>
    </card>
  </column>
</template>

<template name="profile-select-field" args="field_label value">
  <column grow="1" gap="6">
    <text foreground="text_muted">{field_label}</text>
    <card>
      <row padding="11" gap="8" cross="center">
        <text grow="1">{value}</text>
        <icon name="chevron-down" foreground="text_muted" width="16" height="16"/>
      </row>
    </card>
  </column>
</template>

<template name="profile-setup-content">
  <column gap="24">
    <column gap="6">
      <text size="heading">Taxpayer Profile Setup</text>
      <text wrap="true" foreground="text_muted">Required information is used to pre-fill 2551Q.</text>
    </column>

    <if test="{constrainedLayout}">
      <column gap="4" label="Profile setup sections">
        <button
          variant="ghost"
          selected="{profileTaxActive}"
          on-press="show_profile_tax">
          Tax Profile
        </button>
        <button
          variant="ghost"
          selected="{profileCertificateActive}"
          on-press="show_profile_certificate">
          COR
        </button>
        <button
          variant="ghost"
          selected="{profileEmailActive}"
          on-press="show_profile_email">
          Email Settings
        </button>
      </column>
    </if>
    <else>
      <tabs gap="4" label="Profile setup sections">
        <button
          variant="ghost"
          selected="{profileTaxActive}"
          on-press="show_profile_tax">
          Tax Profile
        </button>
        <button
          variant="ghost"
          selected="{profileCertificateActive}"
          on-press="show_profile_certificate">
          COR
        </button>
        <button
          variant="ghost"
          selected="{profileEmailActive}"
          on-press="show_profile_email">
          Email Settings
        </button>
      </tabs>
    </else>

    <if test="{profileTaxActive}">
      <column gap="24">
        <card>
          <column padding="24" gap="20">
        <column gap="4">
          <text><span weight="bold">Registration Details</span></text>
          <text wrap="true" foreground="text_muted">Information from the taxpayer certificate of registration</text>
        </column>

        <if test="{constrainedLayout}">
          <column gap="16">
            <use
              template="profile-text-field"
              field_label="Taxpayer Identification Number (TIN)"
              value="000-000-000-00000"/>
            <use
              template="profile-select-field"
              field_label="Revenue District Office (RDO)"
              value="RDO 040 - Cubao"/>
          </column>
        </if>
        <else>
          <row gap="16" cross="start">
            <use
              template="profile-text-field"
              field_label="Taxpayer Identification Number (TIN)"
              value="000-000-000-00000"/>
            <use
              template="profile-select-field"
              field_label="Revenue District Office (RDO)"
              value="RDO 040 - Cubao"/>
          </row>
        </else>

        <if test="{constrainedLayout}">
          <column gap="16">
            <use
              template="profile-select-field"
              field_label="Taxpayer Type"
              value="Individual"/>
            <use
              template="profile-select-field"
              field_label="Tax Classification"
              value="Non-VAT Registered"/>
          </column>
        </if>
        <else>
          <row gap="16" cross="start">
            <use
              template="profile-select-field"
              field_label="Taxpayer Type"
              value="Individual"/>
            <use
              template="profile-select-field"
              field_label="Tax Classification"
              value="Non-VAT Registered"/>
          </row>
        </else>

        <if test="{constrainedLayout}">
          <column gap="16">
            <use
              template="profile-select-field"
              field_label="EOPT Tier"
              value="Micro Taxpayer"/>
            <use
              template="profile-text-field"
              field_label="Line of Business"
              value="Professional Services"/>
          </column>
        </if>
        <else>
          <row gap="16" cross="start">
            <use
              template="profile-select-field"
              field_label="EOPT Tier"
              value="Micro Taxpayer"/>
            <use
              template="profile-text-field"
              field_label="Line of Business"
              value="Professional Services"/>
          </row>
        </else>
          </column>
        </card>

        <card>
          <column padding="24" gap="20">
        <column gap="4">
          <text><span weight="bold">Taxpayer Information</span></text>
          <text wrap="true" foreground="text_muted">Contact and registered address details</text>
        </column>

        <use
          template="profile-text-field"
          field_label="Taxpayer Name"
          value="Juan Dela Cruz"/>

        <use
          template="profile-text-field"
          field_label="Registered Address"
          value="123 Sample Street, Quezon City"/>

        <if test="{constrainedLayout}">
          <column gap="16">
            <use
              template="profile-text-field"
              field_label="Zip Code"
              value="1100"/>
            <use
              template="profile-text-field"
              field_label="Phone Number"
              value="+63 900 000 0000"/>
          </column>
        </if>
        <else>
          <row gap="16" cross="start">
            <use
              template="profile-text-field"
              field_label="Zip Code"
              value="1100"/>
            <use
              template="profile-text-field"
              field_label="Phone Number"
              value="+63 900 000 0000"/>
          </row>
        </else>

        <if test="{constrainedLayout}">
          <column gap="16">
            <use
              template="profile-text-field"
              field_label="Email Address"
              value="demo@example.com"/>
            <use
              template="profile-text-field"
              field_label="Birth Date"
              value="January 01, 1990"/>
          </column>
        </if>
        <else>
          <row gap="16" cross="start">
            <use
              template="profile-text-field"
              field_label="Email Address"
              value="demo@example.com"/>
            <use
              template="profile-text-field"
              field_label="Birth Date"
              value="January 01, 1990"/>
          </row>
        </else>
          </column>
        </card>
      </column>
    </if>

    <if test="{profileCertificateActive}">
      <card>
        <column padding="24" gap="20">
          <column gap="4">
            <text><span weight="bold">Certificate of Registration</span></text>
            <text wrap="true" foreground="text_muted">Static COR details associated with this taxpayer profile.</text>
          </column>
          <use
            template="profile-text-field"
            field_label="Certificate Number"
            value="OCN-2026-0001842"/>
          <use
            template="profile-text-field"
            field_label="Registration Date"
            value="January 01, 2020"/>
          <use
            template="profile-text-field"
            field_label="Registered Tax Types"
            value="Percentage Tax, Income Tax"/>
          <button variant="outline" icon="folder-open" disabled="true">Replace COR Attachment</button>
        </column>
      </card>
    </if>

    <if test="{profileEmailActive}">
      <card>
        <column padding="24" gap="20">
          <column gap="4">
            <text><span weight="bold">Email Settings</span></text>
            <text wrap="true" foreground="text_muted">Mailbox details used to monitor filing confirmation receipts.</text>
          </column>
          <use
            template="profile-text-field"
            field_label="Email Address"
            value="demo@example.com"/>
          <use
            template="profile-text-field"
            field_label="Incoming Mail Server"
            value="imap.example.com"/>
          <use
            template="profile-select-field"
            field_label="Confirmation Monitoring"
            value="Enabled"/>
          <button variant="outline" icon="send" disabled="true">Send Test Email</button>
        </column>
      </card>
    </if>

    <if test="{constrainedLayout}">
      <column gap="10">
        <button variant="outline" on-press="go_back">Cancel</button>
        <button variant="primary" icon="save" disabled="true">Save Profile</button>
      </column>
    </if>
    <else>
      <row main="end" gap="12">
        <button variant="outline" on-press="go_back">Cancel</button>
        <button variant="primary" icon="save" disabled="true">Save Profile</button>
      </row>
    </else>
  </column>
</template>

<template name="profile-setup-page">
  <scroll grow="1" global-key="page-profile-setup" label="Taxpayer profile setup content">
    <if test="{phoneLayout}">
      <column padding="16">
        <use template="profile-setup-content"/>
      </column>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column padding="20">
          <use template="profile-setup-content"/>
        </column>
      </if>
      <else>
        <column padding="32">
          <use template="profile-setup-content"/>
        </column>
      </else>
    </else>
  </scroll>
</template>

<template name="import-data-content">
  <column gap="24">
    <column gap="6">
      <text size="heading">Import Data</text>
      <text wrap="true" foreground="text_muted">Import a profile or database backup from a .zip file.</text>
    </column>

    <card>
      <column padding="24" gap="20">
        <if test="{constrainedLayout}">
          <column gap="14">
            <row gap="14" cross="center">
              <icon name="download" foreground="accent" width="36" height="36"/>
              <column grow="1" gap="5">
                <text><span weight="bold">Smart Import</span></text>
                <text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text>
              </column>
            </row>
            <row cross="center">
              <badge variant="secondary">Recommended</badge>
            </row>
          </column>
        </if>
        <else>
          <row gap="16" cross="center">
            <icon name="download" foreground="accent" width="36" height="36"/>
            <column grow="1" gap="5">
              <text><span weight="bold">Smart Import</span></text>
              <text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text>
            </column>
            <badge variant="secondary">Recommended</badge>
          </row>
        </else>

        <separator/>

        <text wrap="true">
          Smart Import inspects the selected .zip file and determines whether it contains a taxpayer profile or a complete database backup.
        </text>

        <card>
          <column padding="24" gap="14" cross="center">
            <icon name="archive" foreground="text_muted" width="42" height="42"/>
            <text text-alignment="center"><span weight="bold">Choose an eBIRForms archive</span></text>
            <text foreground="text_muted">Supported file type: .zip</text>
            <button variant="primary" icon="folder-open" disabled="true">Smart Import</button>
          </column>
        </card>

        <row gap="12" cross="start">
          <icon name="info" foreground="info" width="20" height="20"/>
          <column grow="1" gap="5">
            <text><span weight="bold">Before importing</span></text>
            <text wrap="true" foreground="text_muted">
              Keep a current backup of your existing profiles. Imported data should come from a trusted eBIRForms export.
            </text>
          </column>
        </row>
      </column>
    </card>

    <card>
      <column padding="20" gap="12">
        <text><span weight="bold">What Smart Import can recognize</span></text>
        <row gap="12" cross="start">
          <icon name="check-circle" foreground="success" width="18" height="18"/>
          <text wrap="true" grow="1">Single taxpayer profile exports</text>
        </row>
        <row gap="12" cross="start">
          <icon name="check-circle" foreground="success" width="18" height="18"/>
          <text wrap="true" grow="1">Full database backup archives</text>
        </row>
        <row gap="12" cross="start">
          <icon name="check-circle" foreground="success" width="18" height="18"/>
          <text wrap="true" grow="1">Compatible static form and calendar data</text>
        </row>
      </column>
    </card>
  </column>
</template>

<template name="import-data-page">
  <scroll grow="1" global-key="page-import-data" label="Import data content">
    <if test="{phoneLayout}">
      <column padding="16">
        <use template="import-data-content"/>
      </column>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column padding="20">
          <use template="import-data-content"/>
        </column>
      </if>
      <else>
        <column padding="32">
          <use template="import-data-content"/>
        </column>
      </else>
    </else>
  </scroll>
</template>

<template name="background-job-card" args="title description source cadence next_run">
  <card>
    <column padding="20" gap="14">
      <if test="{constrainedLayout}">
        <column gap="12">
          <row gap="12" cross="start">
            <icon name="clock" foreground="warning" width="22" height="22"/>
            <column grow="1" gap="4">
              <text><span weight="bold">{title}</span></text>
              <text wrap="true" foreground="text_muted">{description}</text>
            </column>
          </row>
          <row cross="center">
            <badge variant="secondary">Queued</badge>
          </row>
        </column>
      </if>
      <else>
        <row gap="12" cross="center">
          <icon name="clock" foreground="warning" width="22" height="22"/>
          <column grow="1" gap="4">
            <text><span weight="bold">{title}</span></text>
            <text wrap="true" foreground="text_muted">{description}</text>
          </column>
          <badge variant="secondary">Queued</badge>
        </row>
      </else>

      <separator/>

      <if test="{constrainedLayout}">
        <column gap="14">
          <column gap="5">
            <text foreground="text_muted">Source</text>
            <text>{source}</text>
          </column>
          <column gap="5">
            <text foreground="text_muted">Schedule</text>
            <text>{cadence}</text>
          </column>
          <column gap="5">
            <text foreground="text_muted">Next run</text>
            <text>{next_run}</text>
          </column>
        </column>
      </if>
      <else>
        <row gap="24" cross="start">
          <column grow="1" gap="5">
            <text foreground="text_muted">Source</text>
            <text>{source}</text>
          </column>
          <column grow="1" gap="5">
            <text foreground="text_muted">Schedule</text>
            <text>{cadence}</text>
          </column>
          <column grow="1" gap="5">
            <text foreground="text_muted">Next run</text>
            <text>{next_run}</text>
          </column>
        </row>
      </else>

      <text wrap="true" foreground="text_muted">Status: Queued - Retries: 0</text>

      <if test="{constrainedLayout}">
        <column gap="8">
          <button
            size="sm"
            variant="ghost"
            icon="eye"
            on-press="show_aux_background_task_debug_log">
            View Job
          </button>
          <button size="sm" variant="outline" icon="play" disabled="true">Run Now</button>
          <button size="sm" variant="outline" icon="archive" disabled="true">Archive</button>
          <button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button>
        </column>
      </if>
      <else>
        <row main="end" gap="8">
          <button
            size="sm"
            variant="ghost"
            icon="eye"
            on-press="show_aux_background_task_debug_log">
            View Job
          </button>
          <button size="sm" variant="outline" icon="play" disabled="true">Run Now</button>
          <button size="sm" variant="outline" icon="archive" disabled="true">Archive</button>
          <button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button>
        </row>
      </else>
    </column>
  </card>
</template>

<template name="background-jobs-content">
  <column gap="24">
    <card>
      <column padding="16" gap="12">
        <if test="{constrainedLayout}">
          <column gap="10">
            <select text="Queued" label="Job status"/>
            <search-field placeholder="Search jobs" label="Search background jobs"/>
            <select text="Archive Days: 30" label="Archive retention"/>
            <button variant="outline" icon="archive" disabled="true">Purge Archives</button>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <select text="Queued" label="Job status"/>
            <search-field grow="1" placeholder="Search jobs" label="Search background jobs"/>
            <select text="Archive Days: 30" label="Archive retention"/>
            <button variant="outline" icon="archive" disabled="true">Purge Archives</button>
          </row>
        </else>
        <row gap="8" cross="center">
          <badge variant="secondary">1 queued</badge>
          <text wrap="true" foreground="text_muted">Last checked moments ago</text>
        </row>
      </column>
    </card>

    <use
      template="background-job-card"
      title="Waiting for 2551Q confirmation email"
      description="Checks demo@example.com for the filing confirmation message."
      source="System"
      cadence="Every minute"
      next_run="Past due"/>

  </column>
</template>

<template name="background-logs-content">
  <card>
    <column padding="20" gap="14">
      <row gap="10" cross="center">
        <icon name="terminal" foreground="accent" width="22" height="22"/>
        <column grow="1" gap="4">
          <text><span weight="bold">Recent task logs</span></text>
          <text wrap="true" foreground="text_muted">Static diagnostic entries from the desktop application.</text>
        </column>
      </row>
      <separator/>
      <button
        variant="ghost"
        icon="eye"
        on-press="show_aux_background_task_debug_log">
        Open Poll eFPS Email Confirmations Log
      </button>
      <text wrap="true" foreground="text_muted">No other task logs are available in this static build.</text>
    </column>
  </card>
</template>

<template name="background-tasks-content">
  <column gap="24">
    <column gap="6">
      <text size="heading">Background Tasks</text>
      <text wrap="true" foreground="text_muted">Monitor scheduled jobs, email checks, and maintenance activity.</text>
    </column>

    <if test="{constrainedLayout}">
      <column gap="4" label="Background task sections">
        <button
          variant="ghost"
          selected="{backgroundJobsActive}"
          on-press="show_background_jobs">
          Jobs
        </button>
        <button
          variant="ghost"
          selected="{backgroundLogsActive}"
          on-press="show_background_logs">
          Logs
        </button>
      </column>
    </if>
    <else>
      <tabs gap="4" label="Background task sections">
        <button
          variant="ghost"
          selected="{backgroundJobsActive}"
          on-press="show_background_jobs">
          Jobs
        </button>
        <button
          variant="ghost"
          selected="{backgroundLogsActive}"
          on-press="show_background_logs">
          Logs
        </button>
      </tabs>
    </else>

    <if test="{backgroundJobsActive}">
      <use template="background-jobs-content"/>
    </if>
    <if test="{backgroundLogsActive}">
      <use template="background-logs-content"/>
    </if>

    <card>
      <column padding="18" gap="10">
        <row gap="10" cross="center">
          <icon name="info" foreground="info" width="20" height="20"/>
          <text><span weight="bold">Prototype task monitor</span></text>
        </row>
        <text wrap="true" foreground="text_muted">
          Job controls are presented to match the desktop application. This static milestone does not execute or modify background work.
        </text>
      </column>
    </card>
  </column>
</template>

<template name="background-tasks-page">
  <scroll grow="1" global-key="page-background-tasks" label="Background tasks content">
    <if test="{phoneLayout}">
      <column padding="16">
        <use template="background-tasks-content"/>
      </column>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column padding="20">
          <use template="background-tasks-content"/>
        </column>
      </if>
      <else>
        <column padding="32">
          <use template="background-tasks-content"/>
        </column>
      </else>
    </else>
  </scroll>
</template>

<template name="tax-calendar-deadlines-section">
  <column gap="12">
    <row cross="center" gap="12">
      <column grow="1" gap="4">
        <text><span weight="bold">{currentCalendarMonth} {currentCalendarYear} Deadlines</span></text>
        <text wrap="true" foreground="text_muted">
          The complete year is resolved and exported together. The explorer renders
          one month at a time to keep the native schedule fast and accessible.
        </text>
      </column>
      <badge variant="secondary">{calendarVisibleDeadlineCount}</badge>
    </row>

    <card>
      <row padding="12" gap="12" cross="center">
        <button
          size="sm"
          variant="outline"
          icon="chevron-left"
          label="Previous calendar month"
          on-press="calendar_previous_month"/>
        <column grow="1" gap="3" cross="center">
          <text><span weight="bold">{currentCalendarMonth} {currentCalendarYear}</span></text>
          <text foreground="text_muted">{calendarVisibleDeadlineCount}</text>
        </column>
        <button
          size="sm"
          variant="outline"
          icon="chevron-right"
          label="Next calendar month"
          on-press="calendar_next_month"/>
      </row>
    </card>

    <for each="calendarDeadlines" key="id" as="deadline">
      <card>
        <row padding="16" gap="12" cross="center">
          <column width="72" gap="3" cross="center">
            <text text-alignment="center"><span weight="bold">{deadline.dateLabel}</span></text>
            <text text-alignment="center" foreground="text_muted">{deadline.yearLabel}</text>
          </column>
          <separator/>
          <column grow="1" gap="6">
            <row gap="8" cross="center">
              <badge variant="{deadline.tone}">{deadline.display_form_no}</badge>
              <badge variant="{deadline.tone}">{deadline.statusLabel}</badge>
            </row>
            <text><span weight="bold">{deadline.form_name}</span></text>
            <text wrap="true" foreground="text_muted">Taxable period: {deadline.periodLabel}</text>
            <text wrap="true" foreground="text_muted">{deadline.description}</text>
            <if test="{deadline.adjustmentVisible}">
              <text wrap="true" foreground="accent">{deadline.adjustmentLabel}</text>
            </if>
            <if test="{deadline.sourceVisible}">
              <text wrap="true" foreground="text_muted">Source: {deadline.sourceLabel}</text>
            </if>
          </column>
        </row>
      </card>
    </for>
  </column>
</template>

<template name="tax-calendar-rules-section">
  <column gap="12">
    <column gap="4">
      <text><span weight="bold">Compiled Calendar Rules</span></text>
      <text wrap="true" foreground="text_muted">
        Shared form-deadline rules derived from the reference eBIRForms
        subsystem and checked against current BIR guidance. Event-based forms
        stay separate from dated deadlines.
      </text>
    </column>

    <for each="calendarRules" key="id" as="rule">
      <card>
        <column padding="20" gap="10">
          <row gap="8" cross="center">
            <badge variant="secondary">{rule.frequency}</badge>
            <text><span weight="bold">{rule.form_name}</span></text>
          </row>
          <text wrap="true" foreground="text_muted">Forms: {rule.form_codes}</text>
          <text wrap="true">{rule.description}</text>
        </column>
      </card>
    </for>

    <card>
      <column padding="20" gap="8">
        <text><span weight="bold">Source boundary</span></text>
        <text wrap="true" foreground="text_muted">
          This view is a calendar-year / non-eFPS baseline and includes mutually
          exclusive or conditional form alternatives. Current BIR issuances, the
          taxpayer's registered Forms Set, eFPS filer group, fiscal-year facts,
          and official holiday proclamations remain authoritative.
        </text>
      </column>
    </card>
  </column>
</template>

<template name="deadline-override-editor">
  <card>
    <column padding="20" gap="14">
      <text><span weight="bold">{overrideEditorTitle}</span></text>
      <text wrap="true" foreground="text_muted">
        Source and at least one recognized canonical form are required.
        Separate multiple values with commas.
      </text>
      <input
        text="{overrideTitleValue}"
        placeholder="Extension title"
        label="Override title"
        on-input="calendar_override_title_input"/>
      <input
        text="{overrideFormsValue}"
        placeholder="1701Q, 1702Q"
        label="Affected form codes"
        on-input="calendar_override_forms_input"/>
      <if test="{constrainedLayout}">
        <column gap="10">
          <input
            text="{overrideOriginalValue}"
            placeholder="YYYY-MM-DD"
            label="Original or operative deadline"
            on-input="calendar_override_original_input"/>
          <input
            text="{overrideAdjustedValue}"
            placeholder="YYYY-MM-DD"
            label="Adjusted deadline"
            on-input="calendar_override_adjusted_input"/>
        </column>
      </if>
      <else>
        <row gap="10">
          <input
            grow="1"
            text="{overrideOriginalValue}"
            placeholder="YYYY-MM-DD"
            label="Original or operative deadline"
            on-input="calendar_override_original_input"/>
          <input
            grow="1"
            text="{overrideAdjustedValue}"
            placeholder="YYYY-MM-DD"
            label="Adjusted deadline"
            on-input="calendar_override_adjusted_input"/>
        </row>
      </else>
      <input
        text="{overrideSourceValue}"
        placeholder="RMC / RR / advisory reference"
        label="Official source reference"
        on-input="calendar_override_source_input"/>
      <if test="{constrainedLayout}">
        <column gap="10">
          <input
            text="{overrideRegionsValue}"
            placeholder="Optional, e.g. NCR"
            label="Regions"
            on-input="calendar_override_regions_input"/>
          <input
            text="{overrideTaxpayerTypesValue}"
            placeholder="Optional, e.g. individual"
            label="Taxpayer types"
            on-input="calendar_override_taxpayer_types_input"/>
        </column>
      </if>
      <else>
        <row gap="10">
          <input
            grow="1"
            text="{overrideRegionsValue}"
            placeholder="Optional, e.g. NCR"
            label="Regions"
            on-input="calendar_override_regions_input"/>
          <input
            grow="1"
            text="{overrideTaxpayerTypesValue}"
            placeholder="Optional, e.g. individual"
            label="Taxpayer types"
            on-input="calendar_override_taxpayer_types_input"/>
        </row>
      </else>
      <if test="{constrainedLayout}">
        <column gap="10">
          <input
            text="{overrideEffectiveFromValue}"
            placeholder="Optional YYYY-MM-DD"
            label="Effective from"
            on-input="calendar_override_effective_from_input"/>
          <input
            text="{overrideEffectiveUntilValue}"
            placeholder="Optional YYYY-MM-DD"
            label="Effective until"
            on-input="calendar_override_effective_until_input"/>
          <input
            text="{overrideExpiresAtValue}"
            placeholder="Optional YYYY-MM-DD"
            label="Expires at"
            on-input="calendar_override_expires_at_input"/>
        </column>
      </if>
      <else>
        <row gap="10">
          <input
            grow="1"
            text="{overrideEffectiveFromValue}"
            placeholder="Optional YYYY-MM-DD"
            label="Effective from"
            on-input="calendar_override_effective_from_input"/>
          <input
            grow="1"
            text="{overrideEffectiveUntilValue}"
            placeholder="Optional YYYY-MM-DD"
            label="Effective until"
            on-input="calendar_override_effective_until_input"/>
          <input
            grow="1"
            text="{overrideExpiresAtValue}"
            placeholder="Optional YYYY-MM-DD"
            label="Expires at"
            on-input="calendar_override_expires_at_input"/>
        </row>
      </else>
      <row gap="10">
        <button variant="primary" icon="check" on-press="calendar_save_override">{overrideSaveLabel}</button>
        <button variant="outline" on-press="calendar_cancel_override">Clear</button>
      </row>
    </column>
  </card>
</template>

<template name="non-working-day-editor">
  <card>
    <column padding="20" gap="14">
      <text><span weight="bold">{nonWorkingDayEditorTitle}</span></text>
      <text wrap="true" foreground="text_muted">
        Kind must be regular, local, special, or closure. Only nationwide
        entries adjust the global explorer; regional entries remain stored
        for a future profile/region projection.
      </text>
      <if test="{constrainedLayout}">
        <column gap="10">
          <input
            text="{nonWorkingDateValue}"
            placeholder="YYYY-MM-DD"
            label="Date"
            on-input="calendar_non_working_date_input"/>
          <input
            text="{nonWorkingKindValue}"
            placeholder="regular"
            label="Kind"
            on-input="calendar_non_working_kind_input"/>
        </column>
      </if>
      <else>
        <row gap="10">
          <input
            grow="1"
            text="{nonWorkingDateValue}"
            placeholder="YYYY-MM-DD"
            label="Date"
            on-input="calendar_non_working_date_input"/>
          <input
            grow="1"
            text="{nonWorkingKindValue}"
            placeholder="regular"
            label="Kind"
            on-input="calendar_non_working_kind_input"/>
        </row>
      </else>
      <input
        text="{nonWorkingNameValue}"
        placeholder="Official holiday or closure name"
        label="Name"
        on-input="calendar_non_working_name_input"/>
      <input
        text="{nonWorkingSourceValue}"
        placeholder="Official Gazette / proclamation reference"
        label="Official source"
        on-input="calendar_non_working_source_input"/>
      <input
        text="{nonWorkingRegionsValue}"
        placeholder="Optional, e.g. NCR, Region IV-A"
        label="Regions"
        on-input="calendar_non_working_regions_input"/>
      <row gap="10">
        <button variant="primary" icon="check" on-press="calendar_save_non_working_day">{nonWorkingDaySaveLabel}</button>
        <button variant="outline" on-press="calendar_cancel_non_working_day">Clear</button>
      </row>
    </column>
  </card>
</template>

<template name="tax-calendar-overrides-section">
  <column gap="20">
    <if test="{calendarNoticeVisible}">
      <badge variant="{calendarNoticeTone}">{calendarNotice}</badge>
    </if>

    <column gap="10">
      <text><span weight="bold">Deadline Overrides</span></text>
      <text wrap="true" foreground="text_muted">
        Matching follows the reference resolver: form code plus original or
        already business-day-adjusted deadline; later matching overrides win.
        Region- or taxpayer-scoped overrides remain stored until profile facts
        are available to resolve them safely.
        Effective-range and expiry metadata are preserved separately in SQLite;
        like the reference resolver, they do not limit global matching yet.
      </text>
    </column>

    <if test="{calendarOverridesEmpty}">
      <card>
        <column padding="20" gap="8" cross="center">
          <icon name="clock" foreground="text_muted" width="30" height="30"/>
          <text><span weight="bold">No deadline overrides</span></text>
          <text wrap="true" text-alignment="center" foreground="text_muted">
            Add only sourced BIR extensions or corrections. No sample or
            fictitious holiday override is seeded.
          </text>
        </column>
      </card>
    </if>
    <for each="calendarOverrides" key="id" as="override">
      <card>
        <column padding="18" gap="8">
          <row gap="10" cross="center">
            <column grow="1" gap="4">
              <text><span weight="bold">{override.titleLabel}</span></text>
              <text wrap="true" foreground="text_muted">Forms: {override.formsLabel}</text>
            </column>
            <badge variant="primary">{override.datesLabel}</badge>
          </row>
          <text wrap="true" foreground="text_muted">{override.scopeLabel}</text>
          <text wrap="true" foreground="text_muted">{override.effectiveLabel}</text>
          <text wrap="true">Source: {override.sourceLabel}</text>
          <row gap="8">
            <button size="sm" variant="outline" on-press="calendar_edit_override:{override.id}">Edit</button>
            <button size="sm" variant="ghost" on-press="calendar_delete_override:{override.id}">Delete</button>
          </row>
        </column>
      </card>
    </for>
    <use template="deadline-override-editor"/>

    <separator/>

    <column gap="10">
      <text><span weight="bold">Non-working Days</span></text>
      <text wrap="true" foreground="text_muted">
        Weekends are built in. Official holidays and closures are explicit,
        source-cited SQLite records; none are guessed or auto-seeded.
      </text>
    </column>
    <if test="{calendarNonWorkingDaysEmpty}">
      <card>
        <column padding="18" gap="6" cross="center">
          <text><span weight="bold">No configured non-working days</span></text>
          <text wrap="true" text-alignment="center" foreground="text_muted">
            Until an official day is entered, only Saturday and Sunday
            business-day adjustment is active.
          </text>
        </column>
      </card>
    </if>
    <for each="calendarNonWorkingDays" key="id" as="day">
      <card>
        <column padding="18" gap="8">
          <row gap="10" cross="center">
            <badge variant="secondary">{day.dateLabel}</badge>
            <column grow="1" gap="3">
              <text><span weight="bold">{day.nameLabel}</span></text>
              <text wrap="true" foreground="text_muted">{day.kindLabel} · {day.regionsLabel}</text>
            </column>
          </row>
          <text wrap="true">Source: {day.sourceLabel}</text>
          <row gap="8">
            <button size="sm" variant="outline" on-press="calendar_edit_non_working_day:{day.id}">Edit</button>
            <button size="sm" variant="ghost" on-press="calendar_delete_non_working_day:{day.id}">Delete</button>
          </row>
        </column>
      </card>
    </for>
    <use template="non-working-day-editor"/>
  </column>
</template>

<template name="tax-calendar-content" args="padding">
  <column padding="{padding}" gap="24">
    <if test="{constrainedLayout}">
      <column gap="12">
        <column gap="6">
          <text size="heading">Tax Calendar Explorer</text>
          <text wrap="true" foreground="text_muted">
            Review calendar-year rules, source-cited changes, and SQLite overrides.
          </text>
        </column>
        <column gap="8">
          <button variant="outline" icon="refresh-cw" on-press="calendar_refresh">Refresh from SQLite</button>
        </column>
      </column>
    </if>
    <else>
      <row gap="16" cross="center">
        <column grow="1" gap="6">
          <text size="heading">Tax Calendar Explorer</text>
          <text foreground="text_muted">
            Review calendar-year rules, source-cited changes, and SQLite overrides.
          </text>
        </column>
        <button variant="outline" icon="refresh-cw" on-press="calendar_refresh">Refresh</button>
      </row>
    </else>

    <tabs gap="4" label="Tax calendar sections">
      <button
        variant="ghost"
        selected="{calendarDeadlinesActive}"
        on-press="show_calendar_deadlines">Deadlines</button>
      <button
        variant="ghost"
        selected="{calendarRulesActive}"
        on-press="show_calendar_rules">Rules</button>
      <button
        variant="ghost"
        selected="{calendarOverridesActive}"
        on-press="show_calendar_overrides">Overrides</button>
    </tabs>

    <card>
      <row padding="14" gap="12" cross="center">
        <button
          size="sm"
          variant="outline"
          icon="chevron-left"
          label="Previous calendar year"
          on-press="calendar_previous_year"/>
        <column grow="1" gap="3" cross="center">
          <text><span weight="bold">Calendar Year {currentCalendarYear}</span></text>
          <text foreground="text_muted">{calendarDeadlineCount} in the full export</text>
        </column>
        <button
          size="sm"
          variant="outline"
          icon="chevron-right"
          label="Next calendar year"
          on-press="calendar_next_year"/>
      </row>
    </card>

    <if test="{calendarDeadlinesActive}">
      <use template="tax-calendar-deadlines-section"/>
    </if>
    <if test="{calendarRulesActive}">
      <use template="tax-calendar-rules-section"/>
    </if>
    <if test="{calendarOverridesActive}">
      <use template="tax-calendar-overrides-section"/>
    </if>
  </column>
</template>

<template name="tax-calendar-page">
  <scroll grow="1" global-key="page-tax-calendar" label="Tax calendar explorer content">
    <if test="{phoneLayout}">
      <use template="tax-calendar-content" padding="16"/>
    </if>
    <else>
      <if test="{desktopLayout}">
        <use template="tax-calendar-content" padding="32"/>
      </if>
      <else>
        <use template="tax-calendar-content" padding="24"/>
      </else>
    </else>
  </scroll>
</template>

<template name="settings-action-row" args="icon title body action">
  <column>
    <if test="{constrainedLayout}">
      <column gap="12">
        <row gap="14" cross="start">
          <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
          <column grow="1" gap="4">
            <text><span weight="bold">{title}</span></text>
            <text wrap="true" foreground="text_muted">{body}</text>
          </column>
        </row>
        <button variant="outline" disabled="true">{action}</button>
      </column>
    </if>
    <else>
      <row gap="14" cross="center">
        <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
        <column grow="1" gap="4">
          <text><span weight="bold">{title}</span></text>
          <text wrap="true" foreground="text_muted">{body}</text>
        </column>
        <button variant="outline" disabled="true">{action}</button>
      </row>
    </else>
  </column>
</template>

<template name="settings-switch-row" args="icon title body enabled=false">
  <column>
    <if test="{constrainedLayout}">
      <column gap="12">
        <row gap="14" cross="start">
          <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
          <column grow="1" gap="4">
            <text><span weight="bold">{title}</span></text>
            <text wrap="true" foreground="text_muted">{body}</text>
          </column>
        </row>
        <switch checked="{enabled}" disabled="true" label="{title}"></switch>
      </column>
    </if>
    <else>
      <row gap="14" cross="center">
        <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
        <column grow="1" gap="4">
          <text><span weight="bold">{title}</span></text>
          <text wrap="true" foreground="text_muted">{body}</text>
        </column>
        <switch checked="{enabled}" disabled="true" label="{title}"></switch>
      </row>
    </else>
  </column>
</template>

<template name="settings-danger-row" args="icon title body action">
  <column>
    <if test="{constrainedLayout}">
      <column gap="12">
        <row gap="14" cross="start">
          <icon name="{icon}" foreground="destructive" width="22" height="22"/>
          <column grow="1" gap="4">
            <text><span weight="bold">{title}</span></text>
            <text wrap="true" foreground="text_muted">{body}</text>
          </column>
        </row>
        <button variant="destructive" disabled="true">{action}</button>
      </column>
    </if>
    <else>
      <row gap="14" cross="center">
        <icon name="{icon}" foreground="destructive" width="22" height="22"/>
        <column grow="1" gap="4">
          <text><span weight="bold">{title}</span></text>
          <text wrap="true" foreground="text_muted">{body}</text>
        </column>
        <button variant="destructive" disabled="true">{action}</button>
      </row>
    </else>
  </column>
</template>

<template name="settings-content">
  <column gap="24">
    <column gap="6">
      <text size="heading">Settings</text>
      <text wrap="true" foreground="text_muted">Configure security, privacy, and global application preferences.</text>
    </column>

    <card>
      <if test="{constrainedLayout}">
        <column padding="22" gap="16">
          <row gap="14" cross="start">
            <icon name="sun" foreground="accent" width="30" height="30"/>
            <column grow="1" gap="4">
              <text><span weight="bold">Appearance</span></text>
              <text wrap="true" foreground="text_muted">
                Follow the system appearance or keep eBIRForms in a specific theme.
              </text>
            </column>
          </row>
          <toggle-group gap="2" label="Application appearance">
            <toggle-button
              size="sm"
              selected="{themePreference == 'system'}"
              on-toggle="set_theme_system">
              System
            </toggle-button>
            <toggle-button
              size="sm"
              selected="{themePreference == 'light'}"
              on-toggle="set_theme_light">
              Light
            </toggle-button>
            <toggle-button
              size="sm"
              selected="{themePreference == 'dark'}"
              on-toggle="set_theme_dark">
              Dark
            </toggle-button>
          </toggle-group>
        </column>
      </if>
      <else>
        <row padding="22" gap="18" cross="center">
          <icon name="sun" foreground="accent" width="30" height="30"/>
          <column grow="1" gap="4">
            <text><span weight="bold">Appearance</span></text>
            <text wrap="true" foreground="text_muted">
              Follow the system appearance or keep eBIRForms in a specific theme.
            </text>
          </column>
          <toggle-group gap="2" label="Application appearance">
            <toggle-button
              size="sm"
              selected="{themePreference == 'system'}"
              on-toggle="set_theme_system">
              System
            </toggle-button>
            <toggle-button
              size="sm"
              selected="{themePreference == 'light'}"
              on-toggle="set_theme_light">
              Light
            </toggle-button>
            <toggle-button
              size="sm"
              selected="{themePreference == 'dark'}"
              on-toggle="set_theme_dark">
              Dark
            </toggle-button>
          </toggle-group>
        </row>
      </else>
    </card>

    <card>
      <column padding="22" gap="18">
        <if test="{constrainedLayout}">
          <column gap="12">
            <row gap="14" cross="start">
              <icon name="file-text" foreground="accent" width="30" height="30"/>
              <column grow="1" gap="4">
                <text><span weight="bold">Calendar Integration</span></text>
                <text wrap="true" foreground="text_muted">Default calendar handoff is ready</text>
              </column>
            </row>
            <row cross="center">
              <badge variant="primary">Ready</badge>
            </row>
          </column>
        </if>
        <else>
          <row gap="14" cross="center">
            <icon name="file-text" foreground="accent" width="30" height="30"/>
            <column grow="1" gap="4">
            <text><span weight="bold">Calendar Integration</span></text>
            <text foreground="text_muted">Default calendar handoff is ready</text>
          </column>
          <badge variant="primary">Ready</badge>
        </row>
        </else>
        <text wrap="true" foreground="text_muted">
          Add the resolved schedule to Apple Calendar, Outlook, Google Calendar,
          or another registered calendar app using an ICS handoff. Choose an
          iCloud, Google, or Outlook calendar during import to propagate it to
          mobile. Direct managed Google OAuth sync is optional and not connected.
        </text>
        <if test="{constrainedLayout}">
          <column gap="10">
            <button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button>
            <button variant="outline" disabled="true">Connect Google Directly</button>
          </column>
        </if>
        <else>
          <row gap="10">
            <button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button>
            <button variant="outline" disabled="true">Connect Google Directly</button>
          </row>
        </else>
      </column>
    </card>

    <card>
      <column padding="22" gap="18">
        <column gap="4">
          <text><span weight="bold">Security</span></text>
          <text wrap="true" foreground="text_muted">Protect application access and individual taxpayer profiles.</text>
        </column>
        <separator/>
        <use
          template="settings-action-row"
          icon="settings"
          title="Master PIN"
          body="Require a master PIN when opening protected areas."
          action="Configure"/>
        <separator/>
        <use
          template="settings-action-row"
          icon="circle-dot"
          title="Master Authenticator App"
          body="Use a one-time code from an authenticator application."
          action="Set Up"/>
        <separator/>
        <use
          template="settings-switch-row"
          icon="check-circle"
          title="Enable Profile PINs"
          body="Allow separate access PINs for taxpayer profiles."/>
      </column>
    </card>

    <card>
      <column padding="22" gap="18">
        <column gap="4">
          <text><span weight="bold">Privacy and Display</span></text>
          <text wrap="true" foreground="text_muted">Choose how taxpayer profiles appear in the application shell.</text>
        </column>
        <separator/>
        <use
          template="settings-switch-row"
          icon="eye"
          title="Hide Tax Profiles from Sidebar"
          body="Keep profile names and TINs hidden until the list is opened."/>
        <separator/>
        <use
          template="settings-action-row"
          icon="terminal"
          title="Global Toggle Hotkey"
          body="Configure a keyboard shortcut for hiding and showing profiles."
          action="Set Shortcut"/>
      </column>
    </card>

    <card>
      <column padding="22" gap="18">
        <column gap="4">
          <text><span weight="bold">Data</span></text>
          <text wrap="true" foreground="text_muted">Create a portable archive of application data.</text>
        </column>
        <separator/>
        <use
          template="settings-action-row"
          icon="download"
          title="Export Data"
          body="Export taxpayer profiles and application records to a backup archive."
          action="Export"/>
      </column>
    </card>

    <card>
      <column padding="22" gap="18">
        <column gap="4">
          <text foreground="destructive"><span weight="bold">Danger Zone</span></text>
          <text wrap="true" foreground="text_muted">Destructive options are displayed for layout parity only.</text>
        </column>
        <separator/>
        <use
          template="settings-danger-row"
          icon="alert"
          title="Factory Reset"
          body="Restore global preferences to their defaults."
          action="Factory Reset"/>
        <separator/>
        <use
          template="settings-danger-row"
          icon="trash"
          title="Zero Out Everything"
          body="Remove all local taxpayer and application data."
          action="Zero Out Everything"/>
      </column>
    </card>
  </column>
</template>

<template name="settings-page">
  <scroll grow="1" global-key="page-settings" label="Settings content">
    <if test="{phoneLayout}">
      <column padding="16">
        <use template="settings-content"/>
      </column>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column padding="20">
          <use template="settings-content"/>
        </column>
      </if>
      <else>
        <column padding="32">
          <use template="settings-content"/>
        </column>
      </else>
    </else>
  </scroll>
</template>

<template name="gallery-main-grid" args="grid_columns">
  <grid columns="{grid_columns}" gap="12">
    <button variant="secondary" on-press="show_taxpayer_dashboard">Taxpayer Dashboard</button>
    <button variant="secondary" on-press="show_global_dashboard">Global Dashboard</button>
    <button variant="secondary" on-press="show_profile_setup">Taxpayer Profile Setup</button>
    <button variant="secondary" on-press="show_background_tasks">Background Tasks</button>
    <button variant="secondary" on-press="show_import_data">Import Data</button>
    <button variant="secondary" on-press="show_tax_calendar">Tax Calendar Explorer</button>
    <button variant="secondary" on-press="show_settings">Settings</button>
  </grid>
</template>

<template name="gallery-forms-grid" args="grid_columns">
  <grid columns="{grid_columns}" gap="12">
    <button variant="secondary" on-press="show_form_0605">0605 - Payment Form</button>
    <button variant="secondary" on-press="show_form_0619_e">0619-E - Creditable Income Taxes Withheld</button>
    <button variant="secondary" on-press="show_form_0619_f">0619-F - Final Income Taxes Withheld</button>
    <button variant="secondary" on-press="show_form_1601_c">1601C - Compensation Withholding</button>
    <button variant="secondary" on-press="show_form_1701">1701 - Annual Individual ITR</button>
    <button variant="secondary" on-press="show_form_1701q">1701Q - Quarterly Individual ITR</button>
    <button variant="secondary" on-press="show_form_1702_rt">1702-RT - Regular-Rate Corporation ITR</button>
    <button variant="secondary" on-press="show_form_1702_mx">1702-MX - Mixed-Income Corporation ITR</button>
    <button variant="secondary" on-press="show_form_2550q">2550Q - Quarterly VAT Return</button>
    <button variant="secondary" on-press="show_form_2551q">2551Q - Quarterly Percentage Tax</button>
  </grid>
</template>

<template name="gallery-auxiliary-grid" args="grid_columns">
  <grid columns="{grid_columns}" gap="12">
    <button variant="secondary" on-press="show_aux_admin_auth_overlay">Admin Authentication Overlay</button>
    <button variant="secondary" on-press="show_aux_background_task_debug_log">Background Task Debug Log</button>
    <button variant="secondary" on-press="show_aux_command_palette">Command Palette</button>
    <button variant="secondary" on-press="show_aux_email_confirmation">Email Confirmation</button>
    <button variant="secondary" on-press="show_aux_html_print_preview">HTML Print Preview</button>
    <button variant="secondary" on-press="show_aux_lock_screen">Lock Screen</button>
    <button variant="secondary" on-press="show_aux_profile_auth_overlay">Profile Authentication Overlay</button>
  </grid>
</template>

<template name="screen-gallery-content">
  <column gap="24">
    <if test="{constrainedLayout}">
      <column gap="8">
        <row cross="center">
          <badge variant="outline">Developer Tools</badge>
        </row>
        <column gap="4">
          <text size="heading">Screen Gallery</text>
          <text wrap="true" foreground="text_muted">
            Reviewer-only index for every reconstructed eBIRForms surface. This page is not part of the taxpayer workflow.
          </text>
        </column>
      </column>
    </if>
    <else>
      <row gap="14" cross="start">
        <column grow="1" gap="4">
          <text size="heading">Screen Gallery</text>
          <text wrap="true" foreground="text_muted">
            Reviewer-only index for every reconstructed eBIRForms surface. This page is not part of the taxpayer workflow.
          </text>
        </column>
        <badge variant="outline">Developer Tools</badge>
      </row>
    </else>

    <card>
      <column padding="20" gap="12">
        <column gap="4">
          <text><span weight="bold">Main Screens</span></text>
          <text wrap="true" foreground="text_muted">Primary application pages and taxpayer workflows.</text>
        </column>
        <column>
          <if test="{phoneLayout}">
            <use template="gallery-main-grid" grid_columns="1"/>
          </if>
          <if test="{constrainedLayout and phoneLayout == false}">
            <use template="gallery-main-grid" grid_columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="gallery-main-grid" grid_columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="gallery-main-grid" grid_columns="3"/>
          </if>
        </column>
      </column>
    </card>

    <card>
      <column padding="20" gap="12">
        <column gap="4">
          <text><span weight="bold">BIR Form Editors</span></text>
          <text wrap="true" foreground="text_muted">Static form-editor replicas with audited filing sections and status pipelines.</text>
        </column>
        <column>
          <if test="{phoneLayout}">
            <use template="gallery-forms-grid" grid_columns="1"/>
          </if>
          <if test="{constrainedLayout and phoneLayout == false}">
            <use template="gallery-forms-grid" grid_columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="gallery-forms-grid" grid_columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="gallery-forms-grid" grid_columns="3"/>
          </if>
        </column>
      </column>
    </card>

    <card>
      <column padding="20" gap="12">
        <column gap="4">
          <text><span weight="bold">Auxiliary Surfaces</span></text>
          <text wrap="true" foreground="text_muted">Overlays, confirmation windows, previews, and supporting diagnostic views.</text>
        </column>
        <column>
          <if test="{phoneLayout}">
            <use template="gallery-auxiliary-grid" grid_columns="1"/>
          </if>
          <if test="{constrainedLayout and phoneLayout == false}">
            <use template="gallery-auxiliary-grid" grid_columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="gallery-auxiliary-grid" grid_columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="gallery-auxiliary-grid" grid_columns="3"/>
          </if>
        </column>
      </column>
    </card>
  </column>
</template>

<template name="screen-gallery-page">
  <scroll grow="1" global-key="page-screen-gallery" label="Developer screen gallery">
    <if test="{phoneLayout}">
      <column padding="16">
        <use template="screen-gallery-content"/>
      </column>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column padding="20">
          <use template="screen-gallery-content"/>
        </column>
      </if>
      <else>
        <column padding="32">
          <use template="screen-gallery-content"/>
        </column>
      </else>
    </else>
  </scroll>
</template>

<template name="form-0605-grid-1" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">2 Year Ended month (independent)</text>
      <input placeholder="MM / YYYY" />
    </column>
    <column gap="4">
      <text foreground="text_muted">4 Due Date (MM/DD/YYYY)</text>
      <input placeholder="MM / DD / YYYY" />
    </column>
    <column gap="4">
      <text foreground="text_muted">5 Number of Sheets Attached</text>
      <input placeholder="Enter number" />
    </column>
    <column gap="4">
      <text foreground="text_muted">6 ATC - only source-proven pairs</text>
      <input placeholder="Select ATC" />
    </column>
    <column gap="4">
      <text foreground="text_muted">8 Tax Type - only source-proven pairs</text>
      <input placeholder="Select tax type" />
    </column>
    <column gap="4">
      <text foreground="text_muted">17 Manner of Payment</text>
      <input placeholder="Select manner" />
    </column>
  </grid>
</template>

<template name="form-0605-grid-2" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">9 TIN</text>
      <input placeholder="000-000-000-000" />
    </column>
    <column gap="4">
      <text foreground="text_muted">10 RDO Code</text>
      <input placeholder="RDO" />
    </column>
    <column gap="4">
      <text foreground="text_muted">12 Line of Business / Occupation</text>
      <input placeholder="Business or occupation" />
    </column>
    <column gap="4">
      <text foreground="text_muted">13 Taxpayer Name</text>
      <input placeholder="Registered taxpayer name" />
    </column>
    <column gap="4">
      <text foreground="text_muted">15 Registered Address</text>
      <input placeholder="Registered address" />
    </column>
    <column gap="4">
      <text foreground="text_muted">18 Type of Payment</text>
      <input placeholder="Select payment type" />
    </column>
  </grid>
</template>

<template name="form-0605-grid-3" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">19 Basic Tax / Deposit / Advance Payment</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">20A Surcharge (manual)</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">20B Interest (manual)</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">20C Compromise (manual)</text>
      <input placeholder="Enter amount" />
    </column>
  </grid>
</template>

<template name="form-0605-table-1">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Payment method</text>
          <text>Cash / Bank Debit</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Drawee bank / agency</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Reference number</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Amount</text>
          <text>0.00</text>
        </column>
      </column>
      <separator/>
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Payment method</text>
          <text>Check / Tax Debit Memo / Other</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Drawee bank / agency</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Reference number</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Amount</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                <table-row gap="8">
                  <table-cell>Payment method</table-cell>
                  <table-cell>Drawee bank / agency</table-cell>
                  <table-cell>Reference number</table-cell>
                  <table-cell>Amount</table-cell>
                </table-row>
                <table-row gap="8">
                  <table-cell>Cash / Bank Debit</table-cell>
                  <table-cell>-</table-cell>
                  <table-cell>-</table-cell>
                  <table-cell>0.00</table-cell>
                </table-row>
                <table-row gap="8">
                  <table-cell>Check / Tax Debit Memo / Other</table-cell>
                  <table-cell>-</table-cell>
                  <table-cell>-</table-cell>
                  <table-cell>0.00</table-cell>
                </table-row>
      </table>
    </else>
  </column>
</template>

<template name="form-0605-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
      <column gap="6">
        <text size="heading">BIR Form No. 0605</text>
        <text>Payment Form</text>
        <row gap="8" cross="center">
          <text foreground="text_muted" grow="1">July 1999 (ENCS)</text>
          <badge>Draft</badge>
        </row>
      </column>
