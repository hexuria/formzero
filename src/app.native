<template name="form-1701-masthead">
<column>
<if test="{constrainedLayout}">
<column gap="16">
<column gap="6">
<text size="heading">BIR Form No. 1701</text>
<text>Annual Income Tax Return for Individuals, Estates and Trusts</text>
<row gap="8" cross="center">
<text foreground="text_muted" grow="1">January 2018 (ENCS)</text>
<badge>Draft</badge>
</row>
</column>
<column gap="8">
<button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
<button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
<separator/>
<button variant="secondary" disabled="true">Save Draft</button>
<button variant="primary" disabled="true">Manual / External Filing</button>
</column>
</column>
</if>
<else>
<column gap="16">
<row gap="16" cross="center">
<column gap="4" grow="1">
<text size="heading">BIR Form No. 1701</text>
<text>Annual Income Tax Return for Individuals, Estates and Trusts</text>
<text foreground="text_muted">January 2018 (ENCS)</text>
</column>
<badge>Draft</badge>
</row>
<row gap="8">
<button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
<button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
<spacer/>
<button variant="secondary" disabled="true">Save Draft</button>
<button variant="primary" disabled="true">Manual / External Filing</button>
</row>
</column>
</else>
</column>
</template>
<template name="form-1701-filing-status">
<card>
<column padding="20" gap="12">
<text size="heading">Filing status</text>
<if test="{constrainedLayout}">
<if test="{phoneLayout}">
<column gap="8">
<row cross="center">
<badge>Draft</badge>
</row>
<text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
</column>
</if>
<else>
<row gap="12" cross="center">
<badge>Draft</badge>
<text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
</row>
</else>
</if>
<else>
<stepper active="0">
<step>Draft</step>
<step>Queued</step>
<step>Submitted</step>
<step>Confirmed</step>
<step>Paid</step>
</stepper>
</else>
</column>
</card>
</template>
<template name="form-1701">
<scroll grow="1" global-key="page-form-1701">
<column padding="32" gap="24">
<use template="form-1701-masthead"/>
<use template="tax-profile-form-context"/>
<use template="form-1701-filing-status"/>
<card>
<column padding="20" gap="12">
<text size="heading">ITEMS 1-21 - FILING AND BACKGROUND INFORMATION</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-1" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-1" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-1" columns="3"/>
</if>
<separator />
<text size="heading">SPOUSE BACKGROUND INFORMATION</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-2" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-2" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-2" columns="3"/>
</if>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">SCHEDULE 1 - COMPENSATION INCOME</text>
<use template="form-1701-table-1"/>
<separator />
<text size="heading">SCHEDULE 2 - TAX ON COMPENSATION INCOME</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-3" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-3" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-3" columns="3"/>
</if>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">SCHEDULE 3 - BUSINESS/PROFESSION INCOME</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-4" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-4" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-4" columns="3"/>
</if>
<separator />
<text size="heading">SCHEDULE 3 - SPECIFY LINES</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-5" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-5" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-5" columns="2"/>
</if>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">SCHEDULE 4 - ORDINARY ALLOWABLE ITEMIZED DEDUCTIONS</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-6" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-6" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-6" columns="3"/>
</if>
<separator />
<text size="heading">SCHEDULE 6 - NOLCO SUMMARY</text>
<use template="form-1701-table-2"/>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">PART VI - TAX DUE</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-7" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-7" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-7" columns="3"/>
</if>
<separator />
<text size="heading">PART VII - TAX CREDITS/PAYMENTS</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-8" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-8" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-8" columns="3"/>
</if>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">PART VII - OTHER CREDIT</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-9" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-9" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-9" columns="2"/>
</if>
<separator />
<text size="heading">PART VIII - TAX RELIEF</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-10" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-10" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-10" columns="2"/>
</if>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">PART IX - RECONCILIATION OF NET INCOME</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-11" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-11" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-11" columns="3"/>
</if>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">PART II - TOTAL TAX PAYABLE/(OVERPAYMENT)</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-12" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-12" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-12" columns="3"/>
</if>
<separator />
<if test="{constrainedLayout}">
<column gap="8">
<text>Total Tax Payable / (Overpayment)</text>
<row cross="center">
<badge>PHP 0.00</badge>
</row>
</column>
</if>
<else>
<row gap="8">
<text grow="1">Total Tax Payable / (Overpayment)</text>
<badge>PHP 0.00</badge>
</row>
</else>
<separator />
<text size="heading">ITEMS 32-33 - OVERPAYMENT AND ATTACHMENTS</text>
<if test="{constrainedLayout}">
<use template="form-1701-grid-13" columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="form-1701-grid-13" columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="form-1701-grid-13" columns="2"/>
</if>
</column>
</card>
<card>
<column padding="20" gap="12">
<text size="heading">PART III - DETAILS OF PAYMENT</text>
<use template="form-1701-table-3"/>
</column>
</card>
</column>
</scroll>
</template>
<!-- <text>January 2018 (ENCS)</text> -->
<template name="form-1701q-tax-catalog-source-a">
<column>
<text>1 Taxable Year</text>
<input text="{formFilingYear}" placeholder="YYYY" disabled="true"/>
<text>2 Quarter</text>
<input placeholder="Q1 / Q2 / Q3" disabled="true"/>
<text>3 Amended Return?</text>
<input placeholder="No" disabled="true"/>
</column>
</template>
