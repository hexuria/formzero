<template name="sidebar-profile" args="name tin profile active=false">
<list-item
width="255"
height="72"
padding="8"
radius="md"
selected="{active}"
label="{name}"
on-press="select_taxpayer:{profile}">
<column grow="1" gap="2">
<text><span weight="bold">{name}</span></text>
<text foreground="text_muted">{tin}</text>
<if test="{active}">
<text foreground="text_muted">RDO: {selectedTaxpayerRdo}</text>
</if>
</column>
</list-item>
</template>
<template name="sidebar-dock-full">
<column width="232" gap="8">
<row width="232" height="48" cross="center">
<list-item
key="{sidebarActionEpoch}"
width="232"
height="44"
padding="12"
radius="md"
icon="download"
selected="false"
on-press="show_import_data">
Import Data
</list-item>
</row>
<row width="232" height="48" cross="center">
<if test="{darkThemeActive}">
<list-item
key="{sidebarActionEpoch}"
width="232"
height="44"
padding="12"
radius="md"
icon="sun"
selected="false"
label="Switch to light mode"
on-press="toggle_theme">
Light Mode
</list-item>
</if>
<if test="{lightThemeActive}">
<list-item
key="{sidebarActionEpoch}"
width="232"
height="44"
padding="12"
radius="md"
icon="moon"
selected="false"
label="Switch to dark mode"
on-press="toggle_theme">
Dark Mode
</list-item>
</if>
</row>
<row width="232" height="48" cross="center">
<list-item
key="{sidebarActionEpoch}"
width="232"
height="44"
padding="12"
radius="md"
icon="clock"
selected="false"
on-press="show_background_tasks">
Background Tasks
</list-item>
</row>
<row width="232" height="48" cross="center">
<list-item
key="{sidebarActionEpoch}"
width="232"
height="44"
padding="12"
radius="md"
icon="file-text"
selected="false"
on-press="show_tax_calendar">
Tax Calendars
</list-item>
</row>
<row width="232" height="48" cross="center">
<list-item
key="{sidebarActionEpoch}"
width="232"
height="44"
padding="12"
radius="md"
icon="settings"
selected="false"
on-press="show_settings">
Settings
</list-item>
</row>
</column>
</template>
<template name="sidebar-dock-rail">
<column width="48" gap="8" cross="center">
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="download"
label="Import Data"
on-press="show_import_data">
</button>
<if test="{darkThemeActive}">
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="sun"
label="Switch to light mode"
on-press="toggle_theme">
</button>
</if>
<if test="{lightThemeActive}">
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="moon"
label="Switch to dark mode"
on-press="toggle_theme">
</button>
</if>
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="clock"
label="Background Tasks"
on-press="show_background_tasks">
</button>
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="file-text"
label="Tax Calendars"
on-press="show_tax_calendar">
</button>
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="settings"
label="Settings"
on-press="show_settings">
</button>
</column>
</template>
<template name="app-sidebar-full" args="brand_logo overlay=false">
<stack width="280">
<status-bar background="surface" border-color="surface"></status-bar>
<row width="280">
<column width="279" grow="1" cross="center">
<spacer height="12"/>
<row width="255" height="44" main="end" cross="center">
<if test="{overlay}">
<list-item
width="44"
height="44"
padding="0"
main="center"
cross="center"
radius="xl"
selected="false"
label="Close navigation"
on-press="close_sidebar_overlay">
<icon name="x" width="24" height="24"/>
</list-item>
</if>
<else>
<list-item
width="44"
height="44"
padding="0"
main="center"
cross="center"
radius="xl"
selected="false"
label="Use compact sidebar"
on-press="collapse_sidebar">
<icon name="chevron-left" width="28" height="28"/>
</list-item>
</else>
</row>
<row
width="255"
height="64"
main="center"
cross="center"
role="button"
label="Open Global Dashboard"
on-press="show_global_dashboard">
<image image="{brand_logo}" width="216" height="54" label="eBIRForms"/>
</row>
<row width="232" height="56" cross="center" gap="8">
<text grow="1" foreground="text_muted">
<span weight="bold">TAXPAYER PROFILES</span>
</text>
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="plus"
label="Add taxpayer profile"
on-press="new_taxpayer_profile">
</button>
</row>
<search-field
width="232"
text="{sidebarProfileSearchValue}"
placeholder="Search profiles"
label="Search taxpayer profiles"
autofocus="{overlay}"
on-input="sidebar_profile_search_changed"/>
<spacer height="16"/>
<separator/>
<scroll grow="1" width="255" overscroll="none" label="Sidebar navigation">
<column width="255" grow="1" cross="center" gap="8">
<spacer height="4"/>
<if test="{visibleProfileRowsEmpty}">
<column width="232" padding="12" gap="6" cross="center">
<text><span weight="bold">{profileRowsEmptyTitle}</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">
{profileRowsEmptyMessage}
</text>
</column>
</if>
<for each="visibleProfileRows" key="idLabel" as="profile">
<use
template="sidebar-profile"
name="{profile.nameLabel}"
tin="{profile.tinLabel}"
profile="{profile.slot}"
active="{profile.active and taxpayerNavigationSelectionVisible}"/>
</for>
<row width="232" height="48" cross="center">
<list-item
key="{sidebarActionEpoch}"
width="232"
height="44"
padding="12"
radius="md"
icon="folder-open"
selected="false"
on-press="show_screen_gallery">
Screen Gallery
</list-item>
</row>
<spacer grow="1"/>
<separator/>
<spacer height="8"/>
<use template="sidebar-dock-full"/>
<spacer height="12"/>
</column>
</scroll>
</column>
<separator/>
</row>
</stack>
</template>
<template name="sidebar-avatar" args="initials name profile active=false">
<row width="48" height="64" main="center" cross="center">
<if test="{active}">
<button
width="48"
height="48"
size="icon"
variant="primary"
radius="xl"
selected="true"
label="{name}"
on-press="select_taxpayer:{profile}">
{initials}
</button>
</if>
<else>
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
selected="false"
label="{name}"
on-press="select_taxpayer:{profile}">
{initials}
</button>
</else>
</row>
</template>
<template name="app-sidebar-rail" args="app_icon">
<row width="72" background="background">
<column width="71" grow="1" cross="center">
<spacer height="12"/>
<row width="48" height="44" main="center" cross="center">
<list-item
width="44"
height="44"
padding="0"
main="center"
cross="center"
radius="xl"
selected="false"
label="Expand sidebar"
on-press="expand_sidebar">
<icon name="chevron-right" width="28" height="28"/>
</list-item>
</row>
<row
width="48"
height="64"
main="center"
cross="center"
role="button"
label="Open Global Dashboard"
on-press="show_global_dashboard">
<image image="{app_icon}" width="48" height="48" label="eBIRForms"/>
</row>
<row width="48" height="56" main="center" cross="center">
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="plus"
selected="{page == 'profile_setup'}"
label="Add taxpayer profile"
on-press="new_taxpayer_profile">
</button>
</row>
<row width="48" height="64" main="center" cross="center">
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="search"
label="Search taxpayer profiles"
on-press="open_sidebar_overlay">
</button>
</row>
<spacer height="16"/>
<separator/>
<scroll
grow="1"
width="70"
overscroll="none"
label="Compact sidebar navigation">
<column width="70" grow="1" cross="center" gap="8">
<spacer height="4"/>
<for each="profileRows" key="idLabel" as="profile">
<use
template="sidebar-avatar"
initials="{profile.initialsLabel}"
name="{profile.nameLabel}"
profile="{profile.slot}"
active="{profile.active and taxpayerNavigationSelectionVisible}"/>
</for>
<row width="48" height="64" main="center" cross="center">
<button
width="48"
height="48"
size="icon"
variant="ghost"
radius="xl"
icon="folder-open"
label="Screen Gallery"
on-press="show_screen_gallery">
</button>
</row>
<spacer grow="1"/>
<separator/>
<spacer height="8"/>
<use template="sidebar-dock-rail"/>
<spacer height="12"/>
</column>
</scroll>
</column>
<separator/>
</row>
</template>
<template name="app-mobile-header">
<column>
<row height="56" padding="8" gap="10" cross="center" background="background">
<if test="{page == 'profile_setup'}">
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="chevron-left"
label="{profileBackLabel}"
on-press="cancel_profile_edit">
</button>
</if>
<else>
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="menu"
label="Open navigation"
on-press="toggle_navigation">
</button>
</else>
<text grow="1"><span weight="bold">{currentPageTitle}</span></text>
</row>
<separator/>
</column>
</template>
<template name="app-footer" args="bagong_logo bir_logo goldcoders_logo">
<column>
<if test="{regularFooter}">
<column>
<separator/>
<row height="71" padding="12" cross="center" gap="12" background="background">
<image image="{bagong_logo}" width="48" height="48" label="Bagong Pilipinas"/>
<image image="{bir_logo}" width="48" height="48" label="Bureau of Internal Revenue"/>
<spacer grow="1"/>
<if test="{footerCopyrightVisible}">
<text foreground="text_muted">© 2026 Goldcoders Corp. · goldcoders.dev</text>
</if>
<image image="{goldcoders_logo}" width="44" height="44" label="Goldcoders"/>
</row>
</column>
</if>
<if test="{compactFooter}">
<column>
<separator/>
<row height="57" padding="8" cross="center" gap="8" background="background">
<image image="{bagong_logo}" width="38" height="38" label="Bagong Pilipinas"/>
<image image="{bir_logo}" width="38" height="38" label="Bureau of Internal Revenue"/>
<spacer grow="1"/>
<text foreground="text_muted">© 2026</text>
<image image="{goldcoders_logo}" width="36" height="36" label="Goldcoders"/>
</row>
</column>
</if>
</column>
</template>
<template name="tax-profile-form-context">
<card>
<column padding="16" gap="12">
<column gap="2">
<text><span weight="bold">{formProfileContextTitle}</span></text>
<text wrap="true" foreground="text_muted">{formProfileStatus}</text>
<text wrap="true" foreground="text_muted">Filing period: {formFilingPeriodLabel}</text>
</column>
<if test="{formProfileNotice}">
<row
padding="10"
gap="8"
cross="center"
background="surface_subtle"
radius="md">
<icon name="info" width="18" height="18" foreground="info"/>
<text grow="1" wrap="true">{formProfileNotice}</text>
</row>
</if>
<if test="{formProfileNeedsActivitySelection}">
<column gap="8">
<separator/>
<text><span weight="bold">Registered activity for this filing</span></text>
<text wrap="true" foreground="text_muted">
This profile has more than one effective activity. Choose the activity whose reusable facts belong on this form.
</text>
<for each="formActivityRows" key="idLabel" as="activity">
<button
size="sm"
variant="outline"
selected="{activity.selected}"
on-press="select_form_activity:{activity.id}">
{activity.name}
</button>
</for>
<else>
<text foreground="text_muted">No effective registered activities are available.</text>
</else>
</column>
</if>
<if test="{formProfileHasSpouseRole}">
<column gap="8">
<separator/>
<row gap="8" cross="center">
<column grow="1" gap="2">
<text><span weight="bold">Optional spouse tax profile</span></text>
<text wrap="true" foreground="text_muted">
Bind a different qualified individual profile when this return includes spouse information.
</text>
</column>
<if test="{formProfileHasSpouseBinding}">
<button size="sm" variant="ghost" on-press="clear_form_spouse">Clear spouse</button>
</if>
</row>
<for each="formSpouseRows" key="idLabel" as="spouse">
<button
size="sm"
variant="outline"
selected="{spouse.selected}"
on-press="select_form_spouse:{spouse.id}">
{spouse.name}
</button>
</for>
<else>
<text foreground="text_muted">No other qualified individual profile is available.</text>
</else>
</column>
</if>
</column>
</card>
</template>
<template name="profile-notice-toast">
<alert
width="320"
global-key="profile-notice-toast"
label="Tax profile notification">
<row gap="12" cross="start">
<if test="{profileNoticeFailure}">
<icon name="alert" foreground="destructive" width="20" height="20"/>
</if>
<else>
<if test="{profileNoticeSuccess}">
<icon name="check-circle" foreground="success" width="20" height="20"/>
</if>
<else>
<icon name="info" foreground="info" width="20" height="20"/>
</else>
</else>
<text grow="1" wrap="true">{profileNotice}</text>
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="x"
label="Dismiss tax profile notification"
on-press="dismiss_profile_notice">
</button>
</row>
</alert>
</template>
<template name="profile-calendar-export-toast">
<alert
width="320"
global-key="profile-calendar-export-toast"
label="Calendar export notification">
<row gap="12" cross="start">
<if test="{profileCalendarExportNoticeFailure}">
<icon name="alert" foreground="destructive" width="20" height="20"/>
</if>
<else>
<if test="{profileCalendarExportNoticeSuccess}">
<icon name="check-circle" foreground="success" width="20" height="20"/>
</if>
<else>
<icon name="info" foreground="info" width="20" height="20"/>
</else>
</else>
<text grow="1" wrap="true">{profileCalendarExportNotice}</text>
<if test="{profileCalendarExportNoticeDismissible}">
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="x"
label="Dismiss calendar export notification"
on-press="dismiss_profile_calendar_export_notice">
</button>
</if>
</row>
</alert>
</template>
<template name="app-shell" args="brand_logo app_icon bagong_logo bir_logo goldcoders_logo">
<stack grow="1">
<status-bar background="background" border-color="background"></status-bar>
<column grow="1">
<row grow="1">
<if test="{sidebarExpandedVisible}">
<use template="app-sidebar-full" brand_logo="{brand_logo}"/>
</if>
<if test="{sidebarRailVisible}">
<use template="app-sidebar-rail" app_icon="{app_icon}"/>
</if>
<column grow="1" min-width="0">
<column grow="1" min-width="0">
<if test="{sidebarLauncherVisible}">
<use template="app-mobile-header"/>
</if>
<slot/>
</column>
<use
template="app-footer"
bagong_logo="{bagong_logo}"
bir_logo="{bir_logo}"
goldcoders_logo="{goldcoders_logo}"/>
</column>
</row>
</column>
<if test="{sidebarOverlayVisible}">
<column grow="1">
<row grow="1">
<use
template="app-sidebar-full"
brand_logo="{brand_logo}"
overlay="true"/>
<status-bar
grow="1"
background="shadow"
border-color="shadow"
on-press="close_sidebar_overlay"
label="Close navigation">
</status-bar>
</row>
</column>
</if>
<if test="{profileToastRegionVisible}">
<column grow="1" padding="16" cross="end" gap="8">
<if test="{sidebarLauncherVisible}">
<spacer height="56"/>
</if>
<if test="{profileNoticeVisible}">
<use template="profile-notice-toast"/>
</if>
<if test="{profileCalendarExportNoticeVisible}">
<use template="profile-calendar-export-toast"/>
</if>
</column>
</if>
</stack>
</template>
<template
name="multi-select-combobox"
args="placeholder label">
<stack width="{globalCalendarFormPickerWidth}">
<select
size="sm"
height="{globalCalendarFormRowHeight}"
placeholder="Select options..."
label="{label}"
disabled="{globalCalendarFormPickerDisabled}"
on-press="multi_select_open">{globalCalendarFormSelectionText}</select>
<if test="{globalCalendarFormPickerOpen}">
<dropdown-menu
anchor="below"
anchor-alignment="stretch"
anchor-offset="4"
height="{globalCalendarFormMenuHeight}"
on-dismiss="multi_select_close">
<search-field
size="sm"
height="{globalCalendarFormRowHeight}"
text="{globalCalendarFormQuery}"
placeholder="{placeholder}"
autofocus="true"
on-input="multi_select_query_changed"/>
<separator/>
<row height="{globalCalendarFormRowHeight}" gap="4" cross="center">
<if test="{globalCalendarAllFilteredSelected}">
<button
height="{globalCalendarFormRowHeight}"
size="sm"
variant="ghost"
icon="x"
on-press="multi_select_clear_all">Deselect All</button>
</if>
<else>
<button
height="{globalCalendarFormRowHeight}"
size="sm"
variant="ghost"
icon="check"
on-press="multi_select_select_all_filtered">Select All</button>
<if test="{globalCalendarAnyFormsSelected}">
<button
height="{globalCalendarFormRowHeight}"
size="sm"
variant="ghost"
icon="x-circle"
on-press="multi_select_clear_all">Clear All</button>
</if>
</else>
</row>
<separator/>
<scroll
height="{globalCalendarFormOptionsHeight}"
overscroll="none"
label="{label}">
<column>
<for each="visibleGlobalCalendarFormOptions" key="id" as="option">
<if test="{option.selected}">
<menu-item
height="{globalCalendarFormRowHeight}"
icon="check"
selected="true"
on-press="multi_select_toggle_option:{option.id}">{option.label}</menu-item>
</if>
<else>
<menu-item
height="{globalCalendarFormRowHeight}"
selected="false"
on-press="multi_select_toggle_option:{option.id}">{option.label}</menu-item>
</else>
</for>
<else>
<menu-item height="{globalCalendarFormRowHeight}" disabled="true">No matching options</menu-item>
</else>
</column>
</scroll>
</dropdown-menu>
</if>
</stack>
</template>
<template name="profile-calendar-multi-select-combobox" args="placeholder label">
<stack width="{profileCalendarFormPickerWidth}">
<select
height="44"
placeholder="Select forms..."
label="{label}"
disabled="{profileCalendarFormPickerDisabled}"
on-press="profile_calendar_forms_open">{profileCalendarFormSelectionText}</select>
<if test="{profileCalendarFormPickerOpen}">
<dropdown-menu
anchor="below"
anchor-alignment="stretch"
anchor-offset="4"
height="{profileCalendarFormMenuHeight}"
on-dismiss="profile_calendar_forms_close">
<search-field
height="44"
text="{profileCalendarFormQuery}"
placeholder="{placeholder}"
autofocus="true"
on-input="profile_calendar_forms_query_changed"/>
<separator/>
<row height="44" gap="4" cross="center">
<if test="{profileCalendarAllFilteredSelected}">
<button
height="44"
size="sm"
variant="ghost"
icon="x"
on-press="profile_calendar_forms_clear_all">Deselect All</button>
</if>
<else>
<button
height="44"
size="sm"
variant="ghost"
icon="check"
on-press="profile_calendar_forms_select_all_filtered">Select All</button>
<if test="{profileCalendarAnyFormsSelected}">
<button
height="44"
size="sm"
variant="ghost"
icon="x-circle"
on-press="profile_calendar_forms_clear_all">Clear All</button>
</if>
</else>
</row>
<separator/>
<scroll
height="{profileCalendarFormOptionsHeight}"
overscroll="none"
label="{label}">
<column>
<for each="visibleProfileCalendarFormOptions" key="id" as="option">
<if test="{option.selected}">
<menu-item
height="44"
icon="check"
selected="true"
on-press="profile_calendar_forms_toggle_option:{option.id}">{option.label}</menu-item>
</if>
<else>
<menu-item
height="44"
selected="false"
on-press="profile_calendar_forms_toggle_option:{option.id}">{option.label}</menu-item>
</else>
</for>
<else>
<menu-item height="44" disabled="true">No matching options</menu-item>
</else>
</column>
</scroll>
</dropdown-menu>
</if>
</stack>
</template>
<template name="global-deadline-row" args="date year form status tone title period adjusted adjustment">
<card padding="0">
<row padding="12" gap="14" cross="center">
<column width="58" gap="2" cross="center">
<text><span weight="bold">{date}</span></text>
<text foreground="text_muted">{year}</text>
</column>
<column width="1" height="54" background="border"></column>
<column grow="1" gap="4">
<row gap="8" cross="center">
<badge variant="secondary">{form}</badge>
<badge variant="{tone}">{status}</badge>
</row>
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">Taxable period: {period}</text>
<if test="{adjusted}">
<text wrap="true" foreground="text_muted">{adjustment}</text>
</if>
</column>
</row>
</card>
</template>
<template name="global-news-item" args="title summary source published">
<card padding="0">
<column padding="12" gap="6">
<row cross="center" gap="6">
<badge variant="secondary">{source}</badge>
<text size="sm" grow="1" text-alignment="end" foreground="text_muted">{published}</text>
</row>
<text size="sm"><span weight="bold">{title}</span></text>
<text size="sm" wrap="true" foreground="text_muted">{summary}</text>
</column>
</card>
</template>
<template name="global-calendar-weekday" args="label">
<column height="34" padding="6" main="center" cross="center" background="surface_subtle">
<text text-alignment="center" foreground="text_muted">
<span weight="bold">{label}</span>
</text>
</column>
</template>
<template name="global-calendar-empty-state">
<column padding="16" gap="8" cross="center" background="surface_subtle" radius="md">
<icon name="clock" foreground="text_muted" width="24" height="24"/>
<text><span weight="bold">No deadlines to show</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">
No selected forms have a resolved deadline for this view.
</text>
</column>
</template>
<template name="global-calendar-column">
<column width="{globalCalendarLaneWidth}" gap="12">
<if test="{globalCalendarHeaderStacked}">
<column gap="10">
<text><span weight="bold">Compliance Calendar</span></text>
<use template="multi-select-combobox"
placeholder="Search form codes..."
label="Filter global compliance forms"/>
</column>
</if>
<else>
<row cross="center" gap="12">
<text grow="1"><span weight="bold">Compliance Calendar</span></text>
<use template="multi-select-combobox"
placeholder="Search form codes..."
label="Filter global compliance forms"/>
</row>
</else>
<card padding="0">
<column gap="0">
<row padding="12" cross="center" gap="8">
<text grow="1"><span weight="bold">{globalCalendarMonth} {globalCalendarYear}</span></text>
<row cross="center" gap="2">
<button
width="44"
height="44"
size="icon"
variant="ghost"
icon="chevron-left"
label="Previous month"
on-press="global_calendar_previous_month"></button>
<button
width="44"
height="44"
size="icon"
variant="ghost"
icon="chevron-right"
label="Next month"
on-press="global_calendar_next_month"></button>
</row>
</row>
<separator/>
<grid columns="7" gap="1" background="border">
<use template="global-calendar-weekday" label="Sun"/>
<use template="global-calendar-weekday" label="Mon"/>
<use template="global-calendar-weekday" label="Tue"/>
<use template="global-calendar-weekday" label="Wed"/>
<use template="global-calendar-weekday" label="Thu"/>
<use template="global-calendar-weekday" label="Fri"/>
<use template="global-calendar-weekday" label="Sat"/>
<for each="globalCalendarDays" key="id" as="cell">
<column height="{globalCalendarDayHeight}" cross="stretch" background="surface_subtle">
<if test="{cell.blank}">
<spacer/>
</if>
<else>
<column
grow="1"
padding="7"
main="space_between"
cross="stretch"
background="surface"
role="button"
label="{cell.actionLabel}"
selected="{cell.selected}"
on-press="global_calendar_select_day:{cell.day}">
<if test="{cell.selected}">
<row main="end">
<badge variant="primary">{cell.dayLabel}</badge>
</row>
</if>
<else>
<text text-alignment="end">{cell.dayLabel}</text>
</else>
<if test="{cell.hasDeadlines}">
<row grow="1" main="center" cross="center">
<if test="{cell.overdue}">
<text foreground="destructive">{cell.marker}</text>
</if>
<else>
<if test="{cell.dueSoon}">
<text foreground="warning">{cell.marker}</text>
</if>
<else>
<if test="{cell.approaching}">
<text foreground="success">{cell.marker}</text>
</if>
<else>
<text>{cell.marker}</text>
</else>
</else>
</else>
</row>
</if>
</column>
</else>
</column>
</for>
</grid>
</column>
</card>
<row cross="center" gap="10">
<text grow="1"><span weight="bold">{globalCalendarDeadlineHeading}</span></text>
<badge variant="secondary">{globalCalendarDeadlineCount}</badge>
</row>
<if test="{globalCalendarHasDeadlines}">
<for each="globalDeadlines" key="id" as="deadline">
<use
template="global-deadline-row"
date="{deadline.dateLabel}"
year="{deadline.yearLabel}"
form="{deadline.display_form_no}"
status="{deadline.statusLabel}"
tone="{deadline.tone}"
title="{deadline.form_name}"
period="{deadline.periodLabel}"
adjusted="{deadline.adjustmentVisible}"
adjustment="{deadline.adjustmentLabel}"/>
</for>
</if>
<else>
<use template="global-calendar-empty-state"/>
</else>
</column>
</template>
<template name="global-news-column" args="weight=1">
<column grow="{weight}" gap="12">
<row cross="center" gap="12">
<text grow="1"><span weight="bold">Important News</span></text>
<if test="{constrainedLayout}">
<if test="{importantNewsRefreshing}">
<button
width="44"
height="44"
size="icon"
variant="secondary"
icon="refresh-cw"
label="Refreshing important news"
disabled="{importantNewsRefreshDisabled}"
on-press="refresh_important_news"></button>
</if>
<else>
<button
width="44"
height="44"
size="icon"
variant="secondary"
icon="refresh-cw"
label="Refresh important news"
disabled="{importantNewsRefreshDisabled}"
on-press="refresh_important_news"></button>
</else>
</if>
<else>
<if test="{importantNewsRefreshing}">
<button
size="sm"
variant="secondary"
icon="refresh-cw"
disabled="{importantNewsRefreshDisabled}"
on-press="refresh_important_news">Refreshing…</button>
</if>
<else>
<button
size="sm"
variant="secondary"
icon="refresh-cw"
disabled="{importantNewsRefreshDisabled}"
on-press="refresh_important_news">Refresh</button>
</else>
</else>
</row>
<if test="{importantNewsErrorVisible}">
<alert label="Important news refresh failed">
<row gap="10" cross="start">
<icon name="alert" foreground="destructive" width="20" height="20"/>
<column grow="1" gap="2">
<text><span weight="bold">Could not refresh important news</span></text>
<text wrap="true" foreground="text_muted">{importantNewsError}</text>
</column>
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="x"
label="Dismiss important news error"
on-press="dismiss_important_news_error">
</button>
</row>
</alert>
</if>
<if test="{importantNewsLoadingEmpty}">
<column padding="20" gap="8" cross="center">
<icon name="refresh-cw" foreground="text_muted" width="24" height="24"/>
<text><span weight="bold">Loading important news…</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">
Checking the latest notices while keeping your cached news available.
</text>
</column>
</if>
<if test="{importantNewsEmpty}">
<column padding="20" gap="8" cross="center">
<icon name="file-text" foreground="text_muted" width="24" height="24"/>
<text><span weight="bold">No important news yet</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">
Refresh to check for the latest notices.
</text>
</column>
</if>
<if test="{importantNewsHasRows}">
<for each="importantNewsRows" key="id" as="item">
<use
template="global-news-item"
title="{item.title}"
summary="{item.summary}"
source="{item.source}"
published="{item.publishedLabel}"/>
</for>
</if>
</column>
</template>
<template name="global-dashboard-content">
<column padding="{globalDashboardPagePadding}" gap="32">
<if test="{constrainedLayout}">
</if>
<else>
<column gap="6">
<text size="heading">Global Dashboard</text>
<text wrap="true" foreground="text_muted">
Global tax schedule for {globalCalendarYear}. Profile choices do not filter this calendar.
</text>
</column>
</else>
<if test="{globalDashboardTwoColumnLayout}">
<row gap="20" cross="start">
<use template="global-calendar-column"/>
<use template="global-news-column" weight="1"/>
</row>
</if>
<else>
<column gap="24">
<use template="global-calendar-column"/>
<use template="global-news-column" weight="1"/>
</column>
</else>
</column>
</template>
<template name="global-dashboard-page">
<scroll grow="1" global-key="page-global-dashboard" label="Global dashboard content">
<use template="global-dashboard-content"/>
</scroll>
</template>
<template name="taxpayer-calendar-weekday" args="label">
<column height="28" main="center" cross="center" background="surface_subtle">
<text text-alignment="center" foreground="text_muted">
<span weight="bold">{label}</span>
</text>
</column>
</template>
<template name="t-e" args="i t b">
<column height="154" padding="18" gap="8" main="center" cross="center" background="surface_subtle" radius="md">
<icon name="{i}" foreground="text_muted" width="22" height="22"/>
<text><span weight="bold">{t}</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">{b}</text>
</column>
</template>
<template name="taxpayer-compact-calendar">
<card padding="0">
<column gap="0">
<row padding="8" cross="center" gap="6">
<button width="44" height="44" size="icon" variant="ghost" icon="chevron-left" label="Previous month" disabled="{profileCalendarPreviousMonthDisabled}" on-press="calendar_previous_month"></button>
<text grow="1" text-alignment="center"><span weight="bold">{currentCalendarMonth} {currentCalendarYear}</span></text>
<button width="44" height="44" size="icon" variant="ghost" icon="chevron-right" label="Next month" disabled="{profileCalendarNextMonthDisabled}" on-press="calendar_next_month"></button>
</row>
<separator/>
<grid columns="7" gap="1" background="border">
<use template="taxpayer-calendar-weekday" label="Sun"/>
<use template="taxpayer-calendar-weekday" label="Mon"/>
<use template="taxpayer-calendar-weekday" label="Tue"/>
<use template="taxpayer-calendar-weekday" label="Wed"/>
<use template="taxpayer-calendar-weekday" label="Thu"/>
<use template="taxpayer-calendar-weekday" label="Fri"/>
<use template="taxpayer-calendar-weekday" label="Sat"/>
<for each="profileCalendarDays" key="id" as="cell">
<column height="{profileCalendarDayHeight}" cross="stretch" background="surface_subtle">
<if test="{cell.blank}">
<spacer/>
</if>
<else>
<column
grow="1"
padding="5"
main="space_between"
cross="stretch"
background="surface"
role="button"
label="{cell.actionLabel}"
selected="{cell.selected}"
on-press="profile_calendar_select_day:{cell.day}">
<if test="{cell.selected}">
<text text-alignment="end"><span weight="bold">{cell.dayLabel}</span></text>
</if>
<else>
<text text-alignment="end">{cell.dayLabel}</text>
</else>
<if test="{cell.hasDeadlines}">
<row grow="1" main="center" cross="center">
<if test="{cell.closed}">
<text foreground="success">{cell.marker}</text>
</if>
<else>
<if test="{cell.overdue}">
<text foreground="destructive">{cell.marker}</text>
</if>
<else>
<if test="{cell.dueSoon}">
<text foreground="warning">{cell.marker}</text>
</if>
<else>
<if test="{cell.approaching}">
<text foreground="success">{cell.marker}</text>
</if>
<else>
<text>{cell.marker}</text>
</else>
</else>
</else>
</else>
</row>
</if>
</column>
</else>
</column>
</for>
</grid>
</column>
</card>
</template>
<template name="taxpayer-profile-calendar-year-picker">
<stack width="{profileCalendarYearPickerWidth}">
<select
height="44"
label="Tax calendar year"
disabled="{profileCalendarYearPickerDisabled}"
on-press="profile_calendar_toggle_year_picker">{profileCalendarYearLabel}</select>
<if test="{profileCalendarYearPickerOpen}">
<dropdown-menu
anchor="below"
anchor-alignment="stretch"
anchor-offset="4"
height="280"
on-dismiss="profile_calendar_close_year_picker">
<column padding="8" gap="8">
<input
height="40"
text="{profileCalendarYearQueryValue}"
placeholder="Filter years"
label="Filter tax years"
on-input="profile_calendar_year_query"/>
<scroll height="190" label="Configured tax years">
<column gap="4">
<for each="profileCalendarYearOptions" key="id" as="option">
<menu-item height="44" selected="{option.selected}" on-press="profile_calendar_select_year:{option.year}">{option.year}</menu-item>
</for>
</column>
</scroll>
</column>
</dropdown-menu>
</if>
</stack>
</template>
<template name="taxpayer-profile-calendar-toolbar">
<column gap="0">
<if test="{desktopLayout}">
<row cross="center" gap="8">
<text grow="1"><span weight="bold">{profileCalendarDeadlineHeading}</span></text>
<use template="profile-calendar-multi-select-combobox"
placeholder="Search active forms..."
label="Filter profile calendar forms"/>
<use template="taxpayer-profile-calendar-year-picker"/>
<button height="44" variant="primary" icon="app:calendar" disabled="{profileCalendarExportBusy}" on-press="profile_calendar_export">Add to Calendar</button>
</row>
</if>
<else>
<column gap="8">
<row height="44" cross="center">
<text grow="1"><span weight="bold">{profileCalendarDeadlineHeading}</span></text>
</row>
<if test="{phoneLayout}">
<column gap="8">
<row gap="8" cross="center">
<use template="taxpayer-profile-calendar-year-picker"/>
<button width="44" height="44" size="icon" variant="primary" icon="app:calendar" label="Add to Calendar" disabled="{profileCalendarExportBusy}" on-press="profile_calendar_export"></button>
</row>
<use template="profile-calendar-multi-select-combobox"
placeholder="Search active forms..."
label="Filter profile calendar forms"/>
</column>
</if>
<else>
<row gap="8" cross="center">
<use template="profile-calendar-multi-select-combobox"
placeholder="Search active forms..."
label="Filter profile calendar forms"/>
<use template="taxpayer-profile-calendar-year-picker"/>
<button width="44" height="44" size="icon" variant="primary" icon="app:calendar" label="Add to Calendar" disabled="{profileCalendarExportBusy}" on-press="profile_calendar_export"></button>
</row>
</else>
</column>
</else>
</column>
</template>
<template name="t-dh">
<row height="40" padding="10" gap="8" cross="center" background="surface_subtle">
<text size="sm" grow="1" foreground="text_muted"><span weight="bold">Form</span></text>
<text size="sm" width="108" foreground="text_muted"><span weight="bold">Status</span></text>
<text size="sm" width="{profileDeadlineActionColumnWidth}" text-alignment="center" foreground="text_muted"><span weight="bold">Action</span></text>
</row>
</template>
<template name="t-da" args="pi pl pd mk mo oi ol od">
<stack width="{profileDeadlineActionColumnWidth}">
<row gap="2" main="end" cross="center">
<button width="{profileDeadlineActionButtonSize}" height="{profileDeadlineActionButtonSize}" size="icon" variant="secondary" icon="{pi}" label="{pl}" on-press="profile_deadline_run_action:{pd}"></button>
<if test="{ol != ''}"><button width="{profileDeadlineActionButtonSize}" height="{profileDeadlineActionButtonSize}" size="icon" variant="ghost" icon="chevron-down" label="More filing actions" on-press="profile_deadline_toggle_actions:{mk}"></button></if>
</row>
<if test="{mo}">
<dropdown-menu width="220" anchor="below" anchor-alignment="end" anchor-offset="4" on-dismiss="profile_deadline_close_actions">
<column padding="4" gap="2">
<menu-item height="44" icon="{oi}" on-press="profile_deadline_run_action:{od}">{ol}</menu-item>
</column>
</dropdown-menu>
</if>
</stack>
</template>
<template name="t-l" args="r h">
<column>
<if test="{h}">
<column>
<if test="{profileDeadlineTableLayout}">
<card padding="0">
<column gap="0">
<use template="t-dh"/>
<separator/>
<for each="r" key="id" as="deadline">
<column gap="0">
<row padding="10" gap="8" cross="center">
<column grow="1" gap="4"><row gap="6" cross="center"><badge variant="secondary">{deadline.compactLabel}</badge><if test="{deadline.timingVisible}"><row gap="4" cross="center"><icon name="{deadline.timingIcon}" width="16" height="16"/><badge variant="{deadline.timingTone}">{deadline.timingLabel}</badge></row></if></row><text size="sm"><span weight="bold">{deadline.formName}</span></text><row gap="4" cross="center"><text grow="1" size="sm" wrap="true" foreground="text_muted">{deadline.dueLabel}</text><if test="{deadline.adjustmentVisible}"><button width="{profileDeadlineActionButtonSize}" height="{profileDeadlineActionButtonSize}" size="icon" variant="ghost" icon="info" label="{deadline.adjustmentActionLabel}" on-press="profile_deadline_show_adjustment:{deadline.adjustmentDispatchId}"></button></if></row></column>
<column width="108" gap="6" main="center"><row gap="6" cross="center"><icon name="{deadline.filingIcon}" width="16" height="16"/><badge variant="{deadline.filingTone}">{deadline.filingStatus}</badge></row></column>
<if test="{deadline.primaryActionVisible}"><use template="t-da" pi="{deadline.primaryActionIcon}" pl="{deadline.primaryActionLabel}" pd="{deadline.primaryActionDispatchId}" mk="{deadline.actionMenuId}" mo="{deadline.actionMenuOpen}" oi="{deadline.secondaryActionOneIcon}" ol="{deadline.secondaryActionOneLabel}" od="{deadline.secondaryActionOneDispatchId}"/></if>
</row>
<separator/>
</column>
</for>
</column>
</card>
</if>
<else>
<column gap="8">
<for each="r" key="id" as="deadline">
<card padding="0">
<column padding="12" gap="8">
<row gap="8" cross="start">
<column grow="1" gap="4"><row gap="6" cross="center"><badge variant="secondary">{deadline.compactLabel}</badge><if test="{deadline.timingVisible}"><row gap="4" cross="center"><icon name="{deadline.timingIcon}" width="16" height="16"/><badge variant="{deadline.timingTone}">{deadline.timingLabel}</badge></row></if></row><text size="sm"><span weight="bold">{deadline.formName}</span></text><row gap="4" cross="center"><text grow="1" size="sm" wrap="true" foreground="text_muted">{deadline.dueLabel}</text><if test="{deadline.adjustmentVisible}"><button width="{profileDeadlineActionButtonSize}" height="{profileDeadlineActionButtonSize}" size="icon" variant="ghost" icon="info" label="{deadline.adjustmentActionLabel}" on-press="profile_deadline_show_adjustment:{deadline.adjustmentDispatchId}"></button></if></row></column>
<if test="{deadline.primaryActionVisible}"><use template="t-da" pi="{deadline.primaryActionIcon}" pl="{deadline.primaryActionLabel}" pd="{deadline.primaryActionDispatchId}" mk="{deadline.actionMenuId}" mo="{deadline.actionMenuOpen}" oi="{deadline.secondaryActionOneIcon}" ol="{deadline.secondaryActionOneLabel}" od="{deadline.secondaryActionOneDispatchId}"/></if>
</row>
<separator/>
<row gap="6" cross="center"><icon name="{deadline.filingIcon}" width="16" height="16"/><badge variant="{deadline.filingTone}">{deadline.filingStatus}</badge></row>
</column>
</card>
</for>
</column>
</else>
</column>
</if>
<else>
<slot/>
</else>
</column>
</template>
<template name="t-dc">
<column gap="12">
<row height="36" cross="center" gap="8">
<text grow="1"><span weight="bold">Deadlines</span></text>
<badge variant="secondary">{profileMonthlyDeadlineCountLabel}</badge>
</row>
<use template="taxpayer-compact-calendar"/>
<use template="t-l" r="{profileMonthlyDeadlineRows}" h="{profileMonthlyHasDeadlines}">
<use template="t-e" i="clock" t="No deadlines" b="There are no open deadlines for the selected date or month."/>
</use>
</column>
</template>
<template name="t-ac">
<column gap="12">
<row height="36" cross="center" gap="8">
<text grow="1"><span weight="bold">Action Required</span></text>
<badge variant="secondary">{profileActionRequiredCount}</badge>
</row>
<use template="t-l" r="{profileActionRequiredRows}" h="{profileActionRequiredHasRows}">
<use template="t-e" i="check-circle" t="All caught up" b="Saved filing work that still needs attention will appear here."/>
</use>
</column>
</template>
<template name="t-oc">
<column gap="12">
<row height="36" cross="center" gap="8">
<text grow="1"><span weight="bold">Overdue</span></text>
<badge variant="destructive">{profileOverdueDeadlineCount}</badge>
</row>
<use template="t-l" r="{profileOverdueDeadlineRows}" h="{profileOverdueHasDeadlines}">
<use template="t-e" i="check-circle" t="Nothing overdue" b="No unpaid deadline has passed for this tax profile."/>
</use>
</column>
</template>
<template name="taxpayer-calendar-section">
<column gap="12">
<use template="taxpayer-profile-calendar-toolbar"/>
<if test="{dashboardThreeColumnLayout}">
<row gap="16" cross="start">
<column width="{profileCalendarLaneWidth}"><use template="t-dc"/></column>
<column grow="1"><use template="t-ac"/></column>
<column grow="1"><use template="t-oc"/></column>
</row>
</if>
<else>
<if test="{dashboardTwoColumnLayout}">
<row gap="16" cross="start">
<column width="{profileCalendarLaneWidth}"><use template="t-dc"/></column>
<column grow="1" gap="20">
<use template="t-ac"/>
<use template="t-oc"/>
</column>
</row>
</if>
<else>
<column gap="20">
<column width="{profileCalendarLaneWidth}"><use template="t-dc"/></column>
<use template="t-ac"/>
<use template="t-oc"/>
</column>
</else>
</else>
</column>
</template>
<template name="taxpayer-form-filter-control">
<stack>
<select
height="44"
label="{profileFormsFilterAccessibleLabel}"
on-press="profile_forms_toggle_filter_picker">{profileFormsFilterDisplayLabel}</select>
<if test="{profileFormsFilterPickerOpen}">
<dropdown-menu
anchor="below"
anchor-alignment="stretch"
anchor-offset="4"
height="430"
on-dismiss="profile_forms_close_filter_picker">
<column grow="1" padding="8" gap="8">
<scroll grow="1" overscroll="none" label="Tax Form Library filters">
<column gap="8">
<if test="{managingProfileForms}">
<column gap="4" role="group" label="Selection">
<text><span weight="bold">Selection</span></text>
<checkbox
height="44"
checked="{profileFormsFilterActiveSelected}"
disabled="{profileFormsFilterActiveLocked}"
text="Selected"
on-toggle="profile_forms_toggle_filter_active"/>
<checkbox
height="44"
checked="{profileFormsFilterInactiveSelected}"
disabled="{profileFormsFilterInactiveLocked}"
text="Not selected"
on-toggle="profile_forms_toggle_filter_inactive"/>
</column>
<separator/>
<column gap="4" role="group" label="Capability">
<text><span weight="bold">Capability</span></text>
<checkbox
height="44"
checked="{profileFormsFilterEditorSelected}"
disabled="{profileFormsFilterEditorLocked}"
text="Editor available"
on-toggle="profile_forms_toggle_filter_editor"/>
<checkbox
height="44"
checked="{profileFormsFilterCalendarOnlySelected}"
disabled="{profileFormsFilterCalendarOnlyLocked}"
text="Calendar only"
on-toggle="profile_forms_toggle_filter_calendar_only"/>
</column>
<separator/>
</if>
<if test="{managingProfileForms}">
<column gap="4" role="group" label="Filing cadence">
<text><span weight="bold">Filing cadence</span></text>
<checkbox height="44" checked="{profileFormsCadenceMonthlySelected}" disabled="{profileFormsCadenceMonthlyLocked}" text="Monthly" on-toggle="profile_forms_toggle_cadence_monthly"/>
<checkbox height="44" checked="{profileFormsCadenceQuarterlySelected}" disabled="{profileFormsCadenceQuarterlyLocked}" text="Quarterly" on-toggle="profile_forms_toggle_cadence_quarterly"/>
<checkbox height="44" checked="{profileFormsCadenceAnnualSelected}" disabled="{profileFormsCadenceAnnualLocked}" text="Annual" on-toggle="profile_forms_toggle_cadence_annual"/>
<checkbox height="44" checked="{profileFormsCadenceOnDemandSelected}" disabled="{profileFormsCadenceOnDemandLocked}" text="On-demand" on-toggle="profile_forms_toggle_cadence_on_demand"/>
</column>
<separator/>
<column gap="4" role="group" label="Tax category">
<text><span weight="bold">Tax category</span></text>
<text wrap="true" foreground="text_muted">Leave all unchecked to show every category.</text>
<checkbox height="44" checked="{profileFormsCategoryPaymentSelected}" text="Payment" on-toggle="profile_forms_toggle_category_payment"/>
<checkbox height="44" checked="{profileFormsCategoryRegistrationSelected}" text="Registration" on-toggle="profile_forms_toggle_category_registration"/>
<checkbox height="44" checked="{profileFormsCategoryWithholdingSelected}" text="Withholding tax" on-toggle="profile_forms_toggle_category_withholding"/>
<checkbox height="44" checked="{profileFormsCategoryIncomeSelected}" text="Income tax" on-toggle="profile_forms_toggle_category_income"/>
<checkbox height="44" checked="{profileFormsCategoryVatSelected}" text="Value-added tax" on-toggle="profile_forms_toggle_category_vat"/>
<checkbox height="44" checked="{profileFormsCategoryPercentageSelected}" text="Percentage tax" on-toggle="profile_forms_toggle_category_percentage"/>
<checkbox height="44" checked="{profileFormsCategoryDstSelected}" text="Documentary stamp tax" on-toggle="profile_forms_toggle_category_dst"/>
<checkbox height="44" checked="{profileFormsCategoryExciseSelected}" text="Excise tax" on-toggle="profile_forms_toggle_category_excise"/>
<checkbox height="44" checked="{profileFormsCategoryCapitalGainsSelected}" text="Capital gains tax" on-toggle="profile_forms_toggle_category_capital_gains"/>
<checkbox height="44" checked="{profileFormsCategoryEstateDonorsSelected}" text="Estate and donor's tax" on-toggle="profile_forms_toggle_category_estate_donors"/>
</column>
</if>
<if test="{browsingProfileForms}">
<column gap="6" role="group" label="Monthly filing periods">
<text><span weight="bold">Monthly filings</span></text>
<grid columns="4" gap="4">
<button height="44" variant="{profileFormsMonth1Variant}" selected="{profileFormsMonth1Selected}" label="January" on-press="profile_forms_toggle_month_1">Jan</button>
<button height="44" variant="{profileFormsMonth2Variant}" selected="{profileFormsMonth2Selected}" label="February" on-press="profile_forms_toggle_month_2">Feb</button>
<button height="44" variant="{profileFormsMonth3Variant}" selected="{profileFormsMonth3Selected}" label="March" on-press="profile_forms_toggle_month_3">Mar</button>
<button height="44" variant="{profileFormsMonth4Variant}" selected="{profileFormsMonth4Selected}" label="April" on-press="profile_forms_toggle_month_4">Apr</button>
<button height="44" variant="{profileFormsMonth5Variant}" selected="{profileFormsMonth5Selected}" on-press="profile_forms_toggle_month_5">May</button>
<button height="44" variant="{profileFormsMonth6Variant}" selected="{profileFormsMonth6Selected}" label="June" on-press="profile_forms_toggle_month_6">Jun</button>
<button height="44" variant="{profileFormsMonth7Variant}" selected="{profileFormsMonth7Selected}" label="July" on-press="profile_forms_toggle_month_7">Jul</button>
<button height="44" variant="{profileFormsMonth8Variant}" selected="{profileFormsMonth8Selected}" label="August" on-press="profile_forms_toggle_month_8">Aug</button>
<button height="44" variant="{profileFormsMonth9Variant}" selected="{profileFormsMonth9Selected}" label="September" on-press="profile_forms_toggle_month_9">Sep</button>
<button height="44" variant="{profileFormsMonth10Variant}" selected="{profileFormsMonth10Selected}" label="October" on-press="profile_forms_toggle_month_10">Oct</button>
<button height="44" variant="{profileFormsMonth11Variant}" selected="{profileFormsMonth11Selected}" label="November" on-press="profile_forms_toggle_month_11">Nov</button>
<button height="44" variant="{profileFormsMonth12Variant}" selected="{profileFormsMonth12Selected}" label="December" on-press="profile_forms_toggle_month_12">Dec</button>
</grid>
</column>
<separator/>
<column gap="6" role="group" label="Quarterly filing periods">
<text><span weight="bold">Quarterly filings</span></text>
<grid columns="4" gap="4">
<button height="44" variant="{profileFormsQuarter1Variant}" selected="{profileFormsQuarter1Selected}" label="Quarter 1" on-press="profile_forms_toggle_quarter_1">Q1</button>
<button height="44" variant="{profileFormsQuarter2Variant}" selected="{profileFormsQuarter2Selected}" label="Quarter 2" on-press="profile_forms_toggle_quarter_2">Q2</button>
<button height="44" variant="{profileFormsQuarter3Variant}" selected="{profileFormsQuarter3Selected}" label="Quarter 3" on-press="profile_forms_toggle_quarter_3">Q3</button>
<button height="44" variant="{profileFormsQuarter4Variant}" selected="{profileFormsQuarter4Selected}" label="Quarter 4" on-press="profile_forms_toggle_quarter_4">Q4</button>
</grid>
</column>
<text wrap="true" foreground="text_muted">Selected periods prefill the form. Reset filters restores every filing period.</text>
<separator/>
<column gap="4" role="group" label="Other filing types">
<text><span weight="bold">Other filing types</span></text>
<checkbox height="44" checked="{profileFormsCadenceAnnualSelected}" disabled="{profileFormsCadenceAnnualLocked}" text="Annual" on-toggle="profile_forms_toggle_cadence_annual"/>
<checkbox height="44" checked="{profileFormsCadenceOnDemandSelected}" disabled="{profileFormsCadenceOnDemandLocked}" text="On-demand" on-toggle="profile_forms_toggle_cadence_on_demand"/>
</column>
<if test="{profileFormsHasOnDemandFilters}">
<separator/>
<column gap="4" role="group" label="On-demand forms">
<text><span weight="bold">On-demand forms</span></text>
<text wrap="true" foreground="text_muted">Filter non-recurring filings by form.</text>
<for each="profileOnDemandFilterRows" key="id" as="option">
<checkbox
height="44"
checked="{option.selected}"
label="{option.selectionLabel}"
text="{option.label}"
on-toggle="profile_forms_toggle_on_demand_form:{option.id}"/>
</for>
</column>
</if>
</if>
</column>
</scroll>
<separator/>
<row gap="8" cross="center">
<button grow="1" height="44" variant="ghost" on-press="profile_forms_reset_filters">Reset filters</button>
</row>
</column>
</dropdown-menu>
</if>
</stack>
</template>
<template name="profile-deadline-dialog-content">
<column>
<row padding="16" gap="12" cross="center">
<column grow="1" gap="4">
<text><span weight="bold" scale="1.2">{profileDeadlineDialogTitle}</span></text>
<text wrap="true" foreground="text_muted">{profileDeadlineDialogContext}</text>
</column>
<button width="40" height="40" size="icon" variant="ghost" icon="x" label="Close dialog" on-press="profile_deadline_close_dialog"></button>
</row>
<separator/>
<column padding="16" gap="12">
<text wrap="true">{profileDeadlineDialogBody}</text>
<if test="{profileDeadlineDialogSourceVisible}"><text size="sm" wrap="true" foreground="text_muted">Source: {profileDeadlineDialogSource}</text></if>
</column>
</column>
</template>
<template name="taxpayer-form-info-content" args="code title category cadence capability revision">
<column>
<row padding="16" gap="12" cross="center">
<column grow="1" gap="4">
<text><span weight="bold" scale="1.2">BIR Form {code}</span></text>
<text wrap="true" foreground="text_muted">Form details</text>
</column>
<button
width="40"
height="40"
size="icon"
variant="ghost"
icon="x"
label="Close form details"
on-press="profile_forms_close_info"></button>
</row>
<separator/>
<column padding="16" gap="14">
<column gap="4">
<text size="sm" foreground="text_muted">DESCRIPTION</text>
<text wrap="true">{title}</text>
</column>
<grid columns="2" gap="12">
<column gap="4">
<text size="sm" foreground="text_muted">TAX TYPE</text>
<text><span weight="bold">{category}</span></text>
</column>
<column gap="4">
<text size="sm" foreground="text_muted">FILING FREQUENCY</text>
<text><span weight="bold">{cadence}</span></text>
</column>
<column gap="4">
<text size="sm" foreground="text_muted">CATALOG REVISION</text>
<text><span mono="true">{revision}</span></text>
</column>
<column gap="4">
<text size="sm" foreground="text_muted">AVAILABILITY</text>
<text><span weight="bold">{capability}</span></text>
</column>
</grid>
</column>
</column>
</template>
<template name="t-fp" args="a i x d l s c w v">
<stack width="{w}" height="48">
<if test="{v}">
<panel width="{w}" height="48" padding="0" selected="{x}">
<column width="{w}" height="48" padding="0" main="center" cross="stretch" role="button" label="{a}" disabled="{d}" on-press="open_library_period:{i}">
<column gap="1" main="center" cross="stretch">
<text wrap="false" size="sm" text-alignment="center">{l}</text>
<if test="{c == 'success'}"><text wrap="false" size="sm" text-alignment="center" foreground="success">{s}</text></if>
<if test="{c == 'info'}"><text wrap="false" size="sm" text-alignment="center" foreground="info">{s}</text></if>
<if test="{c == 'warning'}"><text wrap="false" size="sm" text-alignment="center" foreground="warning">{s}</text></if>
<if test="{c == 'destructive'}"><text wrap="false" size="sm" text-alignment="center" foreground="destructive">{s}</text></if>
<if test="{c == 'muted'}"><text wrap="false" size="sm" text-alignment="center" foreground="text_muted">{s}</text></if>
</column>
</column>
</panel>
</if>
<else>
<spacer width="{w}" height="48"/>
</else>
</stack>
</template>
<template name="taxpayer-form-library-section">
<column gap="16">
<if test="{profileFormsHeaderStacked}">
<column gap="8">
<row gap="10" cross="center">
<column grow="1" gap="4">
<if test="{managingProfileForms}">
<text><span weight="bold">Manage Forms</span></text>
<text wrap="true" foreground="text_muted">{profileFormsStagedCountLabel}</text>
</if>
<else>
<text><span weight="bold">Tax Form Library</span></text>
<text wrap="true" foreground="text_muted">{profileFormsCountLabel}</text>
</else>
</column>
<text width="72" text-alignment="center" foreground="text_muted"><span weight="bold">{profileFormsYearLabel}</span></text>
</row>
<if test="{managingProfileForms}">
<row gap="8" cross="center">
<spacer/>
<button height="44" variant="outline" on-press="profile_forms_cancel">Cancel</button>
<button height="44" icon="check" disabled="{profileFormsSaveDisabled}" on-press="profile_forms_save">Save</button>
</row>
</if>
</column>
</if>
<else>
<row gap="10" cross="center">
<column grow="1" gap="4">
<if test="{managingProfileForms}">
<text><span weight="bold">Manage Forms</span></text>
<text wrap="true" foreground="text_muted">{profileFormsStagedCountLabel}</text>
</if>
<else>
<text><span weight="bold">Tax Form Library</span></text>
<text wrap="true" foreground="text_muted">{profileFormsCountLabel}</text>
</else>
</column>
<text width="72" text-alignment="center" foreground="text_muted"><span weight="bold">{profileFormsYearLabel}</span></text>
<if test="{managingProfileForms}">
<button height="44" variant="outline" on-press="profile_forms_cancel">Cancel</button>
<button height="44" icon="check" disabled="{profileFormsSaveDisabled}" on-press="profile_forms_save">Save</button>
</if>
</row>
</else>
<if test="{profileFormsHeaderStacked}">
<column gap="8">
<input
height="44"
text="{profileFormsSearchValue}"
placeholder="Search by form code or title"
label="Search Tax Form Library"
on-input="profile_forms_search_input"/>
<use template="taxpayer-form-filter-control"/>
</column>
</if>
<else>
<row gap="8" cross="center">
<input
grow="1"
height="44"
text="{profileFormsSearchValue}"
placeholder="Search by form code or title"
label="Search Tax Form Library"
on-input="profile_forms_search_input"/>
<column width="260">
<use template="taxpayer-form-filter-control"/>
</column>
</row>
</else>
<if test="{managingProfileForms}">
<if test="{profileFormsHeaderStacked}">
<column gap="8">
<button height="40" variant="outline" on-press="profile_forms_select_all">Select all 51</button>
<button height="40" variant="outline" on-press="profile_forms_clear_all">Clear all</button>
<if test="{profileFormsLegacyResetVisible}">
<button height="40" variant="ghost" on-press="profile_forms_reset_legacy">Reset to catalog default</button>
</if>
</column>
</if>
<else>
<row gap="8">
<button height="40" variant="outline" on-press="profile_forms_select_all">Select all 51</button>
<button height="40" variant="outline" on-press="profile_forms_clear_all">Clear all</button>
<if test="{profileFormsLegacyResetVisible}">
<button height="40" variant="ghost" on-press="profile_forms_reset_legacy">Reset to catalog default</button>
</if>
</row>
</else>
<row gap="8" cross="center">
<badge variant="secondary">{profileFormsChangedCountLabel}</badge>
<text grow="1" wrap="true" foreground="text_muted">Changes remain staged until Save. Saving zero forms creates an explicitly empty library and profile calendar.</text>
</row>
</if>
<if test="{profileFormRowsEmpty}">
<if test="{browsingProfileForms}">
<if test="{profileBrowseActiveEmpty}">
<card padding="0">
<column height="180" padding="24" gap="12" main="center" cross="center">
<icon name="search" foreground="text_muted" width="28" height="28"/>
<text text-alignment="center"><span weight="bold">No active forms</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">Activate forms for this profile and tax year to add them to the library.</text>
<text wrap="true" text-alignment="center" foreground="text_muted">Open Profile Settings → Tax Forms to activate a yearly form set.</text>
</column>
</card>
</if>
<else>
<card padding="0">
<column height="180" padding="24" gap="12" main="center" cross="center">
<icon name="search" foreground="text_muted" width="28" height="28"/>
<text text-alignment="center"><span weight="bold">No forms match these filters</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">Try another search, month, quarter, or filing type.</text>
<button height="44" variant="outline" on-press="profile_forms_reset_filters">Reset filters</button>
</column>
</card>
</else>
</if>
<else>
<use template="t-e" i="search" t="No matching catalog forms" b="Change the search, selection, capability, cadence, or tax-category filters."/>
</else>
</if>
<else>
<if test="{managingProfileForms}">
<grid columns="{profileFormCardColumns}" gap="12">
<for each="profileFormRows" key="id" as="form">
<card padding="0" selected="{form.selected}">
<row padding="14" gap="12" cross="start">
<checkbox
checked="{form.selected}"
label="{form.selectionLabel}"
on-toggle="toggle_profile_form:{form.id}"/>
<column grow="1" gap="8">
<row gap="8" cross="center">
<badge variant="secondary">{form.code}</badge>
<badge variant="{form.manageStatusTone}">{form.manageStatusLabel}</badge>
</row>
<text wrap="true">{form.title}</text>
<text wrap="true" foreground="text_muted">{form.categoryLabel} - {form.cadenceLabel}</text>
<text wrap="true" foreground="text_muted">{form.capability}</text>
</column>
</row>
</card>
</for>
</grid>
</if>
<else>
<grid columns="{profileFormCardColumns}" gap="12">
<for each="profileFormRows" key="id" as="form">
<card padding="0">
<column padding="12" gap="10" cross="stretch">
<row gap="8" cross="center">
<text grow="1"><span weight="bold" scale="1.25">{form.code}</span></text>
<text size="sm" foreground="text_muted">{form.filingProgress}</text>
<button
width="32"
height="32"
size="icon"
variant="ghost"
icon="info"
label="{form.infoLabel}"
on-press="profile_forms_show_info:{form.id}"></button>
</row>
<if test="{form.hasPeriodCells}">
<grid columns="{form.periodGridColumns}" gap="6">
<if test="{form.period1.available}"><use template="t-fp" a="{form.period1.actionLabel}" i="{form.period1.actionId}" x="{form.period1.selected}" d="{form.period1.disabled}" l="{form.period1.label}" s="{form.period1.visualStatus}" v="{form.period1.visible}" c="{form.period1.statusColor}" w="{form.period1.tileWidth}"/></if>
<if test="{form.period2.available}"><use template="t-fp" a="{form.period2.actionLabel}" i="{form.period2.actionId}" x="{form.period2.selected}" d="{form.period2.disabled}" l="{form.period2.label}" s="{form.period2.visualStatus}" v="{form.period2.visible}" c="{form.period2.statusColor}" w="{form.period2.tileWidth}"/></if>
<if test="{form.period3.available}"><use template="t-fp" a="{form.period3.actionLabel}" i="{form.period3.actionId}" x="{form.period3.selected}" d="{form.period3.disabled}" l="{form.period3.label}" s="{form.period3.visualStatus}" v="{form.period3.visible}" c="{form.period3.statusColor}" w="{form.period3.tileWidth}"/></if>
<if test="{form.period4.available}"><use template="t-fp" a="{form.period4.actionLabel}" i="{form.period4.actionId}" x="{form.period4.selected}" d="{form.period4.disabled}" l="{form.period4.label}" s="{form.period4.visualStatus}" v="{form.period4.visible}" c="{form.period4.statusColor}" w="{form.period4.tileWidth}"/></if>
<if test="{form.period5.available}"><use template="t-fp" a="{form.period5.actionLabel}" i="{form.period5.actionId}" x="{form.period5.selected}" d="{form.period5.disabled}" l="{form.period5.label}" s="{form.period5.visualStatus}" v="{form.period5.visible}" c="{form.period5.statusColor}" w="{form.period5.tileWidth}"/></if>
<if test="{form.period6.available}"><use template="t-fp" a="{form.period6.actionLabel}" i="{form.period6.actionId}" x="{form.period6.selected}" d="{form.period6.disabled}" l="{form.period6.label}" s="{form.period6.visualStatus}" v="{form.period6.visible}" c="{form.period6.statusColor}" w="{form.period6.tileWidth}"/></if>
<if test="{form.period7.available}"><use template="t-fp" a="{form.period7.actionLabel}" i="{form.period7.actionId}" x="{form.period7.selected}" d="{form.period7.disabled}" l="{form.period7.label}" s="{form.period7.visualStatus}" v="{form.period7.visible}" c="{form.period7.statusColor}" w="{form.period7.tileWidth}"/></if>
<if test="{form.period8.available}"><use template="t-fp" a="{form.period8.actionLabel}" i="{form.period8.actionId}" x="{form.period8.selected}" d="{form.period8.disabled}" l="{form.period8.label}" s="{form.period8.visualStatus}" v="{form.period8.visible}" c="{form.period8.statusColor}" w="{form.period8.tileWidth}"/></if>
<if test="{form.period9.available}"><use template="t-fp" a="{form.period9.actionLabel}" i="{form.period9.actionId}" x="{form.period9.selected}" d="{form.period9.disabled}" l="{form.period9.label}" s="{form.period9.visualStatus}" v="{form.period9.visible}" c="{form.period9.statusColor}" w="{form.period9.tileWidth}"/></if>
<if test="{form.period10.available}"><use template="t-fp" a="{form.period10.actionLabel}" i="{form.period10.actionId}" x="{form.period10.selected}" d="{form.period10.disabled}" l="{form.period10.label}" s="{form.period10.visualStatus}" v="{form.period10.visible}" c="{form.period10.statusColor}" w="{form.period10.tileWidth}"/></if>
<if test="{form.period11.available}"><use template="t-fp" a="{form.period11.actionLabel}" i="{form.period11.actionId}" x="{form.period11.selected}" d="{form.period11.disabled}" l="{form.period11.label}" s="{form.period11.visualStatus}" v="{form.period11.visible}" c="{form.period11.statusColor}" w="{form.period11.tileWidth}"/></if>
<if test="{form.period12.available}"><use template="t-fp" a="{form.period12.actionLabel}" i="{form.period12.actionId}" x="{form.period12.selected}" d="{form.period12.disabled}" l="{form.period12.label}" s="{form.period12.visualStatus}" v="{form.period12.visible}" c="{form.period12.statusColor}" w="{form.period12.tileWidth}"/></if>
</grid>
</if>
</column>
</card>
</for>
</grid>
</else>
<if test="{profileFormsPaginationVisible}">
<row main="center" cross="center" gap="8">
<button
width="44"
height="44"
size="icon"
variant="outline"
icon="chevron-left"
label="Previous forms"
disabled="{profileFormsPreviousDisabled}"
on-press="profile_forms_show_previous"></button>
<text width="150" text-alignment="center" foreground="text_muted">{profileFormsPageLabel}</text>
<button
width="44"
height="44"
size="icon"
variant="outline"
icon="chevron-right"
label="Next forms"
disabled="{profileFormsNextDisabled}"
on-press="profile_forms_show_more"></button>
</row>
</if>
</else>
</column>
</template>
<template name="profile-field" args="label grow=0">
<column grow="{grow}" gap="6">
<text>{label}</text>
<slot/>
</column>
</template>
<template name="profile-setup-content">
<column gap="24">
<if test="{profileInlineBackVisible}">
<row gap="10" cross="start">
<button
width="44"
height="44"
size="icon"
variant="ghost"
radius="xl"
icon="chevron-left"
label="{profileBackLabel}"
on-press="cancel_profile_edit">
</button>
<column grow="1" gap="6">
<text size="heading">{profileEditorTitle}</text>
<text wrap="true" foreground="text_muted">
Reusable tax facts are versioned once and projected into each qualified
form. Existing filing snapshots never change when a profile is revised.
</text>
</column>
</row>
</if>
<tabs label="Profile setup sections">
<button
height="44"
selected="{profileTaxActive}"
on-press="show_profile_tax">
Tax Profile
</button>
<button
height="44"
selected="{profileTaxFormsActive}"
on-press="show_profile_tax_forms">
Tax Forms
</button>
<button
height="44"
selected="{profileCertificateActive}"
on-press="show_profile_certificate">
COR
</button>
<button
height="44"
selected="{profileEmailActive}"
on-press="show_profile_email">
Email Settings
</button>
</tabs>
<if test="{profileCompletionVisible}">
<card padding="0">
<row padding="12" gap="10" cross="center">
<badge variant="outline">Profile data required</badge>
<text wrap="true" foreground="text_muted">{profileCompletionMessage}</text>
</row>
</card>
</if>
<if test="{profileTaxActive}">
<column gap="24">
<column gap="16">
<column gap="4">
<text><span weight="bold">Identity and registration</span></text>
<text wrap="true" foreground="text_muted">
TIN, RDO, legal name, and subject kind identify this immutable
profile revision.
</text>
</column>
<if test="{constrainedLayout}">
<column gap="12">
<use template="profile-field" label="Taxpayer Identification Number (TIN)">
<input
height="44"
text="{profileTinValue}"
placeholder="000-000-000-000"
label="Taxpayer Identification Number (TIN)"
autofocus="{profileTinAutofocus}"
on-input="profile_tin_input"/>
</use>
<use template="profile-field" label="Revenue District Office (RDO) code">
<input
height="44"
text="{profileRdoValue}"
placeholder="RDO code"
label="Revenue District Office (RDO) code"
autofocus="{profileRdoAutofocus}"
on-input="profile_rdo_input"/>
</use>
</column>
</if>
<else>
<row gap="12">
<use template="profile-field" label="Taxpayer Identification Number (TIN)" grow="1">
<input
height="44"
text="{profileTinValue}"
placeholder="000-000-000-000"
label="Taxpayer Identification Number (TIN)"
autofocus="{profileTinAutofocus}"
on-input="profile_tin_input"/>
</use>
<use template="profile-field" label="Revenue District Office (RDO) code" grow="1">
<input
height="44"
text="{profileRdoValue}"
placeholder="RDO code"
label="Revenue District Office (RDO) code"
autofocus="{profileRdoAutofocus}"
on-input="profile_rdo_input"/>
</use>
</row>
</else>
<column gap="8">
<text>Taxpayer subject kind</text>
<if test="{constrainedLayout}">
<stack>
<select
height="44"
label="Taxpayer subject kind"
on-press="toggle_profile_subject_picker">{profileSubjectKindLabel}</select>
<if test="{profileSubjectPickerOpen}">
<dropdown-menu
anchor="below"
anchor-alignment="stretch"
on-dismiss="close_profile_subject_picker">
<menu-item height="44" selected="{profileIndividualSelected}" on-press="profile_subject_individual">Individual</menu-item>
<menu-item height="44" selected="{profileSoleProprietorSelected}" on-press="profile_subject_sole_proprietor">Sole proprietor</menu-item>
<menu-item height="44" selected="{profileCorporationSelected}" on-press="profile_subject_corporation">Corporation</menu-item>
<menu-item height="44" selected="{profilePartnershipSelected}" on-press="profile_subject_partnership">Partnership</menu-item>
<menu-item height="44" selected="{profileEstateSelected}" on-press="profile_subject_estate">Estate</menu-item>
<menu-item height="44" selected="{profileTrustSelected}" on-press="profile_subject_trust">Trust</menu-item>
<menu-item height="44" selected="{profileOtherLegalSelected}" on-press="profile_subject_other_legal">Other legal entity</menu-item>
</dropdown-menu>
</if>
</stack>
</if>
<else>
<column gap="8">
<row gap="8">
<button height="44" variant="outline" selected="{profileIndividualSelected}" on-press="profile_subject_individual">Individual</button>
<button height="44" variant="outline" selected="{profileSoleProprietorSelected}" on-press="profile_subject_sole_proprietor">Sole proprietor</button>
<button height="44" variant="outline" selected="{profileCorporationSelected}" on-press="profile_subject_corporation">Corporation</button>
<button height="44" variant="outline" selected="{profilePartnershipSelected}" on-press="profile_subject_partnership">Partnership</button>
</row>
<row gap="8">
<button height="44" variant="outline" selected="{profileEstateSelected}" on-press="profile_subject_estate">Estate</button>
<button height="44" variant="outline" selected="{profileTrustSelected}" on-press="profile_subject_trust">Trust</button>
<button height="44" variant="outline" selected="{profileOtherLegalSelected}" on-press="profile_subject_other_legal">Other legal entity</button>
</row>
</column>
</else>
</column>
<use template="profile-field" label="Taxpayer or registered name">
<input
height="44"
text="{profileNameValue}"
placeholder="Registered taxpayer name"
label="Taxpayer or registered name"
autofocus="{profileNameAutofocus}"
on-input="profile_name_input"/>
</use>
<if test="{profileTradeNameVisible}">
<use template="profile-field" label="Trade name">
<input
height="44"
text="{profileTradeNameValue}"
placeholder="Optional DTI or registered trade name"
label="Trade name"
on-input="profile_trade_name_input"/>
</use>
</if>
<use template="profile-field" label="Registered address">
<input
height="44"
text="{profileAddressValue}"
placeholder="Registered address"
label="Registered address"
autofocus="{profileAddressAutofocus}"
on-input="profile_address_input"/>
</use>
<if test="{constrainedLayout}">
<column gap="12">
<use template="profile-field" label="ZIP code">
<input height="44" text="{profileZipValue}" placeholder="ZIP code" label="ZIP code" autofocus="{profileZipAutofocus}" on-input="profile_zip_input"/>
</use>
<use template="profile-field" label="Contact number">
<input height="44" text="{profilePhoneValue}" placeholder="+63 900 000 0000" label="Contact number" autofocus="{profilePhoneAutofocus}" on-input="profile_phone_input"/>
</use>
</column>
</if>
<else>
<row gap="12">
<use template="profile-field" label="ZIP code" grow="1">
<input height="44" text="{profileZipValue}" placeholder="ZIP code" label="ZIP code" autofocus="{profileZipAutofocus}" on-input="profile_zip_input"/>
</use>
<use template="profile-field" label="Contact number" grow="1">
<input height="44" text="{profilePhoneValue}" placeholder="+63 900 000 0000" label="Contact number" autofocus="{profilePhoneAutofocus}" on-input="profile_phone_input"/>
</use>
</row>
</else>
<use template="profile-field" label="Registered email address">
<input height="44" text="{profileEmailValue}" placeholder="name@example.com" label="Registered email address" autofocus="{profileEmailAutofocus}" on-input="profile_email_input"/>
</use>
</column>
<column gap="16">
<column gap="4">
<text><span weight="bold">Individual capabilities</span></text>
<text wrap="true" foreground="text_muted">
Leave fields empty when they do not truthfully apply. Forms
requiring a missing capability will reject this profile.
</text>
</column>
<if test="{constrainedLayout}">
<column gap="12">
<use template="profile-field" label="Birth date">
<input
height="44"
text="{profileBirthDateValue}"
placeholder="YYYY-MM-DD"
label="Birth date"
disabled="{profilePersonalFieldsDisabled}"
autofocus="{profileBirthDateAutofocus}"
on-input="profile_birth_date_input"/>
</use>
<use template="profile-field" label="Citizenship">
<input
height="44"
text="{profileCitizenshipValue}"
placeholder="Citizenship"
label="Citizenship"
disabled="{profilePersonalFieldsDisabled}"
autofocus="{profileCitizenshipAutofocus}"
on-input="profile_citizenship_input"/>
</use>
</column>
</if>
<else>
<row gap="12">
<use template="profile-field" label="Birth date" grow="1">
<input height="44" text="{profileBirthDateValue}" placeholder="YYYY-MM-DD" label="Birth date" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileBirthDateAutofocus}" on-input="profile_birth_date_input"/>
</use>
<use template="profile-field" label="Citizenship" grow="1">
<input height="44" text="{profileCitizenshipValue}" placeholder="Citizenship" label="Citizenship" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileCitizenshipAutofocus}" on-input="profile_citizenship_input"/>
</use>
</row>
</else>
<use template="profile-field" label="Foreign tax number">
<input
height="44"
text="{profileForeignTaxNumberValue}"
placeholder="Optional foreign tax identifier"
label="Foreign tax number"
disabled="{profilePersonalFieldsDisabled}"
autofocus="{profileForeignTaxNumberAutofocus}"
on-input="profile_foreign_tax_number_input"/>
</use>
</column>
<column gap="16">
<column gap="4">
<text><span weight="bold">Business registration</span></text>
<text wrap="true" foreground="text_muted">
Line of business and ATC compose one named activity. Tax type,
withholding-agent status, and special-rate basis are independent
registration facts. Transaction schedules remain on the form.
</text>
</column>
<use template="profile-field" label="Line of business">
<input height="44" text="{profileBusinessLineValue}" placeholder="Line of business" label="Line of business" autofocus="{profileBusinessLineAutofocus}" on-input="profile_business_line_input"/>
</use>
<if test="{constrainedLayout}">
<column gap="12">
<use template="profile-field" label="Alphanumeric Tax Code (ATC)">
<input height="44" text="{profileAtcValue}" placeholder="PT010" label="Alphanumeric Tax Code (ATC)" autofocus="{profileAtcAutofocus}" on-input="profile_atc_input"/>
</use>
<use template="profile-field" label="Registered tax type">
<input height="44" text="{profileTaxTypeValue}" placeholder="Percentage tax" label="Registered tax type" autofocus="{profileTaxTypeAutofocus}" on-input="profile_tax_type_input"/>
</use>
</column>
</if>
<else>
<row gap="12">
<use template="profile-field" label="Alphanumeric Tax Code (ATC)" grow="1">
<input height="44" text="{profileAtcValue}" placeholder="PT010" label="Alphanumeric Tax Code (ATC)" autofocus="{profileAtcAutofocus}" on-input="profile_atc_input"/>
</use>
<use template="profile-field" label="Registered tax type" grow="1">
<input height="44" text="{profileTaxTypeValue}" placeholder="Percentage tax" label="Registered tax type" autofocus="{profileTaxTypeAutofocus}" on-input="profile_tax_type_input"/>
</use>
</row>
</else>
<column gap="8">
<text foreground="text_muted">Government withholding agent</text>
<row gap="8">
<button height="44" variant="outline" selected="{profileGwaUnsetSelected}" on-press="profile_gwa_unset">Not recorded</button>
<button height="44" variant="outline" selected="{profileGwaNoSelected}" on-press="profile_gwa_no">No</button>
<button height="44" variant="outline" selected="{profileGwaYesSelected}" on-press="profile_gwa_yes">Yes</button>
</row>
</column>
<use template="profile-field" label="Special-rate basis">
<input height="44" text="{profileSpecialRateBasisValue}" placeholder="Treaty article, special law, or registration basis" label="Special-rate basis" on-input="profile_special_rate_basis_input"/>
</use>
</column>
<column gap="16">
<column gap="4">
<text><span weight="bold">Revision and registration evidence</span></text>
<text wrap="true" foreground="text_muted">
Each saved revision records the effective period and source
evidence for this taxpayer.
</text>
</column>
<if test="{constrainedLayout}">
<column gap="12">
<use template="profile-field" label="Revision effective from">
<input height="44" text="{profileEffectiveFromValue}" placeholder="YYYY-MM-DD" label="Revision effective from" on-input="profile_effective_from_input"/>
</use>
<use template="profile-field" label="Revision effective until">
<input height="44" text="{profileEffectiveUntilValue}" placeholder="YYYY-MM-DD or empty" label="Revision effective until" on-input="profile_effective_until_input"/>
</use>
</column>
</if>
<else>
<row gap="12">
<use template="profile-field" label="Revision effective from" grow="1">
<input height="44" text="{profileEffectiveFromValue}" placeholder="YYYY-MM-DD" label="Revision effective from" on-input="profile_effective_from_input"/>
</use>
<use template="profile-field" label="Revision effective until" grow="1">
<input height="44" text="{profileEffectiveUntilValue}" placeholder="YYYY-MM-DD or empty" label="Revision effective until" on-input="profile_effective_until_input"/>
</use>
</row>
</else>
<column gap="8">
<text foreground="text_muted">Revision source</text>
<if test="{constrainedLayout}">
<column gap="8">
<button height="44" variant="outline" selected="{profileSourceManualSelected}" on-press="profile_source_manual">Manual entry</button>
<button height="44" variant="outline" selected="{profileSourceImportedSelected}" on-press="profile_source_imported">Imported</button>
<button height="44" variant="outline" selected="{profileSourceMigratedSelected}" on-press="profile_source_migrated">Migrated</button>
</column>
</if>
<else>
<row gap="8">
<button height="44" variant="outline" selected="{profileSourceManualSelected}" on-press="profile_source_manual">Manual entry</button>
<button height="44" variant="outline" selected="{profileSourceImportedSelected}" on-press="profile_source_imported">Imported</button>
<button height="44" variant="outline" selected="{profileSourceMigratedSelected}" on-press="profile_source_migrated">Migrated</button>
</row>
</else>
</column>
<use template="profile-field" label="Source reference">
<input
height="44"
text="{profileSourceReferenceValue}"
placeholder="Import batch, COR reference, or migration record"
label="Source reference"
disabled="{profileSourceReferenceDisabled}"
on-input="profile_source_reference_input"/>
</use>
</column>
</column>
</if>
<if test="{profileTaxFormsActive}">
<column gap="16">
<column gap="4">
<text><span weight="bold">Yearly tax forms</span></text>
<text wrap="true" foreground="text_muted">
Activate a separate Forms Set for each tax year. A year can be
added once, then edited later; an explicitly empty set keeps that
year out of the taxpayer calendar.
</text>
</column>
<if test="{managingProfileForms}">
<use template="taxpayer-form-library-section"/>
</if>
<else>
<row gap="10" cross="end">
<use template="profile-field" label="New tax year" grow="1">
<input
height="44"
text="{profileTaxYearValue}"
placeholder="YYYY"
label="New tax year"
on-input="profile_tax_year_input"/>
</use>
<button
height="44"
variant="primary"
icon="plus"
disabled="{profileFormsAddYearDisabled}"
on-press="profile_forms_add_year">Add yearly form set</button>
</row>
<if test="{editingNewProfile}">
<card padding="0">
<column padding="20" gap="6">
<text><span weight="bold">Save the tax profile first</span></text>
<text wrap="true" foreground="text_muted">
Yearly forms belong to a saved taxpayer profile. Save this
profile, then return here to activate its forms.
</text>
</column>
</card>
</if>
<else>
<if test="{profileFormSetRowsEmpty}">
<card padding="0">
<column padding="24" gap="8" main="center" cross="center">
<icon name="file-text" foreground="text_muted" width="28" height="28"/>
<text text-alignment="center"><span weight="bold">No yearly form sets yet</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">
Add a year to create its independent tax form library.
</text>
</column>
</card>
</if>
<else>
<column gap="10">
<for each="profileFormSetRows" key="id" as="set">
<card padding="0">
<row padding="14" gap="14" cross="center">
<column width="76" gap="2" cross="center">
<text text-alignment="center"><span weight="bold" scale="1.2">{set.yearLabel}</span></text>
<text text-alignment="center" size="sm" foreground="text_muted">Tax year</text>
</column>
<column width="1" height="54" background="border"></column>
<column grow="1" gap="4">
<row gap="8" cross="center">
<badge variant="secondary">{set.stateLabel}</badge>
<text foreground="text_muted">{set.formsLabel}</text>
</row>
<text wrap="true" foreground="text_muted">
Only the active forms for this year appear in the taxpayer calendar.
</text>
</column>
<button height="44" variant="outline" on-press="profile_forms_edit_year:{set.tax_year}">{set.editorLabel}</button>
</row>
</card>
</for>
</column>
</else>
</else>
</else>
</column>
</if>
<if test="{profileCertificateActive}">
<column gap="12">
<text><span weight="bold">Certificate of Registration evidence</span></text>
<text wrap="true" foreground="text_muted">
COR attachments and extraction evidence are intentionally stored
separately from reusable tax facts. This surface will attach
evidence without changing a filed form snapshot.
</text>
<button height="44" variant="outline" icon="folder-open" disabled="true">Attach COR evidence</button>
</column>
</if>
<if test="{profileEmailActive}">
<column gap="12">
<text><span weight="bold">Email monitoring credentials</span></text>
<text wrap="true" foreground="text_muted">
Mailbox credentials are operational secrets, not reusable tax
facts. They are not stored in the tax-profile revision tables.
</text>
<button height="44" variant="outline" icon="send" disabled="true">Configure secure mailbox connection</button>
</column>
</if>
<if test="{profileTaxActive or profileCertificateActive or profileEmailActive}">
<if test="{constrainedLayout}">
<column gap="10">
<button height="44" variant="outline" on-press="cancel_profile_edit">Cancel</button>
<button
height="44"
variant="primary"
icon="save"
disabled="{profileSaveDisabled}"
on-press="save_profile">
{profileSaveLabel}
</button>
</column>
</if>
<else>
<row main="end" gap="12">
<button height="44" variant="outline" on-press="cancel_profile_edit">Cancel</button>
<button
height="44"
variant="primary"
icon="save"
disabled="{profileSaveDisabled}"
on-press="save_profile">
{profileSaveLabel}
</button>
</row>
</else>
</if>
</column>
</template>
<template name="profile-setup-page">
<scroll grow="1" global-key="page-profile-setup" label="Taxpayer profile setup content">
<if test="{phoneLayout}">
<column padding="16">
<use template="profile-setup-content"/>
</column>
</if>
<else>
<if test="{constrainedLayout}">
<column padding="20">
<use template="profile-setup-content"/>
</column>
</if>
<else>
<column padding="32">
<use template="profile-setup-content"/>
</column>
</else>
</else>
</scroll>
</template>
<template name="taxpayer-dashboard-page">
<scroll grow="1" global-key="page-taxpayer-dashboard" label="Taxpayer dashboard content">
<column padding="{taxpayerDashboardPagePadding}" gap="24">
<if test="{constrainedLayout}">
<row gap="12" cross="center">
<avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
<column grow="1" gap="5">
<text size="heading" wrap="true">{selectedTaxpayerName}</text>
<text wrap="true" foreground="text_muted">TIN: {selectedTaxpayerTin}</text>
<text wrap="true" foreground="text_muted">Type: {selectedTaxpayerKind} - Tax Year {currentCalendarYear} - Non-VAT</text>
</column>
</row>
</if>
<else>
<row gap="16" cross="center">
<avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
<column grow="1" gap="6">
<text size="heading">{selectedTaxpayerName}</text>
<text wrap="true" foreground="text_muted">
TIN: {selectedTaxpayerTin} - Type: {selectedTaxpayerKind} - Tax Year {currentCalendarYear} - Non-VAT
</text>
</column>
</row>
</else>
<if test="{constrainedLayout}">
<tabs gap="4" label="Dashboard view">
<button height="44" variant="ghost" selected="{dashboardCalendarActive}" on-press="show_dashboard_calendar">Calendar</button>
<button height="44" variant="ghost" selected="{dashboardFormsActive}" on-press="show_dashboard_forms">Forms</button>
<button height="44" variant="ghost" selected="{dashboardProfileSettingsActive}" on-press="show_dashboard_profile_settings">Profile</button>
</tabs>
</if>
<else>
<tabs gap="4" label="Dashboard view">
<button variant="ghost" icon="app:calendar" selected="{dashboardCalendarActive}" on-press="show_dashboard_calendar">Calendar</button>
<button variant="ghost" icon="folder-open" selected="{dashboardFormsActive}" on-press="show_dashboard_forms">Tax Form Library</button>
<button variant="ghost" icon="settings" selected="{dashboardProfileSettingsActive}" on-press="show_dashboard_profile_settings">Profile Settings</button>
</tabs>
</else>
<if test="{dashboardCalendarActive}">
<use template="taxpayer-calendar-section"/>
</if>
<if test="{dashboardFormsActive}">
<use template="taxpayer-form-library-section"/>
</if>
<if test="{dashboardProfileSettingsActive}">
<use template="profile-setup-content"/>
</if>
</column>
</scroll>
</template>
<template name="import-data-content">
<column gap="24">
<column gap="6">
<text size="heading">Import Data</text>
<text wrap="true" foreground="text_muted">Import a profile or database backup from a .zip file.</text>
</column>
<card>
<column padding="24" gap="20">
<if test="{constrainedLayout}">
<column gap="14">
<row gap="14" cross="center">
<icon name="download" foreground="accent" width="36" height="36"/>
<column grow="1" gap="5">
<text><span weight="bold">Smart Import</span></text>
<text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text>
</column>
</row>
<row cross="center">
<badge variant="secondary">Recommended</badge>
</row>
</column>
</if>
<else>
<row gap="16" cross="center">
<icon name="download" foreground="accent" width="36" height="36"/>
<column grow="1" gap="5">
<text><span weight="bold">Smart Import</span></text>
<text wrap="true" foreground="text_muted">Restore compatible eBIRForms data from one archive</text>
</column>
<badge variant="secondary">Recommended</badge>
</row>
</else>
<separator/>
<text wrap="true">
Smart Import inspects the selected .zip file and determines whether it contains a taxpayer profile or a complete database backup.
</text>
<card>
<column padding="24" gap="14" cross="center">
<icon name="archive" foreground="text_muted" width="42" height="42"/>
<text text-alignment="center"><span weight="bold">Choose an eBIRForms archive</span></text>
<text foreground="text_muted">Supported file type: .zip</text>
<button variant="primary" icon="folder-open" disabled="true">Smart Import</button>
</column>
</card>
<row gap="12" cross="start">
<icon name="info" foreground="info" width="20" height="20"/>
<column grow="1" gap="5">
<text><span weight="bold">Before importing</span></text>
<text wrap="true" foreground="text_muted">
Keep a current backup of your existing profiles. Imported data should come from a trusted eBIRForms export.
</text>
</column>
</row>
</column>
</card>
<card>
<column padding="20" gap="12">
<text><span weight="bold">What Smart Import can recognize</span></text>
<row gap="12" cross="start">
<icon name="check-circle" foreground="success" width="18" height="18"/>
<text wrap="true" grow="1">Single taxpayer profile exports</text>
</row>
<row gap="12" cross="start">
<icon name="check-circle" foreground="success" width="18" height="18"/>
<text wrap="true" grow="1">Full database backup archives</text>
</row>
<row gap="12" cross="start">
<icon name="check-circle" foreground="success" width="18" height="18"/>
<text wrap="true" grow="1">Compatible static form and calendar data</text>
</row>
</column>
</card>
</column>
</template>
<template name="import-data-page">
<scroll grow="1" global-key="page-import-data" label="Import data content">
<if test="{phoneLayout}">
<column padding="16">
<use template="import-data-content"/>
</column>
</if>
<else>
<if test="{constrainedLayout}">
<column padding="20">
<use template="import-data-content"/>
</column>
</if>
<else>
<column padding="32">
<use template="import-data-content"/>
</column>
</else>
</else>
</scroll>
</template>
<template name="background-job-card" args="title description source cadence next_run">
<card>
<column padding="20" gap="14">
<if test="{constrainedLayout}">
<column gap="12">
<row gap="12" cross="start">
<icon name="clock" foreground="warning" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{description}</text>
</column>
</row>
<row cross="center">
<badge variant="secondary">Queued</badge>
</row>
</column>
</if>
<else>
<row gap="12" cross="center">
<icon name="clock" foreground="warning" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{description}</text>
</column>
<badge variant="secondary">Queued</badge>
</row>
</else>
<separator/>
<if test="{constrainedLayout}">
<column gap="14">
<column gap="5">
<text foreground="text_muted">Source</text>
<text>{source}</text>
</column>
<column gap="5">
<text foreground="text_muted">Schedule</text>
<text>{cadence}</text>
</column>
<column gap="5">
<text foreground="text_muted">Next run</text>
<text>{next_run}</text>
</column>
</column>
</if>
<else>
<row gap="24" cross="start">
<column grow="1" gap="5">
<text foreground="text_muted">Source</text>
<text>{source}</text>
</column>
<column grow="1" gap="5">
<text foreground="text_muted">Schedule</text>
<text>{cadence}</text>
</column>
<column grow="1" gap="5">
<text foreground="text_muted">Next run</text>
<text>{next_run}</text>
</column>
</row>
</else>
<text wrap="true" foreground="text_muted">Status: Queued - Retries: 0</text>
<if test="{constrainedLayout}">
<column gap="8">
<button
size="sm"
variant="ghost"
icon="eye"
on-press="show_aux_background_task_debug_log">
View Job
</button>
<button size="sm" variant="outline" icon="play" disabled="true">Run Now</button>
<button size="sm" variant="outline" icon="archive" disabled="true">Archive</button>
<button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button>
</column>
</if>
<else>
<row main="end" gap="8">
<button
size="sm"
variant="ghost"
icon="eye"
on-press="show_aux_background_task_debug_log">
View Job
</button>
<button size="sm" variant="outline" icon="play" disabled="true">Run Now</button>
<button size="sm" variant="outline" icon="archive" disabled="true">Archive</button>
<button size="sm" variant="destructive" icon="trash" disabled="true">Delete</button>
</row>
</else>
</column>
</card>
</template>
<template name="background-jobs-content">
<column gap="24">
<card>
<column padding="16" gap="12">
<if test="{constrainedLayout}">
<column gap="10">
<select text="Queued" label="Job status"/>
<search-field placeholder="Search jobs" label="Search background jobs"/>
<select text="Archive Days: 30" label="Archive retention"/>
<button variant="outline" icon="archive" disabled="true">Purge Archives</button>
</column>
</if>
<else>
<row gap="12" cross="center">
<select text="Queued" label="Job status"/>
<search-field grow="1" placeholder="Search jobs" label="Search background jobs"/>
<select text="Archive Days: 30" label="Archive retention"/>
<button variant="outline" icon="archive" disabled="true">Purge Archives</button>
</row>
</else>
<row gap="8" cross="center">
<badge variant="secondary">1 queued</badge>
<text wrap="true" foreground="text_muted">Last checked moments ago</text>
</row>
</column>
</card>
<use
template="background-job-card"
title="Waiting for 2551Q confirmation email"
description="Checks demo@example.com for the filing confirmation message."
source="System"
cadence="Every minute"
next_run="Past due"/>
</column>
</template>
<template name="background-logs-content">
<card>
<column padding="20" gap="14">
<row gap="10" cross="center">
<icon name="terminal" foreground="accent" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">Recent task logs</span></text>
<text wrap="true" foreground="text_muted">Static diagnostic entries from the desktop application.</text>
</column>
</row>
<separator/>
<button
variant="ghost"
icon="eye"
on-press="show_aux_background_task_debug_log">
Open Poll eFPS Email Confirmations Log
</button>
<text wrap="true" foreground="text_muted">No other task logs are available in this static build.</text>
</column>
</card>
</template>
<template name="background-tasks-content">
<column gap="24">
<column gap="6">
<text size="heading">Background Tasks</text>
<text wrap="true" foreground="text_muted">Monitor scheduled jobs, email checks, and maintenance activity.</text>
</column>
<if test="{constrainedLayout}">
<column gap="4" label="Background task sections">
<button
variant="ghost"
selected="{backgroundJobsActive}"
on-press="show_background_jobs">
Jobs
</button>
<button
variant="ghost"
selected="{backgroundLogsActive}"
on-press="show_background_logs">
Logs
</button>
</column>
</if>
<else>
<tabs gap="4" label="Background task sections">
<button
variant="ghost"
selected="{backgroundJobsActive}"
on-press="show_background_jobs">
Jobs
</button>
<button
variant="ghost"
selected="{backgroundLogsActive}"
on-press="show_background_logs">
Logs
</button>
</tabs>
</else>
<if test="{backgroundJobsActive}">
<use template="background-jobs-content"/>
</if>
<if test="{backgroundLogsActive}">
<use template="background-logs-content"/>
</if>
<card>
<column padding="18" gap="10">
<row gap="10" cross="center">
<icon name="info" foreground="info" width="20" height="20"/>
<text><span weight="bold">Prototype task monitor</span></text>
</row>
<text wrap="true" foreground="text_muted">
Job controls are presented to match the desktop application. This static milestone does not execute or modify background work.
</text>
</column>
</card>
</column>
</template>
<template name="background-tasks-page">
<scroll grow="1" global-key="page-background-tasks" label="Background tasks content">
<if test="{phoneLayout}">
<column padding="16">
<use template="background-tasks-content"/>
</column>
</if>
<else>
<if test="{constrainedLayout}">
<column padding="20">
<use template="background-tasks-content"/>
</column>
</if>
<else>
<column padding="32">
<use template="background-tasks-content"/>
</column>
</else>
</else>
</scroll>
</template>
<template name="tax-calendar-rules-section">
<column gap="12">
<column gap="4">
<text><span weight="bold">Compiled Calendar Rules</span></text>
<text wrap="true" foreground="text_muted">
Shared form-deadline rules derived from the reference eBIRForms
subsystem and checked against current BIR guidance. Event-based forms
stay separate from dated deadlines.
</text>
</column>
<for each="calendarRules" key="id" as="rule">
<card>
<column padding="20" gap="10">
<row gap="8" cross="center">
<badge variant="secondary">{rule.frequency}</badge>
<text><span weight="bold">{rule.form_name}</span></text>
</row>
<text wrap="true" foreground="text_muted">Forms: {rule.form_codes}</text>
<text wrap="true">{rule.description}</text>
</column>
</card>
</for>
<card>
<column padding="20" gap="8">
<text><span weight="bold">Source boundary</span></text>
<text wrap="true" foreground="text_muted">
This view is a calendar-year / non-eFPS baseline and includes mutually
exclusive or conditional form alternatives. Current BIR issuances, the
taxpayer's registered Forms Set, eFPS filer group, fiscal-year facts,
and official holiday proclamations remain authoritative.
</text>
</column>
</card>
</column>
</template>
<template name="deadline-override-editor">
<card>
<column padding="20" gap="14">
<text><span weight="bold">{overrideEditorTitle}</span></text>
<text wrap="true" foreground="text_muted">
Source and at least one recognized canonical form are required.
Separate multiple values with commas.
</text>
<input
text="{overrideTitleValue}"
placeholder="Extension title"
label="Override title"
on-input="calendar_override_title_input"/>
<input
text="{overrideFormsValue}"
placeholder="1701Q, 1702Q"
label="Affected form codes"
on-input="calendar_override_forms_input"/>
<if test="{constrainedLayout}">
<column gap="10">
<input
text="{overrideOriginalValue}"
placeholder="YYYY-MM-DD"
label="Original or operative deadline"
on-input="calendar_override_original_input"/>
<input
text="{overrideAdjustedValue}"
placeholder="YYYY-MM-DD"
label="Adjusted deadline"
on-input="calendar_override_adjusted_input"/>
</column>
</if>
<else>
<row gap="10">
<input
grow="1"
text="{overrideOriginalValue}"
placeholder="YYYY-MM-DD"
label="Original or operative deadline"
on-input="calendar_override_original_input"/>
<input
grow="1"
text="{overrideAdjustedValue}"
placeholder="YYYY-MM-DD"
label="Adjusted deadline"
on-input="calendar_override_adjusted_input"/>
</row>
</else>
<input
text="{overrideSourceValue}"
placeholder="RMC / RR / advisory reference"
label="Official source reference"
on-input="calendar_override_source_input"/>
<if test="{constrainedLayout}">
<column gap="10">
<input
text="{overrideRegionsValue}"
placeholder="Optional RDO codes, e.g. 040; 041"
label="Affected RDO codes"
on-input="calendar_override_regions_input"/>
<input
text="{overrideTaxpayerTypesValue}"
placeholder="Optional, e.g. individual"
label="Taxpayer types"
on-input="calendar_override_taxpayer_types_input"/>
</column>
</if>
<else>
<row gap="10">
<input
grow="1"
text="{overrideRegionsValue}"
placeholder="Optional RDO codes, e.g. 040; 041"
label="Affected RDO codes"
on-input="calendar_override_regions_input"/>
<input
grow="1"
text="{overrideTaxpayerTypesValue}"
placeholder="Optional, e.g. individual"
label="Taxpayer types"
on-input="calendar_override_taxpayer_types_input"/>
</row>
</else>
<if test="{constrainedLayout}">
<column gap="10">
<input
text="{overrideEffectiveFromValue}"
placeholder="Optional YYYY-MM-DD"
label="Effective from"
on-input="calendar_override_effective_from_input"/>
<input
text="{overrideEffectiveUntilValue}"
placeholder="Optional YYYY-MM-DD"
label="Effective until"
on-input="calendar_override_effective_until_input"/>
<input
text="{overrideExpiresAtValue}"
placeholder="Optional YYYY-MM-DD"
label="Expires at"
on-input="calendar_override_expires_at_input"/>
</column>
</if>
<else>
<row gap="10">
<input
grow="1"
text="{overrideEffectiveFromValue}"
placeholder="Optional YYYY-MM-DD"
label="Effective from"
on-input="calendar_override_effective_from_input"/>
<input
grow="1"
text="{overrideEffectiveUntilValue}"
placeholder="Optional YYYY-MM-DD"
label="Effective until"
on-input="calendar_override_effective_until_input"/>
<input
grow="1"
text="{overrideExpiresAtValue}"
placeholder="Optional YYYY-MM-DD"
label="Expires at"
on-input="calendar_override_expires_at_input"/>
</row>
</else>
<row gap="10">
<button variant="primary" icon="check" on-press="calendar_save_override">{overrideSaveLabel}</button>
<button variant="outline" on-press="calendar_cancel_override">Clear</button>
</row>
</column>
</card>
</template>
<template name="non-working-day-editor">
<card>
<column padding="20" gap="14">
<text><span weight="bold">{nonWorkingDayEditorTitle}</span></text>
<text wrap="true" foreground="text_muted">
Kind must be regular, local, special, or closure. Entries without an
RDO scope adjust the global explorer; scoped entries apply only to
matching tax-profile dashboards and calendar handoffs.
</text>
<if test="{constrainedLayout}">
<column gap="10">
<input
text="{nonWorkingDateValue}"
placeholder="YYYY-MM-DD"
label="Date"
on-input="calendar_non_working_date_input"/>
<input
text="{nonWorkingKindValue}"
placeholder="regular"
label="Kind"
on-input="calendar_non_working_kind_input"/>
</column>
</if>
<else>
<row gap="10">
<input
grow="1"
text="{nonWorkingDateValue}"
placeholder="YYYY-MM-DD"
label="Date"
on-input="calendar_non_working_date_input"/>
<input
grow="1"
text="{nonWorkingKindValue}"
placeholder="regular"
label="Kind"
on-input="calendar_non_working_kind_input"/>
</row>
</else>
<input
text="{nonWorkingNameValue}"
placeholder="Official holiday or closure name"
label="Name"
on-input="calendar_non_working_name_input"/>
<input
text="{nonWorkingSourceValue}"
placeholder="Official Gazette / proclamation reference"
label="Official source"
on-input="calendar_non_working_source_input"/>
<input
text="{nonWorkingRegionsValue}"
placeholder="Optional RDO codes, e.g. 040; 041"
label="Affected RDO codes"
on-input="calendar_non_working_regions_input"/>
<row gap="10">
<button variant="primary" icon="check" on-press="calendar_save_non_working_day">{nonWorkingDaySaveLabel}</button>
<button variant="outline" on-press="calendar_cancel_non_working_day">Clear</button>
</row>
</column>
</card>
</template>
<template name="tax-calendar-overrides-section">
<column gap="20">
<if test="{calendarNoticeVisible}">
<row cross="center">
<badge variant="{calendarNoticeTone}">{calendarNotice}</badge>
</row>
</if>
<column gap="10">
<text><span weight="bold">Deadline Overrides</span></text>
<text wrap="true" foreground="text_muted">
Matching follows the reference resolver: form code plus original or
already business-day-adjusted deadline; later matching overrides win.
RDO- or taxpayer-scoped overrides apply only to matching tax profiles.
Effective-range and expiry metadata are preserved separately in SQLite;
like the reference resolver, they do not limit global matching yet.
</text>
</column>
<if test="{calendarOverridesEmpty}">
<card>
<column padding="20" gap="8" cross="center">
<icon name="clock" foreground="text_muted" width="30" height="30"/>
<text><span weight="bold">No deadline overrides</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">
Add only sourced BIR extensions or corrections. No sample or
fictitious holiday override is seeded.
</text>
</column>
</card>
</if>
<for each="calendarOverrides" key="id" as="override">
<card>
<column padding="18" gap="8">
<row gap="10" cross="center">
<column grow="1" gap="4">
<text><span weight="bold">{override.titleLabel}</span></text>
<text wrap="true" foreground="text_muted">Forms: {override.formsLabel}</text>
</column>
<badge variant="primary">{override.datesLabel}</badge>
</row>
<text wrap="true" foreground="text_muted">{override.scopeLabel}</text>
<text wrap="true" foreground="text_muted">{override.effectiveLabel}</text>
<text wrap="true">Source: {override.sourceLabel}</text>
<row gap="8">
<button size="sm" variant="outline" on-press="calendar_edit_override:{override.id}">Edit</button>
<button size="sm" variant="ghost" on-press="calendar_delete_override:{override.id}">Delete</button>
</row>
</column>
</card>
</for>
<use template="deadline-override-editor"/>
<separator/>
<column gap="10">
<text><span weight="bold">Non-working Days</span></text>
<text wrap="true" foreground="text_muted">
Weekends are built in. Official holidays and closures are explicit,
source-cited SQLite records; none are guessed or auto-seeded.
</text>
</column>
<if test="{calendarNonWorkingDaysEmpty}">
<card>
<column padding="18" gap="6" cross="center">
<text><span weight="bold">No configured non-working days</span></text>
<text wrap="true" text-alignment="center" foreground="text_muted">
Until an official day is entered, only Saturday and Sunday
business-day adjustment is active.
</text>
</column>
</card>
</if>
<for each="calendarNonWorkingDays" key="id" as="day">
<card>
<column padding="18" gap="8">
<row gap="10" cross="center">
<badge variant="secondary">{day.dateLabel}</badge>
<column grow="1" gap="3">
<text><span weight="bold">{day.nameLabel}</span></text>
<text wrap="true" foreground="text_muted">{day.kindLabel} · {day.regionsLabel}</text>
</column>
</row>
<text wrap="true">Source: {day.sourceLabel}</text>
<row gap="8">
<button size="sm" variant="outline" on-press="calendar_edit_non_working_day:{day.id}">Edit</button>
<button size="sm" variant="ghost" on-press="calendar_delete_non_working_day:{day.id}">Delete</button>
</row>
</column>
</card>
</for>
<use template="non-working-day-editor"/>
</column>
</template>
<template name="tax-calendar-content" args="padding">
<column padding="{padding}" gap="{dashboardContentGap}">
<if test="{constrainedLayout}">
<row gap="8" cross="center">
<spacer grow="1"/>
<button
width="44"
height="44"
size="icon"
variant="outline"
icon="refresh-cw"
label="Refresh calendar from SQLite"
on-press="calendar_refresh"/>
</row>
</if>
<else>
<row gap="16" cross="center">
<column grow="1" gap="6">
<text size="heading">Tax Calendar Explorer</text>
<text foreground="text_muted">
Review calendar-year rules, source-cited changes, and SQLite overrides.
</text>
</column>
<button variant="outline" icon="refresh-cw" on-press="calendar_refresh">Refresh</button>
</row>
</else>
<tabs gap="4" label="Tax calendar sections">
<button
variant="ghost"
selected="{calendarRulesActive}"
on-press="show_calendar_rules">Rules</button>
<button
variant="ghost"
selected="{calendarOverridesActive}"
on-press="show_calendar_overrides">Overrides</button>
</tabs>
<if test="{calendarRulesActive}">
<use template="tax-calendar-rules-section"/>
</if>
<if test="{calendarOverridesActive}">
<use template="tax-calendar-overrides-section"/>
</if>
</column>
</template>
<template name="tax-calendar-page">
<scroll grow="1" global-key="page-tax-calendar" label="Tax calendar explorer content">
<if test="{phoneLayout}">
<use template="tax-calendar-content" padding="16"/>
</if>
<else>
<if test="{desktopLayout}">
<use template="tax-calendar-content" padding="32"/>
</if>
<else>
<use template="tax-calendar-content" padding="24"/>
</else>
</else>
</scroll>
</template>
<template name="settings-action-row" args="icon title body action">
<column>
<if test="{constrainedLayout}">
<column gap="12">
<row gap="14" cross="start">
<icon name="{icon}" foreground="text_muted" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{body}</text>
</column>
</row>
<button variant="outline" disabled="true">{action}</button>
</column>
</if>
<else>
<row gap="14" cross="center">
<icon name="{icon}" foreground="text_muted" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{body}</text>
</column>
<button variant="outline" disabled="true">{action}</button>
</row>
</else>
</column>
</template>
<template name="settings-switch-row" args="icon title body enabled=false">
<column>
<if test="{constrainedLayout}">
<column gap="12">
<row gap="14" cross="start">
<icon name="{icon}" foreground="text_muted" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{body}</text>
</column>
</row>
<switch checked="{enabled}" disabled="true" label="{title}"></switch>
</column>
</if>
<else>
<row gap="14" cross="center">
<icon name="{icon}" foreground="text_muted" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{body}</text>
</column>
<switch checked="{enabled}" disabled="true" label="{title}"></switch>
</row>
</else>
</column>
</template>
<template name="settings-danger-row" args="icon title body action">
<column>
<if test="{constrainedLayout}">
<column gap="12">
<row gap="14" cross="start">
<icon name="{icon}" foreground="destructive" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{body}</text>
</column>
</row>
<button variant="destructive" disabled="true">{action}</button>
</column>
</if>
<else>
<row gap="14" cross="center">
<icon name="{icon}" foreground="destructive" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">{title}</span></text>
<text wrap="true" foreground="text_muted">{body}</text>
</column>
<button variant="destructive" disabled="true">{action}</button>
</row>
</else>
</column>
</template>
<template name="settings-content">
<column gap="24">
<column gap="6">
<text size="heading">Settings</text>
<text wrap="true" foreground="text_muted">Configure security, privacy, and global application preferences.</text>
</column>
<card>
<if test="{constrainedLayout}">
<column padding="22" gap="16">
<row gap="14" cross="start">
<icon name="sun" foreground="accent" width="30" height="30"/>
<column grow="1" gap="4">
<text><span weight="bold">Appearance</span></text>
<text wrap="true" foreground="text_muted">
Follow the system appearance or keep eBIRForms in a specific theme.
</text>
</column>
</row>
<toggle-group gap="2" label="Application appearance">
<toggle-button
size="sm"
selected="{themePreference == 'system'}"
on-toggle="set_theme_system">
System
</toggle-button>
<toggle-button
size="sm"
selected="{themePreference == 'light'}"
on-toggle="set_theme_light">
Light
</toggle-button>
<toggle-button
size="sm"
selected="{themePreference == 'dark'}"
on-toggle="set_theme_dark">
Dark
</toggle-button>
</toggle-group>
</column>
</if>
<else>
<row padding="22" gap="18" cross="center">
<icon name="sun" foreground="accent" width="30" height="30"/>
<column grow="1" gap="4">
<text><span weight="bold">Appearance</span></text>
<text wrap="true" foreground="text_muted">
Follow the system appearance or keep eBIRForms in a specific theme.
</text>
</column>
<toggle-group gap="2" label="Application appearance">
<toggle-button
size="sm"
selected="{themePreference == 'system'}"
on-toggle="set_theme_system">
System
</toggle-button>
<toggle-button
size="sm"
selected="{themePreference == 'light'}"
on-toggle="set_theme_light">
Light
</toggle-button>
<toggle-button
size="sm"
selected="{themePreference == 'dark'}"
on-toggle="set_theme_dark">
Dark
</toggle-button>
</toggle-group>
</row>
</else>
</card>
<card>
<column padding="22" gap="18">
<if test="{constrainedLayout}">
<column gap="12">
<row gap="14" cross="start">
<icon name="file-text" foreground="accent" width="30" height="30"/>
<column grow="1" gap="4">
<text><span weight="bold">Calendar Integration</span></text>
<text wrap="true" foreground="text_muted">Default calendar handoff is ready</text>
</column>
</row>
<row cross="center">
<badge variant="primary">Ready</badge>
</row>
</column>
</if>
<else>
<row gap="14" cross="center">
<icon name="file-text" foreground="accent" width="30" height="30"/>
<column grow="1" gap="4">
<text><span weight="bold">Calendar Integration</span></text>
<text foreground="text_muted">Default calendar handoff is ready</text>
</column>
<badge variant="primary">Ready</badge>
</row>
</else>
<text wrap="true" foreground="text_muted">
Add the resolved schedule to Apple Calendar, Outlook, Google Calendar,
or another registered calendar app using an ICS handoff. Choose an
iCloud, Google, or Outlook calendar during import to propagate it to
mobile. Direct managed Google OAuth sync is optional and not connected.
</text>
<if test="{constrainedLayout}">
<column gap="10">
<button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button>
<button variant="outline" disabled="true">Connect Google Directly</button>
</column>
</if>
<else>
<row gap="10">
<button variant="primary" icon="external-link" on-press="show_tax_calendar">Open Tax Calendar</button>
<button variant="outline" disabled="true">Connect Google Directly</button>
</row>
</else>
</column>
</card>
<card>
<column padding="22" gap="18">
<column gap="4">
<text><span weight="bold">Security</span></text>
<text wrap="true" foreground="text_muted">Protect application access and individual taxpayer profiles.</text>
</column>
<separator/>
<use
template="settings-action-row"
icon="settings"
title="Master PIN"
body="Require a master PIN when opening protected areas."
action="Configure"/>
<separator/>
<use
template="settings-action-row"
icon="circle-dot"
title="Master Authenticator App"
body="Use a one-time code from an authenticator application."
action="Set Up"/>
<separator/>
<use
template="settings-switch-row"
icon="check-circle"
title="Enable Profile PINs"
body="Allow separate access PINs for taxpayer profiles."/>
</column>
</card>
<card>
<column padding="22" gap="18">
<column gap="4">
<text><span weight="bold">Privacy and Display</span></text>
<text wrap="true" foreground="text_muted">Choose how taxpayer profiles appear in the application shell.</text>
</column>
<separator/>
<use
template="settings-switch-row"
icon="eye"
title="Hide Tax Profiles from Sidebar"
body="Keep profile names and TINs hidden until the list is opened."/>
<separator/>
<use
template="settings-action-row"
icon="terminal"
title="Global Toggle Hotkey"
body="Configure a keyboard shortcut for hiding and showing profiles."
action="Set Shortcut"/>
</column>
</card>
<card>
<column padding="22" gap="18">
<column gap="4">
<text><span weight="bold">Data</span></text>
<text wrap="true" foreground="text_muted">Create a portable archive of application data.</text>
</column>
<separator/>
<row gap="14" cross="start">
<icon name="alert" foreground="warning" width="22" height="22"/>
<column grow="1" gap="4">
<text><span weight="bold">Storage status</span></text>
<text wrap="true" foreground="warning">{artifactStorageClassification}</text>
</column>
</row>
<separator/>
<use
template="settings-action-row"
icon="download"
title="Export Data"
body="Export taxpayer profiles and application records to a backup archive."
action="Export"/>
</column>
</card>
<card>
<column padding="22" gap="18">
<column gap="4">
<text foreground="destructive"><span weight="bold">Danger Zone</span></text>
<text wrap="true" foreground="text_muted">Destructive options are displayed for layout parity only.</text>
</column>
<separator/>
<use
template="settings-danger-row"
icon="alert"
title="Factory Reset"
body="Restore global preferences to their defaults."
action="Factory Reset"/>
<separator/>
<use
template="settings-danger-row"
icon="trash"
title="Zero Out Everything"
body="Remove all local taxpayer and application data."
action="Zero Out Everything"/>
</column>
</card>
</column>
</template>
<template name="settings-page">
<scroll grow="1" global-key="page-settings" label="Settings content">
<if test="{phoneLayout}">
<column padding="16">
<use template="settings-content"/>
</column>
</if>
<else>
<if test="{constrainedLayout}">
<column padding="20">
<use template="settings-content"/>
</column>
</if>
<else>
<column padding="32">
<use template="settings-content"/>
</column>
</else>
</else>
</scroll>
</template>
<template name="gallery-main-grid" args="grid_columns">
<grid columns="{grid_columns}" gap="12">
<button variant="secondary" on-press="show_taxpayer_dashboard">Taxpayer Dashboard</button>
<button variant="secondary" on-press="show_global_dashboard">Global Dashboard</button>
<button variant="secondary" on-press="show_profile_setup">Taxpayer Profile Setup</button>
<button variant="secondary" on-press="show_background_tasks">Background Tasks</button>
<button variant="secondary" on-press="show_import_data">Import Data</button>
<button variant="secondary" on-press="show_tax_calendar">Tax Calendar Explorer</button>
<button variant="secondary" on-press="show_settings">Settings</button>
</grid>
</template>
<template name="gallery-forms-grid" args="grid_columns">
<grid columns="{grid_columns}" gap="12">
<button variant="secondary" on-press="show_form_0605">0605 - Payment Form</button>
<button variant="secondary" on-press="show_form_0619_e">0619-E - Creditable Income Taxes Withheld</button>
<button variant="secondary" on-press="show_form_0619_f">0619-F - Final Income Taxes Withheld</button>
<button variant="secondary" on-press="show_form_1601_c">1601C - Compensation Withholding</button>
<button variant="secondary" on-press="show_form_1701">1701 - Annual Individual ITR</button>
<button variant="secondary" on-press="show_form_1701q">1701Q - Quarterly Individual ITR</button>
<button variant="secondary" on-press="show_form_1702_rt">1702-RT - Regular-Rate Corporation ITR</button>
<button variant="secondary" on-press="show_form_1702_mx">1702-MX - Mixed-Income Corporation ITR</button>
<button variant="secondary" on-press="show_form_2550q">2550Q - Quarterly VAT Return</button>
<button variant="secondary" on-press="show_form_2551q">2551Q - Quarterly Percentage Tax</button>
</grid>
</template>
<template name="gallery-auxiliary-grid" args="grid_columns">
<grid columns="{grid_columns}" gap="12">
<button variant="secondary" on-press="show_aux_admin_auth_overlay">Admin Authentication Overlay</button>
<button variant="secondary" on-press="show_aux_background_task_debug_log">Background Task Debug Log</button>
<button variant="secondary" on-press="show_aux_command_palette">Command Palette</button>
<button variant="secondary" on-press="show_aux_email_confirmation">Email Confirmation</button>
<button variant="secondary" on-press="show_aux_html_print_preview">HTML Print Preview</button>
<button variant="secondary" on-press="show_aux_lock_screen">Lock Screen</button>
<button variant="secondary" on-press="show_aux_profile_auth_overlay">Profile Authentication Overlay</button>
</grid>
</template>
<template name="screen-gallery-content">
<column gap="24">
<if test="{constrainedLayout}">
<column gap="8">
<row cross="center">
<badge variant="outline">Developer Tools</badge>
</row>
<column gap="4">
<text size="heading">Screen Gallery</text>
<text wrap="true" foreground="text_muted">
Reviewer-only index for every reconstructed eBIRForms surface. This page is not part of the taxpayer workflow.
</text>
</column>
</column>
</if>
<else>
<row gap="14" cross="start">
<column grow="1" gap="4">
<text size="heading">Screen Gallery</text>
<text wrap="true" foreground="text_muted">
Reviewer-only index for every reconstructed eBIRForms surface. This page is not part of the taxpayer workflow.
</text>
</column>
<badge variant="outline">Developer Tools</badge>
</row>
</else>
<card>
<column padding="20" gap="12">
<column gap="4">
<text><span weight="bold">Main Screens</span></text>
<text wrap="true" foreground="text_muted">Primary application pages and taxpayer workflows.</text>
</column>
<column>
<if test="{phoneLayout}">
<use template="gallery-main-grid" grid_columns="1"/>
</if>
<if test="{constrainedLayout and phoneLayout == false}">
<use template="gallery-main-grid" grid_columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="gallery-main-grid" grid_columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="gallery-main-grid" grid_columns="3"/>
</if>
</column>
</column>
</card>
<card>
<column padding="20" gap="12">
<column gap="4">
<text><span weight="bold">BIR Form Editors</span></text>
<text wrap="true" foreground="text_muted">Static form-editor replicas with audited filing sections and status pipelines.</text>
</column>
<column>
<if test="{phoneLayout}">
<use template="gallery-forms-grid" grid_columns="1"/>
</if>
<if test="{constrainedLayout and phoneLayout == false}">
<use template="gallery-forms-grid" grid_columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="gallery-forms-grid" grid_columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="gallery-forms-grid" grid_columns="3"/>
</if>
</column>
</column>
</card>
<card>
<column padding="20" gap="12">
<column gap="4">
<text><span weight="bold">Auxiliary Surfaces</span></text>
<text wrap="true" foreground="text_muted">Overlays, confirmation windows, previews, and supporting diagnostic views.</text>
</column>
<column>
<if test="{phoneLayout}">
<use template="gallery-auxiliary-grid" grid_columns="1"/>
</if>
<if test="{constrainedLayout and phoneLayout == false}">
<use template="gallery-auxiliary-grid" grid_columns="1"/>
</if>
<if test="{tabletLayout}">
<use template="gallery-auxiliary-grid" grid_columns="2"/>
</if>
<if test="{desktopLayout}">
<use template="gallery-auxiliary-grid" grid_columns="3"/>
</if>
</column>
</column>
</card>
</column>
</template>
