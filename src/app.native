<template name="html-print-preview-shell">
  <column grow="1" background="background">
    <if test="{constrainedLayout}">
      <column padding="12" gap="10" background="surface_subtle">
        <row gap="10" cross="center">
          <column grow="1" gap="2">
            <text wrap="true">2551Q HTML Form Preview</text>
            <text size="sm" foreground="text_muted">Preview only</text>
          </column>
          <button
            size="icon"
            variant="ghost"
            icon="x"
            label="Close HTML form preview"
            on-press="go_back">
          </button>
        </row>
        <column gap="8">
          <button variant="primary" disabled="true">Export PDF</button>
          <button variant="primary" disabled="true">Print</button>
          <button variant="outline" icon="refresh-cw" disabled="true">Refresh Preview</button>
        </column>
      </column>
    </if>
    <else>
      <row height="48" padding="12" gap="8" cross="center" background="surface_subtle">
        <column grow="1" gap="2">
          <text>2551Q HTML Form Preview</text>
          <text size="sm" foreground="text_muted">Preview only</text>
        </column>
        <button variant="primary" disabled="true">Export PDF</button>
        <button variant="primary" disabled="true">Print</button>
        <button
          size="icon"
          variant="outline"
          icon="refresh-cw"
          label="Refresh preview"
          disabled="true"
        />
        <button
          size="icon"
          variant="ghost"
          icon="x"
          label="Close HTML form preview"
          on-press="go_back">
        </button>
      </row>
    </else>

    <separator/>

    <scroll grow="1" overscroll="none" background="surface_subtle">
      <if test="{constrainedLayout}">
        <column padding="16" gap="24">
          <card height="980" radius="sm" background="background">
            <use template="html-preview-page-one"/>
          </card>
          <card height="980" radius="sm" background="background">
            <use template="html-preview-page-two"/>
          </card>
        </column>
      </if>
      <else>
        <column padding="24" gap="24" cross="center">
          <card width="760" height="980" radius="sm" background="background">
            <use template="html-preview-page-one"/>
          </card>
          <card width="760" height="980" radius="sm" background="background">
            <use template="html-preview-page-two"/>
          </card>
        </column>
      </else>
    </scroll>
  </column>
</template>

<template name="email-confirmation-card-content">
  <column padding="24" gap="10">
    <text wrap="true" size="heading">BIR Electronic Filing and Payment System</text>
    <text wrap="true" foreground="text_muted">Tax Return Receipt Confirmation</text>
    <separator/>

    <text><span mono="true">Date Received: July 29, 2026 10:42 AM</span></text>
    <text><span mono="true">Reference Number: 2551Q-2026-0001842</span></text>
    <text><span mono="true">Form Type: 2551Q</span></text>
    <text><span mono="true">Return Period: September 30, 2026</span></text>
    <text><span mono="true">TIN: 123-456-789-000</span></text>
    <text><span mono="true">Taxpayer: JUAN DELA CRUZ</span></text>
    <text><span mono="true">Status: RECEIVED</span></text>

    <separator/>

    <text wrap="true">
      This confirms receipt of the electronically filed return. Keep this
      confirmation with the taxpayer's filing records.
    </text>
  </column>
</template>

<template name="form-2551q-email-confirmation-window">
  <column grow="1" background="background">
    <if test="{constrainedLayout}">
      <column padding="12" gap="10">
        <row gap="10" cross="center">
          <text wrap="true" size="heading" grow="1">Email Confirmation</text>
          <button
            size="icon"
            variant="ghost"
            icon="x"
            label="Close email confirmation"
            on-press="go_back">
          </button>
        </row>
        <column gap="8">
          <button size="sm" variant="outline" icon="copy" disabled="true">Copy Text</button>
          <button size="sm" variant="outline" icon="download" disabled="true">Export</button>
          <button size="sm" variant="outline" icon="file-text" disabled="true">Print</button>
        </column>
      </column>
    </if>
    <else>
      <row padding="12" gap="12" cross="center">
        <text size="heading" grow="1">Email Confirmation</text>
        <button size="sm" variant="outline" icon="copy" disabled="true">Copy Text</button>
        <button size="sm" variant="outline" icon="download" disabled="true">Export</button>
        <button size="sm" variant="outline" icon="file-text" disabled="true">Print</button>
        <button
          size="icon"
          variant="ghost"
          icon="x"
          label="Close email confirmation"
          on-press="go_back">
        </button>
      </row>
    </else>

    <separator/>

    <scroll grow="1" overscroll="none">
      <column padding="24" gap="12">
        <card background="surface">
          <use template="email-confirmation-card-content"/>
        </card>
      </column>
    </scroll>
  </column>
</template>

<template name="background-task-debug-log-window">
  <column grow="1" background="background">
    <if test="{constrainedLayout}">
      <column padding="12" gap="10">
        <row gap="10" cross="start">
          <column grow="1" gap="2">
            <text wrap="true" size="heading">Debug Log: Poll eFPS email confirmations</text>
            <text wrap="true" size="sm" foreground="text_muted">Background Tasks and Job Queue</text>
          </column>
          <button
            size="icon"
            variant="ghost"
            icon="x"
            label="Close debug log"
            on-press="go_back">
          </button>
        </row>
        <row cross="center">
          <badge variant="outline">Completed</badge>
        </row>
      </column>
    </if>
    <else>
      <row padding="12" gap="12" cross="center">
        <column grow="1" gap="2">
          <text size="heading">Debug Log: Poll eFPS email confirmations</text>
          <text size="sm" foreground="text_muted">Background Tasks and Job Queue</text>
        </column>
        <badge variant="outline">Completed</badge>
        <button
          size="icon"
          variant="ghost"
          icon="x"
          label="Close debug log"
          on-press="go_back">
        </button>
      </row>
    </else>

    <separator/>

    <scroll grow="1" overscroll="none">
      <column padding="16" gap="8">
        <text><span mono="true">[2026-07-29 10:41:59] job started</span></text>
        <text><span mono="true">[2026-07-29 10:42:00] opening configured mailbox</span></text>
        <text><span mono="true">[2026-07-29 10:42:01] checking for eFPS confirmations</span></text>
        <text><span mono="true">[2026-07-29 10:42:02] matched confirmation for Form 2551Q</span></text>
        <text><span mono="true">[2026-07-29 10:42:02] receipt saved to local records</span></text>
        <text foreground="success"><span mono="true">[2026-07-29 10:42:03] job completed successfully</span></text>
      </column>
    </scroll>
  </column>
</template>

<!--
  Editable application root.
  scripts/flatten-native.mjs appends this fragment after every template.
-->
<stack grow="1">
  <if test="{shellVisible}">
    <use
      template="app-shell"
      brand_logo="{brandLogo}"
      app_icon="{appIcon}"
      bagong_logo="{bagongPilipinasLogo}"
      bir_logo="{birLogo}"
      goldcoders_logo="{goldcodersLogo}">
      <column grow="1">
    <if test="{contentPage == 'global_dashboard'}">
      <use template="global-dashboard-page"/>
    </if>
    <if test="{contentPage == 'taxpayer_dashboard'}">
      <use template="taxpayer-dashboard-page"/>
    </if>
    <if test="{contentPage == 'profile_setup'}">
      <use template="profile-setup-page"/>
    </if>
    <if test="{contentPage == 'import_data'}">
      <use template="import-data-page"/>
    </if>
    <if test="{contentPage == 'background_tasks'}">
      <use template="background-tasks-page"/>
    </if>
    <if test="{contentPage == 'tax_calendar'}">
      <use template="tax-calendar-page"/>
    </if>
    <if test="{contentPage == 'settings'}">
      <use template="settings-page"/>
    </if>
    <if test="{contentPage == 'screen_gallery'}">
      <use template="screen-gallery-page"/>
    </if>
    <if test="{contentPage == 'form_0605'}">
      <use template="form-0605"/>
    </if>
    <if test="{contentPage == 'form_0619_e'}">
      <use template="form-0619-e"/>
    </if>
    <if test="{contentPage == 'form_0619_f'}">
      <use template="form-0619-f"/>
    </if>
    <if test="{contentPage == 'form_1601_c'}">
      <use template="form-1601-c"/>
    </if>
    <if test="{contentPage == 'form_1701'}">
      <use template="form-1701"/>
    </if>
    <if test="{contentPage == 'form_1701q'}">
      <use template="form-1701q"/>
    </if>
    <if test="{contentPage == 'form_1702_rt'}">
      <use template="form-1702-rt"/>
    </if>
    <if test="{contentPage == 'form_1702_mx'}">
      <use template="form-1702-mx"/>
    </if>
    <if test="{contentPage == 'form_2550q'}">
      <use template="form-2550q"/>
    </if>
    <if test="{contentPage == 'form_2551q'}">
      <use template="form-2551q"/>
    </if>
      </column>
    </use>
  </if>

    <if test="{page == 'aux_lock_screen'}">
      <use template="lock-screen-page"/>
    </if>
    <if test="{page == 'aux_profile_auth'}">
      <use template="profile-auth-overlay"/>
    </if>
    <if test="{page == 'aux_admin_auth'}">
      <use template="admin-auth-overlay"/>
    </if>
    <if test="{page == 'aux_command_palette'}">
      <use template="command-palette-overlay"/>
    </if>
    <if test="{page == 'aux_html_preview'}">
      <use template="html-print-preview-shell"/>
    </if>
    <if test="{page == 'aux_email_confirmation'}">
      <use template="form-2551q-email-confirmation-window"/>
    </if>
    <if test="{page == 'aux_debug_log'}">
      <use template="background-task-debug-log-window"/>
    </if>
</stack>
