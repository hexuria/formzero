<template name="form-1601-eq-payment" args="columns">
  <column gap="16">
    <column gap="8">
      <text>33 Cash / Bank Debit Memo</text>
      <grid columns="{columns}" gap="12">
        <!-- @include-template form-field label="Item 33 agency" ph="Bank / Agency" -->
        <!-- @include-template form-field label="Item 33 date paid" ph="MM / DD / YYYY" -->
        <!-- @include-template form-field label="Item 33 number" ph="Reference number" -->
        <!-- @include-template form-field label="Item 33 amount" ph="Enter amount" -->
      </grid>
    </column>
    <column gap="8">
      <text>34 Check</text>
      <grid columns="{columns}" gap="12">
        <!-- @include-template form-field label="Item 34 agency" ph="Bank / Agency" -->
        <!-- @include-template form-field label="Item 34 date paid" ph="MM / DD / YYYY" -->
        <!-- @include-template form-field label="Item 34 number" ph="Reference number" -->
        <!-- @include-template form-field label="Item 34 amount" ph="Enter amount" -->
      </grid>
    </column>
    <column gap="8">
      <text>35 Tax Debit Memo</text>
      <grid columns="{columns}" gap="12">
        <!-- @include-template form-field label="Item 35 agency" ph="Bank / Agency" -->
        <!-- @include-template form-field label="Item 35 date paid" ph="MM / DD / YYYY" -->
        <!-- @include-template form-field label="Item 35 number" ph="Reference number" -->
        <!-- @include-template form-field label="Item 35 amount" ph="Enter amount" -->
      </grid>
    </column>
    <column gap="8">
      <text>36 Others</text>
      <grid columns="{columns}" gap="12">
        <!-- @include-template form-field label="Item 36 agency" ph="Bank / Agency" -->
        <!-- @include-template form-field label="Item 36 date paid" ph="MM / DD / YYYY" -->
        <!-- @include-template form-field label="Item 36 number" ph="Reference number" -->
        <!-- @include-template form-field label="Item 36 amount" ph="Enter amount" -->
        <!-- @include-template form-field label="Item 36 particular" ph="Particulars" -->
      </grid>
    </column>
  </column>
</template>

<template name="form-1601-eq-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
        <column gap="6">
          <text size="heading">BIR Form No. 1601EQ</text>
          <text>Quarterly Remittance Return of Creditable Income Taxes Withheld (Expanded)</text>
          <row gap="8" cross="center">
            <text foreground="text_muted" grow="1">January 2018 (ENCS)</text>
            <badge>Draft</badge>
          </row>
        </column>
        <column gap="8">
          <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
          <separator/>
          <button variant="secondary" disabled="true">Save Draft</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 1601EQ</text>
            <text>Quarterly Remittance Return of Creditable Income Taxes Withheld (Expanded)</text>
            <text foreground="text_muted">January 2018 (ENCS)</text>
          </column>
          <badge>Draft</badge>
        </row>
        <row gap="8">
          <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
          <spacer/>
          <button variant="secondary" disabled="true">Save Draft</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-1601-eq">
  <scroll grow="1" global-key="page-form-1601-eq">
    <column padding="32" gap="24">
      <use template="form-1601-eq-masthead"/>
      <!-- @include-template tax-profile-form-context -->
      <card>
        <column padding="20" gap="12">
          <text size="heading">Taxpayer identity</text>
          <text wrap="true" foreground="text_muted">These values come from the saved Tax Profile for this filing period. Save stays disabled until an exact 1601EQ path exists.</text>
          <if test="{constrainedLayout}">
            <use template="form-1601-eq-identity" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1601-eq-identity" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1601-eq-identity" columns="3"/>
          </if>
        </column>
      </card>
      <card>
        <column padding="20" gap="12">
          <text size="heading">PART I - BACKGROUND INFORMATION</text>
          <if test="{constrainedLayout}">
            <use template="form-1601-eq-period" columns="1"/>
          </if>
          <else>
            <use template="form-1601-eq-period" columns="2"/>
          </else>
        </column>
      </card>
      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II - COMPUTATION OF TAX</text>
          <text wrap="true" foreground="text_muted">Unbound January 2018 ENCS ATC rows 13-18 and remittance totals. Rates are not looked up, amounts are not calculated, and nothing can be saved.</text>
          <if test="{constrainedLayout}">
            <use template="form-1601-eq-atc-schedule" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1601-eq-atc-schedule" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1601-eq-atc-schedule" columns="4"/>
          </if>
          <separator/>
          <if test="{constrainedLayout}">
            <use template="form-1601-eq-remittance" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1601-eq-remittance" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1601-eq-remittance" columns="2"/>
          </if>
        </column>
      </card>
      <card>
        <column padding="20" gap="12">
          <text size="heading">PART III - DETAILS OF PAYMENT</text>
          <text wrap="true" foreground="text_muted">Unbound January 2018 ENCS payment rows 33-36. These are not a filing receipt and cannot be saved.</text>
          <if test="{constrainedLayout}">
            <use template="form-1601-eq-payment" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1601-eq-payment" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1601-eq-payment" columns="4"/>
          </if>
        </column>
      </card>
      <card>
        <column padding="20" gap="12">
          <text size="heading">TAX AGENT / SIGNATURE DETAILS</text>
          <text wrap="true" foreground="text_muted">Unbound January 2018 ENCS tax-agent fields. Signature, jurat image, and save stay off this slice.</text>
          <if test="{constrainedLayout}">
            <use template="form-1601-eq-tax-agent" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1601-eq-tax-agent" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1601-eq-tax-agent" columns="3"/>
          </if>
        </column>
      </card>
    </column>
  </scroll>
</template>
