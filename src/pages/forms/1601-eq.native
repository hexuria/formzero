  </grid>
</template>

<template name="form-1601-eq-remittance" args="columns">
  <grid columns="{columns}" gap="12">
    <!-- @include-template form-field label="19 Total tax withheld this quarter" ph="Enter amount" -->
    <!-- @include-template form-field label="20 Less: tax remitted first month (0619E)" ph="Enter amount" -->
    <!-- @include-template form-field label="21 Less: tax remitted second month (0619E)" ph="Enter amount" -->
