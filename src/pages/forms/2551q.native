<template name="form-2551q-grid-1" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">1 Taxable-period basis</text>
      <input text="{percentageTaxPeriodBasis}" placeholder="Calendar / Fiscal" disabled="true" />
      <row gap="8">
        <button
          variant="outline"
          selected="{percentageTaxPeriodCalendarSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_period_calendar">
          Calendar
        </button>
        <button
          variant="outline"
          selected="{percentageTaxPeriodFiscalSelected}"
          disabled="true"
          on-press="percentage_tax_period_fiscal">
          Fiscal (not yet supported)
        </button>
      </row>
    </column>
    <column gap="4">
      <text foreground="text_muted">2 Year-end month</text>
      <input
        text="{percentageTaxYearEndMonth}"
        placeholder="Month"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_year_end_month_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Taxable Quarter</text>
      <input text="{percentageTaxQuarter}" placeholder="Quarter" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Taxable Year</text>
      <input text="{percentageTaxYear}" placeholder="YYYY" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">5 Number of Sheets Attached</text>
      <input
        text="{percentageTaxSheetsAttached}"
        placeholder="Enter number"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_sheets_attached_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Return Options</text>
      <input text="{percentageTaxReturnOption}" placeholder="Original / Amended" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Amended Return?</text>
      <input text="{percentageTaxAmendedReturn}" placeholder="No" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Tax Relief?</text>
      <input text="{percentageTaxRelief}" placeholder="No / Specify" disabled="true" />
      <row gap="8">
        <button
          variant="outline"
          selected="{percentageTaxReliefNoneSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_relief_none">
          No
        </button>
        <button
          variant="outline"
          selected="{percentageTaxReliefSpecifiedSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_relief_specified">
          Specify
        </button>
      </row>
    </column>
    <column gap="4">
      <text foreground="text_muted">12A Tax Relief Specification</text>
      <input
        text="{percentageTaxReliefReference}"
        placeholder="Relief code or basis"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_relief_reference_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">13 Income-tax-rate election</text>
      <input text="{percentageTaxElection}" placeholder="Graduated / 8 percent" disabled="true" />
      <row gap="8">
        <button
          variant="outline"
          selected="{percentageTaxElectionGraduatedSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_election_graduated">
          Graduated
        </button>
        <button
          variant="outline"
          selected="{percentageTaxElectionEightPercentSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_election_eight_percent">
          8 percent
        </button>
      </row>
    </column>
  </grid>
</template>

<template name="form-2551q-grid-2" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">TIN</text>
      <input text="{formFilerTin}" placeholder="000-000-000-000" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">RDO Code</text>
      <input text="{formFilerRdo}" placeholder="RDO" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Taxpayer's Name</text>
      <input text="{formFilerTaxpayerName}" placeholder="Registered taxpayer name" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Registered Address</text>
      <input text="{formFilerRegisteredAddress}" placeholder="Registered address" disabled="{not formFilingContactEditable}" on-input="form_filing_address_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">ZIP Code</text>
      <input text="{formFilerZipCode}" placeholder="ZIP code" disabled="{not formFilingContactEditable}" on-input="form_filing_zip_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Contact Number</text>
      <input text="{formFilerContactNumber}" placeholder="Contact number" disabled="{not formFilingContactEditable}" on-input="form_filing_contact_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Email Address</text>
      <input text="{formFilerEmailAddress}" placeholder="name@example.com" disabled="{not formFilingContactEditable}" on-input="form_filing_email_input"/>
    </column>
  </grid>
</template>

<template name="form-2551q-contact-provenance">
  <row gap="8" cross="center">
    <badge variant="outline">{formFilingContactProvenance}</badge>
    <text grow="1" wrap="true" foreground="text_muted">Changes here apply to this filing only.</text>
    <button height="44" variant="outline" disabled="{formFilingContactResetDisabled}" on-press="form_filing_use_profile_contacts">Use profile values</button>
  </row>
</template>

<template name="form-2551q-schedule-editor" args="columns">
  <column gap="16">
    <text foreground="text_muted">
      Enter the externally supplied rate for each active row. No tax rate is assumed by the application.
    </text>
    <grid columns="{columns}" gap="12">
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 1 Percentage-tax Code</text>
        <input
          text="{percentageTaxLine1Atc}"
          placeholder="ATC code"
          disabled="{not percentageTaxEditable}"
          on-input="percentage_tax_line_1_atc_input"/>
      </column>
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 1 Tax Base / Taxable Amount</text>
        <input
          text="{percentageTaxLine1Base}"
          placeholder="Enter amount"
          disabled="{not percentageTaxEditable}"
          on-input="percentage_tax_line_1_base_input"/>
      </column>
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 1 Policy-supplied Tax Rate</text>
        <input
          text="{percentageTaxLine1Rate}"
          placeholder="Rate"
          disabled="{not percentageTaxEditable}"
          on-input="percentage_tax_line_1_rate_input"/>
      </column>
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 1 Percentage Tax Due</text>
        <input text="{percentageTaxLine1Due}" placeholder="Enter amount" disabled="true" />
      </column>
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 2 Percentage-tax Code</text>
        <input
          text="{percentageTaxLine2Atc}"
          placeholder="ATC code"
          disabled="{not percentageTaxEditable}"
          on-input="percentage_tax_line_2_atc_input"/>
      </column>
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 2 Tax Base / Taxable Amount</text>
        <input
          text="{percentageTaxLine2Base}"
          placeholder="Enter amount"
          disabled="{not percentageTaxEditable}"
          on-input="percentage_tax_line_2_base_input"/>
      </column>
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 2 Policy-supplied Tax Rate</text>
        <input
          text="{percentageTaxLine2Rate}"
          placeholder="Rate"
          disabled="{not percentageTaxEditable}"
          on-input="percentage_tax_line_2_rate_input"/>
      </column>
      <column gap="4">
        <text foreground="text_muted">Schedule 1 Line 2 Percentage Tax Due</text>
        <input text="{percentageTaxLine2Due}" placeholder="Enter amount" disabled="true" />
      </column>
    </grid>
  </column>
</template>

<template name="form-2551q-grid-3" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">14 Total Percentage Tax Due</text>
      <input text="{percentageTaxTotalDue}" placeholder="Enter amount" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">15 Creditable Percentage Tax Withheld</text>
      <input
        text="{percentageTaxCreditableWithheld}"
        placeholder="Enter amount"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_creditable_withheld_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">16 Tax Paid in Previous Return</text>
      <input
        text="{percentageTaxPaidPrevious}"
        placeholder="Enter amount"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_paid_previous_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">17 Other Tax Credit / Payment</text>
      <input
        text="{percentageTaxOtherCredit}"
        placeholder="Enter amount"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_other_credit_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">18 Total Tax Credits / Payments</text>
      <input text="{percentageTaxTotalCredits}" placeholder="Enter amount" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">19 Tax Payable / (Overpayment)</text>
      <input text="{percentageTaxNetTax}" placeholder="Enter amount" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">20 Surcharge (manual)</text>
      <input
        text="{percentageTaxSurcharge}"
        placeholder="Enter amount"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_surcharge_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">21 Interest (manual)</text>
      <input
        text="{percentageTaxInterest}"
        placeholder="Enter amount"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_interest_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">22 Compromise (manual)</text>
      <input
        text="{percentageTaxCompromise}"
        placeholder="Enter amount"
        disabled="{not percentageTaxEditable}"
        on-input="percentage_tax_compromise_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">24 Overpayment Disposition</text>
      <input text="{percentageTaxDisposition}" placeholder="Refund / Tax Credit / Carry Over" disabled="true" />
      <row gap="8">
        <button
          variant="outline"
          selected="{percentageTaxDispositionNotApplicableSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_disposition_not_applicable">
          N/A
        </button>
        <button
          variant="outline"
          selected="{percentageTaxDispositionRefundSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_disposition_refund">
          Refund
        </button>
        <button
          variant="outline"
          selected="{percentageTaxDispositionTaxCreditSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_disposition_tax_credit">
          Tax credit
        </button>
        <button
          variant="outline"
          selected="{percentageTaxDispositionCarryOverSelected}"
          disabled="{not percentageTaxEditable}"
          on-press="percentage_tax_disposition_carry_over">
          Carry over
        </button>
      </row>
    </column>
  </grid>
</template>

<template name="form-2551q-table-1">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
        <column gap="8">
          <column gap="2">
            <text foreground="text_muted">ATC</text>
            <text>{percentageTaxLine1Atc}</text>
          </column>
          <column gap="2">
            <text foreground="text_muted">Tax Base / Taxable Amount</text>
            <text>{percentageTaxLine1Base}</text>
          </column>
          <column gap="2">
            <text foreground="text_muted">Tax Rate</text>
            <text>{percentageTaxLine1Rate}</text>
          </column>
          <column gap="2">
            <text foreground="text_muted">Percentage Tax Due</text>
            <text>{percentageTaxLine1Due}</text>
          </column>
        </column>
        <separator/>
        <column gap="8">
          <column gap="2">
            <text foreground="text_muted">ATC</text>
            <text>{percentageTaxLine2Atc}</text>
          </column>
          <column gap="2">
            <text foreground="text_muted">Tax Base / Taxable Amount</text>
            <text>{percentageTaxLine2Base}</text>
          </column>
          <column gap="2">
            <text foreground="text_muted">Tax Rate</text>
            <text>{percentageTaxLine2Rate}</text>
          </column>
          <column gap="2">
            <text foreground="text_muted">Percentage Tax Due</text>
            <text>{percentageTaxLine2Due}</text>
          </column>
        </column>
      </column>
    </if>
    <else>
      <table gap="4">
        <table-row gap="8">
          <table-cell>ATC</table-cell>
          <table-cell>Tax Base / Taxable Amount</table-cell>
          <table-cell>Tax Rate</table-cell>
          <table-cell>Percentage Tax Due</table-cell>
        </table-row>
        <table-row gap="8">
          <table-cell>{percentageTaxLine1Atc}</table-cell>
          <table-cell>{percentageTaxLine1Base}</table-cell>
          <table-cell>{percentageTaxLine1Rate}</table-cell>
          <table-cell>{percentageTaxLine1Due}</table-cell>
        </table-row>
        <table-row gap="8">
          <table-cell>{percentageTaxLine2Atc}</table-cell>
          <table-cell>{percentageTaxLine2Base}</table-cell>
          <table-cell>{percentageTaxLine2Rate}</table-cell>
          <table-cell>{percentageTaxLine2Due}</table-cell>
        </table-row>
      </table>
    </else>
  </column>
</template>

<template name="form-2551q-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
        <column gap="6">
          <text size="heading">BIR Form No. 2551Q</text>
          <text>Quarterly Percentage Tax Return</text>
          <row gap="8" cross="center">
            <text foreground="text_muted" grow="1">January 2018 (ENCS)</text>
            <badge>Draft</badge>
          </row>
        </column>
        <column gap="8">
          <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
          <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
          <separator/>
          <button
            variant="secondary"
            disabled="{not formProfileCanSaveDraft}"
            on-press="save_recurring_form_draft">
            Save
          </button>
          <button variant="primary" disabled="true">Submit</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 2551Q</text>
            <text>Quarterly Percentage Tax Return</text>
            <text foreground="text_muted">January 2018 (ENCS)</text>
          </column>
          <badge>Draft</badge>
        </row>
        <row gap="8">
          <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
          <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
          <spacer/>
          <button
            variant="secondary"
            disabled="{not formProfileCanSaveDraft}"
            on-press="save_recurring_form_draft">
            Save
          </button>
          <button variant="primary" disabled="true">Submit</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-2551q-filing-status">
  <card>
    <column padding="20" gap="12">
      <text size="heading">Filing status</text>
      <if test="{constrainedLayout}">
        <if test="{phoneLayout}">
          <column gap="8">
            <row cross="center">
              <badge>Draft</badge>
            </row>
            <text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <badge>Draft</badge>
            <text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
          </row>
        </else>
      </if>
      <else>
        <stepper active="0">
          <step>Draft</step>
          <step>Queued</step>
          <step>Submitted</step>
          <step>Confirmed</step>
          <step>Paid</step>
        </stepper>
      </else>
    </column>
  </card>
</template>

<template name="form-2551q">
  <scroll grow="1" global-key="page-form-2551q">
    <column padding="32" gap="24">
      <use template="form-2551q-masthead"/>

      <!-- @include-template tax-profile-form-context -->

      <use template="form-2551q-filing-status"/>

      <card>
        <column padding="20" gap="12">
          <text size="heading">FILING PERIOD</text>
          <if test="{constrainedLayout}">
            <use template="form-2551q-grid-1" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2551q-grid-1" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2551q-grid-1" columns="4"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART I — BACKGROUND INFORMATION (pre-filled from profile)</text>
          <if test="{constrainedLayout}">
            <use template="form-2551q-grid-2" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2551q-grid-2" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2551q-grid-2" columns="3"/>
          </if>
          <use template="form-2551q-contact-provenance"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 1 — COMPUTATION OF TAX</text>
          <if test="{constrainedLayout}">
            <use template="form-2551q-schedule-editor" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2551q-schedule-editor" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2551q-schedule-editor" columns="4"/>
          </if>
          <separator/>
          <use template="form-2551q-table-1"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II — COMPUTATION OF TAX</text>
          <if test="{constrainedLayout}">
            <use template="form-2551q-grid-3" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2551q-grid-3" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2551q-grid-3" columns="3"/>
          </if>
          <separator />
          <if test="{constrainedLayout}">
            <column gap="8">
              <text>Total Amount Payable</text>
              <row cross="center">
                <badge>PHP {percentageTaxTotalAmountPayable}</badge>
              </row>
            </column>
          </if>
          <else>
            <row gap="8">
              <text grow="1">Total Amount Payable</text>
              <badge>PHP {percentageTaxTotalAmountPayable}</badge>
            </row>
          </else>
          <text foreground="text_muted">{percentageTaxValidationStatus}</text>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">Submission controls by status</text>
          <text foreground="text_muted">Draft: Save and Submit. Queued: Cancel Submission Queue. Submitted: Revert Draft and Check Confirmation or Mark as Confirmed Manually. Confirmed: Revert Draft and Mark as Paid. A receipt action appears when available.</text>
        </column>
      </card>
    </column>
  </scroll>
</template>
