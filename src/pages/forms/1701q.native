<template name="form-1701q-grid-1" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">1 Taxable Year</text>
      <input text="{incomeTaxYear}" placeholder="YYYY" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">2 Quarter</text>
      <input text="{incomeTaxQuarter}" placeholder="Q1 / Q2 / Q3" disabled="true" />
      <row gap="8">
        <button
          variant="outline"
          selected="{incomeTaxQuarterQ1Selected}"
          disabled="{incomeTaxInputsDisabled}"
          on-press="income_tax_quarter_q1">
          Q1
        </button>
        <button
          variant="outline"
          selected="{incomeTaxQuarterQ2Selected}"
          disabled="{incomeTaxInputsDisabled}"
          on-press="income_tax_quarter_q2">
          Q2
        </button>
        <button
          variant="outline"
          selected="{incomeTaxQuarterQ3Selected}"
          disabled="{incomeTaxInputsDisabled}"
          on-press="income_tax_quarter_q3">
          Q3
        </button>
      </row>
    </column>
    <column gap="4">
      <text foreground="text_muted">3 Amended Return?</text>
      <input text="{incomeTaxAmendedReturn}" placeholder="No" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">4 Number of Sheets Attached</text>
      <input
        text="{incomeTaxSheetsAttached}"
        placeholder="Enter number"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_sheets_attached_input"/>
    </column>
  </grid>
</template>

<template name="form-1701q-grid-2" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">5 TIN</text>
      <input text="{formFilerTin}" placeholder="000-000-000-000" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">6 RDO Code</text>
      <input text="{formFilerRdo}" placeholder="RDO" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">7 Taxpayer / Filer Name</text>
      <input text="{formFilerTaxpayerName}" placeholder="Registered name" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Registered Address</text>
      <input text="{formFilerRegisteredAddress}" placeholder="Registered address" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Date of Birth</text>
      <input text="{formFilerDateOfBirth}" placeholder="MM / DD / YYYY" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Email Address</text>
      <input text="{formFilerEmailAddress}" placeholder="name@example.com" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Citizenship</text>
      <input text="{formFilerCitizenship}" placeholder="Citizenship" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Foreign Tax Number</text>
      <input text="{formFilerForeignTaxNumber}" placeholder="Foreign tax number" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Income-tax-rate election</text>
      <input text="{incomeTaxElection}" placeholder="Graduated / 8 percent" disabled="true" />
      <row gap="8">
        <button
          variant="outline"
          selected="{incomeTaxElectionGraduatedSelected}"
          disabled="{incomeTaxInputsDisabled}"
          on-press="income_tax_election_graduated">
          Graduated
        </button>
        <button
          variant="outline"
          selected="{incomeTaxElectionEightPercentSelected}"
          disabled="{incomeTaxInputsDisabled}"
          on-press="income_tax_election_eight_percent">
          8 percent
        </button>
      </row>
    </column>
  </grid>
</template>

<template name="form-1701q-grid-3" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Spouse TIN</text>
      <input text="{formSpouseTin}" placeholder="000-000-000-000" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Spouse RDO Code</text>
      <input text="{formSpouseRdo}" placeholder="RDO" disabled="true" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Spouse Name</text>
      <input text="{formSpouseName}" placeholder="Registered spouse name" disabled="true" />
    </column>
  </grid>
</template>

<template name="form-1701q-grid-4" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Sales / Revenues / Receipts</text>
      <input
        text="{incomeTaxGraduatedSales}"
        placeholder="Enter amount"
        disabled="{incomeTaxGraduatedInputsDisabled}"
        on-input="income_tax_graduated_sales_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Cost of Sales / Services</text>
      <input
        text="{incomeTaxGraduatedCost}"
        placeholder="Enter amount"
        disabled="{incomeTaxGraduatedInputsDisabled}"
        on-input="income_tax_graduated_cost_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Allowable Deductions</text>
      <input
        text="{incomeTaxGraduatedDeductions}"
        placeholder="Enter amount"
        disabled="{incomeTaxGraduatedInputsDisabled}"
        on-input="income_tax_graduated_deductions_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Taxable Income (external policy result)</text>
      <input
        text="{incomeTaxGraduatedTaxableIncome}"
        placeholder="Enter externally supplied amount"
        disabled="{incomeTaxGraduatedInputsDisabled}"
        on-input="income_tax_graduated_taxable_income_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Income Tax Due (external policy result)</text>
      <input
        text="{incomeTaxGraduatedTaxDue}"
        placeholder="Enter externally supplied amount"
        disabled="{incomeTaxGraduatedInputsDisabled}"
        on-input="income_tax_graduated_tax_due_input"/>
    </column>
  </grid>
</template>

<template name="form-1701q-grid-5" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Gross Sales / Receipts</text>
      <input
        text="{incomeTaxEightGrossSales}"
        placeholder="Enter amount"
        disabled="{incomeTaxEightPercentInputsDisabled}"
        on-input="income_tax_eight_gross_sales_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Less: Non-Operating Income</text>
      <input
        text="{incomeTaxEightNonOperatingIncome}"
        placeholder="Enter amount"
        disabled="{incomeTaxEightPercentInputsDisabled}"
        on-input="income_tax_eight_non_operating_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Tax Due at 8 percent (external policy result)</text>
      <input
        text="{incomeTaxEightTaxDue}"
        placeholder="Enter externally supplied amount"
        disabled="{incomeTaxEightPercentInputsDisabled}"
        on-input="income_tax_eight_tax_due_input"/>
    </column>
  </grid>
</template>

<template name="form-1701q-grid-6" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Prior-quarter income tax payments</text>
      <input
        text="{incomeTaxPriorQuarterPayments}"
        placeholder="Enter amount"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_prior_payments_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Creditable tax withheld (BIR Form 2307)</text>
      <input
        text="{incomeTaxWithheld2307}"
        placeholder="Enter amount"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_withheld_2307_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">Other Tax Credits / Payments</text>
      <input
        text="{incomeTaxOtherCredits}"
        placeholder="Enter amount"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_other_credits_input"/>
    </column>
  </grid>
</template>

<template name="form-1701q-grid-7" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">63 Tax Payable / (Overpayment) (external policy result)</text>
      <input
        text="{incomeTaxPayableOrOverpayment}"
        placeholder="Enter externally supplied signed amount"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_payable_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">64 Surcharge (external policy result)</text>
      <input
        text="{incomeTaxSurcharge}"
        placeholder="Enter externally supplied amount"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_surcharge_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">65 Interest (external policy result)</text>
      <input
        text="{incomeTaxInterest}"
        placeholder="Enter externally supplied amount"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_interest_input"/>
    </column>
    <column gap="4">
      <text foreground="text_muted">66 Compromise (external policy result)</text>
      <input
        text="{incomeTaxCompromise}"
        placeholder="Enter externally supplied amount"
        disabled="{incomeTaxInputsDisabled}"
        on-input="income_tax_compromise_input"/>
    </column>
  </grid>
</template>

<template name="form-1701q-table-1">
  <column gap="16">
    <row gap="8" cross="center">
      <column gap="2" grow="1">
        <text><span weight="bold">Payment rows</span></text>
        <text foreground="text_muted" wrap="true">
          Optional, bounded payment evidence. Each row keeps a stable persistence identity.
        </text>
      </column>
      <button
        variant="secondary"
        disabled="{incomeTaxPaymentAddDisabled}"
        on-press="income_tax_add_payment">
        Add payment
      </button>
    </row>

    <for each="incomeTaxPaymentRows" key="idLabel" as="payment">
      <button
        variant="outline"
        selected="{payment.selected}"
        disabled="{incomeTaxInputsDisabled}"
        on-press="income_tax_select_payment:{payment.id}">
        {payment.name} — {payment.bankOrAgencyText} — {payment.referenceText} — PHP {payment.amountText}
      </button>
    </for>
    <else>
      <text foreground="text_muted">No payment rows. Add one only when payment evidence exists.</text>
    </else>

    <table gap="4">
      <table-row gap="8">
        <table-cell>Method</table-cell>
        <table-cell>Bank / Agency</table-cell>
        <table-cell>Reference</table-cell>
        <table-cell>Amount</table-cell>
      </table-row>
      <table-row gap="8">
        <table-cell>{incomeTaxPaymentMethod}</table-cell>
        <table-cell>{incomeTaxPaymentBankOrAgency}</table-cell>
        <table-cell>{incomeTaxPaymentReference}</table-cell>
        <table-cell>{incomeTaxPaymentAmount}</table-cell>
      </table-row>
    </table>

    <if test="{incomeTaxPaymentEditorVisible}">
      <separator/>
      <column gap="12">
        <row gap="8" cross="center">
          <column gap="2" grow="1">
            <text><span weight="bold">Selected payment</span></text>
            <text foreground="text_muted">{incomeTaxPaymentMethod}</text>
          </column>
          <button
            variant="ghost"
            disabled="{incomeTaxPaymentRemoveDisabled}"
            on-press="income_tax_remove_selected_payment">
            Remove
          </button>
        </row>

        <row gap="8">
          <button
            variant="outline"
            selected="{incomeTaxPaymentMethodCashSelected}"
            disabled="{incomeTaxInputsDisabled}"
            on-press="income_tax_payment_method_cash">
            Cash
          </button>
          <button
            variant="outline"
            selected="{incomeTaxPaymentMethodCheckSelected}"
            disabled="{incomeTaxInputsDisabled}"
            on-press="income_tax_payment_method_check">
            Check
          </button>
          <button
            variant="outline"
            selected="{incomeTaxPaymentMethodTaxDebitMemoSelected}"
            disabled="{incomeTaxInputsDisabled}"
            on-press="income_tax_payment_method_tax_debit_memo">
            Tax Debit Memo
          </button>
          <button
            variant="outline"
            selected="{incomeTaxPaymentMethodOtherSelected}"
            disabled="{incomeTaxInputsDisabled}"
            on-press="income_tax_payment_method_other">
            Other
          </button>
        </row>

        <column gap="12">
          <column gap="4">
            <text foreground="text_muted">Bank / Agency</text>
            <input
              text="{incomeTaxPaymentBankOrAgency}"
              placeholder="Bank or collecting agency"
              disabled="{incomeTaxInputsDisabled}"
              on-input="income_tax_payment_bank_input"/>
          </column>
          <column gap="4">
            <text foreground="text_muted">Reference</text>
            <input
              text="{incomeTaxPaymentReference}"
              placeholder="Reference number"
              disabled="{incomeTaxInputsDisabled}"
              on-input="income_tax_payment_reference_input"/>
          </column>
          <column gap="4">
            <text foreground="text_muted">Amount</text>
            <input
              text="{incomeTaxPaymentAmount}"
              placeholder="Enter amount"
              disabled="{incomeTaxInputsDisabled}"
              on-input="income_tax_payment_amount_input"/>
          </column>
        </column>
      </column>
    </if>
  </column>
</template>

<template name="form-1701q-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
      <column gap="6">
        <text size="heading">BIR Form No. 1701Q</text>
        <text>Quarterly Income Tax Return for Individuals, Estates and Trusts</text>
        <row gap="8" cross="center">
          <text foreground="text_muted" grow="1">January 2018 (ENCS)</text>
          <badge>Draft</badge>
        </row>
      </column>
        <column gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">HTML Preview</button>
        <separator/>
        <button
          variant="secondary"
          disabled="{incomeTaxSaveDisabled}"
          on-press="save_recurring_form_draft">
          Save Draft
        </button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 1701Q</text>
            <text>Quarterly Income Tax Return for Individuals, Estates and Trusts</text>
            <text foreground="text_muted">January 2018 (ENCS)</text>
          </column>
          <badge>Draft</badge>
        </row>
        <row gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">HTML Preview</button>
        <spacer/>
        <button
          variant="secondary"
          disabled="{incomeTaxSaveDisabled}"
          on-press="save_recurring_form_draft">
          Save Draft
        </button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-1701q-filing-status">
  <card>
    <column padding="20" gap="12">
      <text size="heading">Filing status</text>
      <if test="{constrainedLayout}">
        <if test="{phoneLayout}">
          <column gap="8">
            <row cross="center">
              <badge>Draft</badge>
            </row>
            <text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <badge>Draft</badge>
            <text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
          </row>
        </else>
      </if>
      <else>
        <stepper active="0">
          <step>Draft</step>
          <step>Queued</step>
          <step>Submitted</step>
          <step>Confirmed</step>
          <step>Paid</step>
        </stepper>
      </else>
    </column>
  </card>
</template>

<template name="form-1701q">
  <scroll grow="1" global-key="page-form-1701q">
    <column padding="32" gap="24">
      <use template="form-1701q-masthead"/>

      <!-- @include-template tax-profile-form-context -->

      <if test="{incomeTaxNoticeVisible}">
        <row gap="8" cross="center">
          <badge variant="{incomeTaxNoticeTone}">{incomeTaxNotice}</badge>
        </row>
      </if>

      <use template="form-1701q-filing-status"/>

      <card>
        <column padding="20" gap="12">
          <text size="heading">ITEMS 1-4 - FILING PERIOD</text>
          <if test="{constrainedLayout}">
            <use template="form-1701q-grid-1" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1701q-grid-1" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1701q-grid-1" columns="4"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART I - ITEMS 5-16A</text>
          <if test="{constrainedLayout}">
            <use template="form-1701q-grid-2" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1701q-grid-2" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1701q-grid-2" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II - ITEMS 17-25A (SPOUSE)</text>
          <if test="{constrainedLayout}">
            <use template="form-1701q-grid-3" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1701q-grid-3" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1701q-grid-3" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART V - SCHEDULE I: GRADUATED IT RATE</text>
          <text foreground="text_muted" wrap="true">
            Taxable income and income tax due are explicit externally supplied policy results. This form does not infer a rate or tax table.
          </text>
          <if test="{constrainedLayout}">
            <use template="form-1701q-grid-4" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1701q-grid-4" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1701q-grid-4" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART V - SCHEDULE II: 8% IT RATE</text>
          <text foreground="text_muted" wrap="true">
            Tax due is an explicit externally supplied policy result. Selecting this election does not calculate or assume an 8 percent policy.
          </text>
          <if test="{constrainedLayout}">
            <use template="form-1701q-grid-5" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1701q-grid-5" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1701q-grid-5" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART V - SCHEDULE III: TAX CREDITS/PAYMENTS</text>
          <if test="{constrainedLayout}">
            <use template="form-1701q-grid-6" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1701q-grid-6" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1701q-grid-6" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART V - ITEMS 63-68</text>
          <if test="{constrainedLayout}">
            <use template="form-1701q-grid-7" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-1701q-grid-7" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-1701q-grid-7" columns="3"/>
          </if>
          <separator />
          <if test="{constrainedLayout}">
            <column gap="8">
              <text>PART III - TOTAL TAX PAYABLE</text>
              <row cross="center">
                <badge>{incomeTaxTotalTaxPayable}</badge>
              </row>
            </column>
          </if>
          <else>
            <row gap="8">
              <text grow="1">PART III - TOTAL TAX PAYABLE</text>
              <badge>{incomeTaxTotalTaxPayable}</badge>
            </row>
          </else>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART IV - DETAILS OF PAYMENT</text>
          <use template="form-1701q-table-1"/>
        </column>
      </card>
    </column>
  </scroll>
</template>
