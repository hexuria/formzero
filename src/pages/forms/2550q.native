<template name="form-2550q-table-1">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Description</text>
          <text>Capital good 1</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Date Acquired</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Useful Life</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Acquisition Cost</text>
          <text>0.00</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Allowable Input Tax</text>
          <text>0.00</text>
        </column>
      </column>
      <separator/>
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Description</text>
          <text>Capital good 2</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Date Acquired</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Useful Life</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Acquisition Cost</text>
          <text>0.00</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Allowable Input Tax</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                  <table-row gap="8">
                    <table-cell>Description</table-cell>
                    <table-cell>Date Acquired</table-cell>
                    <table-cell>Useful Life</table-cell>
                    <table-cell>Acquisition Cost</table-cell>
                    <table-cell>Allowable Input Tax</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Capital good 1</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Capital good 2</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                </table>
    </else>
  </column>
</template>

