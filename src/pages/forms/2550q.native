<template name="form-2550q-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
      <column gap="6">
        <text size="heading">BIR Form No. 2550Q</text>
        <text>Quarterly Value-Added Tax Return</text>
        <row gap="8" cross="center">
          <row gap="4" cross="center" grow="1">
            <text foreground="text_muted">Form revision:</text>
            <text foreground="text_muted">April 2024 (ENCS)</text>
          </row>
          <badge variant="{form2550QStateTone}">{form2550QStateLabel}</badge>
        </row>
      </column>
        <column gap="8">
          <button height="44" variant="ghost" global-key="resolved-2550q-preview-back" autofocus="true" on-press="reg_close_resolved_2550q_preview">Back</button>
        <button variant="secondary" disabled="{resolved2550QPreviewActive}" on-press="show_aux_html_print_preview">Print Preview</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 2550Q</text>
            <text>Quarterly Value-Added Tax Return</text>
            <row gap="4" cross="center">
              <text foreground="text_muted">Form revision:</text>
              <text foreground="text_muted">April 2024 (ENCS)</text>
            </row>
          </column>
          <badge variant="{form2550QStateTone}">{form2550QStateLabel}</badge>
        </row>
        <row gap="8">
        <button height="44" variant="ghost" global-key="resolved-2550q-preview-back" autofocus="true" on-press="reg_close_resolved_2550q_preview">Back</button>
        <button variant="secondary" disabled="{resolved2550QPreviewActive}" on-press="show_aux_html_print_preview">Print Preview</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-2550q-filing-status">
  <card>
    <column padding="20" gap="12">
      <text size="heading">Filing status</text>
      <if test="{constrainedLayout}">
        <if test="{phoneLayout}">
          <column gap="8">
            <row cross="center">
              <badge>Draft</badge>
            </row>
            <text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <badge>Draft</badge>
            <text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
          </row>
        </else>
      </if>
      <else>
        <stepper active="0">
          <step>Draft</step>
          <step>Queued</step>
          <step>Submitted</step>
          <step>Confirmed</step>
          <step>Paid</step>
        </stepper>
      </else>
    </column>
  </card>
</template>

<template name="form-2550q">
  <scroll grow="1" global-key="page-form-2550q">
    <column padding="32" gap="24">
      <use template="form-2550q-masthead"/>

      <!-- @include-template tax-profile-form-context -->

      <if test="{resolved2550QPreviewActive}">
      <alert text="Resolved filing scope">
        <column gap="8">
          <row><badge variant="destructive">Not fileable</badge></row>
            <text wrap="true">{preview2550QIdentity}</text>
            <text>Filing period: {formFilingPeriodLabel}</text>
            <text wrap="true">{preview2550QScope}</text>
            <for each="preview2550QCoverage" key="id" as="coverage"><text wrap="true">• {coverage.accessibleLabel}</text></for>
            <separator/>
            <column gap="6">
              <text><span weight="bold">Captured source-record filter</span></text>
              <row><badge variant="outline">Fixture metadata only</badge></row>
              <text size="sm" wrap="true" foreground="text_muted">These deterministic source-index rows are not imported business data. They contain no transaction amounts or schedule payloads and do not populate the 2550Q fields below.</text>
              <text wrap="true" foreground="text_muted">{preview2550QSourceSummary}</text>
              <if test="{preview2550QSourceRecordsEmpty}">
                <text wrap="true" foreground="text_muted">No explicitly attributed source records matched this filter.</text>
              </if>
              <else>
                <for each="preview2550QSourceRecords" key="stableKey" as="record">
                  <text wrap="true" label="{record.accessibleLabel}">• {record.visibleLabel} · {record.occurredOnLabel} · {record.attributionLabel}</text>
                </for>
              </else>
              <if test="{preview2550QSourceReviewRequired}">
                <text wrap="true" foreground="warning">{preview2550QSourceReviewLabel}</text>
              </if>
            </column>
            <text wrap="true" foreground="text_muted">{preview2550QEvidence}</text>
            <separator/>
            <column gap="6">
              <text><span weight="bold">Registration evidence</span></text>
              <for each="preview2550QRegistrationEvidence" key="id" as="evidence">
                <column gap="3" label="{evidence.accessibleLabel}">
                  <text><span weight="bold">{evidence.subjectLabel}</span> · {evidence.subjectId}</text>
                  <text size="sm" wrap="true" foreground="text_muted">Evidence ID: {evidence.evidenceId}</text>
                  <text size="sm" wrap="true" foreground="text_muted">Review decision: {evidence.reviewDecisionId} · sequence {evidence.reviewDecisionSequence}</text>
                  <text size="sm" wrap="true" foreground="text_muted">Assertion ID: {evidence.assertionId}</text>
                </column>
              </for>
            </column>
            <separator/>
            <column gap="6">
              <text><span weight="bold">Policy evidence</span></text>
              <for each="preview2550QPolicyEvidence" key="id" as="evidence">
                <column gap="3">
                  <text><span weight="bold">{evidence.displayName}</span></text>
                  <text wrap="true">{evidence.reviewBasis}</text>
                  <text size="sm" wrap="true" foreground="text_muted">Evidence ID: {evidence.evidenceId}</text>
                </column>
              </for>
            </column>
            <text wrap="true" foreground="text_muted">{preview2550QReadiness}</text>
          </column>
        </alert>
      </if><else><use template="form-2550q-filing-status"/></else>

      <card>
        <column padding="20" gap="12">
          <text size="heading">FILING PERIOD AND BACKGROUND INFORMATION</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-1" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-1" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-1" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART IV — SALES AND OUTPUT TAX</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-2" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-2" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-2" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART IV — CURRENT PURCHASES AND ADJUSTMENTS</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-3" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-3" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-3" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 1 — CAPITAL GOODS (2 reviewed rows)</text>
          <use template="form-2550q-table-1"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 2 — INPUT TAX ATTRIBUTABLE TO EXEMPT SALES</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-4" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-4" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-4" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 3 — CREDITABLE VAT WITHHELD (2 reviewed rows)</text>
          <use template="form-2550q-table-2"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 4 — ADVANCE VAT PAYMENTS (2 reviewed rows)</text>
          <use template="form-2550q-table-3"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II — TOTAL TAX PAYABLE</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-5" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-5" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-5" columns="3"/>
          </if>
          <separator />
          <if test="{constrainedLayout}">
            <column gap="8">
              <text>Total Amount Payable</text>
              <row cross="center">
                <badge>PHP 0.00</badge>
              </row>
            </column>
          </if>
          <else>
            <row gap="8">
              <text grow="1">Total Amount Payable</text>
              <badge>PHP 0.00</badge>
            </row>
          </else>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SIGNATURE AND LOCAL PAYMENT DETAILS</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-6" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-6" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-6" columns="3"/>
          </if>
        </column>
      </card>
    </column>
  </scroll>
</template>
