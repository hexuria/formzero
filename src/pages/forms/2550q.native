          <text foreground="text_muted">Payment Date</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Reference Number</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Taxable Base</text>
          <text>0.00</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Advance VAT Paid</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                  <table-row gap="8">
                    <table-cell>Payment Date</table-cell>
