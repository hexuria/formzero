<template name="form-2550q-grid-1" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Year-end month</text>
      <input placeholder="Month" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Taxable year (raw)</text>
      <input placeholder="YYYY" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Return Period From</text>
      <input placeholder="MM / DD / YYYY" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Return Period To</text>
      <input placeholder="MM / DD / YYYY" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Amended Return?</text>
      <input placeholder="No" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Tax Relief?</text>
      <input placeholder="No / Specify" />
    </column>
    <column gap="4">
      <text foreground="text_muted">TIN</text>
      <input placeholder="000-000-000-000" />
    </column>
    <column gap="4">
      <text foreground="text_muted">RDO Code</text>
      <input placeholder="RDO" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Taxpayer Name</text>
      <input placeholder="Registered taxpayer name" />
    </column>
  </grid>
</template>

<template name="form-2550q-grid-2" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">31A Vatable Sales / Receipts</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">31B Output Tax Due</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">32A Zero-Rated Sales / Receipts</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">33A Exempt Sales / Receipts</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Output VAT Adjustments</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Total Output Tax Due</text>
      <input placeholder="Enter amount" />
    </column>
  </grid>
</template>

<template name="form-2550q-grid-3" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">44 Domestic Purchases / Input Tax</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">45 Services Rendered by Non-Residents</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">46 Importation of Goods</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">47 Other Purchases</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">48 Domestic Purchases Without Input Tax</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">49 Exempt Importations</text>
      <input placeholder="Enter amount" />
    </column>
  </grid>
</template>

<template name="form-2550q-grid-4" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Input Tax Directly Attributable to Exempt Sales</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Input Tax Not Directly Attributable</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Ratable Input Tax to Exempt Sales</text>
      <input placeholder="Enter amount" />
    </column>
  </grid>
</template>

<template name="form-2550q-grid-5" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Prior Return Payment</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Other Tax Credit / Payment</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Net VAT Payable / (Overpayment)</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Surcharge</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Interest</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Compromise</text>
      <input placeholder="Enter amount" />
    </column>
  </grid>
</template>

<template name="form-2550q-grid-6" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Taxpayer / Authorized Representative</text>
      <input placeholder="Name and capacity" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Payment Method</text>
      <input placeholder="Cash / Check / Tax Debit Memo" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Payment Reference</text>
      <input placeholder="Reference number" />
    </column>
  </grid>
</template>

<template name="form-2550q-table-1">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Description</text>
          <text>Capital good 1</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Date Acquired</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Useful Life</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Acquisition Cost</text>
          <text>0.00</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Allowable Input Tax</text>
          <text>0.00</text>
        </column>
      </column>
      <separator/>
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Description</text>
          <text>Capital good 2</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Date Acquired</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Useful Life</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Acquisition Cost</text>
          <text>0.00</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Allowable Input Tax</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                  <table-row gap="8">
                    <table-cell>Description</table-cell>
                    <table-cell>Date Acquired</table-cell>
                    <table-cell>Useful Life</table-cell>
                    <table-cell>Acquisition Cost</table-cell>
                    <table-cell>Allowable Input Tax</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Capital good 1</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Capital good 2</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                </table>
    </else>
  </column>
</template>

<template name="form-2550q-table-2">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Withholding Agent</text>
          <text>Certificate 1</text>
