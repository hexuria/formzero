        </column>
      </column>
      <separator/>
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Withholding Agent</text>
          <text>Certificate 2</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">TIN</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Period</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Creditable VAT Withheld</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                  <table-row gap="8">
                    <table-cell>Withholding Agent</table-cell>
                    <table-cell>TIN</table-cell>
                    <table-cell>Period</table-cell>
                    <table-cell>Creditable VAT Withheld</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Certificate 1</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Certificate 2</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                </table>
    </else>
  </column>
</template>

<template name="form-2550q-table-3">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Payment Date</text>
