                    <table-cell>0.00</table-cell>
                  </table-row>
                </table>
    </else>
  </column>
</template>

<template name="form-2550q-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
      <column gap="6">
        <text size="heading">BIR Form No. 2550Q</text>
        <text>Quarterly Value-Added Tax Return</text>
        <row gap="8" cross="center">
          <text foreground="text_muted" grow="1">April 2024 (ENCS)</text>
          <badge>Draft</badge>
        </row>
      </column>
        <column gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <button variant="secondary" disabled="true">Validate</button>
        <separator/>
        <button variant="secondary" disabled="true">Save Draft</button>
        <button variant="secondary" disabled="true">Revert to Draft</button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 2550Q</text>
            <text>Quarterly Value-Added Tax Return</text>
            <text foreground="text_muted">April 2024 (ENCS)</text>
          </column>
          <badge>Draft</badge>
        </row>
        <row gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <button variant="secondary" disabled="true">Validate</button>
        <spacer/>
        <button variant="secondary" disabled="true">Save Draft</button>
        <button variant="secondary" disabled="true">Revert to Draft</button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-2550q-filing-status">
  <card>
    <column padding="20" gap="12">
      <text size="heading">Filing status</text>
      <if test="{constrainedLayout}">
        <if test="{phoneLayout}">
          <column gap="8">
            <row cross="center">
              <badge>Draft</badge>
            </row>
            <text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <badge>Draft</badge>
            <text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
          </row>
        </else>
      </if>
      <else>
        <stepper active="0">
          <step>Draft</step>
          <step>Queued</step>
          <step>Submitted</step>
          <step>Confirmed</step>
          <step>Paid</step>
        </stepper>
      </else>
    </column>
  </card>
</template>

<template name="form-2550q">
  <scroll grow="1" global-key="page-form-2550q">
    <column padding="32" gap="24">
      <use template="form-2550q-masthead"/>

      <use template="form-2550q-filing-status"/>

      <card>
        <column padding="20" gap="12">
          <text size="heading">FILING PERIOD AND BACKGROUND INFORMATION</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-1" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-1" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-1" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART IV — SALES AND OUTPUT TAX</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-2" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-2" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-2" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART IV — CURRENT PURCHASES AND ADJUSTMENTS</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-3" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-3" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-3" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 1 — CAPITAL GOODS (2 reviewed rows)</text>
          <use template="form-2550q-table-1"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 2 — INPUT TAX ATTRIBUTABLE TO EXEMPT SALES</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-4" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-4" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-4" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 3 — CREDITABLE VAT WITHHELD (2 reviewed rows)</text>
          <use template="form-2550q-table-2"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SCHEDULE 4 — ADVANCE VAT PAYMENTS (2 reviewed rows)</text>
          <use template="form-2550q-table-3"/>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II — TOTAL TAX PAYABLE</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-5" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-5" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-5" columns="3"/>
          </if>
          <separator />
          <if test="{constrainedLayout}">
            <column gap="8">
              <text>Total Amount Payable</text>
              <row cross="center">
                <badge>PHP 0.00</badge>
              </row>
            </column>
          </if>
          <else>
            <row gap="8">
              <text grow="1">Total Amount Payable</text>
              <badge>PHP 0.00</badge>
            </row>
          </else>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">SIGNATURE AND LOCAL PAYMENT DETAILS</text>
          <if test="{constrainedLayout}">
            <use template="form-2550q-grid-6" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-2550q-grid-6" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-2550q-grid-6" columns="3"/>
          </if>
        </column>
      </card>
    </column>
  </scroll>
</template>
