    <!-- @include-template form-field-bound label="5 ATC" v="{formFilerAtc}" ph="Select ATC" -->
    <!-- @include-template form-field-bound label="6 Tax Type Code" v="{formFilerTaxType}" ph="Tax type code" -->
    <!-- @include-template form-field label="Due date day" ph="DD" -->
    <!-- @include-template form-field-bound label="TIN" v="{formFilerTin}" ph="000-000-000-000" -->
    <!-- @include-template form-field-bound label="RDO Code" v="{formFilerRdo}" ph="RDO" -->
    <!-- @include-template form-field-bound label="Registered Taxpayer Name" v="{formFilerTaxpayerName}" ph="-" -->
    <!-- @include-template form-field-bound label="Line of Business" v="{formFilerLineOfBusiness}" ph="-" -->
    <!-- @include-template form-field-bound label="Registered Address" v="{formFilerRegisteredAddress}" ph="-" -->
    <!-- @include-template form-field-bound label="ZIP Code" v="{formFilerZipCode}" ph="-" -->
    <!-- @include-template form-field-bound label="Contact Number" v="{formFilerContactNumber}" ph="-" -->
    <!-- @include-template form-field-bound label="Email Address" v="{formFilerEmailAddress}" ph="-" -->
    <!-- @include-template form-field-bound label="12 Government withholding agent?" v="{formFilerGovernmentWithholdingAgent}" ph="Yes / No" -->
  </grid>
</template>

<template name="form-0619-e-grid-2" args="columns">
  <grid columns="{columns}" gap="12">
    <!-- @include-template form-field label="14 Amount of Remittance" ph="Enter amount" -->
    <!-- @include-template form-field label="15 Less: Amount Remitted from Previously Filed Form" ph="Enter amount" -->
    <!-- @include-template form-field label="16 Net Amount of Remittance (14 - 15)" ph="Enter amount" -->
    <!-- @include-template form-field label="17A Surcharge" ph="Enter amount" -->
    <!-- @include-template form-field label="17B Interest" ph="Enter amount" -->
    <!-- @include-template form-field label="17C Compromise" ph="Enter amount" -->
  </grid>
</template>

<template name="form-0619-e-grid-3" args="columns">
  <grid columns="{columns}" gap="12">
    <!-- @include-template form-field label="Tax Agent Accreditation / Attorney Roll No." ph="Accreditation number" -->
    <!-- @include-template form-field label="Date Issued" ph="MM / DD / YYYY" -->
    <!-- @include-template form-field label="Date of Expiry" ph="MM / DD / YYYY" -->
  </grid>
</template>

<template name="form-0619-e-table-1">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Method</text>
          <text>Cash / Bank Debit</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Bank / Agency</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Reference</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Amount</text>
          <text>0.00</text>
        </column>
      </column>
      <separator/>
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Method</text>
          <text>Check / Tax Debit Memo / Others</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Bank / Agency</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Reference</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Amount</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                  <table-row gap="8">
                    <table-cell>Method</table-cell>
                    <table-cell>Bank / Agency</table-cell>
                    <table-cell>Reference</table-cell>
                    <table-cell>Amount</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Cash / Bank Debit</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>Check / Tax Debit Memo / Others</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                </table>
    </else>
  </column>
</template>

<template name="form-0619-e-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
      <column gap="6">
        <text size="heading">BIR Form No. 0619-E</text>
        <text>Monthly Remittance Form of Creditable Income Taxes Withheld (Expanded)</text>
        <row gap="8" cross="center">
          <text foreground="text_muted" grow="1">January 2018 (ENCS)</text>
          <badge>Draft</badge>
        </row>
      </column>
        <column gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <separator/>
        <button variant="secondary" disabled="true">Save Draft</button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 0619-E</text>
            <text>Monthly Remittance Form of Creditable Income Taxes Withheld (Expanded)</text>
            <text foreground="text_muted">January 2018 (ENCS)</text>
          </column>
          <badge>Draft</badge>
        </row>
        <row gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <spacer/>
        <button variant="secondary" disabled="true">Save Draft</button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-0619-e-filing-status">
  <card>
    <column padding="20" gap="12">
      <text size="heading">Filing status</text>
      <if test="{constrainedLayout}">
        <if test="{phoneLayout}">
          <column gap="8">
            <row cross="center">
              <badge>Draft</badge>
            </row>
            <text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <badge>Draft</badge>
            <text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
          </row>
        </else>
      </if>
      <else>
        <stepper active="0">
          <step>Draft</step>
          <step>Queued</step>
          <step>Submitted</step>
          <step>Confirmed</step>
          <step>Paid</step>
        </stepper>
      </else>
    </column>
  </card>
</template>

<template name="form-0619-e">
  <scroll grow="1" global-key="page-form-0619-e">
    <column padding="32" gap="24">
      <use template="form-0619-e-masthead"/>

      <!-- @include-template tax-profile-form-context -->

      <use template="form-0619-e-filing-status"/>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART I - BACKGROUND INFORMATION</text>
          <if test="{constrainedLayout}">
            <use template="form-0619-e-grid-1" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-0619-e-grid-1" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-0619-e-grid-1" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II - TAX REMITTANCE</text>
          <if test="{constrainedLayout}">
            <use template="form-0619-e-grid-2" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-0619-e-grid-2" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-0619-e-grid-2" columns="2"/>
          </if>
          <separator />
          <if test="{constrainedLayout}">
            <column gap="8">
              <text>18 Total Amount of Remittance (16 + 17D)</text>
              <row cross="center">
                <badge>PHP 0.00</badge>
              </row>
            </column>
          </if>
          <else>
            <row gap="8">
              <text grow="1">18 Total Amount of Remittance (16 + 17D)</text>
              <badge>PHP 0.00</badge>
            </row>
          </else>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">TAX AGENT / SIGNATURE DETAILS</text>
          <if test="{constrainedLayout}">
            <use template="form-0619-e-grid-3" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-0619-e-grid-3" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-0619-e-grid-3" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART III - DETAILS OF PAYMENT</text>
          <use template="form-0619-e-table-1"/>
        </column>
      </card>
    </column>
  </scroll>
</template>
