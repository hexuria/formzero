<template name="form-0619-f-grid-1" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">1 For the Month of (MM/YYYY)</text>
      <input placeholder="MM / YYYY" />
    </column>
    <column gap="4">
      <text foreground="text_muted">3 Amended Form?</text>
      <input placeholder="No" />
    </column>
    <column gap="4">
      <text foreground="text_muted">4 Any Taxes Withheld?</text>
      <input placeholder="Yes / No" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Tax Type Code</text>
      <input placeholder="Tax type code" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Due date day</text>
      <input placeholder="DD" />
    </column>
    <column gap="4">
      <text foreground="text_muted">12 Government withholding agent?</text>
      <input placeholder="Yes / No" />
    </column>
    <column gap="4">
      <text foreground="text_muted">TIN</text>
      <input placeholder="000-000-000-000" />
    </column>
    <column gap="4">
      <text foreground="text_muted">RDO Code</text>
      <input placeholder="RDO" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Registered Taxpayer Name</text>
      <input placeholder="Taxpayer name" />
    </column>
  </grid>
</template>

<template name="form-0619-f-grid-2" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">13 Final tax withheld on interest, deposits and trusts</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">14 Other final income taxes withheld</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">15 Total final income taxes withheld</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">16 Less: Amount Remitted from Previously Filed Form</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">17 Net Amount of Remittance</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">18A Surcharge</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">18B Interest</text>
      <input placeholder="Enter amount" />
    </column>
    <column gap="4">
      <text foreground="text_muted">18C Compromise</text>
      <input placeholder="Enter amount" />
    </column>
  </grid>
</template>

<template name="form-0619-f-grid-3" args="columns">
  <grid columns="{columns}" gap="12">
    <column gap="4">
      <text foreground="text_muted">Tax Agent Accreditation / Attorney Roll No.</text>
      <input placeholder="Accreditation number" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Date Issued</text>
      <input placeholder="MM / DD / YYYY" />
    </column>
    <column gap="4">
      <text foreground="text_muted">Date of Expiry</text>
      <input placeholder="MM / DD / YYYY" />
    </column>
  </grid>
</template>

<template name="form-0619-f-table-1">
  <column>
    <if test="{constrainedLayout or tabletLayout}">
      <column gap="12">
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Item</text>
          <text>20-21</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Payment method</text>
          <text>Cash / Check</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Reference</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Amount</text>
          <text>0.00</text>
        </column>
      </column>
      <separator/>
      <column gap="8">
        <column gap="2">
          <text foreground="text_muted">Item</text>
          <text>22-23</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Payment method</text>
          <text>Tax Debit Memo / Others</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Reference</text>
          <text>-</text>
        </column>
        <column gap="2">
          <text foreground="text_muted">Amount</text>
          <text>0.00</text>
        </column>
      </column>
      </column>
    </if>
    <else>
      <table gap="4">
                  <table-row gap="8">
                    <table-cell>Item</table-cell>
                    <table-cell>Payment method</table-cell>
                    <table-cell>Reference</table-cell>
                    <table-cell>Amount</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>20-21</table-cell>
                    <table-cell>Cash / Check</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                  <table-row gap="8">
                    <table-cell>22-23</table-cell>
                    <table-cell>Tax Debit Memo / Others</table-cell>
                    <table-cell>-</table-cell>
                    <table-cell>0.00</table-cell>
                  </table-row>
                </table>
    </else>
  </column>
</template>

<template name="form-0619-f-masthead">
  <column>
    <if test="{constrainedLayout}">
      <column gap="16">
      <column gap="6">
        <text size="heading">BIR Form No. 0619-F</text>
        <text>Monthly Remittance Form of Final Income Taxes Withheld</text>
        <row gap="8" cross="center">
          <text foreground="text_muted" grow="1">January 2018 (ENCS)</text>
          <badge>Draft</badge>
        </row>
      </column>
        <column gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <separator/>
        <button variant="secondary" disabled="true">Save Draft</button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </column>
      </column>
    </if>
    <else>
      <column gap="16">
        <row gap="16" cross="center">
          <column gap="4" grow="1">
            <text size="heading">BIR Form No. 0619-F</text>
            <text>Monthly Remittance Form of Final Income Taxes Withheld</text>
            <text foreground="text_muted">January 2018 (ENCS)</text>
          </column>
          <badge>Draft</badge>
        </row>
        <row gap="8">
        <button variant="ghost" on-press="show_taxpayer_dashboard">Back</button>
        <button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button>
        <spacer/>
        <button variant="secondary" disabled="true">Save Draft</button>
        <button variant="primary" disabled="true">Manual / External Filing</button>
        </row>
      </column>
    </else>
  </column>
</template>

<template name="form-0619-f-filing-status">
  <card>
    <column padding="20" gap="12">
      <text size="heading">Filing status</text>
      <if test="{constrainedLayout}">
        <if test="{phoneLayout}">
          <column gap="8">
            <badge>Draft</badge>
            <text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <badge>Draft</badge>
            <text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text>
          </row>
        </else>
      </if>
      <else>
        <stepper active="0">
          <step>Draft</step>
          <step>Queued</step>
          <step>Submitted</step>
          <step>Confirmed</step>
          <step>Paid</step>
        </stepper>
      </else>
    </column>
  </card>
</template>

<template name="form-0619-f">
  <scroll grow="1" global-key="page-form-0619-f">
    <column padding="32" gap="24">
      <use template="form-0619-f-masthead"/>

      <use template="form-0619-f-filing-status"/>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART I - BACKGROUND INFORMATION</text>
          <if test="{constrainedLayout}">
            <use template="form-0619-f-grid-1" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-0619-f-grid-1" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-0619-f-grid-1" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART II - TAX REMITTANCE</text>
          <if test="{constrainedLayout}">
            <use template="form-0619-f-grid-2" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-0619-f-grid-2" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-0619-f-grid-2" columns="2"/>
          </if>
          <separator />
          <if test="{constrainedLayout}">
            <column gap="8">
              <text>19 Total Amount of Remittance (17 + 18D)</text>
              <badge>PHP 0.00</badge>
            </column>
          </if>
          <else>
            <row gap="8">
              <text grow="1">19 Total Amount of Remittance (17 + 18D)</text>
              <badge>PHP 0.00</badge>
            </row>
          </else>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">TAX AGENT / SIGNATURE DETAILS</text>
          <if test="{constrainedLayout}">
            <use template="form-0619-f-grid-3" columns="1"/>
          </if>
          <if test="{tabletLayout}">
            <use template="form-0619-f-grid-3" columns="2"/>
          </if>
          <if test="{desktopLayout}">
            <use template="form-0619-f-grid-3" columns="3"/>
          </if>
        </column>
      </card>

      <card>
        <column padding="20" gap="12">
          <text size="heading">PART III - DETAILS OF PAYMENT</text>
          <use template="form-0619-f-table-1"/>
        </column>
      </card>
    </column>
  </scroll>
</template>
