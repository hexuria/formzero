<template name="taxpayer-empty-card" args="title icon body">
  <card>
    <column padding="20" gap="16">
      <row gap="10" cross="center">
        <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
        <text><span weight="bold">{title}</span></text>
      </row>
      <column height="154" main="center" cross="center" gap="10">
        <icon name="check-circle" foreground="success" width="34" height="34"/>
        <text><span weight="bold">Nothing here</span></text>
        <text wrap="true" text-alignment="center" foreground="text_muted">{body}</text>
      </column>
    </column>
  </card>
</template>

<template name="taxpayer-form-launcher" args="code title body">
  <card>
    <column padding="16" gap="10">
      <row cross="center">
        <badge variant="secondary">{code}</badge>
      </row>
      <text><span weight="bold">{title}</span></text>
      <text wrap="true" foreground="text_muted">{body}</text>
      <slot/>
    </column>
  </card>
</template>

<template name="taxpayer-form-library-column-a">
  <column grow="1" gap="12">
    <use
      template="taxpayer-form-launcher"
      code="0605"
      title="Payment Form"
      body="Prepare a payment reference for taxes and fees without a dedicated return.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm0605Disabled}" on-press="show_form_0605">Open Form 0605</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="0619-E"
      title="Creditable Income Taxes Withheld"
      body="Monthly remittance form for expanded withholding tax.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm0619EDisabled}" on-press="show_form_0619_e">Open Form 0619-E</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="0619-F"
      title="Final Income Taxes Withheld"
      body="Monthly remittance form for final withholding tax.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm0619FDisabled}" on-press="show_form_0619_f">Open Form 0619-F</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1601-C"
      title="Compensation Withholding"
      body="Monthly remittance return for taxes withheld on compensation.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm1601CDisabled}" on-press="show_form_1601_c">Open Form 1601-C</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1701"
      title="Annual Individual Income Tax Return"
      body="Annual return for individuals, estates, and trusts.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm1701Disabled}" on-press="show_form_1701">Open Form 1701</button>
    </use>
  </column>
</template>

<template name="taxpayer-form-library-column-b">
  <column grow="1" gap="12">
    <use
      template="taxpayer-form-launcher"
      code="1701Q"
      title="Quarterly Individual Income Tax Return"
      body="Quarterly return for self-employed individuals and professionals.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm1701QDisabled}" on-press="show_form_1701q">Open Form 1701Q</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1702-RT"
      title="Regular-Rate Corporation Income Tax Return"
      body="Annual corporate return for taxpayers subject only to the regular rate.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm1702RTDisabled}" on-press="show_form_1702_rt">Open Form 1702-RT</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="1702-MX"
      title="Mixed-Income Corporation Income Tax Return"
      body="Annual corporate return for mixed or special tax regimes.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm1702MXDisabled}" on-press="show_form_1702_mx">Open Form 1702-MX</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="2550Q"
      title="Quarterly VAT Return"
      body="Quarterly value-added tax return for VAT-registered taxpayers.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm2550QDisabled}" on-press="show_form_2550q">Open Form 2550Q</button>
    </use>
    <use
      template="taxpayer-form-launcher"
      code="2551Q"
      title="Quarterly Percentage Tax Return"
      body="Quarterly return for taxpayers subject to percentage tax.">
      <button variant="secondary" icon="file-text" disabled="{taxpayerForm2551QDisabled}" on-press="show_form_2551q">Open Form 2551Q</button>
    </use>
  </column>
</template>

<template name="taxpayer-calendar-weekday" args="label">
  <column height="28" main="center" cross="center" background="surface_subtle">
    <text text-alignment="center" foreground="text_muted">
      <span weight="bold">{label}</span>
    </text>
  </column>
</template>

<template name="taxpayer-calendar-empty" args="icon title body">
  <column height="154" padding="18" gap="8" main="center" cross="center" background="surface_subtle" radius="md">
    <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
    <text><span weight="bold">{title}</span></text>
    <text wrap="true" text-alignment="center" foreground="text_muted">{body}</text>
  </column>
</template>

<template name="taxpayer-action-required-row" args="action date year form title period status tone">
  <card padding="0">
    <row
      padding="10"
      gap="10"
      cross="center"
      role="button"
      label="{title}"
      on-press="open_profile_action_required:{action}">
      <column width="48" gap="2" cross="center">
        <text><span weight="bold">{date}</span></text>
        <text foreground="text_muted">{year}</text>
      </column>
      <column width="1" height="48" background="border"></column>
      <column grow="1" gap="4">
        <row gap="6" cross="center">
          <badge variant="secondary">{form}</badge>
          <badge variant="{tone}">{status}</badge>
        </row>
        <text><span weight="bold">{title}</span></text>
        <text wrap="true" foreground="text_muted">Filing period: {period}</text>
      </column>
    </row>
  </card>
</template>

<template name="taxpayer-compact-calendar">
  <card padding="0">
    <column gap="0">
      <row padding="8" cross="center" gap="6">
        <button width="44" height="44" size="icon" variant="ghost" icon="chevron-left" label="Previous month" on-press="calendar_previous_month"></button>
        <text grow="1" text-alignment="center"><span weight="bold">{currentCalendarMonth} {currentCalendarYear}</span></text>
        <button width="44" height="44" size="icon" variant="ghost" icon="chevron-right" label="Next month" on-press="calendar_next_month"></button>
      </row>
      <separator/>
      <grid columns="7" gap="1" background="border">
        <use template="taxpayer-calendar-weekday" label="Sun"/>
        <use template="taxpayer-calendar-weekday" label="Mon"/>
        <use template="taxpayer-calendar-weekday" label="Tue"/>
        <use template="taxpayer-calendar-weekday" label="Wed"/>
        <use template="taxpayer-calendar-weekday" label="Thu"/>
        <use template="taxpayer-calendar-weekday" label="Fri"/>
        <use template="taxpayer-calendar-weekday" label="Sat"/>
        <for each="profileCalendarDays" key="id" as="cell">
          <column height="{profileCalendarDayHeight}" cross="stretch" background="surface_subtle">
            <if test="{cell.blank}">
              <spacer/>
            </if>
            <else>
              <column
                grow="1"
                padding="5"
                main="space_between"
                cross="stretch"
                background="surface"
                role="button"
                label="{cell.actionLabel}"
                selected="{cell.selected}"
                on-press="profile_calendar_select_day:{cell.day}">
                <if test="{cell.selected}">
                  <text text-alignment="end"><span weight="bold">{cell.dayLabel}</span></text>
                </if>
                <else>
                  <text text-alignment="end">{cell.dayLabel}</text>
                </else>
                <if test="{cell.hasDeadlines}">
                  <if test="{cell.overdue}">
                    <text text-alignment="center" foreground="destructive">{cell.marker}</text>
                  </if>
                  <else>
                    <if test="{cell.dueSoon}">
                      <text text-alignment="center" foreground="warning">{cell.marker}</text>
                    </if>
                    <else>
                      <if test="{cell.approaching}">
                        <text text-alignment="center" foreground="success">{cell.marker}</text>
                      </if>
                      <else>
                        <text text-alignment="center">{cell.marker}</text>
                      </else>
                    </else>
                  </else>
                </if>
              </column>
            </else>
          </column>
        </for>
      </grid>
    </column>
  </card>
</template>

<template name="taxpayer-upcoming-column">
  <column gap="12">
    <row cross="center" gap="8">
      <text grow="1"><span weight="bold">Upcoming Deadlines</span></text>
      <badge variant="secondary">{profileUpcomingDeadlineCount}</badge>
    </row>
    <use template="taxpayer-compact-calendar"/>
    <if test="{profileUpcomingHasDeadlines}">
      <for each="profileUpcomingDeadlines" key="id" as="deadline">
        <card padding="0">
          <row
            padding="10"
            gap="10"
            cross="center"
            role="button"
            label="{deadline.form_name}"
            on-press="open_profile_deadline:{deadline.id}">
            <column width="48" gap="2" cross="center">
              <text><span weight="bold">{deadline.dateLabel}</span></text>
              <text foreground="text_muted">{deadline.yearLabel}</text>
            </column>
            <column width="1" height="48" background="border"></column>
            <column grow="1" gap="4">
              <row gap="6" cross="center">
                <badge variant="secondary">{deadline.display_form_no}</badge>
                <badge variant="{deadline.tone}">{deadline.statusLabel}</badge>
              </row>
              <text><span weight="bold">{deadline.form_name}</span></text>
              <text wrap="true" foreground="text_muted">Taxable period: {deadline.periodLabel}</text>
              <if test="{deadline.adjustmentVisible}">
                <text wrap="true" foreground="text_muted">{deadline.adjustmentLabel}</text>
              </if>
            </column>
          </row>
        </card>
      </for>
    </if>
    <else>
      <use
        template="taxpayer-calendar-empty"
        icon="clock"
        title="No upcoming deadlines"
        body="There are no open deadlines for the selected date or month."/>
    </else>
  </column>
</template>

<template name="taxpayer-action-required-column">
  <column gap="12">
    <row cross="center" gap="8">
      <text grow="1"><span weight="bold">Action Required</span></text>
      <badge variant="secondary">{profileActionRequiredCount}</badge>
    </row>
    <if test="{profileActionRequiredHasRows}">
      <for each="profileActionRequiredRows" key="id" as="draft">
        <use
          template="taxpayer-action-required-row"
          action="{draft.id}"
          date="{draft.dateLabel}"
          year="{draft.yearLabel}"
          form="{draft.form_code}"
          title="{draft.form_name}"
          period="{draft.period_key}"
          status="{draft.statusLabel}"
          tone="{draft.tone}"/>
      </for>
    </if>
    <else>
      <use
        template="taxpayer-calendar-empty"
        icon="check-circle"
        title="All caught up"
        body="Saved filing work that still needs attention will appear here."/>
    </else>
  </column>
</template>

<template name="taxpayer-overdue-column">
  <column gap="12">
    <row cross="center" gap="8">
      <text grow="1"><span weight="bold">Overdue</span></text>
      <badge variant="destructive">{profileOverdueDeadlineCount}</badge>
    </row>
    <if test="{profileOverdueHasDeadlines}">
      <for each="profileOverdueDeadlines" key="id" as="deadline">
        <card padding="0">
          <row
            padding="10"
            gap="10"
            cross="center"
            role="button"
            label="{deadline.form_name}"
            on-press="open_profile_deadline:{deadline.id}">
            <column width="48" gap="2" cross="center">
              <text><span weight="bold">{deadline.dateLabel}</span></text>
              <text foreground="text_muted">{deadline.yearLabel}</text>
            </column>
            <column width="1" height="48" background="border"></column>
            <column grow="1" gap="4">
              <row gap="6" cross="center">
                <badge variant="secondary">{deadline.display_form_no}</badge>
                <badge variant="destructive">Overdue</badge>
              </row>
              <text><span weight="bold">{deadline.form_name}</span></text>
              <text wrap="true" foreground="text_muted">Taxable period: {deadline.periodLabel}</text>
              <if test="{deadline.adjustmentVisible}">
                <text wrap="true" foreground="text_muted">{deadline.adjustmentLabel}</text>
              </if>
            </column>
          </row>
        </card>
      </for>
    </if>
    <else>
      <use
        template="taxpayer-calendar-empty"
        icon="check-circle"
        title="Nothing overdue"
        body="No unpaid deadline has passed for this tax profile."/>
    </else>
  </column>
</template>

<template name="taxpayer-calendar-section">
  <column gap="12">
    <if test="{dashboardThreeColumnLayout}">
      <row gap="16" cross="start">
        <column grow="1">
          <use template="taxpayer-upcoming-column"/>
        </column>
        <column grow="1">
          <use template="taxpayer-action-required-column"/>
        </column>
        <column grow="1">
          <use template="taxpayer-overdue-column"/>
        </column>
      </row>
    </if>
    <else>
      <if test="{dashboardTwoColumnLayout}">
        <row gap="16" cross="start">
          <column width="{profileCalendarLaneWidth}">
            <use template="taxpayer-upcoming-column"/>
          </column>
          <column grow="1" gap="20">
            <use template="taxpayer-action-required-column"/>
            <use template="taxpayer-overdue-column"/>
          </column>
        </row>
      </if>
      <else>
        <column gap="20">
          <column width="{profileCalendarLaneWidth}">
            <use template="taxpayer-upcoming-column"/>
          </column>
          <use template="taxpayer-action-required-column"/>
          <use template="taxpayer-overdue-column"/>
        </column>
      </else>
    </else>

  </column>
</template>

<template name="taxpayer-form-library-section">
  <column gap="16">
    <if test="{profileFormsHeaderStacked}">
      <column gap="8">
        <row gap="10" cross="center">
          <column grow="1" gap="4">
            <text><span weight="bold">Tax Form Library</span></text>
            <text wrap="true" foreground="text_muted">{profileFormsCountLabel} · Tax Year {currentCalendarYear}</text>
          </column>
          <button width="44" height="44" size="icon" variant="ghost" icon="chevron-left" label="Previous tax year" on-press="calendar_previous_year"></button>
          <button width="44" height="44" size="icon" variant="ghost" icon="chevron-right" label="Next tax year" on-press="calendar_next_year"></button>
        </row>
        <if test="{managingProfileForms}">
          <row gap="8" cross="center">
            <spacer/>
            <button height="44" variant="outline" on-press="profile_forms_cancel">Cancel</button>
            <button height="44" icon="check" disabled="{profileFormsSaveDisabled}" on-press="profile_forms_save">Save</button>
          </row>
        </if>
      </column>
    </if>
    <else>
      <row gap="10" cross="center">
        <column grow="1" gap="4">
          <text><span weight="bold">Tax Form Library</span></text>
          <text wrap="true" foreground="text_muted">{profileFormsCountLabel} · Tax Year {currentCalendarYear}</text>
        </column>
        <button width="44" height="44" size="icon" variant="ghost" icon="chevron-left" label="Previous tax year" on-press="calendar_previous_year"></button>
        <button width="44" height="44" size="icon" variant="ghost" icon="chevron-right" label="Next tax year" on-press="calendar_next_year"></button>
        <if test="{managingProfileForms}">
          <button height="44" variant="outline" on-press="profile_forms_cancel">Cancel</button>
          <button height="44" icon="check" disabled="{profileFormsSaveDisabled}" on-press="profile_forms_save">Save</button>
        </if>
        <else>
          <button height="44" icon="settings" on-press="manage_profile_forms">Manage Forms</button>
        </else>
      </row>
    </else>
    <input
      height="44"
      text="{profileFormsSearchValue}"
      placeholder="Search by form code"
      label="Search Tax Form Library"
      on-input="profile_forms_search_input"/>
    <if test="{profileFormsHeaderStacked}">
      <column gap="8">
        <row gap="8">
          <button height="36" variant="outline" selected="{profileFormsFilterActiveSelected}" on-press="profile_forms_filter_active">Active</button>
          <button height="36" variant="outline" selected="{profileFormsFilterInactiveSelected}" on-press="profile_forms_filter_inactive">Inactive</button>
          <button height="36" variant="outline" selected="{profileFormsFilterAllSelected}" on-press="profile_forms_filter_all">All</button>
        </row>
        <stack>
          <select height="40" label="Capability filter" on-press="profile_forms_toggle_capability_picker">{profileFormsCapabilityFilterLabel}</select>
          <if test="{profileFormsCapabilityPickerOpen}">
            <dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_forms_close_capability_picker">
              <menu-item height="40" selected="{profileFormsCapabilityAllSelected}" on-press="profile_forms_filter_capability_all">All capabilities</menu-item>
              <menu-item height="40" selected="{profileFormsCapabilityEditorSelected}" on-press="profile_forms_filter_editor">Editor available</menu-item>
              <menu-item height="40" selected="{profileFormsCapabilityCalendarSelected}" on-press="profile_forms_filter_calendar_only">Calendar only</menu-item>
            </dropdown-menu>
          </if>
        </stack>
      </column>
    </if>
    <else>
      <row gap="8">
        <button height="36" variant="outline" selected="{profileFormsFilterActiveSelected}" on-press="profile_forms_filter_active">Active</button>
        <button height="36" variant="outline" selected="{profileFormsFilterInactiveSelected}" on-press="profile_forms_filter_inactive">Inactive</button>
        <button height="36" variant="outline" selected="{profileFormsFilterAllSelected}" on-press="profile_forms_filter_all">All</button>
        <button height="36" variant="outline" selected="{profileFormsCapabilityAllSelected}" on-press="profile_forms_filter_capability_all">All capabilities</button>
        <button height="36" variant="outline" selected="{profileFormsCapabilityEditorSelected}" on-press="profile_forms_filter_editor">Editor available</button>
        <button height="36" variant="outline" selected="{profileFormsCapabilityCalendarSelected}" on-press="profile_forms_filter_calendar_only">Calendar only</button>
      </row>
    </else>
    <if test="{managingProfileForms}">
      <if test="{profileFormsHeaderStacked}">
        <column gap="8">
          <button height="40" variant="outline" on-press="profile_forms_select_all">Select all 51</button>
          <button height="40" variant="outline" on-press="profile_forms_clear_all">Clear all</button>
          <if test="{profileFormsLegacyResetVisible}">
            <button height="40" variant="ghost" on-press="profile_forms_reset_legacy">Reset to catalog default</button>
          </if>
        </column>
      </if>
      <else>
        <row gap="8">
          <button height="40" variant="outline" on-press="profile_forms_select_all">Select all 51</button>
          <button height="40" variant="outline" on-press="profile_forms_clear_all">Clear all</button>
          <if test="{profileFormsLegacyResetVisible}">
            <button height="40" variant="ghost" on-press="profile_forms_reset_legacy">Reset to catalog default</button>
          </if>
        </row>
      </else>
      <text wrap="true" foreground="text_muted">Changes remain staged until Save. Saving zero forms creates an explicitly empty library and profile calendar.</text>
    </if>
    <if test="{profileFormRowsEmpty}">
      <use template="taxpayer-calendar-empty" icon="search" title="No matching forms" body="Change the search or filters, or manage this profile's Forms Set."/>
    </if>
    <else>
      <column gap="10">
        <for each="profileFormRows" key="id" as="form">
          <card padding="0">
            <if test="{profileFormsHeaderStacked}">
              <column padding="14" gap="10">
                <row gap="12" cross="center">
                  <if test="{managingProfileForms}">
                    <checkbox
                      checked="{form.selected}"
                      label="{form.selectionLabel}"
                      on-change="toggle_profile_form:{form.id}"/>
                  </if>
                  <column grow="1" gap="5">
                    <row gap="8" cross="center">
                      <badge variant="secondary">{form.code}</badge>
                      <badge variant="outline">{form.activeLabel}</badge>
                      <badge variant="outline">{form.capability}</badge>
                    </row>
                    <text><span weight="bold">{form.title}</span></text>
                  </column>
                </row>
                <if test="{form.launchActionVisible and managingProfileForms == false}">
                  <badge variant="outline">{form.launchStatus}</badge>
                  <button height="40" variant="secondary" icon="file-text" disabled="{form.launchDisabled}" on-press="open_library_form:{form.id}">{form.launchLabel}</button>
                </if>
              </column>
            </if>
            <else>
              <row padding="14" gap="12" cross="center">
                <if test="{managingProfileForms}">
                  <checkbox
                    checked="{form.selected}"
                    label="{form.selectionLabel}"
                    on-change="toggle_profile_form:{form.id}"/>
                </if>
                <column grow="1" gap="5">
                  <row gap="8" cross="center">
                    <badge variant="secondary">{form.code}</badge>
                    <badge variant="outline">{form.activeLabel}</badge>
                    <badge variant="outline">{form.capability}</badge>
                    <if test="{form.launchActionVisible and managingProfileForms == false}">
                      <badge variant="outline">{form.launchStatus}</badge>
                    </if>
                  </row>
                  <text><span weight="bold">{form.title}</span></text>
                </column>
                <if test="{form.launchActionVisible and managingProfileForms == false}">
                  <button height="40" variant="secondary" icon="file-text" disabled="{form.launchDisabled}" on-press="open_library_form:{form.id}">{form.launchLabel}</button>
                </if>
              </row>
            </else>
          </card>
        </for>
      </column>
    </else>
  </column>
</template>

<template name="taxpayer-dashboard-content" args="padding">
  <column padding="{padding}" gap="24">
    <if test="{constrainedLayout}">
      <row gap="12" cross="center">
        <avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
        <column grow="1" gap="5">
          <text size="heading" wrap="true">{selectedTaxpayerName}</text>
          <text wrap="true" foreground="text_muted">TIN: {selectedTaxpayerTin}</text>
          <text wrap="true" foreground="text_muted">Type: {selectedTaxpayerKind} - Tax Year {currentCalendarYear} - Non-VAT</text>
        </column>
        <stack>
          <button
            width="44"
            height="44"
            size="icon"
            variant="outline"
            radius="xl"
            icon="wrench"
            label="Profile actions"
            on-press="toggle_profile_actions">
          </button>
          <if test="{profileActionsOpen}">
            <dropdown-menu
              anchor="below"
              anchor-alignment="end"
              anchor-offset="8"
              on-dismiss="close_profile_actions">
              <menu-item height="44" icon="settings" on-press="show_profile_setup">Profile Settings</menu-item>
              <menu-item height="44" icon="file-text" on-press="manage_profile_forms">Manage Forms</menu-item>
              <menu-item
                height="44"
                icon="app:calendar"
                disabled="{profileCalendarExportBusy}"
                on-press="profile_calendar_export">Add to Calendar</menu-item>
            </dropdown-menu>
          </if>
        </stack>
      </row>
    </if>
    <else>
      <row gap="16" cross="center">
        <avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
        <column grow="1" gap="6">
          <text size="heading">{selectedTaxpayerName}</text>
          <text wrap="true" foreground="text_muted">
            TIN: {selectedTaxpayerTin} - Type: {selectedTaxpayerKind} - Tax Year {currentCalendarYear} - Non-VAT
          </text>
        </column>
        <button variant="outline" icon="settings" on-press="show_profile_setup">Profile Settings</button>
        <button variant="primary" icon="app:calendar" disabled="{profileCalendarExportBusy}" on-press="profile_calendar_export">Add to Calendar</button>
      </row>
    </else>

    <if test="{constrainedLayout}">
      <tabs gap="4" label="Dashboard view">
        <button
          height="44"
          variant="ghost"
          icon="app:calendar"
          selected="{dashboardCalendarActive}"
          on-press="show_dashboard_calendar">Calendar</button>
        <button
          height="44"
          variant="ghost"
          icon="folder-open"
          selected="{dashboardFormsActive}"
          on-press="show_dashboard_forms">Tax Form Library</button>
      </tabs>
    </if>
    <else>
      <tabs gap="4" label="Dashboard view">
        <button
          variant="ghost"
          icon="file-text"
          selected="{dashboardCalendarActive}"
          on-press="show_dashboard_calendar">Calendar</button>
        <button
          variant="ghost"
          icon="folder-open"
          selected="{dashboardFormsActive}"
          on-press="show_dashboard_forms">Tax Form Library</button>
      </tabs>
    </else>

    <if test="{dashboardCalendarActive}">
      <use template="taxpayer-calendar-section"/>
    </if>
    <if test="{dashboardFormsActive}">
      <use template="taxpayer-form-library-section"/>
    </if>
  </column>
</template>

<template name="taxpayer-dashboard-page">
  <scroll grow="1" global-key="page-taxpayer-dashboard" label="Taxpayer dashboard content">
    <if test="{phoneLayout}">
      <use template="taxpayer-dashboard-content" padding="16"/>
    </if>
    <else>
      <if test="{desktopLayout}">
        <use template="taxpayer-dashboard-content" padding="32"/>
      </if>
      <else>
        <use template="taxpayer-dashboard-content" padding="24"/>
      </else>
    </else>
  </scroll>
</template>
