<template name="taxpayer-calendar-weekday" args="label">
  <column height="28" main="center" cross="center" background="surface_subtle">
    <text text-alignment="center" foreground="text_muted">
      <span weight="bold">{label}</span>
    </text>
  </column>
</template>

<template name="taxpayer-calendar-empty" args="icon title body">
  <column height="154" padding="18" gap="8" main="center" cross="center" background="surface_subtle" radius="md">
    <icon name="{icon}" foreground="text_muted" width="22" height="22"/>
    <text><span weight="bold">{title}</span></text>
    <text wrap="true" text-alignment="center" foreground="text_muted">{body}</text>
  </column>
</template>

<template name="taxpayer-compact-calendar">
  <card padding="0">
    <column gap="0">
      <row padding="8" cross="center" gap="6">
        <button width="44" height="44" size="icon" variant="ghost" icon="chevron-left" label="Previous month" on-press="calendar_previous_month"></button>
        <text grow="1" text-alignment="center"><span weight="bold">{currentCalendarMonth} {currentCalendarYear}</span></text>
        <button width="44" height="44" size="icon" variant="ghost" icon="chevron-right" label="Next month" on-press="calendar_next_month"></button>
      </row>
      <separator/>
      <grid columns="7" gap="1" background="border">
        <use template="taxpayer-calendar-weekday" label="Sun"/>
        <use template="taxpayer-calendar-weekday" label="Mon"/>
        <use template="taxpayer-calendar-weekday" label="Tue"/>
        <use template="taxpayer-calendar-weekday" label="Wed"/>
        <use template="taxpayer-calendar-weekday" label="Thu"/>
        <use template="taxpayer-calendar-weekday" label="Fri"/>
        <use template="taxpayer-calendar-weekday" label="Sat"/>
        <for each="profileCalendarDays" key="id" as="cell">
          <column height="{profileCalendarDayHeight}" cross="stretch" background="surface_subtle">
            <if test="{cell.blank}">
              <spacer/>
            </if>
            <else>
              <column
                grow="1"
                padding="5"
                main="space_between"
                cross="stretch"
                background="surface"
                role="button"
                label="{cell.actionLabel}"
                selected="{cell.selected}"
                on-press="profile_calendar_select_day:{cell.day}">
                <if test="{cell.selected}">
                  <text text-alignment="end"><span weight="bold">{cell.dayLabel}</span></text>
                </if>
                <else>
                  <text text-alignment="end">{cell.dayLabel}</text>
                </else>
                <if test="{cell.hasDeadlines}">
                  <row grow="1" main="center" cross="center">
                    <if test="{cell.overdue}">
                      <text foreground="destructive">{cell.marker}</text>
                    </if>
                    <else>
                      <if test="{cell.dueSoon}">
                        <text foreground="warning">{cell.marker}</text>
                      </if>
                      <else>
                        <if test="{cell.approaching}">
                          <text foreground="success">{cell.marker}</text>
                        </if>
                        <else>
                          <text>{cell.marker}</text>
                        </else>
                      </else>
                    </else>
                  </row>
                </if>
              </column>
            </else>
          </column>
        </for>
      </grid>
    </column>
  </card>
</template>

<template name="taxpayer-calendar-section">
  <column gap="12">
    <row cross="center" gap="8">
      <text grow="1"><span weight="bold">{profileCalendarDeadlineHeading}</span></text>
      <badge variant="secondary">{profileCalendarDeadlineCount}</badge>
      <stack width="176">
        <select
          height="44"
          label="Tax calendar year"
          disabled="{profileCalendarYearPickerDisabled}"
          on-press="profile_calendar_toggle_year_picker">{profileCalendarYearLabel}</select>
        <if test="{profileCalendarYearPickerOpen}">
          <dropdown-menu
            anchor="below"
            anchor-alignment="stretch"
            anchor-offset="4"
            height="280"
            on-dismiss="profile_calendar_close_year_picker">
            <column padding="8" gap="8">
              <input
                height="40"
                text="{profileCalendarYearQueryValue}"
                placeholder="Filter years"
                label="Filter tax years"
                on-input="profile_calendar_year_query"/>
              <scroll height="190" label="Configured tax years">
                <column gap="4">
                  <for each="profileCalendarYearOptions" key="id" as="option">
                    <menu-item height="44" selected="{option.selected}" on-press="profile_calendar_select_year:{option.year}">{option.year}</menu-item>
                  </for>
                </column>
              </scroll>
            </column>
          </dropdown-menu>
        </if>
      </stack>
      <button height="44" variant="primary" icon="app:calendar" disabled="{profileCalendarExportBusy}" on-press="profile_calendar_export">Add to Calendar</button>
    </row>
    <use template="taxpayer-compact-calendar"/>
    <if test="{profileCalendarHasDeadlines}">
      <for each="profileCalendarDeadlineRows" key="id" as="deadline">
        <card padding="0">
          <row padding="12" gap="14" cross="center">
            <column width="58" gap="2" cross="center">
              <text text-alignment="center"><span weight="bold">{deadline.dateLabel}</span></text>
              <text text-alignment="center" foreground="text_muted">{deadline.yearLabel}</text>
            </column>
            <column width="1" height="54" background="border"></column>
            <column grow="1" gap="5">
              <row gap="8" cross="center">
                <badge variant="secondary">{deadline.displayFormNo}</badge>
                <badge variant="{deadline.deadlineTone}">{deadline.deadlineStatus}</badge>
                <badge variant="outline">{deadline.filingStatus}</badge>
              </row>
              <text><span weight="bold">{deadline.formName}</span></text>
              <text wrap="true" foreground="text_muted">Taxable period: {deadline.periodLabel}</text>
              <if test="{deadline.adjustmentVisible}">
                <text wrap="true" foreground="text_muted">{deadline.adjustmentLabel}</text>
              </if>
              <if test="{deadline.actionVisible}">
                <row main="end">
                  <button
                    height="36"
                    variant="outline"
                    on-press="open_profile_deadline:{deadline.id}">{deadline.actionLabel}</button>
                </row>
              </if>
            </column>
          </row>
        </card>
      </for>
    </if>
    <else>
      <use
        template="taxpayer-calendar-empty"
        icon="clock"
        title="No deadlines this month"
        body="This tax profile's active Forms Set has no resolved deadlines for the selected date or month."/>
    </else>
  </column>
</template>

<template name="taxpayer-form-filter-control">
  <stack>
    <select
      height="44"
      label="{profileFormsFilterAccessibleLabel}"
      on-press="profile_forms_toggle_filter_picker">{profileFormsFilterDisplayLabel}</select>
    <if test="{profileFormsFilterPickerOpen}">
      <dropdown-menu
        anchor="below"
        anchor-alignment="stretch"
        anchor-offset="4"
        height="430"
        on-dismiss="profile_forms_close_filter_picker">
        <column grow="1" padding="8" gap="8">
          <scroll grow="1" overscroll="none" label="Tax Form Library filters">
            <column gap="8">
              <if test="{managingProfileForms}">
                <column gap="4" role="group" label="Selection">
                  <text><span weight="bold">Selection</span></text>
                  <checkbox
                    height="44"
                    checked="{profileFormsFilterActiveSelected}"
                    disabled="{profileFormsFilterActiveLocked}"
                    text="Selected"
                    on-toggle="profile_forms_toggle_filter_active"/>
                  <checkbox
                    height="44"
                    checked="{profileFormsFilterInactiveSelected}"
                    disabled="{profileFormsFilterInactiveLocked}"
                    text="Not selected"
                    on-toggle="profile_forms_toggle_filter_inactive"/>
                </column>
                <separator/>
                <column gap="4" role="group" label="Capability">
                  <text><span weight="bold">Capability</span></text>
                  <checkbox
                    height="44"
                    checked="{profileFormsFilterEditorSelected}"
                    disabled="{profileFormsFilterEditorLocked}"
                    text="Editor available"
                    on-toggle="profile_forms_toggle_filter_editor"/>
                  <checkbox
                    height="44"
                    checked="{profileFormsFilterCalendarOnlySelected}"
                    disabled="{profileFormsFilterCalendarOnlyLocked}"
                    text="Calendar only"
                    on-toggle="profile_forms_toggle_filter_calendar_only"/>
                </column>
                <separator/>
              </if>
              <if test="{managingProfileForms}">
                <column gap="4" role="group" label="Filing cadence">
                  <text><span weight="bold">Filing cadence</span></text>
                  <checkbox height="44" checked="{profileFormsCadenceMonthlySelected}" disabled="{profileFormsCadenceMonthlyLocked}" text="Monthly" on-toggle="profile_forms_toggle_cadence_monthly"/>
                  <checkbox height="44" checked="{profileFormsCadenceQuarterlySelected}" disabled="{profileFormsCadenceQuarterlyLocked}" text="Quarterly" on-toggle="profile_forms_toggle_cadence_quarterly"/>
                  <checkbox height="44" checked="{profileFormsCadenceAnnualSelected}" disabled="{profileFormsCadenceAnnualLocked}" text="Annual" on-toggle="profile_forms_toggle_cadence_annual"/>
                  <checkbox height="44" checked="{profileFormsCadenceOnDemandSelected}" disabled="{profileFormsCadenceOnDemandLocked}" text="On-demand" on-toggle="profile_forms_toggle_cadence_on_demand"/>
                </column>
                <separator/>
                <column gap="4" role="group" label="Tax category">
                  <text><span weight="bold">Tax category</span></text>
                  <text wrap="true" foreground="text_muted">Leave all unchecked to show every category.</text>
                  <for each="profileFormsCategoryOptions" key="id" as="category">
                    <checkbox height="44" checked="{category.selected}" text="{category.text}" on-toggle="profile_forms_toggle_category:{category.id}"/>
                  </for>
                </column>
              </if>
              <if test="{browsingProfileForms}">
                <column gap="6" role="group" label="Monthly filing periods">
                  <text><span weight="bold">Monthly filings</span></text>
                  <grid columns="4" gap="4">
                    <for each="profileFormsMonthOptions" key="id" as="month">
                      <button height="44" variant="{month.variant}" selected="{month.selected}" label="{month.label}" on-press="profile_forms_toggle_month:{month.month}">{month.text}</button>
                    </for>
                  </grid>
                </column>
                <separator/>
                <column gap="6" role="group" label="Quarterly filing periods">
                  <text><span weight="bold">Quarterly filings</span></text>
                  <grid columns="4" gap="4">
                    <button height="44" variant="{profileFormsQuarter1Variant}" selected="{profileFormsQuarter1Selected}" label="Quarter 1" on-press="profile_forms_toggle_quarter_1">Q1</button>
                    <button height="44" variant="{profileFormsQuarter2Variant}" selected="{profileFormsQuarter2Selected}" label="Quarter 2" on-press="profile_forms_toggle_quarter_2">Q2</button>
                    <button height="44" variant="{profileFormsQuarter3Variant}" selected="{profileFormsQuarter3Selected}" label="Quarter 3" on-press="profile_forms_toggle_quarter_3">Q3</button>
                    <button height="44" variant="{profileFormsQuarter4Variant}" selected="{profileFormsQuarter4Selected}" label="Quarter 4" on-press="profile_forms_toggle_quarter_4">Q4</button>
                  </grid>
                </column>
                <text wrap="true" foreground="text_muted">Selected periods prefill the form. Reset filters restores every filing period.</text>
                <separator/>
                <column gap="4" role="group" label="Other filing types">
                  <text><span weight="bold">Other filing types</span></text>
                  <checkbox height="44" checked="{profileFormsCadenceAnnualSelected}" disabled="{profileFormsCadenceAnnualLocked}" text="Annual" on-toggle="profile_forms_toggle_cadence_annual"/>
                  <checkbox height="44" checked="{profileFormsCadenceOnDemandSelected}" disabled="{profileFormsCadenceOnDemandLocked}" text="On-demand" on-toggle="profile_forms_toggle_cadence_on_demand"/>
                </column>
                <if test="{profileFormsHasOnDemandFilters}">
                  <separator/>
                  <column gap="4" role="group" label="On-demand forms">
                    <text><span weight="bold">On-demand forms</span></text>
                    <text wrap="true" foreground="text_muted">Filter non-recurring filings by form.</text>
                    <for each="profileOnDemandFilterRows" key="id" as="option">
                      <checkbox
                        height="44"
                        checked="{option.selected}"
                        label="{option.selectionLabel}"
                        text="{option.label}"
                        on-toggle="profile_forms_toggle_on_demand_form:{option.id}"/>
                    </for>
                  </column>
                </if>
              </if>
            </column>
          </scroll>
          <separator/>
          <row gap="8" cross="center">
            <button grow="1" height="44" variant="ghost" on-press="profile_forms_reset_filters">Reset filters</button>
          </row>
        </column>
      </dropdown-menu>
    </if>
  </stack>
</template>

<template name="taxpayer-form-info-content" args="code title category cadence capability revision">
  <column>
    <row padding="16" gap="12" cross="center">
      <column grow="1" gap="4">
        <text><span weight="bold" scale="1.2">BIR Form {code}</span></text>
        <text wrap="true" foreground="text_muted">Form details</text>
      </column>
      <button
        width="40"
        height="40"
        size="icon"
        variant="ghost"
        icon="x"
        label="Close form details"
        on-press="profile_forms_close_info"></button>
    </row>
    <separator/>
    <column padding="16" gap="14">
      <column gap="4">
        <text size="sm" foreground="text_muted">DESCRIPTION</text>
        <text wrap="true">{title}</text>
      </column>
      <grid columns="2" gap="12">
        <column gap="4">
          <text size="sm" foreground="text_muted">TAX TYPE</text>
          <text><span weight="bold">{category}</span></text>
        </column>
        <column gap="4">
          <text size="sm" foreground="text_muted">FILING FREQUENCY</text>
          <text><span weight="bold">{cadence}</span></text>
        </column>
        <column gap="4">
          <text size="sm" foreground="text_muted">CATALOG REVISION</text>
          <text><span mono="true">{revision}</span></text>
        </column>
        <column gap="4">
          <text size="sm" foreground="text_muted">AVAILABILITY</text>
          <text><span weight="bold">{capability}</span></text>
        </column>
      </grid>
    </column>
  </column>
</template>

<template name="taxpayer-filing-period-tile" args="editor action_label action_id selected disabled label status status_color tile_width visible">
  <stack width="{tile_width}" height="48">
    <if test="{visible}">
      <panel width="{tile_width}" height="48" padding="0" selected="{selected}">
        <if test="{editor}">
          <column
            width="{tile_width}"
            height="48"
            padding="0"
            gap="1"
            main="center"
            cross="stretch"
            role="button"
            label="{action_label}"
            disabled="{disabled}"
            on-press="open_library_period:{action_id}">
            <text wrap="false" size="sm" text-alignment="center">{label}</text>
            <if test="{status_color == 'success'}"><text wrap="false" size="sm" text-alignment="center" foreground="success">{status}</text></if>
            <if test="{status_color == 'info'}"><text wrap="false" size="sm" text-alignment="center" foreground="info">{status}</text></if>
            <if test="{status_color == 'warning'}"><text wrap="false" size="sm" text-alignment="center" foreground="warning">{status}</text></if>
            <if test="{status_color == 'destructive'}"><text wrap="false" size="sm" text-alignment="center" foreground="destructive">{status}</text></if>
            <if test="{status_color == 'text_muted'}"><text wrap="false" size="sm" text-alignment="center" foreground="text_muted">{status}</text></if>
          </column>
        </if>
        <else>
          <column
            width="{tile_width}"
            height="48"
            padding="0"
            gap="1"
            main="center"
            cross="stretch"
            label="{action_label}"
            disabled="{disabled}">
            <text wrap="false" size="sm" text-alignment="center">{label}</text>
            <if test="{status_color == 'success'}"><text wrap="false" size="sm" text-alignment="center" foreground="success">{status}</text></if>
            <if test="{status_color == 'info'}"><text wrap="false" size="sm" text-alignment="center" foreground="info">{status}</text></if>
            <if test="{status_color == 'warning'}"><text wrap="false" size="sm" text-alignment="center" foreground="warning">{status}</text></if>
            <if test="{status_color == 'destructive'}"><text wrap="false" size="sm" text-alignment="center" foreground="destructive">{status}</text></if>
            <if test="{status_color == 'text_muted'}"><text wrap="false" size="sm" text-alignment="center" foreground="text_muted">{status}</text></if>
          </column>
        </else>
      </panel>
    </if>
    <else>
      <spacer width="{tile_width}" height="48"/>
    </else>
  </stack>
</template>

<template name="taxpayer-form-library-section">
  <column gap="16">
    <!--
      Browse mode owns this header. In the yearly setup workspace the year, the
      status, and the save actions all live beside the year combobox, so
      repeating them here would put two of each on one screen.
    -->
    <if test="{browsingProfileForms}">
      <if test="{profileFormsHeaderStacked}">
        <column gap="8">
          <row gap="10" cross="center">
            <column grow="1" gap="4">
              <text><span weight="bold">Tax Form Library</span></text>
              <text wrap="true" foreground="text_muted">{profileFormsCountLabel}</text>
            </column>
            <text width="72" text-alignment="center" foreground="text_muted"><span weight="bold">{profileFormsYearLabel}</span></text>
          </row>
        </column>
      </if>
      <else>
        <row gap="10" cross="center">
          <column grow="1" gap="4">
            <text><span weight="bold">Tax Form Library</span></text>
            <text wrap="true" foreground="text_muted">{profileFormsCountLabel}</text>
          </column>
          <text width="72" text-alignment="center" foreground="text_muted"><span weight="bold">{profileFormsYearLabel}</span></text>
        </row>
      </else>
    </if>
    <if test="{profileFormsHeaderStacked}">
      <column gap="8">
        <input
          height="44"
          text="{profileFormsSearchValue}"
          placeholder="Search by form code or title"
          label="Search Tax Form Library"
          on-input="profile_forms_search_input"/>
        <use template="taxpayer-form-filter-control"/>
      </column>
    </if>
    <else>
      <row gap="8" cross="center">
        <input
          grow="1"
          height="44"
          text="{profileFormsSearchValue}"
          placeholder="Search by form code or title"
          label="Search Tax Form Library"
          on-input="profile_forms_search_input"/>
        <column width="260">
          <use template="taxpayer-form-filter-control"/>
        </column>
      </row>
    </else>
    <if test="{managingProfileForms}">
      <if test="{profileFormsHeaderStacked}">
        <column gap="8">
          <button height="40" variant="outline" on-press="profile_forms_select_all">Select all 51</button>
          <button height="40" variant="outline" on-press="profile_forms_clear_all">Clear all</button>
          <if test="{profileFormsLegacyResetVisible}">
            <button height="40" variant="ghost" on-press="profile_forms_reset_legacy">Reset to catalog default</button>
          </if>
        </column>
      </if>
      <else>
        <row gap="8">
          <button height="40" variant="outline" on-press="profile_forms_select_all">Select all 51</button>
          <button height="40" variant="outline" on-press="profile_forms_clear_all">Clear all</button>
          <if test="{profileFormsLegacyResetVisible}">
            <button height="40" variant="ghost" on-press="profile_forms_reset_legacy">Reset to catalog default</button>
          </if>
        </row>
      </else>
      <!--
        Side by side the sentence wraps to two lines in a box sized for one
        once the badge has taken its width, so stack them where space is tight.
      -->
      <if test="{profileFormsHeaderStacked}">
        <column gap="6">
          <row>
            <badge variant="secondary">{profileFormsChangedCountLabel}</badge>
          </row>
          <text wrap="true" foreground="text_muted">Nothing is saved until you choose Save.</text>
        </column>
      </if>
      <else>
        <row gap="8" cross="center">
          <badge variant="secondary">{profileFormsChangedCountLabel}</badge>
          <text grow="1" wrap="true" foreground="text_muted">Nothing is saved until you choose Save.</text>
        </row>
      </else>
    </if>
    <if test="{profileFormRowsEmpty}">
      <if test="{browsingProfileForms}">
        <if test="{profileBrowseActiveEmpty}">
          <card padding="0">
            <column height="180" padding="24" gap="12" main="center" cross="center">
              <icon name="search" foreground="text_muted" width="28" height="28"/>
              <text text-alignment="center"><span weight="bold">No active forms</span></text>
              <text wrap="true" text-alignment="center" foreground="text_muted">Activate forms for this profile and tax year to add them to the library.</text>
              <text wrap="true" text-alignment="center" foreground="text_muted">Open Profile Settings → Tax Forms to activate a yearly form set.</text>
            </column>
          </card>
        </if>
        <else>
          <card padding="0">
            <column height="180" padding="24" gap="12" main="center" cross="center">
              <icon name="search" foreground="text_muted" width="28" height="28"/>
              <text text-alignment="center"><span weight="bold">No forms match these filters</span></text>
              <text wrap="true" text-alignment="center" foreground="text_muted">Try another search, month, quarter, or filing type.</text>
              <button height="44" variant="outline" on-press="profile_forms_reset_filters">Reset filters</button>
            </column>
          </card>
        </else>
      </if>
      <else>
        <use template="taxpayer-calendar-empty" icon="search" title="No matching catalog forms" body="Change the search, selection, capability, cadence, or tax-category filters."/>
      </else>
    </if>
    <else>
      <if test="{managingProfileForms}">
        <grid columns="{profileFormCardColumns}" gap="12">
          <for each="profileFormRows" key="id" as="form">
            <card padding="0" selected="{form.selected}">
              <row padding="14" gap="12" cross="start">
                <checkbox
                  checked="{form.selected}"
                  label="{form.selectionLabel}"
                  on-toggle="toggle_profile_form:{form.id}"/>
                <column grow="1" gap="8">
                  <row gap="8" cross="center">
                    <badge variant="secondary">{form.code}</badge>
                    <badge variant="{form.manageStatusTone}">{form.manageStatusLabel}</badge>
                  </row>
                  <text wrap="true">{form.title}</text>
                  <text wrap="true" foreground="text_muted">{form.categoryLabel} - {form.cadenceLabel}</text>
                  <text wrap="true" foreground="text_muted">{form.capability}</text>
                </column>
              </row>
            </card>
          </for>
        </grid>
      </if>
      <else>
        <grid columns="{profileFormCardColumns}" gap="12">
          <for each="profileFormRows" key="id" as="form">
            <card padding="0">
              <column padding="12" gap="10" cross="stretch">
                <row gap="8" cross="center">
                  <text grow="1"><span weight="bold" scale="1.25">{form.code}</span></text>
                  <text size="sm" foreground="text_muted">{form.filingProgress}</text>
                  <button
                    width="32"
                    height="32"
                    size="icon"
                    variant="ghost"
                    icon="info"
                    label="{form.infoLabel}"
                    on-press="profile_forms_show_info:{form.id}"></button>
                </row>
                <if test="{form.hasPeriodCells}">
                  <grid columns="{form.periodGridColumns}" gap="6">
                    <if test="{form.period1.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period1.actionLabel}" action_id="{form.period1.actionId}" selected="{form.period1.selected}" disabled="{form.period1.disabled}" label="{form.period1.label}" status="{form.period1.visualStatus}" visible="{form.period1.visible}" status_color="{form.period1.statusColor}" tile_width="{form.period1.tileWidth}"/></if>
                    <if test="{form.period2.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period2.actionLabel}" action_id="{form.period2.actionId}" selected="{form.period2.selected}" disabled="{form.period2.disabled}" label="{form.period2.label}" status="{form.period2.visualStatus}" visible="{form.period2.visible}" status_color="{form.period2.statusColor}" tile_width="{form.period2.tileWidth}"/></if>
                    <if test="{form.period3.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period3.actionLabel}" action_id="{form.period3.actionId}" selected="{form.period3.selected}" disabled="{form.period3.disabled}" label="{form.period3.label}" status="{form.period3.visualStatus}" visible="{form.period3.visible}" status_color="{form.period3.statusColor}" tile_width="{form.period3.tileWidth}"/></if>
                    <if test="{form.period4.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period4.actionLabel}" action_id="{form.period4.actionId}" selected="{form.period4.selected}" disabled="{form.period4.disabled}" label="{form.period4.label}" status="{form.period4.visualStatus}" visible="{form.period4.visible}" status_color="{form.period4.statusColor}" tile_width="{form.period4.tileWidth}"/></if>
                    <if test="{form.period5.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period5.actionLabel}" action_id="{form.period5.actionId}" selected="{form.period5.selected}" disabled="{form.period5.disabled}" label="{form.period5.label}" status="{form.period5.visualStatus}" visible="{form.period5.visible}" status_color="{form.period5.statusColor}" tile_width="{form.period5.tileWidth}"/></if>
                    <if test="{form.period6.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period6.actionLabel}" action_id="{form.period6.actionId}" selected="{form.period6.selected}" disabled="{form.period6.disabled}" label="{form.period6.label}" status="{form.period6.visualStatus}" visible="{form.period6.visible}" status_color="{form.period6.statusColor}" tile_width="{form.period6.tileWidth}"/></if>
                    <if test="{form.period7.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period7.actionLabel}" action_id="{form.period7.actionId}" selected="{form.period7.selected}" disabled="{form.period7.disabled}" label="{form.period7.label}" status="{form.period7.visualStatus}" visible="{form.period7.visible}" status_color="{form.period7.statusColor}" tile_width="{form.period7.tileWidth}"/></if>
                    <if test="{form.period8.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period8.actionLabel}" action_id="{form.period8.actionId}" selected="{form.period8.selected}" disabled="{form.period8.disabled}" label="{form.period8.label}" status="{form.period8.visualStatus}" visible="{form.period8.visible}" status_color="{form.period8.statusColor}" tile_width="{form.period8.tileWidth}"/></if>
                    <if test="{form.period9.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period9.actionLabel}" action_id="{form.period9.actionId}" selected="{form.period9.selected}" disabled="{form.period9.disabled}" label="{form.period9.label}" status="{form.period9.visualStatus}" visible="{form.period9.visible}" status_color="{form.period9.statusColor}" tile_width="{form.period9.tileWidth}"/></if>
                    <if test="{form.period10.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period10.actionLabel}" action_id="{form.period10.actionId}" selected="{form.period10.selected}" disabled="{form.period10.disabled}" label="{form.period10.label}" status="{form.period10.visualStatus}" visible="{form.period10.visible}" status_color="{form.period10.statusColor}" tile_width="{form.period10.tileWidth}"/></if>
                    <if test="{form.period11.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period11.actionLabel}" action_id="{form.period11.actionId}" selected="{form.period11.selected}" disabled="{form.period11.disabled}" label="{form.period11.label}" status="{form.period11.visualStatus}" visible="{form.period11.visible}" status_color="{form.period11.statusColor}" tile_width="{form.period11.tileWidth}"/></if>
                    <if test="{form.period12.available}"><use template="taxpayer-filing-period-tile" editor="{form.editorAvailable}" action_label="{form.period12.actionLabel}" action_id="{form.period12.actionId}" selected="{form.period12.selected}" disabled="{form.period12.disabled}" label="{form.period12.label}" status="{form.period12.visualStatus}" visible="{form.period12.visible}" status_color="{form.period12.statusColor}" tile_width="{form.period12.tileWidth}"/></if>
                  </grid>
                </if>
              </column>
            </card>
          </for>
        </grid>
      </else>
      <if test="{profileFormsPaginationVisible}">
        <row main="center" cross="center" gap="8">
          <button
            width="44"
            height="44"
            size="icon"
            variant="outline"
            icon="chevron-left"
            label="Previous forms"
            disabled="{profileFormsPreviousDisabled}"
            on-press="profile_forms_show_previous"></button>
          <text width="150" text-alignment="center" foreground="text_muted">{profileFormsPageLabel}</text>
          <button
            width="44"
            height="44"
            size="icon"
            variant="outline"
            icon="chevron-right"
            label="Next forms"
            disabled="{profileFormsNextDisabled}"
            on-press="profile_forms_show_more"></button>
        </row>
      </if>
    </else>
  </column>
</template>

<template name="taxpayer-dashboard-content" args="padding">
  <column padding="{padding}" gap="24">
    <if test="{constrainedLayout}">
      <row gap="12" cross="center">
        <avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
        <column grow="1" gap="5">
          <text size="heading" wrap="true">{selectedTaxpayerName}</text>
          <text wrap="true" foreground="text_muted">TIN: {selectedTaxpayerTin}</text>
          <text wrap="true" foreground="text_muted">Type: {selectedTaxpayerKind} - Tax Year {currentCalendarYear} - {selectedTaxpayerTaxType}</text>
        </column>
        <button
          width="44"
          height="44"
          size="icon"
          variant="outline"
          radius="xl"
          icon="settings"
          label="Profile Settings"
          on-press="show_profile_setup">
        </button>
      </row>
    </if>
    <else>
      <row gap="16" cross="center">
        <avatar label="{selectedTaxpayerName}">{selectedTaxpayerInitials}</avatar>
        <column grow="1" gap="6">
          <text size="heading">{selectedTaxpayerName}</text>
          <text wrap="true" foreground="text_muted">{selectedTaxpayerSummary}</text>
        </column>
        <button variant="outline" icon="settings" on-press="show_profile_setup">Profile Settings</button>
      </row>
    </else>

    <if test="{constrainedLayout}">
      <tabs gap="4" label="Dashboard view">
        <button
          height="44"
          variant="ghost"
          icon="app:calendar"
          selected="{dashboardCalendarActive}"
          on-press="show_dashboard_calendar">Calendar</button>
        <button
          height="44"
          variant="ghost"
          icon="folder-open"
          selected="{dashboardFormsActive}"
          on-press="show_dashboard_forms">Tax Form Library</button>
      </tabs>
    </if>
    <else>
      <tabs gap="4" label="Dashboard view">
        <button
          variant="ghost"
          icon="file-text"
          selected="{dashboardCalendarActive}"
          on-press="show_dashboard_calendar">Calendar</button>
        <button
          variant="ghost"
          icon="folder-open"
          selected="{dashboardFormsActive}"
          on-press="show_dashboard_forms">Tax Form Library</button>
      </tabs>
    </else>

    <if test="{dashboardCalendarActive}">
      <use template="taxpayer-calendar-section"/>
    </if>
    <if test="{dashboardFormsActive}">
      <use template="taxpayer-form-library-section"/>
    </if>
  </column>
</template>

<template name="taxpayer-dashboard-page">
  <scroll grow="1" global-key="page-taxpayer-dashboard" label="Taxpayer dashboard content">
    <if test="{phoneLayout}">
      <use template="taxpayer-dashboard-content" padding="16"/>
    </if>
    <else>
      <if test="{desktopLayout}">
        <use template="taxpayer-dashboard-content" padding="32"/>
      </if>
      <else>
        <use template="taxpayer-dashboard-content" padding="24"/>
      </else>
    </else>
  </scroll>
</template>
