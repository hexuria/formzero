<template name="admin-auth-content">
  <column gap="24" cross="center">
    <column gap="4" cross="center">
      <badge variant="outline">BIR</badge>
      <text size="display">e-BIRForms</text>
    </column>

    <column gap="6" cross="center">
      <text wrap="true" text-alignment="center" size="heading">Admin Access Required</text>
      <text wrap="true" text-alignment="center" foreground="text_muted">Enter App Lock PIN to access Background Tasks</text>
    </column>

    <input
      width="300"
      size="lg"
      placeholder="Enter 4-digit PIN"
      label="Administrator PIN"
    />

    <column width="300" gap="8">
      <button width="300" variant="outline" disabled="true">OS Auth Override</button>
      <button width="300" variant="ghost" on-press="go_back">Cancel</button>
    </column>
  </column>
</template>

<template name="admin-auth-overlay">
  <column grow="1" padding="16" main="center" cross="center" background="background">
    <if test="{phoneLayout}">
      <column gap="24" cross="center">
        <use template="admin-auth-content"/>
      </column>
    </if>
    <else>
      <column width="460" gap="24" cross="center">
        <use template="admin-auth-content"/>
      </column>
    </else>
  </column>
</template>
