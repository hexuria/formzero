<template name="profile-field" args="label grow=0">
  <column grow="{grow}" gap="6">
    <text>{label}</text>
    <slot/>
  </column>
</template>

<template name="profile-read-value" args="label value">
  <column gap="4">
    <text size="sm" foreground="text_muted">{label}</text>
    <text wrap="true">{value}</text>
  </column>
</template>

<template name="profile-tin-editor">
  <row gap="6" cross="center">
    <input grow="1" height="44" text="{profileTinSegmentOneValue}" placeholder="3 digits" label="TIN first three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentOneAutofocus}" on-input="profile_tin_segment_one_input"/>
    <text foreground="text_muted">-</text>
    <input grow="1" height="44" text="{profileTinSegmentTwoValue}" placeholder="3 digits" label="TIN second three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentTwoAutofocus}" on-input="profile_tin_segment_two_input"/>
    <text foreground="text_muted">-</text>
    <input grow="1" height="44" text="{profileTinSegmentThreeValue}" placeholder="3 digits" label="TIN third three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentThreeAutofocus}" on-input="profile_tin_segment_three_input"/>
    <text foreground="text_muted">-</text>
    <input grow="1" height="44" text="{profileTinSegmentBranchValue}" placeholder="5 digits" label="TIN five digit branch code" autofocus="{profileTinSegmentBranchAutofocus}" on-input="profile_tin_segment_branch_input"/>
  </row>
</template>

<template name="profile-rdo-editor">
  <column gap="4">
    <stack>
      <combobox height="44" text="{profileRdoQueryValue}" placeholder="Search code or city" label="Revenue District Office (RDO)" autofocus="{profileRdoAutofocus}" on-input="profile_rdo_query_input" on-press="profile_rdo_toggle_picker"/>
      <if test="{profileRdoPickerOpen}">
        <dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_rdo_close_picker">
          <column padding="4" gap="2">
            <for each="profileRdoOptionRows" key="id" as="option">
              <menu-item height="44" selected="{option.selected}" on-press="profile_rdo_select:{option.id}">{option.rowLabel}</menu-item>
            </for>
          </column>
        </dropdown-menu>
      </if>
    </stack>
    <if test="{profileRdoSelectionMissing}">
      <text wrap="true" foreground="warning">Choose an RDO from the filtered results.</text>
    </if>
  </column>
</template>

<template name="profile-setup-year-combobox-body">
  <column>
    <select
      height="44"
      label="Tax year for forms setup"
      on-press="profile_setup_toggle_year_picker">{profileSetupYearLabel}</select>
    <if test="{profileSetupYearPickerOpen}">
      <!--
        Wider than the compact trigger: a row states the year and what that
        year's setup is, and a truncated status would leave the user guessing
        which years still need setting up.
      -->
      <dropdown-menu
        anchor="below"
        anchor-alignment="end"
        anchor-offset="4"
        width="300"
        height="300"
        on-dismiss="profile_setup_close_year_picker">
        <column padding="8" gap="8">
          <input
            height="40"
            text="{profileSetupYearQueryValue}"
            placeholder="Type a year"
            label="Filter tax years"
            on-input="profile_setup_year_query"/>
          <if test="{profileSetupYearHelperVisible}">
            <text wrap="true" foreground="text_muted">{profileSetupYearHelperText}</text>
          </if>
          <scroll height="200" label="Tax years">
            <column gap="4">
              <for each="profileSetupYearOptions" key="id" as="option">
                <menu-item
                  height="44"
                  selected="{option.selected}"
                  label="{option.accessibleLabel}"
                  on-press="profile_setup_select_year:{option.year}">{option.rowLabel}</menu-item>
              </for>
            </column>
          </scroll>
        </column>
      </dropdown-menu>
    </if>
  </column>
</template>

<template name="profile-setup-year-combobox">
  <!--
    A four-digit year needs little room, so the control stays compact where
    there is space and fills the width only when the header has stacked and a
    narrow control would sit oddly alone on its own row.
  -->
  <column>
    <if test="{profileFormsHeaderStacked}">
      <stack>
        <use template="profile-setup-year-combobox-body"/>
      </stack>
    </if>
    <else>
      <stack width="176">
        <use template="profile-setup-year-combobox-body"/>
      </stack>
    </else>
  </column>
</template>

<template name="profile-setup-source-picker">
  <stack width="220">
    <select
      height="44"
      label="Change the year this setup copies from"
      on-press="profile_setup_toggle_source_picker">Change source</select>
    <if test="{profileSetupSourcePickerOpen}">
      <dropdown-menu
        anchor="below"
        anchor-alignment="stretch"
        anchor-offset="4"
        height="240"
        on-dismiss="profile_setup_close_source_picker">
        <scroll height="220" label="Years you can copy from">
          <column padding="8" gap="4">
            <for each="profileSetupSourceOptions" key="id" as="source">
              <menu-item
                height="44"
                selected="{source.selected}"
                label="{source.accessibleLabel}"
                on-press="profile_setup_draft_seed:{source.year}">{source.rowLabel}</menu-item>
            </for>
          </column>
        </scroll>
      </dropdown-menu>
    </if>
  </stack>
</template>

<template name="profile-setup-cor-card">
  <card padding="0">
    <row padding="14" gap="12" cross="center">
      <icon name="file-text" foreground="text_muted" width="22" height="22"/>
      <column grow="1" gap="4">
        <text><span weight="bold">Certificate of Registration</span></text>
        <text wrap="true" foreground="text_muted">{profileCorStatusLabel}</text>
      </column>
      <if test="{profileCorReviewAvailable}">
        <button
          height="44"
          variant="outline"
          on-press="profile_cor_begin_review">Review against COR</button>
      </if>
      <button
        height="44"
        variant="outline"
        icon="folder-open"
        disabled="{profileCorUploadDisabled}"
        on-press="profile_cor_upload">{profileCorActionLabel}</button>
    </row>
  </card>
</template>

<template name="profile-setup-cor-review">
  <card padding="0">
    <column padding="16" gap="12">
      <column gap="4">
        <text><span weight="bold">Review against the COR</span></text>
        <text wrap="true" foreground="text_muted">Type what the document says. Only the rows you accept are applied.</text>
      </column>

      <use template="profile-field" label="TIN shown on the COR">
        <input
          height="44"
          text="{profileCorReviewTinValue}"
          placeholder="000-000-000-000"
          label="TIN shown on the COR"
          on-input="profile_cor_tin_input"/>
      </use>

      <if test="{profileCorMismatchVisible}">
        <card padding="0">
          <column padding="12" gap="6">
            <text><span weight="bold">{profileCorMismatchLabel}</span></text>
            <text wrap="true" foreground="text_muted">Nothing here can be applied to this taxpayer.</text>
          </column>
        </card>
      </if>
      <else>
        <column gap="10">
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorRdoLabel}</text>
            <input height="44" text="{profileCorRdoValue}" placeholder="What the COR says" label="{profileCorRdoLabel}" on-input="profile_cor_rdo_input"/>
            <checkbox height="44" checked="{profileCorRdoAccepted}" text="Use this value" on-toggle="profile_cor_toggle_rdo"/>
          </column>
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorNameLabel}</text>
            <input height="44" text="{profileCorNameValue}" placeholder="What the COR says" label="{profileCorNameLabel}" on-input="profile_cor_name_input"/>
            <checkbox height="44" checked="{profileCorNameAccepted}" text="Use this value" on-toggle="profile_cor_toggle_name"/>
          </column>
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorAddressLabel}</text>
            <input height="44" text="{profileCorAddressValue}" placeholder="What the COR says" label="{profileCorAddressLabel}" on-input="profile_cor_address_input"/>
            <checkbox height="44" checked="{profileCorAddressAccepted}" text="Use this value" on-toggle="profile_cor_toggle_address"/>
          </column>
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorZipLabel}</text>
            <input height="44" text="{profileCorZipValue}" placeholder="What the COR says" label="{profileCorZipLabel}" on-input="profile_cor_zip_input"/>
            <checkbox height="44" checked="{profileCorZipAccepted}" text="Use this value" on-toggle="profile_cor_toggle_zip"/>
          </column>
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorTaxTypeLabel}</text>
            <input height="44" text="{profileCorTaxTypeValue}" placeholder="What the COR says" label="{profileCorTaxTypeLabel}" on-input="profile_cor_tax_type_input"/>
            <checkbox height="44" checked="{profileCorTaxTypeAccepted}" text="Use this value" on-toggle="profile_cor_toggle_tax_type"/>
          </column>
          <checkbox
            height="44"
            checked="{profileCorApplyFormsSelected}"
            text="{profileCorApplyFormsLabel}"
            on-toggle="profile_cor_toggle_apply_forms"/>
        </column>
      </else>

      <row gap="8">
        <button
          height="44"
          variant="outline"
          on-press="profile_cor_cancel_review">Cancel</button>
        <button
          height="44"
          variant="primary"
          disabled="{profileCorApplyDisabled}"
          on-press="profile_cor_apply">{profileCorApplyLabel}</button>
      </row>
    </column>
  </card>
</template>

<template name="profile-setup-content">
  <column gap="24">
    <if test="{profileInlineBackVisible}">
      <row gap="10" cross="start">
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="chevron-left"
          label="{profileBackLabel}"
          disabled="{profileInlineBackDisabled}"
          on-press="go_back">
        </button>
        <column grow="1" gap="6">
          <text size="heading">{profileEditorTitle}</text>
          <text wrap="true" foreground="text_muted">
            Reusable tax facts are versioned once and projected into each qualified
            form. Existing filing snapshots never change when a profile is revised.
          </text>
        </column>
      </row>
    </if>

    <tabs label="Profile setup sections">
      <button
        height="44"
        selected="{profileTaxActive}"
        on-press="show_profile_tax">
        Tax Profile
      </button>
      <button
        height="44"
        selected="{profileTaxFormsActive}"
        on-press="show_profile_tax_forms">
        Registration & Forms
      </button>
      <button
        height="44"
        selected="{profileEmailActive}"
        on-press="show_profile_email">
        Email Settings
      </button>
    </tabs>

    <if test="{profileDirtyNavigationVisible}">
      <card padding="0">
        <column padding="16" gap="10">
          <text><span weight="bold">{profileDirtyNavigationTitle}</span></text>
          <text wrap="true" foreground="text_muted">{profileDirtyNavigationBody}</text>
          <row gap="8">
            <button height="44" variant="primary" autofocus="true" on-press="profile_keep_editing">Stay and keep editing</button>
            <button height="44" variant="outline" on-press="profile_discard_navigation">Discard and continue</button>
          </row>
        </column>
      </card>
    </if>

    <if test="{profileCompletionVisible}">
      <card padding="0">
        <row padding="12" gap="10" cross="center">
          <badge variant="outline">Profile data required</badge>
          <text wrap="true" foreground="text_muted">{profileCompletionMessage}</text>
        </row>
      </card>
    </if>

    <if test="{profileTaxActive}">
      <column gap="24">
        <if test="{profileTaxViewing}">
          <column gap="20">
            <if test="{constrainedLayout}">
              <column gap="10">
                <column gap="4">
                  <text><span weight="bold">Saved tax profile</span></text>
                  <text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text>
                </column>
                <button height="44" variant="primary" on-press="edit_tax_profile">Edit Tax Profile</button>
              </column>
            </if>
            <else>
              <row gap="12" cross="center">
                <column grow="1" gap="4">
                  <text><span weight="bold">Saved tax profile</span></text>
                  <text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text>
                </column>
                <button height="44" variant="primary" on-press="edit_tax_profile">Edit Tax Profile</button>
              </row>
            </else>

            <if test="{profileFactsSummaryVisible}">
              <card padding="0">
                <column padding="14" gap="6">
                  <text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text>
                </column>
              </card>
            </if>

            <card padding="0">
              <column padding="18" gap="16">
                <column gap="4">
                  <text><span weight="bold">Identity and contact</span></text>
                  <text wrap="true" foreground="text_muted">Base facts shared by the taxpayer's forms.</text>
                </column>
                <grid columns="{profileReadColumns}" gap="16">
                  <use template="profile-read-value" label="Taxpayer Identification Number (TIN)" value="{profileTinDisplayValue}"/>
                  <use template="profile-read-value" label="Revenue District Office (RDO) code" value="{profileRdoDisplayValue}"/>
                  <use template="profile-read-value" label="Taxpayer Type" value="{profileSubjectKindLabel}"/>
                  <if test="{profileNaturalPersonClassificationVisible}">
                    <use template="profile-read-value" label="Tax Classification" value="{profileNaturalPersonClassificationLabel}"/>
                  </if>
                  <use template="profile-read-value" label="Taxpayer or registered name" value="{profileNameDisplayValue}"/>
                  <if test="{profileTradeNameVisible}">
                    <use template="profile-read-value" label="Trade name" value="{profileTradeNameDisplayValue}"/>
                  </if>
                  <use template="profile-read-value" label="Registered address" value="{profileAddressDisplayValue}"/>
                  <use template="profile-read-value" label="ZIP code" value="{profileZipDisplayValue}"/>
                  <use template="profile-read-value" label="Contact number" value="{profilePhoneDisplayValue}"/>
                  <use template="profile-read-value" label="Registered email address" value="{profileEmailDisplayValue}"/>
                </grid>
              </column>
            </card>

            <if test="{profileBusinessFieldsVisible}">
              <card padding="0">
                <column padding="18" gap="16">
                  <column gap="4">
                    <text><span weight="bold">Business registration</span></text>
                    <text wrap="true" foreground="text_muted">Registration-owned details used by forms that apply to this taxpayer.</text>
                  </column>
                  <grid columns="{profileReadColumns}" gap="16">
                    <use template="profile-read-value" label="EOPT Tier" value="{profileEoptTierLabel}"/>
                    <use template="profile-read-value" label="Primary Line of Business" value="{profilePrimaryLineOfBusinessDisplayValue}"/>
                  </grid>
                </column>
              </card>
            </if>

            <if test="{profilePersonalFieldsVisible}">
              <card padding="0">
                <column padding="18" gap="16">
                  <text><span weight="bold">Individual details</span></text>
                  <grid columns="{profileReadColumns}" gap="16">
                    <use template="profile-read-value" label="Birth date" value="{profileBirthDateDisplayValue}"/>
                    <use template="profile-read-value" label="Citizenship" value="{profileCitizenshipDisplayValue}"/>
                    <use template="profile-read-value" label="Foreign tax number" value="{profileForeignTaxNumberDisplayValue}"/>
                  </grid>
                </column>
              </card>
            </if>

            <card padding="0">
              <column padding="18" gap="8">
                <text><span weight="bold">Effective date</span></text>
                <use template="profile-read-value" label="Details effective from" value="{profileEffectiveFromDisplayValue}"/>
              </column>
            </card>
          </column>
        </if>
        <else>
        <if test="{profileBranchMode}">
          <card padding="0">
            <column padding="14" gap="6">
              <text><span weight="bold">{profileBranchBannerTitle}</span></text>
              <text wrap="true" foreground="text_muted">{profileBranchBannerBody}</text>
              <text wrap="true" foreground="text_muted">{profileBranchCopyNote}</text>
            </column>
          </card>
        </if>

        <if test="{profileFactsSummaryVisible}">
          <card padding="0">
            <column padding="14" gap="6">
              <text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text>
              <if test="{profileFactsMissingVisible}">
                <text wrap="true" foreground="text_muted">{profileFactsMissingHelpText}</text>
              </if>
            </column>
          </card>
        </if>

        <column gap="16">
            <column gap="4">
              <text><span weight="bold">Identity and registration</span></text>
              <text wrap="true" foreground="text_muted">
                TIN, RDO, registered name, and Taxpayer Type identify this immutable
                profile revision.
              </text>
            </column>

            <grid columns="{profileReadColumns}" gap="12">
              <use template="profile-field" label="Taxpayer Identification Number (TIN)"><use template="profile-tin-editor"/></use>
              <use template="profile-field" label="Revenue District Office (RDO)"><use template="profile-rdo-editor"/></use>
            </grid>
            <if test="{profileTinInvalidVisible}">
              <text wrap="true" foreground="destructive">{profileTinValidationMessage}</text>
            </if>

            <column gap="8">
              <text>Taxpayer Type</text>
              <stack>
                <select
                  height="44"
                  label="Taxpayer Type"
                  disabled="{profileBranchMode}"
                  on-press="toggle_profile_subject_picker">{profileSubjectKindLabel}</select>
                <if test="{profileSubjectPickerOpen}">
                  <dropdown-menu
                    anchor="below"
                    anchor-alignment="stretch"
                    on-dismiss="close_profile_subject_picker">
                    <menu-item height="44" disabled="{profileBranchMode}" selected="{profileIndividualSelected}" on-press="profile_subject_individual">Individual</menu-item>
                    <menu-item height="44" disabled="{profileBranchMode}" selected="{profileCorporationSelected}" on-press="profile_subject_corporation">Corporation</menu-item>
                    <menu-item height="44" disabled="{profileBranchMode}" selected="{profilePartnershipSelected}" on-press="profile_subject_partnership">Partnership</menu-item>
                    <menu-item height="44" disabled="{profileBranchMode}" selected="{profileCooperativeSelected}" on-press="profile_subject_cooperative">Cooperative</menu-item>
                    <menu-item height="44" disabled="{profileBranchMode}" selected="{profileEstateSelected}" on-press="profile_subject_estate">Estate</menu-item>
                    <menu-item height="44" disabled="{profileBranchMode}" selected="{profileTrustSelected}" on-press="profile_subject_trust">Trust</menu-item>
                    <menu-item height="44" disabled="{profileBranchMode}" selected="{profileOtherLegalSelected}" on-press="profile_subject_other_legal">Other Legal Entity</menu-item>
                  </dropdown-menu>
                </if>
              </stack>
            </column>

            <if test="{profileNaturalPersonClassificationVisible}">
              <column gap="8">
                <text>Tax Classification</text>
                <text wrap="true" foreground="text_muted">
                  Individual is the Taxpayer Type. Classification records
                  whether this person earns compensation, business/professional
                  income, or both.
                </text>
                <if test="{profileClassificationUnknownSelected}">
                  <text wrap="true" foreground="warning">Choose a Tax Classification before saving this profile.</text>
                </if>
                <stack>
                  <select
                    height="44"
                    label="Tax Classification"
                    on-press="toggle_profile_classification_picker">{profileNaturalPersonClassificationLabel}</select>
                  <if test="{profileClassificationPickerOpen}">
                    <dropdown-menu
                      anchor="below"
                      anchor-alignment="stretch"
                      on-dismiss="close_profile_classification_picker">
                      <menu-item height="44" selected="{profilePureCompensationSelected}" on-press="profile_classification_pure_compensation">Purely Compensation</menu-item>
                      <menu-item height="44" selected="{profileSelfEmployedSelected}" on-press="profile_classification_self_employed">Self-Employed / Professional</menu-item>
                      <menu-item height="44" selected="{profileMixedIncomeSelected}" on-press="profile_classification_mixed_income">Mixed Income</menu-item>
                    </dropdown-menu>
                  </if>
                </stack>
              </column>
            </if>

            <use template="profile-field" label="Taxpayer or registered name">
              <input
                height="44"
                text="{profileNameValue}"
                placeholder="Registered taxpayer name"
                label="Taxpayer or registered name"
                autofocus="{profileNameAutofocus}"
                on-input="profile_name_input"/>
            </use>
            <if test="{profileTradeNameVisible}">
              <use template="profile-field" label="Trade name">
                <input
                  height="44"
                  text="{profileTradeNameValue}"
                  placeholder="Optional DTI or registered trade name"
                  label="Trade name"
                  on-input="profile_trade_name_input"/>
              </use>
            </if>
            <use template="profile-field" label="Registered address">
              <input
                height="44"
                text="{profileAddressValue}"
                placeholder="Registered address"
                label="Registered address"
                autofocus="{profileAddressAutofocus}"
                on-input="profile_address_input"/>
            </use>

            <grid columns="{profileReadColumns}" gap="12">
              <use template="profile-field" label="ZIP code"><input height="44" text="{profileZipValue}" placeholder="ZIP code" label="ZIP code" autofocus="{profileZipAutofocus}" on-input="profile_zip_input"/></use>
              <use template="profile-field" label="Contact number"><input height="44" text="{profilePhoneValue}" placeholder="+63 900 000 0000" label="Contact number" autofocus="{profilePhoneAutofocus}" on-input="profile_phone_input"/></use>
            </grid>

            <use template="profile-field" label="Registered email address">
              <input height="44" text="{profileEmailValue}" placeholder="name@example.com" label="Registered email address" autofocus="{profileEmailAutofocus}" on-input="profile_email_input"/>
            </use>
        </column>

        <if test="{profileBusinessFieldsVisible}">
          <column gap="16">
            <column gap="4">
              <text><span weight="bold">Business registration</span></text>
              <text wrap="true" foreground="text_muted">
                The primary activity and EOPT Tier belong to Registration and
                are saved together with this Tax Profile.
              </text>
            </column>
            <if test="{profileRegistrationLoadFailureVisible}">
              <text wrap="true" foreground="destructive">Registration details could not be loaded. Retry before saving this Tax Profile.</text>
            </if>
            <else>
              <column gap="8">
                <text>EOPT Tier</text>
                <if test="{profileEoptTierMissing}">
                  <text wrap="true" foreground="warning">Choose the taxpayer's EOPT Tier before saving.</text>
                </if>
                <stack>
                  <select
                    height="44"
                    label="EOPT Tier"
                    on-press="toggle_profile_eopt_picker">{profileEoptTierLabel}</select>
                  <if test="{profileEoptPickerOpen}">
                    <dropdown-menu
                      anchor="below"
                      anchor-alignment="stretch"
                      on-dismiss="close_profile_eopt_picker">
                      <menu-item height="44" selected="{profileEoptMicroSelected}" on-press="profile_eopt_micro">Micro</menu-item>
                      <menu-item height="44" selected="{profileEoptSmallSelected}" on-press="profile_eopt_small">Small</menu-item>
                      <menu-item height="44" selected="{profileEoptMediumSelected}" on-press="profile_eopt_medium">Medium</menu-item>
                      <menu-item height="44" selected="{profileEoptLargeSelected}" on-press="profile_eopt_large">Large</menu-item>
                    </dropdown-menu>
                  </if>
                </stack>
              </column>
              <use template="profile-field" label="Primary Line of Business">
                <input
                  height="44"
                  text="{profilePrimaryLineOfBusinessValue}"
                  placeholder="Primary registered business activity"
                  label="Primary Line of Business"
                  on-input="profile_primary_line_of_business_input"/>
              </use>
              <if test="{profilePrimaryLineOfBusinessMissing}">
                <text wrap="true" foreground="warning">Enter the primary Line of Business before saving.</text>
              </if>
              <text wrap="true" foreground="text_muted">Manage additional business activities under Registration & Forms.</text>
            </else>
          </column>
        </if>

        <if test="{profilePersonalFieldsVisible}">
          <column gap="16">
            <column gap="4">
              <text><span weight="bold">Individual capabilities</span></text>
              <text wrap="true" foreground="text_muted">
                Leave fields empty when they do not truthfully apply. Forms
                requiring a missing capability will reject this profile.
              </text>
            </column>
            <grid columns="{profileReadColumns}" gap="12">
              <use template="profile-field" label="Birth date"><input height="44" text="{profileBirthDateValue}" placeholder="YYYY-MM-DD" label="Birth date" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileBirthDateAutofocus}" on-input="profile_birth_date_input"/></use>
              <use template="profile-field" label="Citizenship"><input height="44" text="{profileCitizenshipValue}" placeholder="Citizenship" label="Citizenship" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileCitizenshipAutofocus}" on-input="profile_citizenship_input"/></use>
            </grid>
            <use template="profile-field" label="Foreign tax number">
              <input
                height="44"
                text="{profileForeignTaxNumberValue}"
                placeholder="Optional foreign tax identifier"
                label="Foreign tax number"
                disabled="{profilePersonalFieldsDisabled}"
                autofocus="{profileForeignTaxNumberAutofocus}"
                on-input="profile_foreign_tax_number_input"/>
            </use>
          </column>
        </if>

        <column gap="16">
            <column gap="4">
              <text><span weight="bold">When this applies</span></text>
              <text wrap="true" foreground="text_muted">{profileEffectiveDateHelp}</text>
            </column>

            <if test="{profileChangeControlsVisible}">
              <grid columns="{profileReadColumns}" gap="8">
                <button height="44" variant="outline" selected="{profileRecordChangeSelected}" on-press="profile_record_change">Record a change</button>
                <button height="44" variant="outline" selected="{profileFixMistakeSelected}" on-press="profile_fix_mistake">Fix a mistake</button>
              </grid>
            </if>

            <use template="profile-field" label="{profileEffectiveDateLabel}">
              <input
                height="44"
                text="{profileEffectiveFromValue}"
                placeholder="YYYY-MM-DD"
                label="{profileEffectiveDateLabel}"
                on-input="profile_effective_from_input"/>
            </use>

            <text wrap="true" foreground="text_muted">{profileIdentityLockNote}</text>

            <use template="profile-field" label="Applies until">
              <input height="44" text="{profileEffectiveUntilValue}" placeholder="YYYY-MM-DD or empty" label="Applies until" on-input="profile_effective_until_input"/>
            </use>
        </column>
        </else>
      </column>
    </if>

    <if test="{profileTaxFormsActive}">
      <column gap="16">
        <if test="{profileFormsHeaderStacked}">
          <column gap="10">
            <column gap="4">
              <text><span weight="bold">Registration & Forms</span></text>
              <text wrap="true" foreground="text_muted">
                Choose which BIR forms apply to this taxpayer in each tax year.
              </text>
            </column>
            <use template="profile-setup-year-combobox"/>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <column grow="1" gap="4">
              <text><span weight="bold">Registration & Forms</span></text>
              <text wrap="true" foreground="text_muted">
                Choose which BIR forms apply to this taxpayer in each tax year.
              </text>
            </column>
            <use template="profile-setup-year-combobox"/>
          </row>
        </else>

        <if test="{editingNewProfile}">
          <card padding="0">
            <column padding="20" gap="6">
              <text><span weight="bold">Save this taxpayer first</span></text>
              <text wrap="true" foreground="text_muted">
                Yearly forms belong to a saved taxpayer. Save this taxpayer,
                then return here to choose its forms.
              </text>
            </column>
          </card>
        </if>
        <else>
          <if test="{regLoadFail}">
            <card padding="0"><column padding="16" gap="10"><text><span weight="bold">Registration unavailable</span></text><button height="44" variant="outline" on-press="reg_retry">Try again</button></column></card>
          </if>
          <if test="{regContent}">
            <card padding="0">
              <column padding="16" gap="14">
                <column gap="4"><text><span weight="bold">Registration</span></text><text wrap="true" foreground="text_muted">Reusable, effective-dated activities and tax obligations.</text></column>
                <if test="{regEditing}"><column gap="8"><button height="44" variant="primary" disabled="{regSaveDisabled}" on-press="reg_save">Save Registration</button><button height="44" variant="outline" disabled="{regCancelDisabled}" on-press="reg_cancel">Cancel</button></column></if>
                <else><if test="{regEditVisible}"><button height="44" variant="outline" on-press="reg_edit">Edit Registration</button></if></else>
                <if test="{regErrVisible}"><text wrap="true" foreground="destructive">{regErrText}</text></if>
                <if test="{regConflict}"><card padding="0"><column padding="12" gap="8"><text><span weight="bold">Newer revision saved</span></text><button height="44" variant="outline" on-press="reg_conflict_accept">Keep my draft</button><button height="44" variant="outline" on-press="reg_conflict_reload">Reload saved</button></column></card></if>
                <if test="{regActVisible}">
                  <column gap="8"><row gap="8" cross="center"><text grow="1"><span weight="bold">Activities</span></text><if test="{regEditing}"><button height="44" variant="outline" disabled="{regAddActDisabled}" on-press="reg_add_act">Add activity</button></if></row>
                    <if test="{regActEmpty}"><text foreground="text_muted">No activity recorded.</text></if>
                    <for each="regActRows" key="id" as="activity"><card padding="0"><column padding="12" gap="6"><text><span weight="bold">{activity.lineOfBusiness}</span></text><text foreground="text_muted">ATC: {activity.atcLabel} - {activity.effectiveLabel}</text><if test="{regEditing}"><row gap="8"><button height="44" variant="outline" on-press="reg_edit_act:{activity.id}">Edit</button><button height="44" variant="ghost" on-press="reg_remove_act:{activity.id}">Remove</button></row></if></column></card></for>
                  </column>
                </if>
                <if test="{regObVisible}">
                  <column gap="8"><row gap="8" cross="center"><text grow="1"><span weight="bold">Tax obligations</span></text><if test="{regEditing}"><button height="44" variant="outline" disabled="{regAddObDisabled}" on-press="reg_add_ob">Add obligation</button></if></row>
                    <if test="{regObEmpty}"><text foreground="text_muted">None recorded.</text></if>
                    <for each="regObRows" key="id" as="obligation"><card padding="0"><column padding="12" gap="6"><text><span weight="bold">{obligation.kindLabel}</span></text><text foreground="text_muted">{obligation.effectiveLabel}</text><if test="{regEditing}"><row gap="8"><button height="44" variant="outline" on-press="reg_edit_ob:{obligation.id}">Edit</button><button height="44" variant="ghost" on-press="reg_remove_ob:{obligation.id}">Remove</button></row></if></column></card></for>
                  </column>
                </if>
                <if test="{regFactsVisible}"><column gap="8"><text><span weight="bold">Other confirmed registration facts</span></text><grid columns="{profileReadColumns}" gap="8"><for each="regFactRows" key="id" as="fact"><use template="profile-read-value" label="{fact.label}" value="{fact.value}"/></for></grid></column></if>
                <if test="{regReview}"><text wrap="true" foreground="warning">{regReviewLabel}</text></if>
                <if test="{regDialog}">
                  <card padding="0"><column padding="14" gap="10"><text><span weight="bold">{regDialogTitle}</span></text>
                    <if test="{regActivityDialog}"><input height="44" text="{regLine}" placeholder="Line of business" label="Line of business" on-input="reg_line_input"/><input height="44" text="{regAtcValue}" placeholder="Optional ATC, for example PT010" label="Alphanumeric Tax Code" on-input="reg_atc_input"/></if>
                    <else><grid columns="{profileReadColumns}" gap="8"><button height="44" variant="outline" selected="{regIncome}" on-press="reg_kind_income_tax">Income tax</button><button height="44" variant="outline" selected="{regVat}" on-press="reg_kind_vat">VAT</button><button height="44" variant="outline" selected="{regPct}" on-press="reg_kind_percentage_tax">Percentage tax</button><button height="44" variant="outline" selected="{regWhComp}" on-press="reg_kind_wh_comp">Withholding - compensation</button><button height="44" variant="outline" selected="{regWhExpanded}" on-press="reg_kind_wh_expanded">Withholding - expanded</button><button height="44" variant="outline" selected="{regWhFinal}" on-press="reg_kind_wh_final">Withholding - final</button><button height="44" variant="outline" selected="{regWhOther}" on-press="reg_kind_wh_other">Other withholding</button></grid><if test="{regOtherVisible}"><input height="44" text="{regOtherValue}" placeholder="Registered withholding type" label="Other withholding type" on-input="reg_other_input"/></if></else>
                    <input height="44" text="{regFrom}" placeholder="YYYY-MM-DD" label="Effective from" on-input="reg_from_input"/><input height="44" text="{regUntil}" placeholder="Optional YYYY-MM-DD" label="Effective until" on-input="reg_until_input"/>
                    <row gap="8"><button height="44" variant="outline" on-press="reg_dialog_cancel">Cancel</button><button height="44" variant="primary" on-press="reg_dialog_save">Apply</button></row>
                  </column></card>
                </if>
              </column>
            </card>
          </if>
          <use template="profile-setup-cor-card"/>
          <if test="{profileCorReviewOpen}">
            <use template="profile-setup-cor-review"/>
          </if>

          <if test="{profileSetupPendingSwitchVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupPendingSwitchTitle}</span></text>
                <text wrap="true" foreground="text_muted">{profileSetupPendingSwitchBody}</text>
                <row gap="8">
                  <button
                    height="44"
                    variant="primary"
                    autofocus="true"
                    on-press="profile_setup_cancel_year_switch">Keep editing</button>
                  <button
                    height="44"
                    variant="outline"
                    on-press="profile_setup_confirm_year_switch">Discard changes</button>
                </row>
              </column>
            </card>
          </if>

          <if test="{profileSetupOpenFailedVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupStatusLabel}</span></text>
                <row>
                  <button
                    height="44"
                    variant="outline"
                    on-press="profile_setup_retry_year">Try again</button>
                </row>
              </column>
            </card>
          </if>
          <else>
            <text wrap="true" foreground="text_muted">{profileSetupStatusLabel}</text>
          </else>

          <if test="{profileSetupConflictVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupConflictTitle}</span></text>
                <text wrap="true" foreground="text_muted">
                  Your choices are still here. Review the saved setup, then keep
                  or change it.
                </text>
                <row gap="8">
                  <button
                    height="44"
                    variant="primary"
                    on-press="profile_setup_conflict_review">{profileSetupConflictReviewLabel}</button>
                  <button
                    height="44"
                    variant="outline"
                    on-press="profile_setup_conflict_discard">Discard my draft</button>
                </row>
              </column>
            </card>
          </if>

          <if test="{profileSetupDraftBannerVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupDraftTitle}</span></text>
                <if test="{profileSetupDraftChoiceVisible}">
                  <column gap="8">
                    <text wrap="true" foreground="text_muted">
                      Start from scratch, or copy the forms you already set up
                      for another year.
                    </text>
                    <if test="{profileFormsHeaderStacked}">
                      <column gap="8">
                        <button
                          height="44"
                          variant="outline"
                          on-press="profile_setup_draft_empty">Start empty</button>
                        <if test="{profileSetupSeedAvailable}">
                          <button
                            height="44"
                            variant="primary"
                            on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button>
                        </if>
                      </column>
                    </if>
                    <else>
                      <row gap="8">
                        <button
                          height="44"
                          variant="outline"
                          on-press="profile_setup_draft_empty">Start empty</button>
                        <if test="{profileSetupSeedAvailable}">
                          <button
                            height="44"
                            variant="primary"
                            on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button>
                        </if>
                      </row>
                    </else>
                  </column>
                </if>
                <if test="{profileSetupSeededVisible}">
                  <column gap="8">
                    <text><span weight="bold">{profileSetupSourceLabel}</span></text>
                    <text wrap="true" foreground="text_muted">{profileSetupSourceSummary}</text>
                    <use template="profile-setup-source-picker"/>
                  </column>
                </if>
                <text wrap="true" foreground="text_muted">{profileSetupInheritanceNote}</text>
                <text wrap="true" foreground="text_muted">
                  Filings, drafts, payments, deadlines, COR files, and email
                  settings never copy between years.
                </text>
              </column>
            </card>
          </if>

          <if test="{profileSetupBrowseVisible}">
            <column gap="16">
              <row main="end">
                <button
                  height="44"
                  variant="outline"
                  icon="settings"
                  on-press="profile_forms_manage">Manage Forms</button>
              </row>
              <!-- @include-template taxpayer-form-library-section -->
            </column>
          </if>

          <!--
            The actions sit above the catalog, not after it. Fifty-one form
            cards do not paginate while managing, so a footer button would be
            a long scroll away from the choices it commits.
          -->
          <if test="{profileSetupManagerVisible}">
            <if test="{profileSetupScopeVisible}">
              <column gap="10">
                <text><span weight="bold">When does this apply?</span></text>
                <if test="{constrainedLayout}">
                  <column gap="8">
                    <button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button>
                    <button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button>
                  </column>
                </if>
                <else>
                  <row gap="8">
                    <button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button>
                    <button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button>
                  </row>
                </else>
                <if test="{profileSetupScopeDateVisible}">
                  <use template="profile-field" label="Change takes effect">
                    <input
                      height="44"
                      text="{profileSetupChangeDateValue}"
                      placeholder="YYYY-MM-DD"
                      label="Change takes effect"
                      on-input="profile_setup_change_date_input"/>
                  </use>
                  <text wrap="true" foreground="text_muted">Records that this year's forms changed on that date. Deadlines and the tax calendar still follow the year's saved setup.</text>
                </if>
              </column>
            </if>
            <if test="{profileSetupZeroFormsHelperVisible}">
              <text wrap="true" foreground="text_muted">{profileSetupZeroFormsHelperText}</text>
            </if>
            <if test="{profileSetupDeactivationWarningVisible}">
              <card padding="0"><column padding="12" gap="6"><text><span weight="bold">Confirm deactivation on Save</span></text><text wrap="true" foreground="text_muted">{profileSetupDeactivationWarningText}</text></column></card>
            </if>
            <if test="{profileFormsHeaderStacked}">
              <column gap="10">
                <button
                  height="44"
                  variant="primary"
                  icon="save"
                  disabled="{profileSetupPrimaryDisabled}"
                  on-press="profile_setup_save">{profileSetupPrimaryLabel}</button>
                <button
                  height="44"
                  variant="outline"
                  disabled="{profileFormsCancelDisabled}"
                  on-press="profile_forms_cancel">Cancel</button>
              </column>
            </if>
            <else>
              <row main="end" gap="12">
                <button
                  height="44"
                  variant="outline"
                  disabled="{profileFormsCancelDisabled}"
                  on-press="profile_forms_cancel">Cancel</button>
                <button
                  height="44"
                  variant="primary"
                  icon="save"
                  disabled="{profileSetupPrimaryDisabled}"
                  on-press="profile_setup_save">{profileSetupPrimaryLabel}</button>
              </row>
            </else>
            <if test="{profileSetupChangesVisible}">
              <column gap="8">
                <row>
                  <button
                    height="44"
                    variant="ghost"
                    icon="chevron-right"
                    on-press="profile_setup_toggle_changes_disclosure">{profileSetupChangesDisclosureLabel}</button>
                </row>
                <if test="{profileSetupChangesExpandedVisible}">
                  <column gap="8">
                    <for each="profileSetupChangeRows" key="id" as="change">
                      <card padding="0">
                        <row padding="12" gap="12" cross="center">
                          <column grow="1" gap="2">
                            <text><span weight="bold">{change.rangeLabel}</span></text>
                            <text foreground="text_muted">{change.formsLabel}</text>
                          </column>
                          <if test="{change.todayBadgeVisible}">
                            <badge variant="secondary">Covers today</badge>
                          </if>
                        </row>
                      </card>
                    </for>
                    <text wrap="true" foreground="text_muted">Recorded for reference. Deadlines and the calendar keep following the year's saved setup.</text>
                  </column>
                </if>
              </column>
            </if>
            <!-- @include-template taxpayer-form-library-section -->
          </if>

          <if test="{profileSetupYearsDisclosureVisible}">
            <column gap="8">
              <row>
                <button
                  height="44"
                  variant="ghost"
                  icon="chevron-right"
                  on-press="profile_setup_toggle_years_disclosure">{profileSetupYearsDisclosureLabel}</button>
              </row>
              <if test="{profileSetupYearsExpandedVisible}">
                <column gap="8">
                  <for each="profileFormSetRows" key="id" as="set">
                    <card padding="0">
                      <row padding="12" gap="12" cross="center">
                        <text width="60" text-alignment="center"><span weight="bold">{set.yearLabel}</span></text>
                        <column width="1" height="36" background="border"></column>
                        <column grow="1" gap="2">
                          <text foreground="text_muted">{set.formsLabel}</text>
                        </column>
                        <badge variant="secondary">{set.stateLabel}</badge>
                        <button
                          height="44"
                          variant="outline"
                          on-press="profile_setup_select_year:{set.tax_year}">Open</button>
                      </row>
                    </card>
                  </for>
                </column>
              </if>
            </column>
          </if>
        </else>
      </column>
    </if>

    <if test="{profileEmailActive}">
      <column gap="12">
          <text><span weight="bold">Email monitoring credentials</span></text>
          <text wrap="true" foreground="text_muted">
            Mailbox credentials are operational secrets, not reusable tax
            facts. They are not stored in the tax-profile revision tables.
          </text>
          <button height="44" variant="outline" icon="send" disabled="true">Configure secure mailbox connection</button>
      </column>
    </if>

    <if test="{profileEditorActionsVisible}">
      <grid columns="{profileReadColumns}" gap="10">
        <button height="44" variant="outline" disabled="{profileCancelDisabled}" on-press="cancel_profile_edit">Cancel changes</button>
        <button
          height="44"
          variant="primary"
          icon="save"
          disabled="{profileSaveDisabled}"
          on-press="save_profile">
          {profileSaveLabel}
        </button>
      </grid>
    </if>
  </column>
</template>

<template name="profile-setup-page">
  <scroll grow="1" global-key="page-profile-setup" label="Taxpayer profile setup content">
    <if test="{phoneLayout}">
      <column padding="16">
        <use template="profile-setup-content"/>
      </column>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column padding="20">
          <use template="profile-setup-content"/>
        </column>
      </if>
      <else>
        <column padding="32">
          <use template="profile-setup-content"/>
        </column>
      </else>
    </else>
  </scroll>
</template>
