<template name="profile-field" args="label grow=0">
  <column grow="{grow}" gap="6">
    <text>{label}</text>
    <slot/>
  </column>
</template>

<template name="profile-read-value" args="label value">
  <column gap="4">
    <text size="sm" foreground="text_muted">{label}</text>
    <text wrap="true">{value}</text>
  </column>
</template>

<template name="registration-action-feedback" args="visible">
  <column>
    <if test="{visible}">
      <alert text="{regActionHeading}">
        <text wrap="true">{regActionLabel}</text>
      </alert>
    </if>
  </column>
</template>

<template name="registration-create-taxpayer" args="action">
  <column gap="12">
    <grid columns="{profileReadColumns}" gap="12">
      <column gap="6">
        <text>Nine-digit TIN root</text>
        <input height="44" text="{regTinRootInputValue}" placeholder="e.g. 123456789" label="Nine-digit TIN root" disabled="{regCanonicalMutationsDisabled}" on-input="reg_tin_root_input"/>
      </column>
      <column gap="6">
        <text>Taxpayer effective from</text>
        <input height="44" text="{regCreateEffectiveInputValue}" placeholder="YYYY-MM-DD" label="Taxpayer effective from" disabled="{regCanonicalMutationsDisabled}" on-input="reg_create_effective_input"/>
      </column>
    </grid>
    <button height="44" variant="primary" label="{action}" disabled="{regCreateTaxpayerDisabled}" on-press="reg_create_taxpayer">{action}</button>
    <use template="registration-action-feedback" visible="{regTaxpayerActionVisible}"/>
  </column>
</template>

<template name="profile-tin-editor">
  <row gap="6" cross="center">
    <input key="{profileTinSegmentOneKey}" grow="1" height="44" text="{profileTinSegmentOneValue}" placeholder="3 digits" label="TIN first three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentOneAutofocus}" on-input="profile_tin_segment_one_input"/>
    <text foreground="text_muted">-</text>
    <input key="{profileTinSegmentTwoKey}" grow="1" height="44" text="{profileTinSegmentTwoValue}" placeholder="3 digits" label="TIN second three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentTwoAutofocus}" on-input="profile_tin_segment_two_input"/>
    <text foreground="text_muted">-</text>
    <input key="{profileTinSegmentThreeKey}" grow="1" height="44" text="{profileTinSegmentThreeValue}" placeholder="3 digits" label="TIN third three digits" disabled="{profileBranchMode}" autofocus="{profileTinSegmentThreeAutofocus}" on-input="profile_tin_segment_three_input"/>
    <text foreground="text_muted">-</text>
    <input key="{profileTinSegmentBranchKey}" grow="1" height="44" text="{profileTinSegmentBranchValue}" placeholder="5 digits" label="TIN five digit branch code" autofocus="{profileTinSegmentBranchAutofocus}" on-input="profile_tin_segment_branch_input"/>
  </row>
</template>

<template name="profile-rdo-editor">
  <column gap="4">
    <stack>
      <combobox height="44" text="{profileRdoQueryValue}" placeholder="Search code or city" label="Revenue District Office (RDO)" selected="{profileRdoCommittedSelection}" expanded="{profileRdoPickerOpen}" autofocus="{profileRdoAutofocus}" on-input="profile_rdo_query_input" on-press="profile_rdo_toggle_picker" on-blur="profile_rdo_blurred"/>
      <if test="{profileRdoPickerOpen}">
        <dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_rdo_close_picker">
          <column padding="4" gap="2">
            <for each="profileRdoOptionRows" key="id" as="option">
              <menu-item height="44" selected="{option.selected}" on-press="profile_rdo_select:{option.id}">{option.rowLabel}</menu-item>
            </for>
          </column>
        </dropdown-menu>
      </if>
    </stack>
    <if test="{profileRdoErrorVisible}">
      <text wrap="true" foreground="destructive">{profileRdoValidationMessage}</text>
    </if>
  </column>
</template>

<template name="profile-setup-year-combobox-body">
  <column>
    <select
      height="44"
      label="Tax year for forms setup"
      on-press="profile_setup_toggle_year_picker">{profileSetupYearLabel}</select>
    <if test="{profileSetupYearPickerOpen}">
      <dropdown-menu
        anchor="below"
        anchor-alignment="end"
        anchor-offset="4"
        width="300"
        height="300"
        on-dismiss="profile_setup_close_year_picker">
        <column padding="8" gap="8">
          <input
            height="40"
            text="{profileSetupYearQueryValue}"
            placeholder="Type a year"
            label="Filter tax years"
            on-input="profile_setup_year_query"/>
          <if test="{profileSetupYearHelperVisible}">
            <text wrap="true" foreground="text_muted">{profileSetupYearHelperText}</text>
          </if>
          <scroll height="200" label="Tax years">
            <column gap="4">
              <for each="profileSetupYearOptions" key="id" as="option">
                <menu-item
                  height="44"
                  selected="{option.selected}"
                  label="{option.accessibleLabel}"
                  on-press="profile_setup_select_year:{option.year}">{option.rowLabel}</menu-item>
              </for>
            </column>
          </scroll>
        </column>
      </dropdown-menu>
    </if>
  </column>
</template>

<template name="profile-setup-year-combobox">
  <column>
    <if test="{profileFormsHeaderStacked}">
      <stack>
        <use template="profile-setup-year-combobox-body"/>
      </stack>
    </if>
    <else>
      <stack width="176">
        <use template="profile-setup-year-combobox-body"/>
      </stack>
    </else>
  </column>
</template>

<template name="profile-setup-source-picker">
  <stack width="220">
    <select
      height="44"
      label="Change the year this setup copies from"
      on-press="profile_setup_toggle_source_picker">Change source</select>
    <if test="{profileSetupSourcePickerOpen}">
      <dropdown-menu
        anchor="below"
        anchor-alignment="stretch"
        anchor-offset="4"
        height="240"
        on-dismiss="profile_setup_close_source_picker">
        <scroll height="220" label="Years you can copy from">
          <column padding="8" gap="4">
            <for each="profileSetupSourceOptions" key="id" as="source">
              <menu-item
                height="44"
                selected="{source.selected}"
                label="{source.accessibleLabel}"
                on-press="profile_setup_draft_seed:{source.year}">{source.rowLabel}</menu-item>
            </for>
          </column>
        </scroll>
      </dropdown-menu>
    </if>
  </stack>
</template>

<template name="profile-setup-cor-card">
  <card padding="0">
    <row padding="14" gap="12" cross="center">
      <icon name="file-text" foreground="text_muted" width="22" height="22"/>
      <column grow="1" gap="4">
        <text><span weight="bold">Certificate of Registration</span></text>
        <text wrap="true" foreground="text_muted">{profileCorStatusLabel}</text>
      </column>
      <if test="{profileCorReviewAvailable}">
        <button
          height="44"
          variant="outline"
          on-press="profile_cor_begin_review">Review against COR</button>
      </if>
      <button
        height="44"
        variant="outline"
        icon="folder-open"
        disabled="{profileCorUploadDisabled}"
        on-press="profile_cor_upload">{profileCorActionLabel}</button>
    </row>
  </card>
</template>

<template name="profile-setup-cor-review">
  <card padding="0">
    <column padding="16" gap="12">
      <column gap="4">
        <text><span weight="bold">Review against the COR</span></text>
        <text wrap="true" foreground="text_muted">Type what the document says. Only the rows you accept are applied.</text>
      </column>

      <use template="profile-field" label="TIN shown on the COR">
        <input
          height="44"
          text="{profileCorReviewTinValue}"
          placeholder="000-000-000-000"
          label="TIN shown on the COR"
          on-input="profile_cor_tin_input"/>
      </use>

      <if test="{profileCorMismatchVisible}">
        <card padding="0">
          <column padding="12" gap="6">
            <text><span weight="bold">{profileCorMismatchLabel}</span></text>
            <text wrap="true" foreground="text_muted">Nothing here can be applied to this taxpayer.</text>
          </column>
        </card>
      </if>
      <else>
        <column gap="10">
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorRdoLabel}</text>
            <input height="44" text="{profileCorRdoValue}" placeholder="What the COR says" label="{profileCorRdoLabel}" on-input="profile_cor_rdo_input"/>
            <checkbox height="44" checked="{profileCorRdoAccepted}" text="Use this value" on-toggle="profile_cor_toggle_rdo"/>
          </column>
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorNameLabel}</text>
            <input height="44" text="{profileCorNameValue}" placeholder="What the COR says" label="{profileCorNameLabel}" on-input="profile_cor_name_input"/>
            <checkbox height="44" checked="{profileCorNameAccepted}" text="Use this value" on-toggle="profile_cor_toggle_name"/>
          </column>
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorAddressLabel}</text>
            <input height="44" text="{profileCorAddressValue}" placeholder="What the COR says" label="{profileCorAddressLabel}" on-input="profile_cor_address_input"/>
            <checkbox height="44" checked="{profileCorAddressAccepted}" text="Use this value" on-toggle="profile_cor_toggle_address"/>
          </column>
          <column gap="6">
            <text wrap="true" foreground="text_muted">{profileCorZipLabel}</text>
            <input height="44" text="{profileCorZipValue}" placeholder="What the COR says" label="{profileCorZipLabel}" on-input="profile_cor_zip_input"/>
            <checkbox height="44" checked="{profileCorZipAccepted}" text="Use this value" on-toggle="profile_cor_toggle_zip"/>
          </column>
          <checkbox
            height="44"
            checked="{profileCorApplyFormsSelected}"
            text="{profileCorApplyFormsLabel}"
            on-toggle="profile_cor_toggle_apply_forms"/>
        </column>
      </else>

      <row gap="8">
        <button
          height="44"
          variant="outline"
          on-press="profile_cor_cancel_review">Cancel</button>
        <button
          height="44"
          variant="primary"
          disabled="{profileCorApplyDisabled}"
          on-press="profile_cor_apply">{profileCorApplyLabel}</button>
      </row>
    </column>
  </card>
</template>

<template name="profile-dirty-navigation-dialog-content">
  <column min-width="0">
    <row min-width="0" padding="20" gap="12" cross="center">
      <column grow="1" min-width="0" gap="4">
        <text><span weight="bold" scale="1.2">{profileDirtyNavigationTitle}</span></text>
      </column>
      <button
        width="36"
        height="36"
        size="icon"
        variant="ghost"
        icon="x"
        label="Keep editing"
        on-press="profile_keep_editing">
      </button>
    </row>
    <separator/>
    <column grow="1" min-width="0" padding="20" gap="16">
      <text wrap="true" foreground="text_muted">{profileDirtyNavigationBody}</text>
      <if test="{profileSessionDraftActionVisible}">
        <text size="sm" wrap="true" foreground="text_muted">{profileSessionDraftMessage}</text>
      </if>
      <if test="{profileSessionDraftBlockedVisible}">
        <text size="sm" wrap="true" foreground="warning">A session draft is already available. Resume or discard it before saving another draft.</text>
      </if>
    </column>
    <separator/>
    <if test="{constrainedLayout}">
      <column min-width="0" padding="20" gap="8">
        <if test="{profileSessionDraftActionVisible}">
          <button size="sm" variant="primary" on-press="profile_save_session_draft_navigation">Save draft and continue</button>
        </if>
        <button size="sm" variant="destructive" on-press="profile_discard_navigation">{profileDiscardNavigationLabel}</button>
      </column>
    </if>
    <else>
      <row min-width="0" padding="20" gap="8" main="end" cross="center">
        <if test="{profileSessionDraftActionVisible}">
          <button size="sm" variant="primary" on-press="profile_save_session_draft_navigation">Save draft and continue</button>
        </if>
        <button size="sm" variant="destructive" on-press="profile_discard_navigation">{profileDiscardNavigationLabel}</button>
      </row>
    </else>
  </column>
</template>

<template name="profile-setup-content">
  <column gap="24">
    <if test="{profileInlineBackVisible}">
      <row gap="10" cross="start">
        <button
          width="44"
          height="44"
          size="icon"
          variant="ghost"
          radius="xl"
          icon="chevron-left"
          label="{profileBackLabel}"
          disabled="{profileInlineBackDisabled}"
          on-press="go_back">
        </button>
        <column grow="1" gap="6">
          <text size="heading">{profileEditorTitle}</text>
          <text wrap="true" foreground="text_muted">{profileVersioningHelp}</text>
        </column>
      </row>
    </if>

    <tabs label="Profile setup sections">
      <button
        height="44"
        selected="{profileTaxActive}"
        on-press="show_profile_tax">
        {profileTaxTabLabel}
      </button>
      <button
        height="44"
        selected="{profileRegistrationFilingActive}"
        on-press="show_profile_reg_filing">
        {profileRegistrationTabLabel}
      </button>
      <button
        height="44"
        selected="{profileTaxFormsActive}"
        on-press="show_profile_tax_forms">
        {profileTaxFormsTabLabel}
      </button>
      <button
        height="44"
        selected="{profileEmailActive}"
        on-press="show_profile_email">
        {profileEmailTabLabel}
      </button>
    </tabs>


    <if test="{profileCompletionVisible}">
      <card padding="0">
        <row padding="12" gap="10" cross="center">
          <badge variant="outline">Profile data required</badge>
          <text wrap="true" foreground="text_muted">{profileCompletionMessage}</text>
        </row>
      </card>
    </if>

    <if test="{profileTaxActive}">
      <if test="{profileSessionDraftVisible}">
        <card padding="0">
          <column padding="14" gap="10">
            <column gap="4">
              <row gap="8" cross="center">
                <text><span weight="bold">Session draft available</span></text>
                <badge variant="secondary">Session only</badge>
              </row>
              <text wrap="true" foreground="text_muted">{profileSessionDraftMessage}</text>
            </column>
            <if test="{constrainedLayout}">
              <column gap="8">
                <button size="sm" variant="primary" on-press="resume_profile_session_draft">Resume draft</button>
                <button size="sm" variant="ghost" icon="x" on-press="discard_profile_session_draft">Discard session draft</button>
              </column>
            </if>
            <else>
              <row gap="8" main="end">
                <button size="sm" variant="ghost" icon="x" label="Discard session draft" on-press="discard_profile_session_draft"></button>
                <button size="sm" variant="primary" on-press="resume_profile_session_draft">Resume draft</button>
              </row>
            </else>
          </column>
        </card>
      </if>
      <if test="{profileLegacyIdentityReadOnly}">
        <alert text="Legacy Taxpayer Profile is read-only">
          <column gap="10">
            <text wrap="true">{profileLegacyIdentityReadOnlyHelp}</text>
            <row>
              <button height="44" variant="primary" on-press="show_profile_reg_filing">Open Registration & Filing</button>
            </row>
          </column>
        </alert>
      </if>
      <else>
      <column gap="24">
        <if test="{profileTaxViewing}">
          <column gap="20">
            <if test="{constrainedLayout}">
              <column gap="10">
                <column gap="4">
                  <text><span weight="bold">Saved Taxpayer Profile</span></text>
                  <text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text>
                </column>
                <button height="44" variant="primary" on-press="edit_tax_profile">Edit Taxpayer Profile</button>
              </column>
            </if>
            <else>
              <row gap="12" cross="center">
                <column grow="1" gap="4">
                  <text><span weight="bold">Saved Taxpayer Profile</span></text>
                  <text wrap="true" foreground="text_muted">These are the reusable taxpayer details currently on file.</text>
                </column>
                <button height="44" variant="primary" on-press="edit_tax_profile">Edit Taxpayer Profile</button>
              </row>
            </else>

            <if test="{profileFactsSummaryVisible}">
              <card padding="0">
                <column padding="14" gap="6">
                  <text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text>
                </column>
              </card>
            </if>

            <card padding="0">
              <column padding="18" gap="16">
                <column gap="4">
                  <text><span weight="bold">Identity and contact</span></text>
                  <text wrap="true" foreground="text_muted">Base facts shared by the taxpayer's forms.</text>
                </column>
                <grid columns="{profileReadColumns}" gap="16">
                  <use template="profile-read-value" label="Taxpayer Identification Number (TIN)" value="{profileTinDisplayValue}"/>
                  <use template="profile-read-value" label="Revenue District Office (RDO) code" value="{profileRdoDisplayValue}"/>
                  <use template="profile-read-value" label="Taxpayer Type" value="{profileSubjectKindLabel}"/>
                  <if test="{profileNaturalPersonClassificationVisible}">
                    <use template="profile-read-value" label="Tax Classification" value="{profileNaturalPersonClassificationLabel}"/>
                  </if>
                  <use template="profile-read-value" label="Taxpayer or registered name" value="{profileNameDisplayValue}"/>
                  <if test="{profileTradeNameVisible}">
                    <use template="profile-read-value" label="Trade name" value="{profileTradeNameDisplayValue}"/>
                  </if>
                  <use template="profile-read-value" label="Registered address" value="{profileAddressDisplayValue}"/>
                  <use template="profile-read-value" label="ZIP code" value="{profileZipDisplayValue}"/>
                  <use template="profile-read-value" label="Contact number" value="{profilePhoneDisplayValue}"/>
                  <use template="profile-read-value" label="Registered email address" value="{profileEmailDisplayValue}"/>
                </grid>
              </column>
            </card>

            <card padding="0">
              <column padding="18" gap="16">
                <column gap="4">
                  <text><span weight="bold">Accounting period</span></text>
                  <text wrap="true" foreground="text_muted">The accounting basis used to derive filing periods.</text>
                </column>
                <grid columns="{profileReadColumns}" gap="16">
                  <use template="profile-read-value" label="Accounting basis" value="{profileAccountingPeriodBasisLabel}"/>
                  <if test="{profileFiscalYearEndMonthVisible}">
                    <use template="profile-read-value" label="Fiscal year-end month" value="{profileFiscalYearEndMonthValue}"/>
                  </if>
                </grid>
              </column>
            </card>

            <if test="{profileBusinessFieldsVisible}">
              <card padding="0">
                <column padding="18" gap="16">
                  <column gap="4">
                    <text><span weight="bold">Business details</span></text>
                    <text wrap="true" foreground="text_muted">Reusable business facts shared by forms that request them.</text>
                  </column>
                  <grid columns="{profileReadColumns}" gap="16">
                    <use template="profile-read-value" label="EOPT Tier" value="{profileEoptTierLabel}"/>
                    <use template="profile-read-value" label="Primary Line of Business" value="{profilePrimaryLineOfBusinessDisplayValue}"/>
                  </grid>
                </column>
              </card>
            </if>

            <if test="{profilePersonalFieldsVisible}">
              <card padding="0">
                <column padding="18" gap="16">
                  <text><span weight="bold">Individual details</span></text>
                  <grid columns="{profileReadColumns}" gap="16">
                    <use template="profile-read-value" label="Birth date" value="{profileBirthDateDisplayValue}"/>
                    <use template="profile-read-value" label="Citizenship" value="{profileCitizenshipDisplayValue}"/>
                    <use template="profile-read-value" label="Foreign tax number" value="{profileForeignTaxNumberDisplayValue}"/>
                  </grid>
                </column>
              </card>
            </if>

            <card padding="0">
              <column padding="18" gap="8">
                <text><span weight="bold">Effective date</span></text>
                <use template="profile-read-value" label="Details effective from" value="{profileEffectiveFromDisplayValue}"/>
              </column>
            </card>
          </column>
        </if>
        <else>
        <if test="{profileBranchMode}">
          <card padding="0">
            <column padding="14" gap="6">
              <text><span weight="bold">{profileBranchBannerTitle}</span></text>
              <text wrap="true" foreground="text_muted">{profileBranchBannerBody}</text>
              <text wrap="true" foreground="text_muted">{profileBranchCopyNote}</text>
            </column>
          </card>
        </if>

        <if test="{profileFactsSummaryVisible}">
          <card padding="0">
            <column padding="14" gap="6">
              <text wrap="true" foreground="text_muted">{profileFactsSummaryLabel}</text>
              <if test="{profileFactsMissingVisible}">
                <text wrap="true" foreground="text_muted">{profileFactsMissingHelpText}</text>
              </if>
            </column>
          </card>
        </if>

        <column gap="16">
            <column gap="4">
              <text><span weight="bold">Identity and contact</span></text>
              <text wrap="true" foreground="text_muted">{profileIdentityHelp}</text>
            </column>

            <grid columns="{profileReadColumns}" gap="12">
              <use template="profile-field" label="Taxpayer Identification Number (TIN)"><use template="profile-tin-editor"/></use>
              <use template="profile-field" label="Revenue District Office (RDO)"><use template="profile-rdo-editor"/></use>
            </grid>
            <if test="{profileTinInvalidVisible}">
              <text wrap="true" foreground="destructive">{profileTinValidationMessage}</text>
            </if>

            <column gap="8">
              <text>Taxpayer Type</text>
              <stack>
                <combobox
                  height="44"
                  text="{profileSubjectQueryValue}"
                  placeholder="Search taxpayer type"
                  label="Taxpayer Type"
                  selected="{profileSubjectCommittedSelection}"
                  expanded="{profileSubjectPickerOpen}"
                  disabled="{profileBranchMode}"
                  on-input="profile_subject_query_input"
                  on-press="toggle_profile_subject_picker"
                  on-blur="profile_subject_blurred"/>
                <if test="{profileSubjectPickerOpen}">
                  <dropdown-menu
                    anchor="below"
                    anchor-alignment="stretch"
                    on-dismiss="close_profile_subject_picker">
                    <column padding="4" gap="2">
                      <for each="profileSubjectKindOptionRows" key="id" as="option">
                        <menu-item height="44" selected="{option.selected}" on-press="profile_subject_select:{option.id}">{option.label}</menu-item>
                      </for>
                    </column>
                  </dropdown-menu>
                </if>
              </stack>
              <if test="{profileSubjectErrorVisible}">
                <text wrap="true" foreground="destructive">{profileSubjectValidationMessage}</text>
              </if>
            </column>

            <if test="{profileNaturalPersonClassificationVisible}">
              <column gap="8">
                <text>Tax Classification</text>
                <text wrap="true" foreground="text_muted">{profileClassificationHelp}</text>
                <stack>
                  <combobox
                    height="44"
                    text="{profileClassificationQueryValue}"
                    placeholder="Search tax classification"
                    label="Tax Classification"
                    selected="{profileClassificationCommittedSelection}"
                    expanded="{profileClassificationPickerOpen}"
                    on-input="profile_classification_query_input"
                    on-press="toggle_profile_classification_picker"
                    on-blur="profile_classification_blurred"/>
                  <if test="{profileClassificationPickerOpen}">
                    <dropdown-menu
                      anchor="below"
                      anchor-alignment="stretch"
                      on-dismiss="close_profile_classification_picker">
                      <column padding="4" gap="2">
                        <for each="profileClassificationOptionRows" key="id" as="option">
                          <menu-item height="44" selected="{option.selected}" on-press="profile_classification_select:{option.id}">{option.label}</menu-item>
                        </for>
                        <else><menu-item height="44" disabled="true">No matching classifications</menu-item></else>
                      </column>
                    </dropdown-menu>
                  </if>
                </stack>
                <if test="{profileClassificationErrorVisible}">
                  <text wrap="true" foreground="destructive">{profileClassificationValidationMessage}</text>
                </if>
              </column>
            </if>

            <use template="profile-field" label="Taxpayer or registered name">
              <column gap="6">
                <input
                  height="44"
                  text="{profileNameValue}"
                  placeholder="Registered taxpayer name"
                  label="Taxpayer or registered name"
                  autofocus="{profileNameAutofocus}"
                  on-input="profile_name_input"
                  on-blur="profile_name_blurred"/>
                <if test="{profileNameErrorVisible}">
                  <text wrap="true" foreground="destructive">{profileNameValidationMessage}</text>
                </if>
              </column>
            </use>
            <if test="{profileTradeNameVisible}">
              <use template="profile-field" label="Trade name">
                <input
                  height="44"
                  text="{profileTradeNameValue}"
                  placeholder="Optional DTI or registered trade name"
                  label="Trade name"
                  on-input="profile_trade_name_input"/>
              </use>
            </if>
            <use template="profile-field" label="Registered address">
              <column gap="6">
                <input
                  height="44"
                  text="{profileAddressValue}"
                  placeholder="Registered address"
                  label="Registered address"
                  autofocus="{profileAddressAutofocus}"
                  on-input="profile_address_input"
                  on-blur="profile_address_blurred"/>
                <if test="{profileAddressErrorVisible}"><text wrap="true" foreground="destructive">{profileAddressValidationMessage}</text></if>
              </column>
            </use>

            <grid columns="{profileReadColumns}" gap="12">
              <use template="profile-field" label="ZIP code">
                <column gap="6">
                  <input height="44" text="{profileZipValue}" placeholder="4-digit ZIP code" label="ZIP code" autofocus="{profileZipAutofocus}" on-input="profile_zip_input" on-blur="profile_zip_blurred"/>
                  <if test="{profileZipErrorVisible}"><text wrap="true" foreground="destructive">{profileZipValidationMessage}</text></if>
                </column>
              </use>
              <use template="profile-field" label="Contact number">
                <column gap="6">
                  <input height="44" text="{profilePhoneValue}" placeholder="+63 917 123 4567" label="Contact number" autofocus="{profilePhoneAutofocus}" on-input="profile_phone_input" on-blur="profile_phone_blurred"/>
                  <if test="{profilePhoneErrorVisible}"><text wrap="true" foreground="destructive">{profilePhoneValidationMessage}</text></if>
                </column>
              </use>
            </grid>

            <use template="profile-field" label="Registered email address">
              <column gap="6">
                <input height="44" text="{profileEmailValue}" placeholder="name@example.ph" label="Registered email address" autofocus="{profileEmailAutofocus}" on-input="profile_email_input" on-blur="profile_email_blurred"/>
                <if test="{profileEmailErrorVisible}"><text wrap="true" foreground="destructive">{profileEmailValidationMessage}</text></if>
              </column>
            </use>
        </column>

        <column gap="16">
          <column gap="4">
            <text><span weight="bold">Accounting period</span></text>
            <text wrap="true" foreground="text_muted">Choose the basis used to derive this taxpayer's filing periods.</text>
          </column>
          <grid columns="{profileReadColumns}" gap="8">
            <button height="44" variant="outline" selected="{profileAccountingPeriodCalendarSelected}" on-press="profile_accounting_period_calendar">Calendar</button>
            <button height="44" variant="outline" selected="{profileAccountingPeriodFiscalSelected}" on-press="profile_accounting_period_fiscal">Fiscal</button>
          </grid>
          <if test="{profileAccountingPeriodBasisErrorVisible}">
            <text wrap="true" foreground="destructive">{profileAccountingPeriodBasisValidationMessage}</text>
          </if>
          <if test="{profileFiscalYearEndMonthVisible}">
            <use template="profile-field" label="Fiscal year-end month">
              <column gap="6">
                <input
                  height="44"
                  text="{profileFiscalYearEndMonthValue}"
                  placeholder="1 to 12"
                  label="Fiscal year-end month"
                  on-input="profile_fiscal_year_end_month_input"
                  on-blur="profile_fiscal_year_end_month_blurred"/>
                <if test="{profileFiscalYearEndMonthErrorVisible}"><text wrap="true" foreground="destructive">{profileFiscalYearEndMonthValidationMessage}</text></if>
              </column>
            </use>
          </if>
        </column>

        <if test="{profileBusinessFieldsVisible}">
          <column gap="16">
            <column gap="4">
              <text><span weight="bold">Business details</span></text>
              <text wrap="true" foreground="text_muted">
                These reusable fields are saved in this Taxpayer Profile revision.
              </text>
            </column>
            <column gap="8">
              <text>EOPT Tier</text>
              <stack>
                <select
                  height="44"
                  label="EOPT Tier"
                  on-press="toggle_profile_eopt_picker">{profileEoptTierLabel}</select>
                <if test="{profileEoptPickerOpen}">
                  <dropdown-menu
                    anchor="below"
                    anchor-alignment="stretch"
                    on-dismiss="close_profile_eopt_picker">
                    <menu-item height="44" selected="{profileEoptMicroSelected}" on-press="profile_eopt_micro">Micro</menu-item>
                    <menu-item height="44" selected="{profileEoptSmallSelected}" on-press="profile_eopt_small">Small</menu-item>
                    <menu-item height="44" selected="{profileEoptMediumSelected}" on-press="profile_eopt_medium">Medium</menu-item>
                    <menu-item height="44" selected="{profileEoptLargeSelected}" on-press="profile_eopt_large">Large</menu-item>
                  </dropdown-menu>
                </if>
              </stack>
            </column>
            <use template="profile-field" label="Primary Line of Business">
              <input
                height="44"
                text="{profilePrimaryLineOfBusinessValue}"
                placeholder="Primary line of business"
                label="Primary Line of Business"
                on-input="profile_primary_line_of_business_input"/>
            </use>
          </column>
        </if>

        <if test="{profilePersonalFieldsVisible}">
          <column gap="16">
            <column gap="4">
              <text><span weight="bold">Individual details</span></text>
              <text wrap="true" foreground="text_muted">Birth date and citizenship are required for an individual taxpayer. A foreign tax number remains optional.</text>
            </column>
            <grid columns="{profileReadColumns}" gap="12">
              <use template="profile-field" label="Birth date">
                <column gap="6">
                  <input height="44" text="{profileBirthDateValue}" placeholder="81788, 08/17/1988, or 1988-08-17" label="Birth date" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileBirthDateAutofocus}" on-input="profile_birth_date_input" on-focus="profile_birth_date_focused" on-blur="profile_birth_date_blurred"/>
                  <if test="{profileBirthDateErrorVisible}"><text wrap="true" foreground="destructive">{profileBirthDateValidationMessage}</text></if>
                </column>
              </use>
              <use template="profile-field" label="Citizenship">
                <column gap="6">
                  <stack>
                    <combobox height="44" text="{profileCitizenshipQueryValue}" placeholder="Search citizenship" label="Citizenship" selected="{profileCitizenshipCommittedSelection}" expanded="{profileCitizenshipPickerOpen}" disabled="{profilePersonalFieldsDisabled}" autofocus="{profileCitizenshipAutofocus}" on-input="profile_citizenship_input" on-press="profile_citizenship_toggle_picker" on-blur="profile_citizenship_blurred"/>
                    <if test="{profileCitizenshipPickerOpen}">
                      <dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_citizenship_close_picker">
                        <column padding="4" gap="2">
                          <for each="profileCitizenshipOptionRows" key="id" as="option">
                            <menu-item height="44" selected="{option.selected}" on-press="profile_citizenship_select:{option.id}">{option.label}</menu-item>
                          </for>
                        </column>
                      </dropdown-menu>
                    </if>
                  </stack>
                  <if test="{profileCitizenshipErrorVisible}"><text wrap="true" foreground="destructive">{profileCitizenshipValidationMessage}</text></if>
                </column>
              </use>
            </grid>
            <use template="profile-field" label="Foreign tax number">
              <input
                height="44"
                text="{profileForeignTaxNumberValue}"
                placeholder="Optional foreign tax identifier"
                label="Foreign tax number"
                disabled="{profilePersonalFieldsDisabled}"
                autofocus="{profileForeignTaxNumberAutofocus}"
                on-input="profile_foreign_tax_number_input"/>
            </use>
          </column>
        </if>

        <column gap="16">
            <column gap="4">
              <text><span weight="bold">When this applies</span></text>
              <text wrap="true" foreground="text_muted">{profileEffectiveDateHelp}</text>
            </column>

            <if test="{profileChangeControlsVisible}">
              <grid columns="{profileReadColumns}" gap="8">
                <button height="44" variant="outline" selected="{profileRecordChangeSelected}" on-press="profile_record_change">Record a change</button>
                <button height="44" variant="outline" selected="{profileFixMistakeSelected}" on-press="profile_fix_mistake">Fix a mistake</button>
              </grid>
            </if>

            <grid columns="{profileReadColumns}" gap="8">
              <button height="44" variant="outline" selected="{profileAnnualEffectiveYears}" on-press="profile_use_annual_effective_years">Year selection</button>
              <button height="44" variant="outline" selected="{profileExactEffectiveDates}" on-press="profile_use_exact_effective_dates">Use exact dates</button>
            </grid>

            <if test="{profileAnnualEffectiveYears}">
              <text wrap="true" foreground="text_muted">A start year maps to January 1. An optional end year maps to December 31; leaving it blank keeps this profile available in later years.</text>
              <grid columns="{profileReadColumns}" gap="12">
                <use template="profile-field" label="When did this take effect?">
                  <column gap="6">
                    <stack>
                      <combobox height="44" text="{profileEffectiveStartYearValue}" placeholder="YYYY" label="When did this take effect?" selected="{profileEffectiveStartYearSelected}" expanded="{profileEffectiveStartYearPickerOpen}" on-input="profile_effective_start_year_input" on-press="profile_effective_start_year_toggle_picker" on-blur="profile_effective_start_year_blurred"/>
                      <if test="{profileEffectiveStartYearPickerOpen}">
                        <dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_effective_start_year_close_picker">
                          <column padding="4" gap="2">
                            <for each="profileEffectiveStartYearOptionRows" key="value" as="option">
                              <menu-item height="44" selected="{option.selected}" on-press="profile_effective_start_year_select:{option.value}">{option.value}</menu-item>
                            </for>
                          </column>
                        </dropdown-menu>
                      </if>
                    </stack>
                    <if test="{profileEffectiveStartErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveStartValidationMessage}</text></if>
                  </column>
                </use>
                <use template="profile-field" label="Applies until">
                  <column gap="6">
                    <stack>
                      <combobox height="44" text="{profileEffectiveEndYearValue}" placeholder="Optional YYYY" label="Applies until" selected="{profileEffectiveEndYearSelected}" expanded="{profileEffectiveEndYearPickerOpen}" on-input="profile_effective_end_year_input" on-press="profile_effective_end_year_toggle_picker" on-blur="profile_effective_end_year_blurred"/>
                      <if test="{profileEffectiveEndYearPickerOpen}">
                        <dropdown-menu anchor="below" anchor-alignment="stretch" on-dismiss="profile_effective_end_year_close_picker">
                          <column padding="4" gap="2">
                            <menu-item height="44" selected="{profileEffectiveEndYearClearSelected}" on-press="profile_effective_end_year_clear">No end year</menu-item>
                            <for each="profileEffectiveEndYearOptionRows" key="value" as="option">
                              <menu-item height="44" selected="{option.selected}" on-press="profile_effective_end_year_select:{option.value}">{option.value}</menu-item>
                            </for>
                          </column>
                        </dropdown-menu>
                      </if>
                    </stack>
                    <if test="{profileEffectiveEndErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveEndValidationMessage}</text></if>
                  </column>
                </use>
              </grid>
            </if>
            <else>
              <text wrap="true" foreground="warning">This revision uses custom dates. Keep them exact so historic filings continue to select the right profile facts.</text>
              <use template="profile-field" label="{profileEffectiveDateLabel}">
                <column gap="6">
                  <input height="44" text="{profileEffectiveFromValue}" placeholder="YYYY-MM-DD" label="{profileEffectiveDateLabel}" on-input="profile_effective_from_input" on-blur="profile_effective_start_blurred"/>
                  <if test="{profileEffectiveStartErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveStartValidationMessage}</text></if>
                </column>
              </use>
              <use template="profile-field" label="Applies until">
                <column gap="6">
                  <input height="44" text="{profileEffectiveUntilValue}" placeholder="YYYY-MM-DD or empty" label="Applies until" on-input="profile_effective_until_input" on-blur="profile_effective_end_blurred"/>
                  <if test="{profileEffectiveEndErrorVisible}"><text wrap="true" foreground="destructive">{profileEffectiveEndValidationMessage}</text></if>
                </column>
              </use>
            </else>

            <text wrap="true" foreground="text_muted">{profileIdentityLockNote}</text>
        </column>
        </else>
      </column>
      </else>
    </if>

    <if test="{profileRegistrationFilingActive}">
      <column gap="20">
        <column gap="4">
          <text size="heading"><span weight="bold">Registration & Filing</span></text>
          <text wrap="true" foreground="text_muted">{regCanonicalHelp}</text>
        </column>

        <alert text="{regCanonicalMutationGateTitle}">
          <text wrap="true">{regCanonicalMutationGateHelp}</text>
        </alert>

        <if test="{regGlobalActionVisible}">
          <alert text="{regActionHeading}">
            <text wrap="true">{regActionLabel}</text>
          </alert>
        </if>

        <if test="{regCanonicalEmpty}">
          <if test="{regCanonicalMutationsEnabled}">
            <card padding="0">
              <column padding="20" gap="10">
                <text><span weight="bold">Create the first Taxpayer</span></text>
                <row><badge variant="outline">{regWorkspaceStatusLabel}</badge></row>
                <text wrap="true" foreground="text_muted">{regCreateHelp}</text>
                <use template="registration-create-taxpayer" action="Create Taxpayer"/>
              </column>
            </card>
          </if>
          <else>
            <card padding="0">
              <column padding="20" gap="8">
                <text><span weight="bold">No canonical registration records</span></text>
                <row><badge variant="outline">Read-only</badge></row>
                <text wrap="true" foreground="text_muted">No Taxpayer or Registration Unit records exist in this data store. Creation controls are hidden because this is not an explicitly owned fixture workspace.</text>
              </column>
            </card>
          </else>
        </if>
        <else>
          <column gap="16">
            <column gap="10">
              <grid columns="{profileReadColumns}" gap="8">
                <text grow="1"><span weight="bold">Taxpayers</span></text>
                <row gap="6" cross="center">
                  <badge variant="outline">{regWorkspaceStatusLabel}</badge>
                  <if test="{regCanonicalMutationsDisabled}"><badge variant="outline">Read-only</badge></if>
                  <if test="{regWorkspaceReviewRequired}"><badge variant="destructive">Review Required</badge></if>
                </row>
              </grid>
              <column gap="6">
                <for each="regTaxpayerRows" key="stableKey" as="taxpayer">
                  <list-item height="64" padding="10" selected="{taxpayer.selected}" label="{taxpayer.accessibleLabel}" on-press="reg_select_taxpayer:{taxpayer.id}">
                    <column grow="1" gap="3">
                      <text><span weight="bold">{taxpayer.visibleLabel}</span></text>
                      <text size="sm" foreground="text_muted">{taxpayer.statusLabel}</text>
                    </column>
                  </list-item>
                </for>
              </column>
              <if test="{regCanonicalMutationsEnabled}">
                <separator/>
                <use template="registration-create-taxpayer" action="Add Taxpayer"/>
              </if>
            </column>

            <separator/>

            <grid columns="{profileReadColumns}" gap="16">
              <column gap="10">
                <column gap="3">
                  <text><span weight="bold">Registration Units</span></text>
                  <text wrap="true" foreground="text_muted">{regUnitListStatusLabel}</text>
                </column>
                <if test="{regUnitRowsEmpty}">
                  <text wrap="true" foreground="warning">Review Required — no effective Registration Unit is available.</text>
                </if>
                <else>
                  <column gap="6">
                    <for each="regUnitRows" key="stableKey" as="unit">
                      <list-item height="84" padding="10" selected="{unit.selected}" label="{unit.accessibleLabel}" on-press="reg_select_registration_unit:{unit.id}">
                        <column grow="1" gap="3">
                          <text><span weight="bold">{unit.kindLabel}</span> · {unit.codeLabel}</text>
                          <text size="sm" wrap="true" foreground="text_muted">{unit.statusLabel} · RDO {unit.rdoLabel}</text>
                          <row><badge variant="{unit.vatRegistrationTone}">{unit.vatRegistrationLabel}</badge></row>
                        </column>
                      </list-item>
                    </for>
                  </column>
                </else>
              </column>

              <column gap="10">
                <use template="profile-read-value" label="Taxpayer TIN root" value="{regSelectedTaxpayerMaskedTin}"/>
                <use template="profile-read-value" label="Workspace focus" value="{regSelectedRegistrationUnitLabel}"/>
                <use template="profile-read-value" label="Workspace-focus RDO" value="{regSelectedRegistrationUnitRdoLabel}"/>
                <text wrap="true" foreground="text_muted">This Registration Unit selection is for workspace review only; it is neither Source Attribution nor the resolved Filing Unit.</text>
              </column>
            </grid>

            <separator/>

            <column gap="10">
              <if test="{phoneLayout}">
                <column gap="6">
                  <text><span weight="bold">Source records for this Registration Unit</span></text>
                  <text wrap="true" foreground="text_muted">{regSourceWorkspaceSummary}</text>
                  <row>
                    <if test="{regSourceWorkspaceReviewRequired}">
                      <badge variant="destructive">Review Required</badge>
                    </if>
                    <else>
                      <badge variant="outline">Read-only filter</badge>
                    </else>
                  </row>
                </column>
              </if>
              <else>
                <row gap="8" cross="center">
                  <column grow="1" gap="3">
                    <text><span weight="bold">Source records for this Registration Unit</span></text>
                    <text wrap="true" foreground="text_muted">{regSourceWorkspaceSummary}</text>
                  </column>
                  <if test="{regSourceWorkspaceReviewRequired}">
                    <badge variant="destructive">Review Required</badge>
                  </if>
                  <else>
                    <badge variant="outline">Read-only filter</badge>
                  </else>
                </row>
              </else>

              <text wrap="true" foreground="text_muted">Only records with Source Attribution entered or derived before this selection can appear. Changing this workspace filter never assigns a Source Unit, changes Return Coverage, or chooses the Filing Unit.</text>

              <if test="{regSourceRowsEmpty}">
                <text wrap="true" foreground="text_muted">No explicitly attributed records match this taxpayer, Registration Unit, and quarter.</text>
              </if>
              <else>
                <column gap="4">
                  <for each="regSourceRecordRows" key="stableKey" as="record">
                    <list-item label="{record.accessibleLabel}">
                      <row padding="10" gap="12" cross="center">
                        <column grow="1" gap="3">
                          <text><span weight="bold">{record.visibleLabel}</span> · {record.occurredOnLabel}</text>
                          <text size="sm" wrap="true" foreground="text_muted">{record.attributionLabel}</text>
                        </column>
                        <badge variant="outline">Attributed</badge>
                      </row>
                    </list-item>
                  </for>
                </column>
              </else>

              <if test="{regSourceWorkspaceReviewRequired}">
                <alert text="Unresolved Source Attribution excluded">
                  <text wrap="true">{regSourceWorkspaceReviewLabel}</text>
                </alert>
              </if>
              <text size="sm" wrap="true" foreground="text_muted">{regSourcePreviewHelp}</text>
            </column>

            <if test="{regCanonicalMutationsEnabled}">
              <separator/>

              <column gap="12">
                <column gap="4">
                  <text><span weight="bold">Add a branch candidate</span></text>
                  <text foreground="warning"><span weight="bold">{regSuggestedBranchLabel}</span></text>
                  <text wrap="true" foreground="text_muted">{regBranchHelp}</text>
                </column>
                <grid columns="{profileReadColumns}" gap="12">
                  <use template="profile-field" label="Candidate Branch Code">
                    <input height="44" text="{regBranchCodeInputValue}" placeholder="e.g. 00001" label="Candidate Branch Code" on-input="reg_branch_code_input"/>
                  </use>
                  <use template="profile-field" label="Branch candidate effective from">
                    <input height="44" text="{regBranchEffectiveInputValue}" placeholder="YYYY-MM-DD" label="Branch candidate effective from" on-input="reg_branch_effective_input"/>
                  </use>
                </grid>
                <grid columns="{profileReadColumns}" gap="8">
                  <button height="44" variant="outline" disabled="{regBranchSuggestionUnavailable}" on-press="reg_use_branch_suggestion">Use suggestion</button>
                  <button height="44" variant="primary" disabled="{regCreateBranchDisabled}" on-press="reg_create_branch">Create pending branch</button>
                </grid>
                <use template="registration-action-feedback" visible="{regBranchActionVisible}"/>
              </column>

              <separator/>
            </if>

            <if test="{regRegistrationEvidenceAuthoringVisible}">
              <column gap="14">
                <column gap="4">
                  <grid columns="{profileReadColumns}" gap="8">
                    <text><span weight="bold">{regRegistrationUnitReviewTitle}</span></text>
                    <row><badge variant="outline">{regRegistrationUnitReviewBadge}</badge></row>
                  </grid>
                  <text wrap="true" foreground="text_muted">{regEvidenceHelp}</text>
                </column>
                <use template="profile-field" label="Taxpayer TIN shown on reviewed evidence">
                  <input height="44" text="{regConfirmTinInputValue}" placeholder="9 digits" label="Taxpayer TIN shown on reviewed evidence" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_tin_input"/>
                </use>
                <if test="{regSelectedRegistrationUnitReviewable}">
                  <grid columns="{profileReadColumns}" gap="12">
                  <use template="profile-field" label="Exact BIR Branch Code">
                    <input height="44" text="{regConfirmCodeInputValue}" placeholder="e.g. 00000" label="Exact BIR Branch Code" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_code_input"/>
                  </use>
                  <use template="profile-field" label="RDO code (optional)">
                    <input height="44" text="{regConfirmRdoInputValue}" label="RDO code (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_rdo_input"/>
                  </use>
                  <use template="profile-field" label="Registered address (required)">
                    <input height="44" text="{regAddressValue}" placeholder="Address shown on reviewed evidence" label="Registered address (required)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_address_input"/>
                  </use>
                  <use template="profile-field" label="ZIP code (optional)">
                    <input height="44" text="{regZipValue}" placeholder="4 digits" label="ZIP code (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_zip_input"/>
                  </use>
                  <use template="profile-field" label="Phone / contact number (optional)">
                    <input height="44" text="{regContactValue}" placeholder="+63 900 000 0000" label="Phone / contact number (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_contact_input"/>
                  </use>
                  <use template="profile-field" label="Email address (optional)">
                    <input height="44" text="{regEmailValue}" placeholder="name@example.com" label="Email address (optional)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_email_input"/>
                  </use>
                  </grid>
                </if>
                <grid columns="{profileReadColumns}" gap="12">
                  <use template="profile-field" label="Reviewed evidence effective from">
                    <input height="44" text="{regConfirmEffectiveInputValue}" placeholder="YYYY-MM-DD" label="Reviewed evidence effective from" disabled="{regCanonicalMutationsDisabled}" on-input="reg_confirm_effective_input"/>
                  </use>
                  <use template="profile-field" label="Evidence capture date (required)">
                    <input height="44" text="{regEvidenceCapturedInputValue}" placeholder="YYYY-MM-DD" label="Evidence capture date (required)" disabled="{regCanonicalMutationsDisabled}" on-input="reg_evidence_captured_input"/>
                  </use>
                </grid>
                <if test="{regVatRegistrationChoiceVisible}">
                  <toggle checked="{regVatRegistrationConfirmed}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_toggle_vat_registration">Reviewed evidence confirms active VAT registration</toggle>
                </if>
                <column gap="6">
                  <text>Evidence source</text>
                  <text wrap="true" size="sm" foreground="text_muted">Choose the single reviewed BIR source used for this confirmation.</text>
                  <toggle-group gap="2" label="Evidence source choices">
                    <toggle-button height="44" variant="outline" label="Certificate of Registration (COR)" selected="{regEvidenceSourceCorSelected}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_evidence_source_cor">COR</toggle-button>
                    <toggle-button height="44" variant="outline" label="Electronic Certificate of Registration (eCOR)" selected="{regEvidenceSourceEcorSelected}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_evidence_source_ecor">eCOR</toggle-button>
                    <toggle-button height="44" variant="outline" label="Other BIR registration record" selected="{regEvidenceSourceBirRecordSelected}" disabled="{regCanonicalMutationsDisabled}" on-toggle="reg_evidence_source_bir_record">Other BIR record</toggle-button>
                  </toggle-group>
                </column>
                <column gap="6">
                  <text>Reviewed evidence file</text>
                  <grid columns="{profileReadColumns}" gap="8">
                    <button height="44" variant="outline" label="Choose reviewed registration evidence file" disabled="{regCanonicalMutationsDisabled}" on-press="reg_choose_evidence_file">Choose evidence file</button>
                    <text wrap="true">{regEvidenceFileLabel}</text>
                  </grid>
                  <if test="{regEvidenceFileProblemVisible}">
                    <text wrap="true" foreground="warning">{regEvidenceFileHelp}</text>
                  </if>
                  <else>
                    <text wrap="true" foreground="text_muted">{regEvidenceFileHelp}</text>
                  </else>
                </column>
                <text wrap="true" foreground="text_muted">{regDateHelp}</text>
                <if test="{regEvidenceFormProblemVisible}">
                  <alert text="Check reviewed evidence details">
                    <text wrap="true">{regEvidenceFormHelp}</text>
                  </alert>
                </if>
                <row>
                  <button height="44" variant="primary" label="{regConfirmActionLabel}" disabled="{regConfirmDisabled or regCanonicalMutationsDisabled}" on-press="reg_confirm_selected_unit">{regConfirmActionLabel}</button>
                </row>
              </column>
              <separator/>
            </if>

            <use template="registration-action-feedback" visible="{regConfirmationActionVisible}"/>

            <column gap="12">
                <grid columns="{profileReadColumns}" gap="8">
                  <column grow="1" gap="3">
                    <text><span weight="bold">2550Q filing-scope check</span></text>
                    <text wrap="true" foreground="text_muted">{regPlanningPeriodLabel}</text>
                  </column>
                  <if test="{regPolicyCatalogMissing}">
                    <row><badge variant="destructive">Policy Review Required</badge></row>
                  </if>
                  <else>
                    <row><badge variant="outline">Reviewed fixture policy</badge></row>
                  </else>
                </grid>
                <text wrap="true">{regPlanningStatusLabel}</text>
                <grid columns="{profileReadColumns}" gap="12">
                  <use template="profile-read-value" label="Workspace focus (view only)" value="{regSelectedRegistrationUnitLabel}"/>
                  <use template="profile-read-value" label="Resolved Filing Unit branch code" value="{regResolvedFilingCodeLabel}"/>
                  <use template="profile-read-value" label="Resolved Filing Unit RDO" value="{regResolvedFilingRdoLabel}"/>
                  <use template="profile-read-value" label="Projected filer identity" value="{regProjectedFilerTinLabel}"/>
                  <use template="profile-read-value" label="Resolved form revision" value="{regResolvedFormRevisionLabel}"/>
                  <use template="profile-read-value" label="Policy revision" value="{regPolicyCatalogLabel}"/>
                </grid>
                <column gap="4">
                  <text size="sm" foreground="text_muted">Return Coverage</text>
                  <if test="{regCoverageVisible}">
                    <for each="regCoverageRows" key="id" as="coverage">
                      <text wrap="true">{coverage.accessibleLabel}</text>
                    </for>
                  </if>
                  <else><text>Not resolved</text></else>
                </column>
                <column gap="4">
                  <text size="sm" foreground="text_muted">Policy evidence</text>
                  <if test="{regPolicyEvidenceVisible}">
                    <for each="regPolicyEvidenceRows" key="id" as="evidence">
                      <column gap="3">
                        <text><span weight="bold">{evidence.displayName}</span></text>
                        <text wrap="true">{evidence.reviewBasis}</text>
                        <text size="sm" wrap="true" foreground="text_muted">Evidence ID: {evidence.evidenceId}</text>
                      </column>
                    </for>
                  </if>
                  <else><text wrap="true">{regPolicyEvidenceLabel}</text></else>
                </column>
                <use template="profile-read-value" label="Preview scope validation" value="{regProvenanceLabel}"/>
                <use template="profile-read-value" label="Editor and filing capability" value="{regFileabilityLabel}"/>
                <if test="{regRepairActionsVisible}">
                  <column gap="6">
                    <text><span weight="bold">Why review is required</span></text>
                    <for each="regReviewReasonRows" key="id" as="reason">
                      <text wrap="true" foreground="warning">• {reason.label}</text>
                    </for>
                    <text wrap="true" foreground="text_muted">{regRepairHelp}</text>
                  </column>
                </if>
                <text wrap="true" foreground="text_muted">{regReadinessHelp}</text>
              <row><button height="44" variant="primary" global-key="{registrationPreviewOpenerIdentity}" autofocus="{regResolved2550QPreviewOpenerAutofocus}" disabled="{regResolved2550QPreviewDisabled}" on-press="reg_open_resolved_2550q_preview">Open resolved 2550Q preview</button></row>
            </column>

          </column>
        </else>

        <if test="{regLegacyReviewVisible}">
          <card padding="0">
            <column padding="16" gap="8">
              <grid columns="{profileReadColumns}" gap="8">
                <row><badge variant="outline">Legacy Taxpayer Profile context · separate</badge></row>
                <row><badge variant="destructive">Review Required</badge></row>
              </grid>
              <text><span weight="bold">{profileRegistrationLegacyWorkspaceLabel}</span></text>
              <text label="{profileRegistrationMaskedTinRootLabel}"><span mono="true">{profileRegistrationMaskedTinRoot}</span></text>
              <text wrap="true" foreground="text_muted">{profileRegistrationBranchCodeLabel}</text>
              <text wrap="true" foreground="text_muted">{regLegacyHelp}</text>
            </column>
          </card>
        </if>
      </column>
    </if>

    <if test="{profileTaxFormsActive}">
      <column gap="16">
        <if test="{profileFormsHeaderStacked}">
          <column gap="10">
            <column gap="4">
              <text><span weight="bold">Forms Set</span></text>
              <text wrap="true" foreground="text_muted">{profileFormsSetHelp}</text>
            </column>
            <use template="profile-setup-year-combobox"/>
          </column>
        </if>
        <else>
          <row gap="12" cross="center">
            <column grow="1" gap="4">
              <text><span weight="bold">Forms Set</span></text>
              <text wrap="true" foreground="text_muted">{profileFormsSetHelp}</text>
            </column>
            <use template="profile-setup-year-combobox"/>
          </row>
        </else>

        <if test="{editingNewProfile}">
          <card padding="0">
            <column padding="20" gap="6">
              <text><span weight="bold">Save this taxpayer first</span></text>
              <text wrap="true" foreground="text_muted">{profileFormsUnsavedHelp}</text>
            </column>
          </card>
        </if>
        <else>
          <use template="profile-setup-cor-card"/>
          <if test="{profileCorReviewOpen}">
            <use template="profile-setup-cor-review"/>
          </if>

          <if test="{profileSetupPendingSwitchVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupPendingSwitchTitle}</span></text>
                <text wrap="true" foreground="text_muted">{profileSetupPendingSwitchBody}</text>
                <row gap="8">
                  <button
                    height="44"
                    variant="primary"
                    autofocus="true"
                    on-press="profile_setup_cancel_year_switch">Keep editing</button>
                  <button
                    height="44"
                    variant="outline"
                    on-press="profile_setup_confirm_year_switch">Discard changes</button>
                </row>
              </column>
            </card>
          </if>

          <if test="{profileSetupOpenFailedVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupStatusLabel}</span></text>
                <row>
                  <button
                    height="44"
                    variant="outline"
                    on-press="profile_setup_retry_year">Try again</button>
                </row>
              </column>
            </card>
          </if>
          <else>
            <text wrap="true" foreground="text_muted">{profileSetupStatusLabel}</text>
          </else>

          <if test="{profileSetupConflictVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupConflictTitle}</span></text>
                <text wrap="true" foreground="text_muted">{profileFormsConflictHelp}</text>
                <row gap="8">
                  <button
                    height="44"
                    variant="primary"
                    on-press="profile_setup_conflict_review">{profileSetupConflictReviewLabel}</button>
                  <button
                    height="44"
                    variant="outline"
                    on-press="profile_setup_conflict_discard">Discard my draft</button>
                </row>
              </column>
            </card>
          </if>

          <if test="{profileSetupDraftBannerVisible}">
            <card padding="0">
              <column padding="16" gap="10">
                <text><span weight="bold">{profileSetupDraftTitle}</span></text>
                <if test="{profileSetupDraftChoiceVisible}">
                  <column gap="8">
                    <text wrap="true" foreground="text_muted">{profileFormsDraftHelp}</text>
                    <if test="{profileFormsHeaderStacked}">
                      <column gap="8">
                        <button
                          height="44"
                          variant="outline"
                          on-press="profile_setup_draft_empty">Start empty</button>
                        <if test="{profileSetupSeedAvailable}">
                          <button
                            height="44"
                            variant="primary"
                            on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button>
                        </if>
                      </column>
                    </if>
                    <else>
                      <row gap="8">
                        <button
                          height="44"
                          variant="outline"
                          on-press="profile_setup_draft_empty">Start empty</button>
                        <if test="{profileSetupSeedAvailable}">
                          <button
                            height="44"
                            variant="primary"
                            on-press="profile_setup_draft_seed:{profileSetupSeedYear}">{profileSetupSeedLabel}</button>
                        </if>
                      </row>
                    </else>
                  </column>
                </if>
                <if test="{profileSetupSeededVisible}">
                  <column gap="8">
                    <text><span weight="bold">{profileSetupSourceLabel}</span></text>
                    <text wrap="true" foreground="text_muted">{profileSetupSourceSummary}</text>
                    <use template="profile-setup-source-picker"/>
                  </column>
                </if>
                <text wrap="true" foreground="text_muted">{profileSetupInheritanceNote}</text>
                <text wrap="true" foreground="text_muted">{profileFormsInheritanceHelp}</text>
              </column>
            </card>
          </if>

          <if test="{profileSetupBrowseVisible}">
            <column gap="16">
              <row main="end">
                <button
                  height="44"
                  variant="outline"
                  icon="settings"
                  on-press="profile_forms_manage">Manage Forms</button>
              </row>
              <!-- @include-template taxpayer-form-library-section -->
            </column>
          </if>

          <if test="{profileSetupManagerVisible}">
            <if test="{profileSetupScopeVisible}">
              <column gap="10">
                <text><span weight="bold">When does this apply?</span></text>
                <if test="{constrainedLayout}">
                  <column gap="8">
                    <button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button>
                    <button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button>
                  </column>
                </if>
                <else>
                  <row gap="8">
                    <button height="44" variant="outline" selected="{profileSetupScopeWholeYearSelected}" on-press="profile_setup_apply_whole_year">Whole year</button>
                    <button height="44" variant="outline" selected="{profileSetupScopeFromDateSelected}" on-press="profile_setup_apply_from_date">From a date</button>
                  </row>
                </else>
                <if test="{profileSetupScopeDateVisible}">
                  <use template="profile-field" label="Change takes effect">
                    <input
                      height="44"
                      text="{profileSetupChangeDateValue}"
                      placeholder="YYYY-MM-DD"
                      label="Change takes effect"
                      on-input="profile_setup_change_date_input"/>
                  </use>
                  <text wrap="true" foreground="text_muted">{profileFormsChangeHelp}</text>
                </if>
              </column>
            </if>
            <if test="{profileSetupZeroFormsHelperVisible}">
              <text wrap="true" foreground="text_muted">{profileSetupZeroFormsHelperText}</text>
            </if>
            <if test="{profileSetupDeactivationWarningVisible}">
              <card padding="0"><column padding="12" gap="6"><text><span weight="bold">Confirm deactivation on Save</span></text><text wrap="true" foreground="text_muted">{profileSetupDeactivationWarningText}</text></column></card>
            </if>
            <if test="{profileFormsHeaderStacked}">
              <column gap="10">
                <button
                  height="44"
                  variant="primary"
                  icon="save"
                  disabled="{profileSetupPrimaryDisabled}"
                  on-press="profile_setup_save">{profileSetupPrimaryLabel}</button>
                <button
                  height="44"
                  variant="outline"
                  disabled="{profileFormsCancelDisabled}"
                  on-press="profile_forms_cancel">Cancel</button>
              </column>
            </if>
            <else>
              <row main="end" gap="12">
                <button
                  height="44"
                  variant="outline"
                  disabled="{profileFormsCancelDisabled}"
                  on-press="profile_forms_cancel">Cancel</button>
                <button
                  height="44"
                  variant="primary"
                  icon="save"
                  disabled="{profileSetupPrimaryDisabled}"
                  on-press="profile_setup_save">{profileSetupPrimaryLabel}</button>
              </row>
            </else>
            <if test="{profileSetupChangesVisible}">
              <column gap="8">
                <row>
                  <button
                    height="44"
                    variant="ghost"
                    icon="chevron-right"
                    on-press="profile_setup_toggle_changes_disclosure">{profileSetupChangesDisclosureLabel}</button>
                </row>
                <if test="{profileSetupChangesExpandedVisible}">
                  <column gap="8">
                    <for each="profileSetupChangeRows" key="id" as="change">
                      <card padding="0">
                        <row padding="12" gap="12" cross="center">
                          <column grow="1" gap="2">
                            <text><span weight="bold">{change.rangeLabel}</span></text>
                            <text foreground="text_muted">{change.formsLabel}</text>
                          </column>
                          <if test="{change.todayBadgeVisible}">
                            <badge variant="secondary">Covers today</badge>
                          </if>
                        </row>
                      </card>
                    </for>
                    <text wrap="true" foreground="text_muted">{profileFormsReferenceHelp}</text>
                  </column>
                </if>
              </column>
            </if>
            <!-- @include-template taxpayer-form-library-section -->
          </if>

          <if test="{profileSetupYearsDisclosureVisible}">
            <column gap="8">
              <row>
                <button
                  height="44"
                  variant="ghost"
                  icon="chevron-right"
                  on-press="profile_setup_toggle_years_disclosure">{profileSetupYearsDisclosureLabel}</button>
              </row>
              <if test="{profileSetupYearsExpandedVisible}">
                <column gap="8">
                  <for each="profileFormSetRows" key="id" as="set">
                    <card padding="0">
                      <row padding="12" gap="12" cross="center">
                        <text width="60" text-alignment="center"><span weight="bold">{set.yearLabel}</span></text>
                        <column width="1" height="36" background="border"></column>
                        <column grow="1" gap="2">
                          <text foreground="text_muted">{set.formsLabel}</text>
                        </column>
                        <badge variant="secondary">{set.stateLabel}</badge>
                        <button
                          height="44"
                          variant="outline"
                          on-press="profile_setup_select_year:{set.tax_year}">Open</button>
                      </row>
                    </card>
                  </for>
                </column>
              </if>
            </column>
          </if>
        </else>
      </column>
    </if>

    <if test="{profileEmailActive}">
      <column gap="12">
          <text><span weight="bold">Email monitoring credentials</span></text>
          <text wrap="true" foreground="text_muted">{profileEmailSecretHelp}</text>
          <button height="44" variant="outline" icon="send" disabled="true">Configure secure mailbox connection</button>
      </column>
    </if>

    <if test="{profileEditorActionsVisible}">
      <grid columns="{profileReadColumns}" gap="10">
        <button height="44" variant="outline" disabled="{profileCancelDisabled}" on-press="cancel_profile_edit">Cancel</button>
        <button
          height="44"
          variant="primary"
          icon="save"
          disabled="{profileSaveDisabled}"
          on-press="save_profile">
          {profileSaveLabel}
        </button>
      </grid>
    </if>
  </column>
</template>

<template name="profile-setup-page">
  <scroll grow="1" global-key="page-profile-setup" label="Taxpayer profile setup content" value="{profileSetupScrollOffset}" on-scroll="profile_setup_scrolled">
    <if test="{phoneLayout}">
      <column padding="16">
        <use template="profile-setup-content"/>
      </column>
    </if>
    <else>
      <if test="{constrainedLayout}">
        <column padding="20">
          <use template="profile-setup-content"/>
        </column>
      </if>
      <else>
        <column padding="32">
          <use template="profile-setup-content"/>
        </column>
      </else>
    </else>
  </scroll>
</template>
