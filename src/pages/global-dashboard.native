<template name="global-news-item" args="title body meta">
  <card>
    <column padding="16" gap="8">
      <text><span weight="bold">{title}</span></text>
      <text wrap="true" foreground="text_muted">{body}</text>
      <text foreground="text_muted">{meta}</text>
    </column>
  </card>
</template>

<template name="global-calendar-column">
  <column grow="1" gap="12">
    <row cross="center" gap="12">
      <column grow="1" gap="4">
        <text><span weight="bold">Compliance Calendar</span></text>
        <text wrap="true" foreground="text_muted">One resolver for rules, dates, holidays, and extensions</text>
      </column>
      <badge variant="secondary">{calendarDeadlineCount}</badge>
    </row>

    <card>
      <column padding="20" gap="12">
        <row gap="10" cross="center">
          <icon name="clock" foreground="accent" width="26" height="26"/>
          <column grow="1" gap="4">
            <text><span weight="bold">{currentCalendarYear} tax deadline rules</span></text>
            <text wrap="true" foreground="text_muted">
              Shared rules and sourced policy records are used when a taxpayer
              profile resolves its schedule.
            </text>
          </column>
        </row>
        <separator/>
        <text wrap="true" foreground="text_muted">
          Saturdays and Sundays adjust automatically. Only source-cited
          SQLite non-working days and deadline overrides change the schedule.
        </text>
        <button variant="primary" icon="external-link" on-press="show_tax_calendar">Review Calendar Rules</button>
      </column>
    </card>
  </column>
</template>

<template name="global-news-column">
  <column grow="1" gap="12">
    <row cross="center" gap="12">
      <column grow="1" gap="4">
        <text><span weight="bold">Important News</span></text>
        <text wrap="true" foreground="text_muted">BIR updates and application notices</text>
      </column>
      <button size="sm" variant="ghost" icon="refresh-cw" disabled="true">Refresh</button>
    </row>

    <use
      template="global-news-item"
      title="Stay current with BIR advisories"
      body="Review official issuances before filing. The calendar is computed from compiled rules plus source-cited local policy records."
      meta="Application notice"/>
    <use
      template="global-news-item"
      title="Quarterly returns use typed taxable periods"
      body="Confirm taxpayer classifications and registered tax types before preparing each return."
      meta="Calendar guidance"/>
    <use
      template="global-news-item"
      title="Keep profile information complete"
      body="Accurate registration details help pre-fill forms consistently across the application."
      meta="Profile guidance"/>

    <card>
      <column padding="20" gap="10">
        <row gap="10" cross="center">
          <icon name="info" foreground="info" width="22" height="22"/>
          <text><span weight="bold">Calendar source of truth</span></text>
        </row>
        <text wrap="true" foreground="text_muted">
          Calendar rules, year projection, overrides, non-working days, and
          export now share one tested resolver. News content remains a static application notice.
        </text>
      </column>
    </card>
  </column>
</template>

<template name="global-dashboard-content" args="padding">
  <column padding="{padding}" gap="24">
    <if test="{constrainedLayout}">
      <column gap="12">
        <column gap="6">
          <text size="heading">Global Dashboard</text>
          <text wrap="true" foreground="text_muted">Overview of all taxpayer profiles for {currentCalendarYear}</text>
        </column>
        <button variant="outline" icon="refresh-cw" disabled="true">Refresh</button>
      </column>
    </if>
    <else>
      <row cross="center" gap="16">
        <column grow="1" gap="6">
          <text size="heading">Global Dashboard</text>
          <text foreground="text_muted">Overview of all taxpayer profiles for {currentCalendarYear}</text>
        </column>
        <button variant="outline" icon="refresh-cw" disabled="true">Refresh</button>
      </row>
    </else>

    <if test="{constrainedLayout}">
      <column gap="24">
        <use template="global-calendar-column"/>
        <use template="global-news-column"/>
      </column>
    </if>
    <else>
      <row gap="20" cross="start">
        <use template="global-calendar-column"/>
        <use template="global-news-column"/>
      </row>
    </else>
  </column>
</template>

<template name="global-dashboard-page">
  <scroll grow="1" global-key="page-global-dashboard" label="Global dashboard content">
    <if test="{phoneLayout}">
      <use template="global-dashboard-content" padding="16"/>
    </if>
    <else>
      <if test="{desktopLayout}">
        <use template="global-dashboard-content" padding="32"/>
      </if>
      <else>
        <use template="global-dashboard-content" padding="24"/>
      </else>
    </else>
  </scroll>
</template>
