<template name="d-s" args="d y c t p">
  <card padding="0">
    <row padding="12" gap="14" cross="center">
      <column width="58" gap="2" cross="center">
        <text><span weight="bold">{d}</span></text>
        <text foreground="text_muted">{y}</text>
      </column>
      <column width="1" height="54" background="border"></column>
      <column grow="1" gap="4">
        <row gap="8" cross="center"><badge variant="secondary">{c}</badge><slot/></row>
        <text><span weight="bold">{t}</span></text>
        <text wrap="true" foreground="text_muted">Taxable period: {p}</text>
      </column>
    </row>
  </card>
</template>

<template name="global-news-item" args="title summary source published">
  <card padding="0">
    <column padding="12" gap="6">
      <row cross="center" gap="6">
        <badge variant="secondary">{source}</badge>
        <text size="sm" grow="1" text-alignment="end" foreground="text_muted">{published}</text>
      </row>
      <text size="sm"><span weight="bold">{title}</span></text>
      <text size="sm" wrap="true" foreground="text_muted">{summary}</text>
    </column>
  </card>
</template>

<template name="global-calendar-weekday" args="label">
  <column height="34" padding="6" main="center" cross="center" background="surface_subtle">
    <text text-alignment="center" foreground="text_muted">
      <span weight="bold">{label}</span>
    </text>
  </column>
</template>

<template name="global-calendar-empty-state">
  <column padding="16" gap="8" cross="center" background="surface_subtle" radius="md">
    <icon name="clock" foreground="text_muted" width="24" height="24"/>
    <text><span weight="bold">No deadlines to show</span></text>
    <text wrap="true" text-alignment="center" foreground="text_muted">
      No selected forms have a resolved deadline for this view.
    </text>
  </column>
</template>

<template name="global-calendar-column">
  <column width="{globalCalendarLaneWidth}" gap="12">
    <if test="{globalCalendarHeaderStacked}">
      <column gap="10">
        <text><span weight="bold">Compliance Calendar</span></text>
        <!-- @include-template multi-select-combobox
          placeholder="Search form codes..."
          label="Filter global compliance forms"
        -->
      </column>
    </if>
    <else>
      <row cross="center" gap="12">
        <text grow="1"><span weight="bold">Compliance Calendar</span></text>
        <!-- @include-template multi-select-combobox
          placeholder="Search form codes..."
          label="Filter global compliance forms"
        -->
      </row>
    </else>

    <card padding="0">
      <column gap="0">
        <row padding="12" cross="center" gap="8">
          <text grow="1"><span weight="bold">{globalCalendarMonth} {globalCalendarYear}</span></text>
          <row cross="center" gap="2">
            <button
              width="44"
              height="44"
              size="icon"
              variant="ghost"
              icon="chevron-left"
              label="Previous month"
              on-press="global_calendar_previous_month"></button>
            <button
              width="44"
              height="44"
              size="icon"
              variant="ghost"
              icon="chevron-right"
              label="Next month"
              on-press="global_calendar_next_month"></button>
          </row>
        </row>
        <separator/>
        <grid columns="7" gap="1" background="border">
          <use template="global-calendar-weekday" label="Sun"/>
          <use template="global-calendar-weekday" label="Mon"/>
          <use template="global-calendar-weekday" label="Tue"/>
          <use template="global-calendar-weekday" label="Wed"/>
          <use template="global-calendar-weekday" label="Thu"/>
          <use template="global-calendar-weekday" label="Fri"/>
          <use template="global-calendar-weekday" label="Sat"/>

          <for each="globalCalendarDays" key="id" as="cell">
            <column height="{globalCalendarDayHeight}" cross="stretch" background="surface_subtle">
              <if test="{cell.blank}">
                <spacer/>
              </if>
              <else>
                <column
                  grow="1"
                  padding="7"
                  main="space_between"
                  cross="stretch"
                  background="surface"
                  role="button"
                  label="{cell.actionLabel}"
                  selected="{cell.selected}"
                  on-press="global_calendar_select_day:{cell.day}">
                  <if test="{cell.selected}">
                    <row main="center">
                      <badge variant="primary">{cell.dayLabel}</badge>
                    </row>
                  </if>
                  <else>
                    <text text-alignment="center">{cell.dayLabel}</text>
                  </else>
                <if test="{cell.hasDeadlines}">
                    <row grow="1" main="center" cross="center">
                      <if test="{cell.overdue}">
                        <text foreground="destructive">{cell.marker}</text>
                      </if>
                      <else>
                        <if test="{cell.dueSoon}">
                          <text foreground="warning">{cell.marker}</text>
                        </if>
                        <else>
                          <if test="{cell.approaching}">
                            <text foreground="success">{cell.marker}</text>
                          </if>
                          <else>
                            <text>{cell.marker}</text>
                          </else>
                        </else>
                      </else>
                    </row>
                  </if>
                </column>
              </else>
            </column>
          </for>
        </grid>
      </column>
    </card>

    <row cross="center" gap="10">
      <text grow="1"><span weight="bold">{globalCalendarDeadlineHeading}</span></text>
      <badge variant="secondary">{globalCalendarDeadlineCount}</badge>
    </row>
    <if test="{globalCalendarHasDeadlines}">
      <for each="globalDeadlines" key="id" as="deadline">
        <use template="d-s" d="{deadline.dateLabel}" y="{deadline.yearLabel}" c="{deadline.display_form_no}" t="{deadline.form_name}" p="{deadline.periodLabel}">
          <badge variant="{deadline.tone}">{deadline.statusLabel}</badge>
        </use>
      </for>
    </if>
    <else>
      <use template="global-calendar-empty-state"/>
    </else>
  </column>
</template>

<template name="global-news-column" args="weight=1">
  <column grow="{weight}" gap="12">
    <row cross="center" gap="12">
      <text grow="1"><span weight="bold">Important News</span></text>
      <if test="{constrainedLayout}">
        <if test="{importantNewsRefreshing}">
          <button
            width="44"
            height="44"
            size="icon"
            variant="secondary"
            icon="refresh-cw"
            label="Refreshing important news"
            disabled="{importantNewsRefreshDisabled}"
            on-press="refresh_important_news"></button>
        </if>
        <else>
          <button
            width="44"
            height="44"
            size="icon"
            variant="secondary"
            icon="refresh-cw"
            label="Refresh important news"
            disabled="{importantNewsRefreshDisabled}"
            on-press="refresh_important_news"></button>
        </else>
      </if>
      <else>
        <if test="{importantNewsRefreshing}">
          <button
            size="sm"
            variant="secondary"
            icon="refresh-cw"
            disabled="{importantNewsRefreshDisabled}"
            on-press="refresh_important_news">Refreshing…</button>
        </if>
        <else>
          <button
            size="sm"
            variant="secondary"
            icon="refresh-cw"
            disabled="{importantNewsRefreshDisabled}"
            on-press="refresh_important_news">Refresh</button>
        </else>
      </else>
    </row>

    <if test="{importantNewsErrorVisible}">
      <alert label="Important news refresh failed">
        <row gap="10" cross="start">
          <icon name="alert" foreground="destructive" width="20" height="20"/>
          <column grow="1" gap="2">
            <text><span weight="bold">Could not refresh important news</span></text>
            <text wrap="true" foreground="text_muted">{importantNewsError}</text>
          </column>
          <button
            width="44"
            height="44"
            size="icon"
            variant="ghost"
            radius="xl"
            icon="x"
            label="Dismiss important news error"
            on-press="dismiss_important_news_error">
          </button>
        </row>
      </alert>
    </if>

    <if test="{importantNewsLoadingEmpty}">
      <column padding="20" gap="8" cross="center">
        <icon name="refresh-cw" foreground="text_muted" width="24" height="24"/>
        <text><span weight="bold">Loading important news…</span></text>
        <text wrap="true" text-alignment="center" foreground="text_muted">
          Checking the latest notices while keeping your cached news available.
        </text>
      </column>
    </if>

    <if test="{importantNewsEmpty}">
      <column padding="20" gap="8" cross="center">
        <icon name="file-text" foreground="text_muted" width="24" height="24"/>
        <text><span weight="bold">No important news yet</span></text>
        <text wrap="true" text-alignment="center" foreground="text_muted">
          Refresh to check for the latest notices.
        </text>
      </column>
    </if>

    <if test="{importantNewsHasRows}">
      <for each="importantNewsRows" key="id" as="item">
        <use
          template="global-news-item"
          title="{item.title}"
          summary="{item.summary}"
          source="{item.source}"
          published="{item.publishedLabel}"/>
      </for>
    </if>
  </column>
</template>

<template name="global-dashboard-content">
  <column padding="{globalDashboardPagePadding}" gap="32">
    <if test="{constrainedLayout}">
    </if>
    <else>
      <column gap="6">
        <text size="heading">Global Dashboard</text>
        <text wrap="true" foreground="text_muted">
          Global tax schedule for {globalCalendarYear}. Profile choices do not filter this calendar.
        </text>
      </column>
    </else>

    <if test="{globalDashboardTwoColumnLayout}">
      <row gap="20" cross="start">
      <use template="global-calendar-column"/>
        <use template="global-news-column" weight="1"/>
      </row>
    </if>
    <else>
      <column gap="24">
      <use template="global-calendar-column"/>
        <use template="global-news-column" weight="1"/>
      </column>
    </else>
  </column>
</template>

<template name="global-dashboard-page">
  <scroll grow="1" global-key="page-global-dashboard" label="Global dashboard content">
    <use template="global-dashboard-content"/>
  </scroll>
</template>
