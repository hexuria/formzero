<template name="global-deadline-row" args="date form title detail">
  <card padding="0">
    <row padding="12" gap="14" cross="center">
      <card padding="0" background="surface_subtle">
        <column width="54" height="54" main="center" cross="center" gap="1">
          <text foreground="text_muted"><span weight="bold">JUL</span></text>
          <text size="heading"><span weight="bold">{date}</span></text>
        </column>
      </card>
      <column grow="1" gap="4">
        <text><span weight="bold">{form}</span></text>
        <text wrap="true" foreground="text_muted">{title}</text>
        <if test="{detail}">
          <text wrap="true" foreground="text_muted">{detail}</text>
        </if>
      </column>
    </row>
  </card>
</template>

<template name="global-news-item" args="title body meta">
  <card padding="0">
    <column padding="16" gap="8">
      <row cross="center" gap="8">
        <badge variant="secondary">RSS Feed</badge>
        <text grow="1" text-alignment="end" foreground="text_muted">{meta}</text>
      </row>
      <text><span weight="bold">{title}</span></text>
      <text wrap="true" foreground="text_muted">{body}</text>
    </column>
  </card>
</template>

<template name="global-calendar-weekday" args="label">
  <column height="34" padding="6" main="center" cross="center" background="surface_subtle">
    <text text-alignment="center" foreground="text_muted">
      <span weight="bold">{label}</span>
    </text>
  </column>
</template>

<template name="global-calendar-day" args="day marker=">
  <column height="58" padding="7" main="space_between" cross="stretch" background="surface">
    <text text-alignment="end">{day}</text>
    <if test="{marker}">
      <text text-alignment="center" foreground="destructive">{marker}</text>
    </if>
  </column>
</template>

<template name="global-calendar-warning-day" args="day marker=">
  <column height="58" padding="7" main="space_between" cross="stretch" background="surface">
    <text text-alignment="end">{day}</text>
    <if test="{marker}">
      <text text-alignment="center" foreground="warning">{marker}</text>
    </if>
  </column>
</template>

<template name="global-calendar-empty">
  <column height="58" background="surface_subtle"></column>
</template>

<template name="global-calendar-today">
  <column height="58" padding="7" main="space_between" cross="stretch" background="surface">
    <row main="end">
      <badge variant="outline">29</badge>
    </row>
    <spacer/>
  </column>
</template>

<template name="global-calendar-column">
  <column grow="1" gap="12">
    <if test="{constrainedLayout}">
      <column gap="10">
        <text><span weight="bold">Compliance Calendar</span></text>
        <use
          template="multi-select-combobox"
          value="{formFilterText}"
          query="{formFilterQuery}"
          open="{formFilterOpen}"
          options="{visibleFormOptions}"
          allselected="{formFilterAllFilteredSelected}"
          hiddencount="{formFilterHiddenCount}"
          width="240"
          menuheight="420"
          placeholder="Search form codes..."
          label="Filter compliance calendar forms"/>
      </column>
    </if>
    <else>
      <row cross="center" gap="12">
        <text grow="1"><span weight="bold">Compliance Calendar</span></text>
        <use
          template="multi-select-combobox"
          value="{formFilterText}"
          query="{formFilterQuery}"
          open="{formFilterOpen}"
          options="{visibleFormOptions}"
          allselected="{formFilterAllFilteredSelected}"
          hiddencount="{formFilterHiddenCount}"
          width="240"
          menuheight="420"
          placeholder="Search form codes..."
          label="Filter compliance calendar forms"/>
      </row>
    </else>

    <card padding="0">
      <column gap="0">
        <row padding="12" cross="center" gap="8">
          <text grow="1"><span weight="bold">July 2026</span></text>
          <row padding="4" cross="center" gap="2" background="surface_subtle" radius="md">
            <button
              size="sm"
              variant="ghost"
              icon="chevron-left"
              label="Previous month"></button>
            <button
              size="sm"
              variant="ghost"
              icon="chevron-right"
              label="Next month"></button>
          </row>
        </row>
        <separator/>
        <grid columns="7" gap="1" background="border">
          <use template="global-calendar-weekday" label="Sun"/>
          <use template="global-calendar-weekday" label="Mon"/>
          <use template="global-calendar-weekday" label="Tue"/>
          <use template="global-calendar-weekday" label="Wed"/>
          <use template="global-calendar-weekday" label="Thu"/>
          <use template="global-calendar-weekday" label="Fri"/>
          <use template="global-calendar-weekday" label="Sat"/>

          <use template="global-calendar-empty"/>
          <use template="global-calendar-empty"/>
          <use template="global-calendar-empty"/>
          <use template="global-calendar-day" day="1"/>
          <use template="global-calendar-day" day="2"/>
          <use template="global-calendar-day" day="3"/>
          <use template="global-calendar-day" day="4"/>

          <use template="global-calendar-day" day="5"/>
          <use template="global-calendar-day" day="6"/>
          <use template="global-calendar-day" day="7"/>
          <use template="global-calendar-day" day="8"/>
          <use template="global-calendar-day" day="9"/>
          <use template="global-calendar-day" day="10" marker="{calendarDay10Marker}"/>
          <use template="global-calendar-day" day="11"/>

          <use template="global-calendar-day" day="12"/>
          <use template="global-calendar-day" day="13"/>
          <use template="global-calendar-day" day="14"/>
          <use template="global-calendar-day" day="15" marker="{calendarDay15Marker}"/>
          <use template="global-calendar-day" day="16"/>
          <use template="global-calendar-day" day="17"/>
          <use template="global-calendar-day" day="18"/>

          <use template="global-calendar-day" day="19"/>
          <use template="global-calendar-day" day="20"/>
          <use template="global-calendar-day" day="21"/>
          <use template="global-calendar-day" day="22"/>
          <use template="global-calendar-day" day="23"/>
          <use template="global-calendar-day" day="24"/>
          <use template="global-calendar-day" day="25"/>

          <use template="global-calendar-day" day="26"/>
          <use template="global-calendar-day" day="27" marker="{calendarDay27Marker}"/>
          <use template="global-calendar-day" day="28"/>
          <use template="global-calendar-today"/>
          <use template="global-calendar-day" day="30"/>
          <use
            template="global-calendar-warning-day"
            day="31"
            marker="{calendarDay31Marker}"/>
          <use template="global-calendar-empty"/>
        </grid>
      </column>
    </card>

    <text><span weight="bold">Deadlines for July 2026</span></text>
    <if test="{hasVisibleGlobalDeadlines}">
      <for each="visibleGlobalDeadlines" key="id" as="deadline">
        <use
          template="global-deadline-row"
          date="{deadline.day}"
          form="{deadline.form}"
          title="{deadline.title}"
          detail="{deadline.detail}"/>
      </for>
    </if>
    <else>
      <card padding="0">
        <column padding="24" gap="8" cross="center">
          <icon name="file-text" foreground="text_muted" width="22" height="22"/>
          <text><span weight="bold">No upcoming deadlines</span></text>
          <text wrap="true" text-alignment="center" foreground="text_muted">
            Select one or more forms to show their July filing deadlines.
          </text>
        </column>
      </card>
    </else>
  </column>
</template>

<template name="global-news-column">
  <column grow="1" gap="12">
    <row cross="center" gap="12">
      <text grow="1"><span weight="bold">Important News</span></text>
      <button size="sm" variant="secondary">Refresh</button>
    </row>

    <use
      template="global-news-item"
      title="Executive Order No. 115, s. 2026"
      body="STRENGTHENING THE TECHNICAL COOPERATION COUNCIL OF THE PHILIPPINES"
      meta="Wed, 29 Apr 2026 02:00:36 +0000"/>
    <use
      template="global-news-item"
      title="Republic Act No. 12321"
      body="AN ACT INSTITUTIONALIZING SUPPORT FOR PUBLIC BASIC EDUCATION SCHOOLS IN GEOGRAPHICALLY ISOLATED AND DISADVANTAGED AREAS (GIDA) AND UNDERSERVED COMMUNITIES, AND APPROPRIATING FUNDS THEREFOR"
      meta="Wed, 22 Jul 2026 03:04:07 +0000"/>
    <use
      template="global-news-item"
      title="DMW-Advisory No. 44, s. 2026"
      body="OWWA E-CARD AS AN OFW'S PRIMARY IDENTIFICATION CARD AND VALID GOVERNMENT-ISSUED ID"
      meta="Wed, 15 Jul 2026 02:00:38 +0000"/>
    <use
      template="global-news-item"
      title="Executive Order No. 118, s. 2026"
      body="MALACAÑAN PALACE MANILA BY THE PRESIDENT OF THE PHILIPPINES EXECUTIVE ORDER NO. 118 IMPOSITION OF A MANDATED PRICE CEILING ON IMPORTED RICE"
      meta="Wed, 13 May 2026 08:00:36 +0000"/>
    <use
      template="global-news-item"
      title="Proclamation No. 1317 s. 2026"
      body="DECLARING WEDNESDAY, 01 JULY 2026 AS A SPECIAL (NON-WORKING) DAY IN THE CITY OF DIPOLOG, PROVINCE OF ZAMBOANGA DEL NORTE"
      meta="Wed, 10 Jun 2026 04:05:31 +0000"/>
    <use
      template="global-news-item"
      title="Proclamation No. 1316 s. 2026"
      body="DECLARING WEDNESDAY, 01 JULY 2026, A SPECIAL (NON-WORKING) DAY IN THE MUNICIPALITY OF KIBAWE"
      meta="Wed, 10 Jun 2026 04:00:31 +0000"/>
  </column>
</template>

<template name="global-dashboard-content" args="padding">
  <column padding="{padding}" gap="32">
    <column gap="6">
      <text size="heading">Global Dashboard</text>
      <text wrap="true" foreground="text_muted">
        Overview of all taxpayer profiles for 2026
      </text>
    </column>

    <if test="{constrainedLayout}">
      <column gap="24">
        <use template="global-calendar-column"/>
        <use template="global-news-column"/>
      </column>
    </if>
    <else>
      <row gap="20" cross="start">
        <use template="global-calendar-column"/>
        <use template="global-news-column"/>
      </row>
    </else>
  </column>
</template>

<template name="global-dashboard-page">
  <scroll grow="1" global-key="page-global-dashboard" label="Global dashboard content">
    <if test="{phoneLayout}">
      <use template="global-dashboard-content" padding="16"/>
    </if>
    <else>
      <if test="{desktopLayout}">
        <use template="global-dashboard-content" padding="32"/>
      </if>
      <else>
        <use template="global-dashboard-content" padding="24"/>
      </else>
    </else>
  </scroll>
</template>
