"><alert text="Resolved filing scope"><column gap="8"><row><badge variant="destructive">Not fileable</badge></row><text wrap="true">{preview2550QIdentity}</text><text>Filing period: {formFilingPeriodLabel}</text><text wrap="true">{preview2550QScope}</text><for each="preview2550QCoverage" key="id" as="coverage"><text wrap="true">• {coverage.accessibleLabel}</text></for><separator/><column gap="6"><text><span weight="bold">Captured source-record filter</span></text><row><badge variant="outline">Fixture metadata only</badge></row><text size="sm" wrap="true" foreground="text_muted">These deterministic source-index rows are not imported business data. They contain no transaction amounts or schedule payloads and do not populate the 2550Q fields below.</text><text wrap="true" foreground="text_muted">{preview2550QSourceSummary}</text><if test="{preview2550QSourceRecordsEmpty}"><text wrap="true" foreground="text_muted">No explicitly attributed source records matched this filter.</text></if><else><for each="preview2550QSourceRecords" key="stableKey" as="record"><text wrap="true" label="{record.accessibleLabel}">• {record.visibleLabel} · {record.occurredOnLabel} · {record.attributionLabel}</text></for></else><if test="{preview2550QSourceReviewRequired}"><text wrap="true" foreground="warning">{preview2550QSourceReviewLabel}</text></if></column><text wrap="true" foreground="text_muted">{preview2550QEvidence}</text><separator/><column gap="6"><text><span weight="bold">Registration evidence</span></text><for each="preview2550QRegistrationEvidence" key="id" as="evidence"><column gap="3" label="{evidence.accessibleLabel}"><text><span weight="bold">{evidence.subjectLabel}</span>· {evidence.subjectId}</text><text size="sm" wrap="true" foreground="text_muted">Evidence ID: {evidence.evidenceId}</text><text size="sm" wrap="true" foreground="text_muted">Review decision: {evidence.reviewDecisionId} · sequence {evidence.reviewDecisionSequence}</text><text size="sm" wrap="true" foreground="text_muted">Assertion ID: {evidence.assertionId}</text></column></for></column><separator/><column gap="6"><text><span weight="bold">Policy evidence</span></text><for each="preview2550QPolicyEvidence" key="id" as="evidence"><column gap="3"><text><span weight="bold">{evidence.displayName}</span></text><text wrap="true">{evidence.reviewBasis}</text><text size="sm" wrap="true" foreground="text_muted">Evidence ID: {evidence.evidenceId}</text></column></for></column><text wrap="true" foreground="text_muted">{preview2550QReadiness}</text></column></alert></if><else><use template="fx"/></else><card><column padding="20" gap="12"><text size="heading">FILING PERIOD AND BACKGROUND INFORMATION</text><if test="{constrainedLayout}"><use template="fn" columns="1"/></if><if test="{tabletLayout}"><use template="fn" columns="2"/></if><if test="{desktopLayout}"><use template="fn" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">PART IV — SALES AND OUTPUT TAX</text><if test="{constrainedLayout}"><use template="fo" columns="1"/></if><if test="{tabletLayout}"><use template="fo" columns="2"/></if><if test="{desktopLayout}"><use template="fo" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">PART IV — CURRENT PURCHASES AND ADJUSTMENTS</text><if test="{constrainedLayout}"><use template="fp" columns="1"/></if><if test="{tabletLayout}"><use template="fp" columns="2"/></if><if test="{desktopLayout}"><use template="fp" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 1 — CAPITAL GOODS (2 reviewed rows)</text><use template="ft"/></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 2 — INPUT TAX ATTRIBUTABLE TO EXEMPT SALES</text><if test="{constrainedLayout}"><use template="fq" columns="1"/></if><if test="{tabletLayout}"><use template="fq" columns="2"/></if><if test="{desktopLayout}"><use template="fq" columns="3"/></if></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 3 — CREDITABLE VAT WITHHELD (2 reviewed rows)</text><use template="fu"/></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 4 — ADVANCE VAT PAYMENTS (2 reviewed rows)</text><use template="fv"/></column></card><card><column padding="20" gap="12"><text size="heading">PART II — TOTAL TAX PAYABLE</text><if test="{constrainedLayout}"><use template="fr" columns="1"/></if><if test="{tabletLayout}"><use template="fr" columns="2"/></if><if test="{desktopLayout}"><use template="fr" columns="3"/></if><separator/><if test="{constrainedLayout}"><column gap="8"><text>Total Amount Payable</text><row cross="center"><badge>PHP 0.00</badge></row></column></if><else><row gap="8"><text grow="1">Total Amount Payable</text><badge>PHP 0.00</badge></row></else></column></card><card><column padding="20" gap="12"><text size="heading">SIGNATURE AND LOCAL PAYMENT DETAILS</text><if test="{constrainedLayout}"><use template="fs" columns="1"/></if><if test="{tabletLayout}"><use template="fs" columns="2"/></if><if test="{desktopLayout}"><use template="fs" columns="3"/></if></column></card></column></scroll></template><template name="fz" args="columns"><grid columns="{columns}" gap="12"><column gap="4"><text foreground="text_muted">1 Taxable-period basis</text><input text="{percentageTaxPeriodBasis}" placeholder="Calendar / Fiscal" disabled="true"/><text wrap="true" foreground="text_muted">Read-only from the frozen Base Tax Profile revision.</text></column><column gap="4"><text foreground="text_muted">2 Year-end month</text><input text="{percentageTaxYearEndMonth}" placeholder="Month" disabled="true"/><text wrap="true" foreground="text_muted">Derived from the frozen Base Tax Profile revision.</text></column><use template="c" label="Taxable Quarter" v="{percentageTaxQuarter}" ph="Quarter"/><use template="c" label="Taxable Year" v="{percentageTaxYear}" ph="YYYY"/><column gap="4"><text foreground="text_muted">5 Number of Sheets Attached</text><input text="{percentageTaxSheetsAttached}" placeholder="Enter number" disabled="{not percentageTaxEditable}" on-input="percentage_tax_sheets_attached_input"/></column><use template="c" label="Return Options" v="{percentageTaxReturnOption}" ph="Original / Amended"/><use template="c" label="Amended Return?" v="{percentageTaxAmendedReturn}" ph="No"/><column gap="4"><text foreground="text_muted">Tax Relief?</text><input text="{percentageTaxRelief}" placeholder="No / Specify" disabled="true"/><row gap="8"><button variant="outline" selected="{percentageTaxReliefNoneSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_relief_none">No</button><button variant="outline" selected="{percentageTaxReliefSpecifiedSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_relief_specified">Specify</button></row></column><column gap="4"><text foreground="text_muted">12A Tax Relief Specification</text><input text="{percentageTaxReliefReference}" placeholder="Relief code or basis" disabled="{not percentageTaxEditable}" on-input="percentage_tax_relief_reference_input"/></column><if test="{percentageTaxElectionVisible}"><column gap="4"><text foreground="text_muted">13 What income tax rates are you availing?</text><input height="44" text="{percentageTaxElection}" placeholder="Set in the 2551Q Tax Form Profile" disabled="true"/><text wrap="true" foreground="text_muted">Item 13 is projected only for Q1 from the exact saved 2551Q Tax Form Profile revision.</text></column></if></grid></template><template name="ga" args="columns"><grid columns="{columns}" gap="12"><use template="c" label="TIN" v="{formFilerTin}" ph="000-000-000-000"/><use template="c" label="RDO Code" v="{formFilerRdo}" ph="RDO"/><use template="c" label="Taxpayer's Name" v="{formFilerTaxpayerName}" ph="Registered taxpayer name"/><column gap="4"><text foreground="text_muted">Registered Address</text><input text="{formFilerRegisteredAddress}" placeholder="Registered address" disabled="{not formFilingContactEditable}" on-input="form_filing_address_input"/></column><column gap="4"><text foreground="text_muted">ZIP Code</text><input text="{formFilerZipCode}" placeholder="ZIP code" disabled="{not formFilingContactEditable}" on-input="form_filing_zip_input"/></column><column gap="4"><text foreground="text_muted">Contact Number</text><input text="{formFilerContactNumber}" placeholder="Contact number" disabled="{not formFilingContactEditable}" on-input="form_filing_contact_input"/></column><column gap="4"><text foreground="text_muted">Email Address</text><input text="{formFilerEmailAddress}" placeholder="name@example.com" disabled="{not formFilingContactEditable}" on-input="form_filing_email_input"/></column></grid></template><template name="gb"><row gap="8" cross="center"><badge variant="outline">{formFilingContactProvenance}</badge><text grow="1" wrap="true" foreground="text_muted">Changes here apply to this filing only.</text><button height="44" variant="outline" disabled="{formFilingContactResetDisabled}" on-press="form_filing_use_profile_contacts">Use profile values</button></row></template><template name="gc" args="columns"><column gap="16"><text foreground="text_muted">Enter the externally supplied rate for each active row. No tax rate is assumed by the application.</text><grid columns="{columns}" gap="12"><column gap="4"><text foreground="text_muted">Schedule 1 Line 1 Percentage-tax Code</text><input text="{percentageTaxLine1Atc}" placeholder="ATC code" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_1_atc_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 1 Tax Base / Taxable Amount</text><input text="{percentageTaxLine1Base}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_1_base_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 1 Policy-supplied Tax Rate</text><input text="{percentageTaxLine1Rate}" placeholder="Rate" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_1_rate_input"/></column><use template="c" label="Schedule 1 Line 1 Percentage Tax Due" v="{percentageTaxLine1Due}" ph="Enter amount"/><column gap="4"><text foreground="text_muted">Schedule 1 Line 2 Percentage-tax Code</text><input text="{percentageTaxLine2Atc}" placeholder="ATC code" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_2_atc_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 2 Tax Base / Taxable Amount</text><input text="{percentageTaxLine2Base}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_2_base_input"/></column><column gap="4"><text foreground="text_muted">Schedule 1 Line 2 Policy-supplied Tax Rate</text><input text="{percentageTaxLine2Rate}" placeholder="Rate" disabled="{not percentageTaxEditable}" on-input="percentage_tax_line_2_rate_input"/></column><use template="c" label="Schedule 1 Line 2 Percentage Tax Due" v="{percentageTaxLine2Due}" ph="Enter amount"/></grid></column></template><template name="gd" args="columns"><grid columns="{columns}" gap="12"><use template="c" label="14 Total Percentage Tax Due" v="{percentageTaxTotalDue}" ph="Enter amount"/><column gap="4"><text foreground="text_muted">15 Creditable Percentage Tax Withheld</text><input text="{percentageTaxCreditableWithheld}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_creditable_withheld_input"/></column><column gap="4"><text foreground="text_muted">16 Tax Paid in Previous Return</text><input text="{percentageTaxPaidPrevious}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_paid_previous_input"/></column><column gap="4"><text foreground="text_muted">17 Other Tax Credit / Payment</text><input text="{percentageTaxOtherCredit}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_other_credit_input"/></column><use template="c" label="18 Total Tax Credits / Payments" v="{percentageTaxTotalCredits}" ph="Enter amount"/><use template="c" label="19 Tax Payable / (Overpayment)" v="{percentageTaxNetTax}" ph="Enter amount"/><column gap="4"><text foreground="text_muted">20 Surcharge (manual)</text><input text="{percentageTaxSurcharge}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_surcharge_input"/></column><column gap="4"><text foreground="text_muted">21 Interest (manual)</text><input text="{percentageTaxInterest}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_interest_input"/></column><column gap="4"><text foreground="text_muted">22 Compromise (manual)</text><input text="{percentageTaxCompromise}" placeholder="Enter amount" disabled="{not percentageTaxEditable}" on-input="percentage_tax_compromise_input"/></column><column gap="4"><text foreground="text_muted">24 Overpayment Disposition</text><input text="{percentageTaxDisposition}" placeholder="Refund / Tax Credit / Carry Over" disabled="true"/><row gap="8"><button variant="outline" selected="{percentageTaxDispositionNotApplicableSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_disposition_not_applicable">N/A</button><button variant="outline" selected="{percentageTaxDispositionRefundSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_disposition_refund">Refund</button><button variant="outline" selected="{percentageTaxDispositionTaxCreditSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_disposition_tax_credit">Tax credit</button><button variant="outline" selected="{percentageTaxDispositionCarryOverSelected}" disabled="{not percentageTaxEditable}" on-press="percentage_tax_disposition_carry_over">Carry over</button></row></column></grid></template><template name="ge"><column><if test="{constrainedLayout or tabletLayout}"><column gap="12"><column gap="8"><column gap="2"><text foreground="text_muted">ATC</text><text>{percentageTaxLine1Atc}</text></column><column gap="2"><text foreground="text_muted">Tax Base / Taxable Amount</text><text>{percentageTaxLine1Base}</text></column><column gap="2"><text foreground="text_muted">Tax Rate</text><text>{percentageTaxLine1Rate}</text></column><column gap="2"><text foreground="text_muted">Percentage Tax Due</text><text>{percentageTaxLine1Due}</text></column></column><separator/><column gap="8"><column gap="2"><text foreground="text_muted">ATC</text><text>{percentageTaxLine2Atc}</text></column><column gap="2"><text foreground="text_muted">Tax Base / Taxable Amount</text><text>{percentageTaxLine2Base}</text></column><column gap="2"><text foreground="text_muted">Tax Rate</text><text>{percentageTaxLine2Rate}</text></column><column gap="2"><text foreground="text_muted">Percentage Tax Due</text><text>{percentageTaxLine2Due}</text></column></column></column></if><else><table gap="4"><table-row gap="8"><table-cell>ATC</table-cell><table-cell>Tax Base / Taxable Amount</table-cell><table-cell>Tax Rate</table-cell><table-cell>Percentage Tax Due</table-cell></table-row><table-row gap="8"><table-cell>{percentageTaxLine1Atc}</table-cell><table-cell>{percentageTaxLine1Base}</table-cell><table-cell>{percentageTaxLine1Rate}</table-cell><table-cell>{percentageTaxLine1Due}</table-cell></table-row><table-row gap="8"><table-cell>{percentageTaxLine2Atc}</table-cell><table-cell>{percentageTaxLine2Base}</table-cell><table-cell>{percentageTaxLine2Rate}</table-cell><table-cell>{percentageTaxLine2Due}</table-cell></table-row></table></else></column></template><template name="gf"><column><if test="{constrainedLayout}"><column gap="16"><column gap="6"><text size="heading">BIR Form No. 2551Q</text><text>Quarterly Percentage Tax Return</text><row gap="8" cross="center"><text foreground="text_muted" grow="1">January 2018 (ENCS)</text><badge>Draft</badge></row></column><column gap="8"><button variant="ghost" on-press="show_taxpayer_dashboard">Back</button><button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button><separator/><button variant="secondary" disabled="{not formProfileCanSaveDraft}" on-press="save_recurring_form_draft">Save</button><button variant="primary" disabled="true">Submit</button></column></column></if><else><column gap="16"><row gap="16" cross="center"><column gap="4" grow="1"><text size="heading">BIR Form No. 2551Q</text><text>Quarterly Percentage Tax Return</text><text foreground="text_muted">January 2018 (ENCS)</text></column><badge>Draft</badge></row><row gap="8"><button variant="ghost" on-press="show_taxpayer_dashboard">Back</button><button variant="secondary" on-press="show_aux_html_print_preview">Print Preview</button><spacer/><button variant="secondary" disabled="{not formProfileCanSaveDraft}" on-press="save_recurring_form_draft">Save</button><button variant="primary" disabled="true">Submit</button></row></column></else></column></template><template name="gg"><card><column padding="20" gap="12"><text size="heading">Filing status</text><if test="{constrainedLayout}"><if test="{phoneLayout}"><column gap="8"><row cross="center"><badge>Draft</badge></row><text foreground="text_muted">Next: Queued, Submitted, Confirmed, and Paid</text></column></if><else><row gap="12" cross="center"><badge>Draft</badge><text foreground="text_muted" grow="1">Next: Queued, Submitted, Confirmed, and Paid</text></row></else></if><else><stepper active="0"><step>Draft</step><step>Queued</step><step>Submitted</step><step>Confirmed</step><step>Paid</step></stepper></else></column></card></template><template name="gh"><scroll grow="1" global-key="page-form-2551q"><column padding="32" gap="24"><use template="gf"/><use template="l"/><use template="gg"/><card><column padding="20" gap="12"><text size="heading">FILING PERIOD</text><if test="{constrainedLayout}"><use template="fz" columns="1"/></if><if test="{tabletLayout}"><use template="fz" columns="2"/></if><if test="{desktopLayout}"><use template="fz" columns="4"/></if></column></card><card><column padding="20" gap="12"><text size="heading">PART I — BACKGROUND INFORMATION (pre-filled from profile)</text><if test="{constrainedLayout}"><use template="ga" columns="1"/></if><if test="{tabletLayout}"><use template="ga" columns="2"/></if><if test="{desktopLayout}"><use template="ga" columns="3"/></if><use template="gb"/></column></card><card><column padding="20" gap="12"><text size="heading">SCHEDULE 1 — COMPUTATION OF TAX</text><if test="{constrainedLayout}"><use template="gc" columns="1"/></if><if test="{tabletLayout}"><use template="gc" columns="2"/></if><if test="{desktopLayout}"><use template="gc" columns="4"/></if><separator/><use template="ge"/></column></card><card><column padding="20" gap="12"><text size="heading">PART II — COMPUTATION OF TAX</text><if test="{constrainedLayout}"><use template="gd" columns="1"/></if><if test="{tabletLayout}"><use template="gd" columns="2"/></if><if test="{desktopLayout}"><use template="gd" columns="3"/></if><separator/><if test="{constrainedLayout}"><column gap="8"><text>Total Amount Payable</text><row cross="center"><badge>PHP {percentageTaxTotalAmountPayable}</badge></row></column></if><else><row gap="8"><text grow="1">Total Amount Payable</text><badge>PHP {percentageTaxTotalAmountPayable}</badge></row></else><text foreground="text_muted">{percentageTaxValidationStatus}</text></column></card><card><column padding="20" gap="12"><text size="heading">Submission controls by status</text><text foreground="text_muted">Draft: Save and Submit. Queued: Cancel Submission Queue. Submitted: Revert Draft and Check Confirmation or Mark as Confirmed Manually. Confirmed: Revert Draft and Mark as Paid. A receipt action appears when available.</text></column></card></column></scroll></template>
